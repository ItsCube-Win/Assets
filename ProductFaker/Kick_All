    statusLabel.TextColor3 = color or Color3.fromRGB(200, 200, 220)
end

local function sendFakeSignal()
    local id = 3557475287
    local mps = game:GetService("MarketplaceService")
    local ok, err = pcall(function()
        mps:SignalPromptProductPurchaseFinished(player.UserId, id, true)
    end)
    if ok then
        updateStatus("Kick signal sent! (" .. id .. ")", Color3.fromRGB(0, 255, 127))
        sendButton.Text = "KICKED!"
        sendButton.TextColor3 = Color3.fromRGB(0, 255, 127)
        sendButton.BackgroundColor3 = Color3.fromRGB(30, 100, 30)
        task.wait(1.5)
        sendButton.Text = "KICK"
        sendButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        sendButton.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    else
        updateStatus("Error: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        sendButton.Text = "ERROR"
        sendButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        sendButton.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
        task.wait(1.5)
        sendButton.Text = "KICK"
        sendButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        sendButton.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    end
end

sendButton.MouseButton1Click:Connect(sendFakeSignal)

sendButton.MouseEnter:Connect(function()
    sendButton.BackgroundColor3 = Color3.fromRGB(230, 50, 50)
end)
sendButton.MouseLeave:Connect(function()
    sendButton.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
end)

local dragging, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
