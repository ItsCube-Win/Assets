-- ==================== ЛОГИКА ====================
local flying = false

local function setStatus(text, color)
    Status.Text = text
    Status.TextColor3 = color or Color3.fromRGB(180, 180, 200)
end

local function getSpeed()
    local v = tonumber(SpeedBox.Text)
    if not v or v <= 0 then v = DEFAULT_SPEED end
    if v > 1000 then v = 1000 end
    if v < 5 then v = 5 end
    return v
end

local function getDepth()
    local v = tonumber(DepthBox.Text)
    if not v or v <= 0 then v = DEFAULT_DEPTH end
    if v > 500 then v = 500 end
    if v < 10 then v = 10 end
    return v
end

local function getStopDist()
    local v = tonumber(StopBox.Text)
    if not v or v <= 0 then v = ITEM_STOP_DIST end
    if v > 50 then v = 50 end
    if v < 3 then v = 3 end
    return v
end

local function getThrowDirection()
    local cam = workspace.CurrentCamera
    local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
    local horiz = Vector3.new(look.X, 0, look.Z)
    if horiz.Magnitude > 0.15 then return horiz.Unit end
    return Vector3.new(0, 0, -1)
end

local function zeroVelocity(hrp)
    if not hrp then return end
    pcall(function()
        hrp.Velocity = Vector3.zero
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end)
end

-- Плавный полёт по сегменту
local function flySegment(fromPos, toPos, speed)
    local hrp = getHRP()
    if not hrp then return end
    local dist = (toPos - fromPos).Magnitude
    if dist < 0.5 then return end
    local duration = dist / speed
    if duration < 0.05 then duration = 0.05 end
    local t0 = os.clock()
    while os.clock() - t0 < duration do
        local t = (os.clock() - t0) / duration
        if t >= 1 then break end
        local curPos = fromPos:Lerp(toPos, t)
        pcall(function() hrp.CFrame = CFrame.new(curPos) end)
        zeroVelocity(hrp)
        task.wait()
    end
    pcall(function() hrp.CFrame = CFrame.new(toPos) end)
    zeroVelocity(hrp)
    task.wait(0.05)
end

-- ============ ПОЛЁТ (только дальний) ============
local function flyToPos(targetPos, speed, depth, lockCarry, stopDist)
    if flying then return end
    local hrp = getHRP()
    if not hrp then return end
    flying = true

    local origCarry = LocalPlayer:GetAttribute("IsCarrying")
    if lockCarry then
        LocalPlayer:SetAttribute("IsCarrying", true)
    end

    local lockConn
    if lockCarry then
        lockConn = RunService.Heartbeat:Connect(function()
            LocalPlayer:SetAttribute("IsCarrying", true)
        end)
    end

    stopDist = stopDist or 3
    local startPos = hrp.Position
    local dir = targetPos - startPos
    local fullDist = dir.Magnitude

    if fullDist <= stopDist then
        -- Уже близко — не летим
        flying = false
        if lockConn then lockConn:Disconnect() end
        if lockCarry then
            LocalPlayer:SetAttribute("IsCarrying", origCarry or false)
        end
        return
    end

    local finalTarget = startPos + dir.Unit * (fullDist - stopDist)

    if silentEnabled then
        local dropPos = Vector3.new(startPos.X, startPos.Y - depth, startPos.Z)
        local underTarget = Vector3.new(finalTarget.X, finalTarget.Y - depth, finalTarget.Z)
        -- Поднимаемся чуть выше земли цели — потом сами упадём
        local risePos = Vector3.new(finalTarget.X, finalTarget.Y + 5, finalTarget.Z)

        flySegment(startPos, dropPos, speed)
        flySegment(dropPos, underTarget, speed)
        flySegment(underTarget, risePos, speed)
    else
        local endPos = Vector3.new(finalTarget.X, finalTarget.Y + 5, finalTarget.Z)
        flySegment(startPos, endPos, speed)
    end

    -- Финальная заморозка
    zeroVelocity(hrp)

    if lockConn then lockConn:Disconnect() end
    if lockCarry then
        LocalPlayer:SetAttribute("IsCarrying", origCarry or false)
    end

    flying = false
    print("[Fly] Прибыл в", hrp.Position)
end

-- ============ ПЕШКОМ К ЦЕЛИ ============
local function walkToTarget(targetPos, stopDist, timeout)
    stopDist = stopDist or 3
    timeout = timeout or WALK_TIMEOUT

    local hum = getHum()
    local hrp = getHRP()
    if not hum or not hrp then return false end

    -- Ждём падения на землю (или пока не зависнем)
    setStatus("🪂 Падаю на землю...", Color3.fromRGB(200, 180, 120))
    local landStart = os.clock()
    while os.clock() - landStart < LAND_WAIT do
        if not hum.Parent or hum.Health <= 0 then return false end
        task.wait(0.05)
    end

    -- Проверяем что стоим (получили коллизию с землёй — Humanoid.FloorMaterial не nil)
    local floorWait = os.clock()
    while os.clock() - floorWait < 1.5 do
        if hum.FloorMaterial ~= Enum.Material.Air then break end
        if not hum.Parent or hum.Health <= 0 then return false end
        task.wait(0.05)
    end

    -- Теперь идём
    setStatus("🚶 Иду пешком...", Color3.fromRGB(160, 220, 160))

    local oldSpeed = hum.WalkSpeed
    hum.WalkSpeed = WALK_SPEED

    pcall(function() hum:MoveTo(targetPos) end)

    local t0 = os.clock()
    local reached = false
    while os.clock() - t0 < timeout do
        if not hum.Parent or hum.Health <= 0 then break end
        local cur = hrp.Position
        local dx, dz = cur.X - targetPos.X, cur.Z - targetPos.Z
        local d = math.sqrt(dx*dx + dz*dz)
        if d < stopDist then
            reached = true
            break
        end
        task.wait(0.05)
    end

    -- Стоп
    pcall(function() hum:MoveTo(hrp.Position) end)
    task.wait(0.1)
    hum.WalkSpeed = oldSpeed

    if reached then
        setStatus("✅ Дошёл", Color3.fromRGB(80, 190, 120))
    else
        setStatus("⚠ Не дошёл", Color3.fromRGB(240, 170, 70))
    end
    return reached
end

-- ============ АКТИВАЦИЯ ПРОМПТА ============
local function activatePrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    local hrp = getHRP()
    if hrp and prompt.Parent then
        local pp = prompt.Parent
        local tp
        if pp:IsA("BasePart") then tp = pp.Position
        elseif pp:IsA("Model") then
            local ok, p = pcall(function() return pp:GetPivot().Position end)
            if ok then tp = p end
        end
        if tp then
            local look = CFrame.lookAt(hrp.Position, Vector3.new(tp.X, hrp.Position.Y, tp.Z))
            pcall(function() hrp.CFrame = look end)
            task.wait(0.15)
        end
    end

    local ok1 = pcall(function() prompt:InputHoldBegin() end)
    if not ok1 then
        print("[Auto] InputHoldBegin упал")
        return false
    end
    local dur = prompt.HoldDuration or 0
    if dur > 0 then
        task.wait(dur + 0.1)
    else
        task.wait(0.15)
    end
    pcall(function() prompt:InputHoldEnd() end)
    return true
end

-- ==================== ОСНОВНОЙ ЦИКЛ ====================
local function runAutoLoop()
    print("[Auto] Старт цикла")
    while getgenv().AutoBaseRunning do
        local items = scanItems()
        InfoLabel.Text = ("Strength: %d | Items: %d"):format(getStrength(), #items)

        if #items == 0 then
            setStatus("⏳ Нет подходящих", Color3.fromRGB(240, 170, 70))
            task.wait(1)
            continue
        end

        table.sort(items, function(a, b) return a.dist < b.dist end)
        local pick = items[1]

        setStatus(("1/4 → %s (w=%s)"):format(pick.model.Name, tostring(pick.weight)), Color3.fromRGB(255, 200, 80))
        print(("[Auto] Цель: %s w=%s d=%.1f"):format(pick.model.Name, tostring(pick.weight), pick.dist))

        -- 1. ЛЕТИМ (только дальний полёт, стоп за N studs)
        flyToPos(pick.pos, getSpeed(), getDepth(), false, getStopDist())

        if not getgenv().AutoBaseRunning then break end
        task.wait(0.2)

        -- 2. ИДЁМ ПЕШКОМ до предмета
        setStatus("2/4 Иду к предмету...", Color3.fromRGB(160, 220, 160))
        walkToTarget(pick.pos, 3, WALK_TIMEOUT)
        task.wait(0.3)

        if not pick.model.Parent then
            setStatus("⚠ Исчез", Color3.fromRGB(240, 170, 70))
            task.wait(0.3)
            continue
        end

        -- 3. ПОДБИРАЕМ
        local prompt = findPickupPrompt(pick.model)
        if not prompt then
            setStatus("❌ Нет PickupPrompt", Color3.fromRGB(230, 90, 90))
            task.wait(0.5)
            continue
        end

        setStatus("3/4 Подбираю...", Color3.fromRGB(160, 200, 240))
        activatePrompt(prompt)
        task.wait(0.6)

        if not isCarrying() then
            setStatus("⚠ Не подобрал", Color3.fromRGB(240, 170, 70))
            task.wait(0.5)
            continue
        end

        -- 4. ЛЕТИМ НА БАЗУ + БРОСОК
        local base = findMyBase()
        if not base then
            setStatus("❌ Нет базы", Color3.fromRGB(230, 90, 90))
            task.wait(1)
            continue
        end
        local hole = findHoleHitbox(base)
        if not hole then
            setStatus("❌ Нет HoleHitbox", Color3.fromRGB(230, 90, 90))
            task.wait(1)
            continue
        end

        setStatus("4/4 На базу + бросок...", Color3.fromRGB(160, 240, 160))
        flyToPos(hole.Position, getSpeed(), getDepth(), true, BASE_STOP_DIST)

        if not getgenv().AutoBaseRunning then break end
        task.wait(0.5)

        if ThrowItem and isCarrying() then
            local dir = getThrowDirection()
            pcall(function() ThrowItem:FireServer(dir) end)
            print(("[Auto] Бросок: %.2f, %.2f, %.2f"):format(dir.X, dir.Y, dir.Z))
            setStatus("🎯 Брошено!", Color3.fromRGB(80, 190, 120))
            task.wait(0.5)
        else
            setStatus("⚠ Нечего бросать", Color3.fromRGB(240, 170, 70))
            task.wait(0.5)
        end

        task.wait(AUTO_DELAY)
    end
    setStatus("⏹ Стоп", Color3.fromRGB(150, 150, 170))
    print("[Auto] Цикл завершён")
end

AutoBtn.MouseButton1Click:Connect(function()
    if autoRunning then
        autoRunning = false
        getgenv().AutoBaseRunning = false
        AutoBtn.Text = "▶ AUTO: OFF"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(120, 100, 255)
        setStatus("⏹ Остановлено", Color3.fromRGB(150, 150, 170))
    else
        autoRunning = true
        getgenv().AutoBaseRunning = true
        AutoBtn.Text = "⏸ AUTO: ON"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(240, 100, 100)
        setStatus("🚀 Запуск...", Color3.fromRGB(80, 190, 120))
        task.spawn(runAutoLoop)
    end
end)

ManualBtn.MouseButton1Click:Connect(function()
    if flying then return end
    task.spawn(function()
        local base = findMyBase()
        if not base then
            setStatus("❌ База не найдена", Color3.fromRGB(230, 90, 90))
            return
        end
        local hole = findHoleHitbox(base)
        if not hole then
            setStatus("❌ HoleHitbox нет", Color3.fromRGB(230, 90, 90))
            return
        end
        setStatus("⚡ На базу...", Color3.fromRGB(255, 200, 80))
        flyToPos(hole.Position, getSpeed(), getDepth(), isCarrying(), BASE_STOP_DIST)
        task.wait(0.5)
        if ThrowItem and isCarrying() then
            local dir = getThrowDirection()
            pcall(function() ThrowItem:FireServer(dir) end)
            setStatus("🎯 Брошено", Color3.fromRGB(80, 190, 120))
        else
            setStatus("✅ Прибыл", Color3.fromRGB(80, 190, 120))
        end
    end)
end)

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(1)
        local s = getStrength()
        local items = scanItems()
        InfoLabel.Text = ("Strength: %d | Items: %d"):format(s, #items)
    end
end)

print("[Auto Base Runner — Walk on Arrival] Загружено")
