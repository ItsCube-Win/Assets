
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local MyUserId = LocalPlayer.UserId

local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
local ThrowItem = remotes and remotes:WaitForChild("ThrowItem", 10)

-- ==================== КОНФИГ ====================
local DEFAULT_SPEED = 75
local DEFAULT_DEPTH = 60
local SILENT_MODE = true
local AUTO_DELAY = 0.6
local ITEM_STOP_DIST = 10       -- за N studs до предмета отключаем флай
local BASE_STOP_DIST = 3        -- за N studs до HoleHitbox
local WALK_SPEED = 16
local LAND_WAIT = 0.6           -- ждать падения на землю
local WALK_TIMEOUT = 4          -- макс время ходьбы

-- ==================== ХЕЛПЕРЫ ====================
local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getChar() return LocalPlayer.Character end

local function isCarrying()
    if LocalPlayer:GetAttribute("IsCarrying") == true then return true end
    local c = LocalPlayer.Character
    if c and c:GetAttribute("IsCarrying") == true then return true end
    local ci = LocalPlayer:FindFirstChild("CarryingItem")
    return ci and ci:IsA("ObjectValue") and ci.Value ~= nil
end

local function getStrength()
    local s = LocalPlayer:GetAttribute("Strength")
    if typeof(s) ~= "number" then return 0 end
    return s
end

local function findMyBase()
    local map0 = workspace:FindFirstChild("0Map")
    if not map0 then return nil end
    for _, folder in ipairs(map0:GetChildren()) do
        if folder.Name:lower():find("base") then
            for _, base in ipairs(folder:GetChildren()) do
                if base:GetAttribute("OwnerUserId") == MyUserId then
                    return base
                end
            end
        end
    end
    return nil
end

local function findHoleHitbox(base)
    if not base then return nil end
    return base:FindFirstChild("HoleHitbox")
end

local function findPickupPrompt(item)
    for _, obj in ipairs(item:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "PickupPrompt" then
            return obj
        end
    end
    for _, obj in ipairs(item:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then return obj end
    end
    return nil
end

local function getItemPosition(item)
    local prompt = findPickupPrompt(item)
    if prompt and prompt.Parent then
        local pp = prompt.Parent
        if pp:IsA("BasePart") then return pp.Position end
        if pp:IsA("Model") then
            local ok, pivot = pcall(function() return pp:GetPivot().Position end)
            if ok then return pivot end
        end
    end
    if item:IsA("Model") then
        local ok, pivot = pcall(function() return item:GetPivot().Position end)
        if ok then return pivot end
    end
    if item:IsA("BasePart") then return item.Position end
    return nil
end

local function scanItems()
    local folder = workspace:FindFirstChild("SpawnedItems")
    if not folder then return {} end
    local hrp = getHRP()
    if not hrp then return {} end
    local strength = getStrength()
    local myPos = hrp.Position
    local result = {}
    for _, item in ipairs(folder:GetChildren()) do
        local weight = item:GetAttribute("Weight")
        if typeof(weight) == "number" and weight <= strength then
            local pos = getItemPosition(item)
            if pos then
                table.insert(result, {
                    model = item, pos = pos,
                    dist = (pos - myPos).Magnitude, weight = weight,
                })
            end
        end
    end
    return result
end

local function getGuiParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- ==================== NOCLIP ====================
local noclipEnabled = true
RunService.Stepped:Connect(function()
    if not noclipEnabled then return end
    local char = getChar()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end)

