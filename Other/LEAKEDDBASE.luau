		self.Enabled = enabled == true

		if thread then
			pcall(function()
				task.cancel(thread)
			end)
			thread = nil
		end

		if self.Enabled then
			fn_handleTable()
			thread = task.spawn(function()
				local obj = setmetatable({}, {
					__mode = "k"
				})

				while self.Enabled do
					if fn_getAttribute() then
						local fnhandleHumanoid = fn_handleHumanoidRootPart()

						if fnhandleHumanoid then
							local setEnabledFlag, setEnabledValue2 = fn_getServerTimeNow(fnhandleHumanoid, obj)

