moduleDefs["Modules.Signal.OnlinePlayersHandler"] = function()
	return {
		Players = {},
		Listeners = {},
		Register = function(self, signalService)
			signalService:OnMessage("online_players", function(obj)
				if not obj.data then
					return
				end

				self.Players = obj.data
				self:Notify()
			end)
			signalService:OnMessage("player_joined", function(obj)
				if obj.player then
					table.insert(self.Players, obj.player)
					self:Notify()
				end
			end)
			signalService:OnMessage("player_left", function(obj)
				local number = tonumber(obj.userId)

				if number then
					for i, player in ipairs(self.Players) do
						if tonumber(player.userId) == number then
							table.remove(self.Players, i)

							break
						end
					end

					self:Notify()
				end
			end)
		end,
		GetPlayers = function(self)
			return self.Players
		end,
		GetCount = function(list)
			return #list.Players
		end,
		Subscribe = function(self, setOnlinePlayers)
			table.insert(self.Listeners, setOnlinePlayers)
		end,
		Notify = function(self)
			for _, listener in ipairs(self.Listeners) do
				pcall(listener, self.Players)
			end
		end
	}
end
moduleDefs["Modules.Signal.SkinSyncHandler"] = function()
	local Players = game_:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local registerBroadcastApply = {}
	local registerObj
	local registerObj2
	local registerList

	registerBroadcastApply.Register = function(self, signalService, tagService, onlinePlayersHandler)
		registerObj2 = signalService
		registerObj = tagService
		registerList = onlinePlayersHandler
		signalService:OnMessage("skin_sync", function(list)
			local number = tonumber(list.fromUserId)

			if not number or number == LocalPlayer.UserId then
				return
			end

			local player2
			for _, player in ipairs(Players:GetPlayers()) do
				if player.UserId == number then
					player2 = player

					break
				end
			end

			if not player2 then
				return
			end

			if list.action == "apply" and list.avatarId then
				tagService:ApplyToPlayer(player2, tonumber(list.avatarId))
			elseif list.action == "apply_desc" and list.description then
				local registerObj3, registerObj2_2 = tagService:DeserializeDescription(list.description)

				if registerObj3 and player2.Character then
					local Character = player2.Character
					local Humanoid = Character:FindFirstChildOfClass("Humanoid")

					if Humanoid then
						if not tagService.RemoteOriginalDescs[player2.UserId] then
							pcall(function()
								tagService.RemoteOriginalDescs[player2.UserId] = Humanoid:GetAppliedDescription()
							end)
						end

						pcall(function()
							if Humanoid.ApplyDescriptionClientServer then
								Humanoid:ApplyDescriptionClientServer(registerObj3)
							else
								Humanoid:ApplyDescription(registerObj3)
							end
						end)
						task.delay(0.2, function()
							if not Character or not Character.Parent then
								return
							end

							pcall(function()
								local BodyColors = Character:FindFirstChildOfClass("BodyColors")

								if not BodyColors then
									BodyColors = Instance.new("BodyColors")
									BodyColors.Parent = Character
								end

								if registerObj3.HeadColor then
									BodyColors.HeadColor3 = registerObj3.HeadColor
								end

								if registerObj3.TorsoColor then
									BodyColors.TorsoColor3 = registerObj3.TorsoColor
								end

								if registerObj3.LeftArmColor then
									BodyColors.LeftArmColor3 = registerObj3.LeftArmColor
								end

								if registerObj3.RightArmColor then
									BodyColors.RightArmColor3 = registerObj3.RightArmColor
								end

								if registerObj3.LeftLegColor then
									BodyColors.LeftLegColor3 = registerObj3.LeftLegColor
								end

								if registerObj3.RightLegColor then
									BodyColors.RightLegColor3 = registerObj3.RightLegColor
								end
							end)

							if registerObj2_2.ShirtTemplate and registerObj2_2.ShirtTemplate ~= "" then
								pcall(function()
									local Shirt = Character:FindFirstChildOfClass("Shirt") or Instance.new("Shirt")

									Shirt.Parent = Character
									Shirt.ShirtTemplate = registerObj2_2.ShirtTemplate
								end)
							end

							if registerObj2_2.PantsTemplate and registerObj2_2.PantsTemplate ~= "" then
								pcall(function()
									local Pants = Character:FindFirstChildOfClass("Pants") or Instance.new("Pants")

									Pants.Parent = Character
									Pants.PantsTemplate = registerObj2_2.PantsTemplate
								end)
							end

							if registerObj2_2.Graphic and registerObj2_2.Graphic ~= "" then
								pcall(function()
									local ShirtGraphic = Character:FindFirstChildOfClass("ShirtGraphic") or Instance.new("ShirtGraphic")

									ShirtGraphic.Parent = Character
									ShirtGraphic.Graphic = registerObj2_2.Graphic
								end)
							end

							if registerObj2_2.FaceTexture and registerObj2_2.FaceTexture ~= "" then
								pcall(function()
									local Head = Character:FindFirstChild("Head")

									if Head then
										for _, child in ipairs(Head:GetChildren()) do
											if child:IsA("Decal") and (child.Name == "face" or child.Face == Enum.NormalId.Front) then
												child:Destroy()
											end
										end

										local Decal = Instance.new("Decal")

										Decal.Name = "face"
										Decal.Face = Enum.NormalId.Front
										Decal.Texture = registerObj2_2.FaceTexture
										Decal.Parent = Head
									end
								end)
							end

							local Head = list.description.properties and list.description.properties.Head

							if Head and Head ~= 0 then
								pcall(function()
									local Head2 = Character:FindFirstChild("Head")

									if Head2 then
										local ok, result = pcall(game_.GetObjects, game_, "rbxassetid://" .. Head)

										if ok and result then
											local exitTo
											local isSpecialMesh

											for _, v in ipairs(result) do
												isSpecialMesh = v:IsA("SpecialMesh") and v or v:FindFirstChildOfClass("SpecialMesh")

												if isSpecialMesh then
													exitTo = 1

													break
												end
											end

											if exitTo == 1 then
												for _, child in ipairs(Head2:GetChildren()) do
													if child:IsA("SpecialMesh") or child:IsA("DataModelMesh") then
														child:Destroy()
													end
												end

												isSpecialMesh:Clone().Parent = Head2
											end
										end
									end
								end)
							end

							if tagService.DecollideAccessories then
								tagService:DecollideAccessories(Character, 2)
							else
								for _, descendant in ipairs(Character:GetDescendants()) do
									if descendant:IsA("BasePart") and descendant:FindFirstAncestorWhichIsA("Accessory") then
										descendant.CanCollide = false
										descendant.Massless = true
									end
								end
							end
						end)
					end
				end
			elseif list.action == "revert" then
				tagService:RevertPlayer(player2)
			end

			if list.horns and type_(list.horns) == "table" and registerList and player2.Character then
				for k, v in pairs(list.horns) do
					if v then
						local Head = player2.Character:FindFirstChild("Head")

						if Head then
							local registerList2 = ({
								Fiery = { 215718515 },
								Poisoned = { 1744060292 },
								Frozen = { 74891470 }
							})[k]

							if registerList2 then
								for _, instance in ipairs(registerList2) do
									pcall(function()
										local objects = game_:GetObjects("rbxassetid://" .. tostring(instance))

										if objects and objects[1] then
											local Accessory = objects[1]

											if not Accessory:IsA("Accessory") then
												Accessory = Accessory:FindFirstChildWhichIsA("Accessory", true) or Accessory
											end

											local Handle = Accessory:FindFirstChild("Handle")

											if Handle then
												local Attachment = Handle:FindFirstChildOfClass("Attachment")

												if Attachment then
													local part
													for _, descendant in pairs(Head:GetDescendants()) do
														if descendant:IsA("Attachment") and descendant.Name == Attachment.Name then
															part = descendant

															break
														end
													end

													if part then
														local Weld = Instance.new("Weld")

														Weld.Part0 = Head
														Weld.Part1 = Handle
														Weld.C0 = part.CFrame
														Weld.C1 = Attachment.CFrame
														Weld.Parent = Head
													end
												end
											end

											Accessory.Parent = player2.Character

											for _, part in pairs(Accessory:GetDescendants()) do
												if part:IsA("BasePart") then
													part.CanCollide = false
													part.Massless = true
												end
											end
										end
									end)
								end
							end
						end
					end
				end
			end
		end)
		signalService:OnMessage("skin_request_state", function()
			registerBroadcastApply:BroadcastState()
		end)
		Players.PlayerAdded:Connect(function()
			task.wait(2)
			registerBroadcastApply:BroadcastState()
		end)
	end
	registerBroadcastApply.BroadcastApply = function(self, appliedId)
		if not registerObj2 then
			return
		end

		registerObj2:Send("skin_sync", {
			fromUserId = LocalPlayer.UserId,
			action = "apply",
			avatarId = appliedId,
			horns = registerList and registerList:GetToggles() or nil
		})
	end
	registerBroadcastApply.BroadcastCustom = function(self, lastCustomDesc)
		if not registerObj2 then
			return
		end

		registerObj2:Send("skin_sync", {
			fromUserId = LocalPlayer.UserId,
			action = "apply_desc",
			description = lastCustomDesc,
			horns = registerList and registerList:GetToggles() or nil
		})
		self._lastCustomDesc = lastCustomDesc
	end
	registerBroadcastApply.BroadcastRevert = function()
		if not registerObj2 then
			return
		end

		registerObj2:Send("skin_sync", {
			fromUserId = LocalPlayer.UserId,
			action = "revert"
		})
	end
	registerBroadcastApply.BroadcastHorns = function()
		if not registerObj2 or not registerList then
			return
		end

		registerObj2:Send("skin_sync", {
			fromUserId = LocalPlayer.UserId,
			action = "horns",
			horns = registerList:GetToggles()
		})
	end
	registerBroadcastApply.BroadcastState = function(self)
		if not registerObj2 or not registerObj then
			return
		end

		if registerObj.Applied then
			if self._lastCustomDesc then
				self:BroadcastCustom(self._lastCustomDesc)
			elseif registerObj.AppliedId then
				self:BroadcastApply(registerObj.AppliedId)
			end
		elseif registerList then
			local broadcastStateFlag = false

			for _, v in pairs(registerList:GetToggles()) do
				if v then
					broadcastStateFlag = true

					break
				end
			end

			if broadcastStateFlag then
				self:BroadcastHorns()
			end
		end
	end

	return registerBroadcastApply
end
moduleDefs["Modules.Signal.TagHandler"] = function()
	local Players = game_:GetService("Players")
	local lookup = {}

	return {
		Register = function(self, signalService, tagService, onlinePlayersHandler)
			local UserId = Players.LocalPlayer.UserId

			local function fn_getPlayers(userId)
				if userId == UserId then
					return true
				end

				for _, player in ipairs(onlinePlayersHandler:GetPlayers()) do
					if tonumber(player.userId) == userId then
						return true
					end
				end

				return false
			end
			local function fn_getPlayers2()
				for _, player in ipairs(Players:GetPlayers()) do
					local lookupEntry = lookup[player.UserId]

					if lookupEntry and fn_getPlayers(player.UserId) then
						tagService:SetTag(player.UserId, lookupEntry.tag, lookupEntry.color or {
							255,
							255,
							255
						}, lookupEntry.effect, lookupEntry.tier, lookupEntry.colors)
					else
						tagService:RemoveTag(player.UserId)
					end
				end
			end

			signalService:OnMessage("tags", function(list)
				if not list.data then
					return
				end

				lookup = {}

				for k, v in pairs(list.data) do
					local number = tonumber(k)

					if number and v.tag then
						lookup[number] = v
					end
				end

				fn_getPlayers2()
			end)
			signalService:OnMessage("tag_update", function(obj)
				local number = tonumber(obj.userId)

				if not number then
					return
				end

				if obj.tag then
					lookup[number] = obj
				else
					lookup[number] = nil
				end

				fn_getPlayers2()
			end)
			signalService:OnMessage("injection_log", function(obj)
				if not tonumber(obj.userId) then
					return
				end

				fn_getPlayers2()
			end)
			signalService:OnMessage("player_left", function(obj)
				local number = tonumber(obj.userId)

				if number then
					lookup[number] = nil
					tagService:RemoveTag(number)
				end
			end)
			onlinePlayersHandler:Subscribe(function()
				fn_getPlayers2()
			end)
			Players.PlayerAdded:Connect(function()
				task.wait(0.1)
				fn_getPlayers2()
			end)
			signalService:OnMessage("vip_feature_update", function(obj)
				local number = tonumber(obj.userId)

				if not number then
					return
				end

				if obj.featureId == "hide_tag" then
					tagService:SetTagHidden(number, obj.active == true)
				end
			end)
			signalService:OnMessage("vip_feature_snapshot", function(obj)
				local users = obj.users

				if type_(users) ~= "table" then
					return
				end

				for k, user in pairs(users) do
					local number = tonumber(k)

					if number and type_(user) == "table" and user.hide_tag ~= nil then
						tagService:SetTagHidden(number, user.hide_tag == true)
					end
				end
			end)
		end
	}
end
