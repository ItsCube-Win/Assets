				while true do
					task.wait(10)

					if self.State.Active and self.State.ExpiresAt and self.State.Plan ~= "lifetime" and not self.State.FreeMode and not self.State.Frozen and self.State.ExpiresAt <= os.time() then
						self.State.Active = false
