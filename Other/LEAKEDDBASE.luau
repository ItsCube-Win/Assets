		end

		local Basement2 = House2:FindFirstChild("Basement 2")
		local NostalgicThings1 = Basement2 and Basement2:FindFirstChild("Nostalgic Things 1")
		local INTERACTIVE = NostalgicThings1 and NostalgicThings1:FindFirstChild("INTERACTIVE")

		if INTERACTIVE then
			local _InteractivePromptPart = INTERACTIVE:FindFirstChild("_InteractivePromptPart")
			local value

			if _InteractivePromptPart then
				for _, v in ipairs(_InteractivePromptPart:GetDescendants()) do
					if v:IsA("ProximityPrompt") then
						value = v

						break
					end
				end
			end

			local ImpostorMask = INTERACTIVE:FindFirstChild("Impostor Mask")
			local Batteries = INTERACTIVE:FindFirstChild("Batteries")

