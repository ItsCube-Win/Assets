				end

				local stages = scene.stages

				stages[#stages + 1] = list

				if not scene.conn then
					scene.conn = RunService2.Heartbeat:Connect(function(l)
						local M = os.clock()

						if l > 0.1 then
							l = 0.1
						end

						local c = scene.stages

						for G = #c, 1, -1.0 do
							local x = c[G]

							if not x.root.Parent then
								table.remove(c, G)
								x.running = false
							else
								x.t = x.t + l
								x.la = x.la + l

								if x.la >= 0.033 then
									x.la = 0
									scene.stepLayers(x)
								end

								if x.P then
									scene.stepParts(x, l)
								end
							end
						end

						if #c == 0 and scene.conn then
							scene.conn:Disconnect()
							scene.conn = nil
						end

						local l = scene.perf

						l.frames = l.frames + 1
						l.cost = l.cost + (os.clock() - M)
					end)
				end
			elseif not flag and list.running then
