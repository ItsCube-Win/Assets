			local ok, result = pcall(getconnections, remote.OnClientEvent)

			if ok and type_(result) == "table" then
				for _, v in ipairs(result) do
					pcall(function()
						if v.Disable then
							v:Disable()
						elseif v.Disconnect then
							v:Disconnect()
						end
					end)
				end
			end
		end

		local connection3 = remote.OnClientEvent:Connect(function()
			local fn_getPlayersResult = fn_getPlayers() or "(server-wide / staff?)"

			fn_applyLastAttacker(("hard-kill %s by %s"):format(remote.Name, fn_getPlayersResult))
			fn_applyStatus(("Blocked %s from %s"):format(remote.Name, fn_getPlayersResult))
		end)

		table.insert(setEnabledList, connection3)
	end
	local function onPlayerAdded(player)
		if player == LocalPlayer then
			return
		end

		local function onCharacterAdded(character)
			if not character then
				return
			end

			local function fn_handleGlitchTool()
				for _, child in ipairs(character:GetChildren()) do
					if child.Name == "GlitchTool" and not lookup2[player] then
						lookup2[player] = true
						fn_applyLastAttacker(("GlitchTool holder: @%s"):format(player.Name))
						fn_applyStatus(("@%s equipped GlitchTool"):format(player.Name))
					end
				end
			end

			fn_handleGlitchTool()
			lookup[#lookup + 1] = character.ChildAdded:Connect(function(child)
				if child.Name == "GlitchTool" and not lookup2[player] then
					lookup2[player] = true
					fn_applyLastAttacker(("GlitchTool holder: @%s"):format(player.Name))
					fn_applyStatus(("@%s got GlitchTool in %s"):format(player.Name, character.Name))
				end
			end)
		end

		onCharacterAdded(player:FindFirstChildOfClass("Backpack"))

		if player.Character then
			onCharacterAdded(player.Character)
		end

		lookup[#lookup + 1] = player.CharacterAdded:Connect(onCharacterAdded)
		lookup[#lookup + 1] = player.ChildAdded:Connect(function(child)
			if child:IsA("Backpack") then
				onCharacterAdded(child)
			end
		end)
	end
	local function fn_getPlayers2()
		for _, player in ipairs(Players:GetPlayers()) do
			onPlayerAdded(player)
		end

		lookup[#lookup + 1] = Players.PlayerAdded:Connect(onPlayerAdded)
	end
	local function fn_runDisable2(remote, perSec)
		if not remote then
			return
		end

		if type_(getconnections) ~= "function" then
			return
		end

		local list = {}
		local ok, result = pcall(getconnections, remote.OnClientEvent)

		if ok and type_(result) == "table" then
			for _, v in ipairs(result) do
				if v.Function then
					table.insert(list, v.Function)
				end

				pcall(function()
					if v.Disable then
						v:Disable()
					elseif v.Disconnect then
						v:Disconnect()
					end
				end)
			end
		end

		local now = os.clock()
		local amount = 0
		local connection3 = remote.OnClientEvent:Connect(function(...)
			local now2 = os.clock()

			if now2 - now > 1 then
				now = now2
				amount = 0
			end

			amount += 1

			if perSec < amount then
				fn_applyLastAttacker("rate-limit " .. remote.Name)

				return
			end

			for _, v in ipairs(list) do
				task.spawn(v, ...)
			end
		end)

		table.insert(setEnabledList, connection3)
	end
	local function fn_handlePlayerGui()
		local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

		if not PlayerGui then
			return
		end

		connection2 = PlayerGui.ChildAdded:Connect(function(child)
			if not onStatusChangedState.Enabled then
				return
			end

			task.defer(function()
				if not child.Parent then
					return
				end

				if child:IsA("ScreenGui") and child.Name == "" then
					local amount = 0

					for _, child2 in ipairs(child:GetChildren()) do
						if child2:IsA("Frame") then
							amount += 1

							if not (amount > 50) then
								continue
							end

							pcall(function()
								child:Destroy()
							end)
							fn_applyLastAttacker("GpuFlood ScreenGui")

							return
						end
					end
				end
			end)
		end)
	end
	local function fn_unnamed()
		for _, v in ipairs(tbl) do
			local fn_handleRemotesResult = fn_handleRemotes(v.folder, v.name)

			if fn_handleRemotesResult then
				fn_runDisable(fn_handleRemotesResult)
			end
		end

		for _, v in ipairs(tbl2) do
			local fn_handleRemotes2Result = fn_handleRemotes2(v.path)

			if fn_handleRemotes2Result then
				fn_runDisable2(fn_handleRemotes2Result, v.perSec)
			end
		end
	end

	onStatusChangedState.SetEnabled = function(self, flag)
		local enabled = flag == true

		if enabled == self.Enabled then
			return
		end

		self.Enabled = enabled

		for _, v in ipairs(setEnabledList) do
			pcall(function()
				v:Disconnect()
			end)
		end

		setEnabledList = {}

		for _, v in ipairs(lookup) do
			pcall(function()
				v:Disconnect()
			end)
		end

		lookup = {}
		lookup2 = {}

		if connection2 then
			pcall(function()
				connection2:Disconnect()
			end)
			connection2 = nil
		end

		if connection then
			pcall(function()
				connection:Disconnect()
			end)
			connection = nil
		end

		if not self.Enabled then
			fn_applyStatus("Idle")

			return
		end

		fn_handlePlayerScripts()
		fn_unnamed()
		fn_handlePlayerGui()
		fn_getPlayers2()
		connection = LocalPlayer.CharacterAdded:Connect(function()
			if self.Enabled then
				task.wait(0.5)
				fn_handlePlayerScripts()
				fn_unnamed()
			end
		end)
		fn_applyStatus("Armed")
	end
	onStatusChangedState.GetStatus = function(obj)
		return obj.Status
	end
	onStatusChangedState.GetBlockedCount = function(obj)
		return obj.BlockedCount
	end
	onStatusChangedState.GetLastAttacker = function(obj)
		return obj.LastAttacker
	end

	return onStatusChangedState
end
moduleDefs["Games.Rovibes.AutoCandy"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local onStatusChangedState = {
		Enabled = false,
		OnStatusChanged = nil,
		Status = "Idle",
		Collected = 0,
		Config = {
			speed = 350,
			returnToStart = true
		}
	}
	local tbl = {
		{
			folder = "HalloweenCandiesLocal",
			feature = "HalloweenCandy",
			attr = "CandiesAmount"
		},
		{
			folder = "WerewolfPotionsLocal",
			feature = "WerewolfBite",
			attr = "WerewolfPotions"
		}
	}
	local thread
	local connection
	local connection2
	local lookup = {}
	local Position
	local CFrame_

	local function fn_applyStatus(status)
		onStatusChangedState.Status = status

		if onStatusChangedState.OnStatusChanged then
			pcall(onStatusChangedState.OnStatusChanged, status)
		end
	end
	local function fn_handleHumanoidRootPart()
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if HumanoidRootPart and Humanoid and Humanoid.Health > 0 then
			return HumanoidRootPart
		end

		return nil
	end
	local function fn_handleModel()
		local lookup2 = {}

		for _, v in ipairs(tbl) do
			local VFolder = workspace:FindFirstChild(v.folder)

			if VFolder then
				for _, child in ipairs(VFolder:GetChildren()) do
					if child:IsA("Model") then
						lookup2[#lookup2 + 1] = child
					end
				end
			end
		end

		return lookup2
	end
	local function fn_getAttribute(attr)
		local attribute = LocalPlayer:GetAttribute(attr)

		return type_(attribute) == "number" and attribute or 0
	end
	local function fn_unnamed()
		local amount = 0

		for _, v in ipairs(tbl) do
			amount += fn_getAttribute(v.attr)
		end

		return amount
	end
	local function fn_handleCandiesAmount()
		return ("candy %d · potions %d"):format(fn_getAttribute("CandiesAmount"), fn_getAttribute("WerewolfPotions"))
	end
	local function fn_handleFeatures()
		local Features = ReplicatedStorage:FindFirstChild("Features")

		if not Features then
			return false
		end

		for _, v in ipairs(tbl) do
			if Features:FindFirstChild(v.feature) then
				return true
			end
		end

		return false
	end
	local function fnapplyFilter()
		local raycastParams = RaycastParams.new()

		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { LocalPlayer.Character }

		return raycastParams
	end
	local function fn_runRaycast(lookup3Entry, arg2)
		local hit = workspace:Raycast(Vector3.new(lookup3Entry, 60, arg2), Vector3.new(0, -140, 0), fnapplyFilter())

		return hit and hit.Position.Y or nil
	end
	local function fn_getPivot(obj)
		local Position2 = obj:GetPivot().Position
		local hit = workspace:Raycast(Position2 + Vector3.new(0, 20, 0), Vector3.new(0, -50, 0), fnapplyFilter())

		if not hit then
			return true
		end

		if Position2.Y - hit.Position.Y > 8 then
			return true
		end

		if Position2.Y < -5 then
			return true
		end

		return false
	end
	local function fn_applyCanCollideCFrame(flag)
		if flag then
			if connection then
				return
			end

			connection = RunService.Stepped:Connect(function()
				local Character = LocalPlayer.Character

				if not Character then
					return
				end

				for _, descendant in ipairs(Character:GetDescendants()) do
					if descendant:IsA("BasePart") and descendant.CanCollide then
						lookup[descendant] = true
						descendant.CanCollide = false
					end
				end
			end)
			connection2 = RunService.Heartbeat:Connect(function()
				if not Position then
					return
				end

				local fnhandleHumanoid = fn_handleHumanoidRootPart()

				if fnhandleHumanoid then
					fnhandleHumanoid.CFrame = CFrame.new(Position) * (fnhandleHumanoid.CFrame - fnhandleHumanoid.CFrame.Position)
					fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end

			if connection2 then
				connection2:Disconnect()
				connection2 = nil
			end

			Position = nil

			for k in pairs(lookup) do
				if k.Parent then
					k.CanCollide = true
				end
			end

			table.clear(lookup)
		end
	end

	local obj = setmetatable({}, {
		__mode = "k"
	})

	local function fn_unnamed2()
		local now = os.clock()

		for _, v in ipairs(fn_handleModel()) do
			if (obj[v] or 0) < now and not fn_getPivot(v) then
				return true
			end
		end

		return false
	end
	local function fnapplyC(amount, flag)
		Position = nil

		local clamped = math.clamp(tonumber(onStatusChangedState.Config.speed) or 350, 50, 800)
		local now = os.clock()

		while onStatusChangedState.Enabled and os.clock() - now < 12 do
			if flag and fn_unnamed2() then
				local fnhandleHumanoid = fn_handleHumanoidRootPart()

				Position = fnhandleHumanoid and fnhandleHumanoid.Position or nil

				return "candy"
			end

			local result = RunService.Heartbeat:Wait()
			local fnhandleHumanoid = fn_handleHumanoidRootPart()

			if not fnhandleHumanoid then
				return false
			end

			local vector = amount - fnhandleHumanoid.Position
			local Magnitude = vector.Magnitude

			if Magnitude < 1 then
				break
			end

			local assemblyLinearVelocity = vector / Magnitude

			fnhandleHumanoid.CFrame = CFrame.new(fnhandleHumanoid.Position + assemblyLinearVelocity * math.min(Magnitude, clamped * result)) * (fnhandleHumanoid.CFrame - fnhandleHumanoid.CFrame.Position)
			fnhandleHumanoid.AssemblyLinearVelocity = assemblyLinearVelocity * math.min(clamped, 200)
		end

		Position = amount

		return true
	end
	local function fn_handleMap()
		local Map = workspace:FindFirstChild("Map")

		if not Map then
			return nil
		end

		local huge = math.huge
		local huge3 = -math.huge
		local huge2 = math.huge
		local huge4 = -math.huge

		for _, descendant in ipairs(Map:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Size.Magnitude < 2000 then
				local Position2 = descendant.Position

				if Position2.X < huge then
					huge = Position2.X
				end

				if huge3 < Position2.X then
					huge3 = Position2.X
				end

				if Position2.Z < huge2 then
					huge2 = Position2.Z
				end

				if huge4 < Position2.Z then
					huge4 = Position2.Z
				end
			end
		end

		if huge3 < huge then
			return nil
		end

		return huge, huge3, huge2, huge4
	end
	local function fn_unnamed3()
		local flag, amount2, amount3, amount4 = fn_handleMap()

		if not flag then
			return {}
		end

		local lookup2 = {}
		local amount = 0
		local amount5 = amount3 + 250

		while amount5 <= amount4 do
			amount += 1

			local lookup3 = {}
			local amount6 = flag + 250

			while amount6 <= amount2 do
				lookup3[#lookup3 + 1] = amount6
				amount6 += 500
			end

			if amount % 2 == 0 then
				for i = #lookup3, 1, -1 do
					local fn_runRaycastResult = fn_runRaycast(lookup3[i], amount5)

					if fn_runRaycastResult then
						lookup2[#lookup2 + 1] = Vector3.new(lookup3[i], fn_runRaycastResult + 3, amount5)
					end
				end
			else
				for i = 1, #lookup3 do
					local fn_runRaycastResult = fn_runRaycast(lookup3[i], amount5)

					if fn_runRaycastResult then
						lookup2[#lookup2 + 1] = Vector3.new(lookup3[i], fn_runRaycastResult + 3, amount5)
					end
				end
			end

			amount5 += 500
		end

		return lookup2
	end
	local function fn_getPivot2()
		for i = 1, 30 do
			if not onStatusChangedState.Enabled then
				return
			end

			local fnhandleHumanoid = fn_handleHumanoidRootPart()

			if not fnhandleHumanoid then
				return
			end

			local now = os.clock()
			local instance
			local flag

			for _, v in ipairs(fn_handleModel()) do
				if (obj[v] or 0) < now and not fn_getPivot(v) then
					local Magnitude = (v:GetPivot().Position - fnhandleHumanoid.Position).Magnitude

					if not flag or Magnitude < flag then
						instance = v
						flag = Magnitude
					end
				end
			end

			if not instance then
				return
			end

			local Parent = instance.Parent
			local value = fn_unnamed()

			fnapplyC(instance:GetPivot().Position + Vector3.new(0, 1.5, 0))

			local now2 = os.clock()

			while onStatusChangedState.Enabled and instance.Parent == Parent and os.clock() - now2 < 2.5 do
				task.wait(0.05)
			end

			if fn_unnamed() == value and instance.Parent == Parent then
				obj[instance] = os.clock() + 20
			else
				onStatusChangedState.Collected += 1
			end

			fn_applyStatus(("Collected %d (%s)"):format(onStatusChangedState.Collected, fn_handleCandiesAmount()))
		end
	end
	local function fnapplyC2()
		local fnhandleHumanoid = fn_handleHumanoidRootPart()

		if fnhandleHumanoid then
			local fn_runRaycastResult = fn_runRaycast(fnhandleHumanoid.Position.X, fnhandleHumanoid.Position.Z)

			if fn_runRaycastResult then
				fnhandleHumanoid.CFrame = CFrame.new(fnhandleHumanoid.Position.X, fn_runRaycastResult + 3, fnhandleHumanoid.Position.Z) * (fnhandleHumanoid.CFrame - fnhandleHumanoid.CFrame.Position)
			end

			fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
		end
	end
	local function fnapplyC3()
		Position = nil

		local fnhandleHumanoid = fn_handleHumanoidRootPart()

		if fnhandleHumanoid and CFrame_ then
			if onStatusChangedState.Config.returnToStart then
				fnhandleHumanoid.CFrame = CFrame_
				fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
			else
				fnapplyC2()
			end
		else
			fnapplyC2()
			CFrame_ = nil
			fn_applyCanCollideCFrame(false)

			return
		end

		CFrame_ = nil
		fn_applyCanCollideCFrame(false)
	end

	onStatusChangedState.SetEnabled = function(self, enabled)
		local Enabled = self.Enabled

		self.Enabled = enabled == true

		if thread then
			pcall(function()
				task.cancel(thread)
			end)
			thread = nil
		end

		if not self.Enabled then
			if Enabled then
				fnapplyC3()
			end

			fn_applyStatus("Idle")

			return
		end

		thread = task.spawn(function()
			if not fn_handleFeatures() then
				fn_applyStatus("Halloween event not found")
				self.Enabled = false

				return
			end

			local fnhandleHumanoid = fn_handleHumanoidRootPart()

			CFrame_ = fnhandleHumanoid and fnhandleHumanoid.CFrame or nil
			fn_applyStatus("Mapping the route...")

			local setEnabledList = fn_unnamed3()

			if #setEnabledList == 0 then
				fn_applyStatus("Map not found")
				self.Enabled = false

				return
			end

			fn_applyCanCollideCFrame(true)

			while self.Enabled do
				for i, v in ipairs(setEnabledList) do
					if not self.Enabled then
						break
					end

					if fn_handleHumanoidRootPart() then
						fn_applyStatus(("Route %d/%d · collected %d (%s)"):format(i, #setEnabledList, self.Collected, fn_handleCandiesAmount()))

						for i2 = 1, 6 do
							if not (fnapplyC(v, true) == "candy" and self.Enabled) then
								break
							end

							task.wait(0.3)
							fn_getPivot2()
						end

						local now = os.clock()

						while self.Enabled and os.clock() - now < 2.2 and not fn_unnamed2() do
							task.wait(0.1)
						end

						fn_getPivot2()
					else
						fn_applyStatus("Waiting for character...")
						task.wait(1)
					end
				end
			end
		end)
	end
	onStatusChangedState.SetOption = function(self, arg2, arg3)
		if self.Config[arg2] ~= nil then
			self.Config[arg2] = arg3
		end
	end
	onStatusChangedState.Stop = function(self)
		self:SetEnabled(false)
	end

	return onStatusChangedState
end
moduleDefs["Games.Rovibes.AutoChest"] = function()
