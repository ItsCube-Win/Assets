			end

			break
		end

		if exitTo ~= 1 then
			lookup[instance] = os.clock() + 8
			fn_applyStatus("Ore stuck, skipping...")

			return false
		end

		if not statusCountService._mgFired or not statusCountService.Enabled then
			if instance.Parent and not statusCountService._mgFired then
				lookup[instance] = os.clock() + 5
			end

			return false
		end

