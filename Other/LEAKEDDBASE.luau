							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, Humanoid2.WalkSpeed), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, -RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(-1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
							task.wait()
						end

						if part.Velocity.Magnitude > 500 or part.Parent ~= Character2 or player.Parent ~= Players or player.Character ~= Character2 or Humanoid2.Sit or Humanoid.Health <= 0 or now + 2 < tick() then
							break
						end
					end
				end

				if RootPart2 and Head then
					if (RootPart2.Position - Head.Position).Magnitude > 5 then
						sit(Head)
					else
						sit(RootPart2)
					end
				elseif RootPart2 then
					sit(RootPart2)
				elseif Head then
					sit(Head)
				elseif Handle then
					sit(Handle)
				elseif self.Notify then
					self.Notify("LowHub", "Could not find a part of the target player to fling.")
				end

				BodyVelocity:Destroy()
				Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
				workspace.CurrentCamera.CameraSubject = Humanoid

				if flag then
					repeat
						Character:PivotTo(CFrame_)
						Humanoid:ChangeState("GettingUp")

						for _, child in ipairs(Character:GetChildren()) do
							if child:IsA("BasePart") then
								child.Velocity = Vector3.zero
								child.RotVelocity = Vector3.zero
							end
						end

						task.wait()
					until (RootPart.Position - CFrame_.Position).Magnitude < 15

					workspace.FallenPartsDestroyHeight = FallenPartsDestroyHeight
				end

				return
			end
		else
			if flag == nil then
				flag = true
			end

			Character = LocalPlayer.Character
			Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			RootPart = Humanoid and Humanoid.RootPart
			Character2 = player and player.Character
			Humanoid2 = Character2 and Character2:FindFirstChildOfClass("Humanoid")
			RootPart2 = Humanoid2 and Humanoid2.RootPart
			Head = Character2 and Character2:FindFirstChild("Head")

			local Accessory = Character2 and Character2:FindFirstChildOfClass("Accessory")

			Handle = Accessory and Accessory:FindFirstChild("Handle")

			if Character and Humanoid and RootPart and Character2 then
				CFrame_ = RootPart.CFrame
				FallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight
				workspace.FallenPartsDestroyHeight = (0/0)
				BodyVelocity = Instance.new("BodyVelocity")
				BodyVelocity.Name = "LowHubVel"
				BodyVelocity.Parent = RootPart
				BodyVelocity.Velocity = Vector3.new(900000000, 900000000, 900000000)
				BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

				if Head then
					workspace.CurrentCamera.CameraSubject = Head
				elseif Handle then
					workspace.CurrentCamera.CameraSubject = Handle
				elseif Humanoid2 then
					workspace.CurrentCamera.CameraSubject = Humanoid2
				end

				skidFlingValue12 = function(part, amount, amount2)
					RootPart.CFrame = CFrame.new(part.Position) * amount * amount2
					Character:SetPrimaryPartCFrame(CFrame.new(part.Position) * amount * amount2)
					RootPart.Velocity = Vector3.new(90000000, 900000000, 90000000)
					RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
				end
				sit = function(part)
					local now = tick()
					local skidFlingAmount = 0

					while RootPart and Humanoid2 do
						if part.Velocity.Magnitude < 50 then
							skidFlingAmount += 100

							local cFrame = CFrame.Angles

							skidFlingValue12(part, CFrame.new(0, 1.5, 0) + Humanoid2.MoveDirection * part.Velocity.Magnitude / 1.25, cFrame(math.rad(skidFlingAmount), 0, 0))
							task.wait()

							local cFrame2 = CFrame.Angles

							skidFlingValue12(part, CFrame.new(0, -1.5, 0) + Humanoid2.MoveDirection * part.Velocity.Magnitude / 1.25, cFrame2(math.rad(skidFlingAmount), 0, 0))
							task.wait()

							local cFrame3 = CFrame.Angles

							skidFlingValue12(part, CFrame.new(2.25, 1.5, -2.25) + Humanoid2.MoveDirection * part.Velocity.Magnitude / 1.25, cFrame3(math.rad(skidFlingAmount), 0, 0))
							task.wait()

							local cFrame4 = CFrame.Angles

							skidFlingValue12(part, CFrame.new(-2.25, -1.5, 2.25) + Humanoid2.MoveDirection * part.Velocity.Magnitude / 1.25, cFrame4(math.rad(skidFlingAmount), 0, 0))
							task.wait()

							local cFrame5 = CFrame.Angles

							skidFlingValue12(part, CFrame.new(0, 1.5, 0) + Humanoid2.MoveDirection, cFrame5(math.rad(skidFlingAmount), 0, 0))
							task.wait()

							local cFrame6 = CFrame.Angles

							skidFlingValue12(part, CFrame.new(0, -1.5, 0) + Humanoid2.MoveDirection, cFrame6(math.rad(skidFlingAmount), 0, 0))
							task.wait()
						else
							skidFlingValue12(part, CFrame.new(0, 1.5, Humanoid2.WalkSpeed), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, -Humanoid2.WalkSpeed), CFrame.Angles(0, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, Humanoid2.WalkSpeed), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, -RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, 1.5, RootPart2.Velocity.Magnitude / 1.25), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(-1.5707963267948966, 0, 0))
							task.wait()
							skidFlingValue12(part, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
							task.wait()
						end

						if part.Velocity.Magnitude > 500 or part.Parent ~= Character2 or player.Parent ~= Players or player.Character ~= Character2 or Humanoid2.Sit or Humanoid.Health <= 0 or now + 2 < tick() then
							break
						end
					end
				end

				if RootPart2 and Head then
					if (RootPart2.Position - Head.Position).Magnitude > 5 then
						sit(Head)
					else
						sit(RootPart2)
					end
				elseif RootPart2 then
					sit(RootPart2)
				elseif Head then
					sit(Head)
				elseif Handle then
					sit(Handle)
				elseif self.Notify then
					self.Notify("LowHub", "Could not find a part of the target player to fling.")
				end

				BodyVelocity:Destroy()
				Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
				workspace.CurrentCamera.CameraSubject = Humanoid

				if flag then
					repeat
						Character:PivotTo(CFrame_)
						Humanoid:ChangeState("GettingUp")

						for _, child in ipairs(Character:GetChildren()) do
							if child:IsA("BasePart") then
								child.Velocity = Vector3.zero
								child.RotVelocity = Vector3.zero
							end
						end

						task.wait()
					until (RootPart.Position - CFrame_.Position).Magnitude < 15

					workspace.FallenPartsDestroyHeight = FallenPartsDestroyHeight
				end

				return
			end
		end
	end
	SayClass.RevealRolesToChat = function(self)
		local findMurdererResult = self.Roles:FindMurderer()
		local findSheriffResult = self.Roles:FindSheriff()
		local remoteArg = string.format("Murderer: %s | Sheriff: %s | <<LowHub>>", findMurdererResult and findMurdererResult.DisplayName or "None", findSheriffResult and findSheriffResult.DisplayName or "None")
		local TextChatService = game_:GetService("TextChatService")

		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local RBXGeneral = TextChatService:FindFirstChild("RBXGeneral", true)

			if RBXGeneral then
				RBXGeneral:SendAsync(remoteArg)
			end
		else
			local DefaultChatSystemChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			local SayMessageRequest = DefaultChatSystemChatEvents and DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")

			if SayMessageRequest then
				SayMessageRequest:FireServer(remoteArg, "All")
			end
		end
	end

	return SayClass
end
moduleDefs["Games.MM2.MM2Dodge"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local ControlsClass = {}

	ControlsClass.__index = ControlsClass
	ControlsClass.new = function(position)
		local obj = setmetatable({}, ControlsClass)

		obj.State = position.State
		obj.Roles = position.Roles
		obj._knives = {}

		return obj
	end

	local function fnrunFind(instance)
		if instance:IsA("BasePart") then
			return instance
		end

		return instance:FindFirstChild("BladePosition") or instance:FindFirstChildWhichIsA("BasePart", true)
	end

	ControlsClass._controls = function(self)
		if self._ctrl == nil then
			local ok, result = pcall(function()
				return requireModule(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 3)):GetControls()
			end)

			self._ctrl = ok and result or false
		end

		local _ctrl = self._ctrl or nil

		return _ctrl
	end
	ControlsClass._dodge = function(self, position, vector, amount)
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not HumanoidRootPart or Humanoid.Health <= 0 then
			return
		end

		self._dodging = true

		local vector3 = Vector3.new(vector.X, 0, vector.Z)
		local vector32 = vector3.Magnitude > 1 and vector3.Unit:Cross(Vector3.yAxis) or Vector3.xAxis

		if vector32:Dot(HumanoidRootPart.Position - (position + vector * amount)) < 0 then
			vector32 = -vector32

			local raycastParams = RaycastParams.new()

			raycastParams.FilterDescendantsInstances = { Character }

			if workspace:Raycast(HumanoidRootPart.Position, vector32 * 5, raycastParams) then
				vector32 = -vector32
			end
		else
			local raycastParams = RaycastParams.new()

			raycastParams.FilterDescendantsInstances = { Character }

			if workspace:Raycast(HumanoidRootPart.Position, vector32 * 5, raycastParams) then
				vector32 = -vector32
			end
		end

		local controlsResult = self:_controls()

		if controlsResult then
			pcall(function()
				controlsResult:Disable()
			end)

			if vector.Y > -40 and Humanoid.FloorMaterial ~= Enum.Material.Air then
				Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			if self.State.DodgeTurn then
				pcall(function()
					HumanoidRootPart.CFrame = CFrame.lookAt(HumanoidRootPart.Position, HumanoidRootPart.Position + vector32)
				end)
			end
		else
			if vector.Y > -40 and Humanoid.FloorMaterial ~= Enum.Material.Air then
				Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			if self.State.DodgeTurn then
				pcall(function()
					HumanoidRootPart.CFrame = CFrame.lookAt(HumanoidRootPart.Position, HumanoidRootPart.Position + vector32)
				end)
				Humanoid:Move(vector32, false)
				task.delay(math.clamp(amount + 0.12, 0.25, 0.45), function()
					pcall(function()
						Humanoid:Move(Vector3.zero, false)
					end)

					if controlsResult then
						pcall(function()
							controlsResult:Enable()
						end)
					end

					self._dodging = false
				end)

				return
			end
		end

		Humanoid:Move(vector32, false)
		task.delay(math.clamp(amount + 0.12, 0.25, 0.45), function()
			pcall(function()
				Humanoid:Move(Vector3.zero, false)
			end)

			if controlsResult then
				pcall(function()
					controlsResult:Enable()
				end)
			end

			self._dodging = false
		end)
	end
	ControlsClass._step = function(list)
		if not list.State.AutoDodge then
			return
		end

		if list.Roles:AmMurderer() then
			return
		end

		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return
		end

		local now = os.clock()

		for k, knive in pairs(list._knives) do
			local Parent = k.Parent and fnrunFind(k)

			if Parent then
				local Position = Parent.Position

				if knive.last and now - knive.lastT > 0.001 then
					local vector = (Position - knive.last) / (now - knive.lastT)
					local Magnitude = vector.Magnitude

					if Magnitude > 150 then
						vector = vector.Unit * 91
						Magnitude = 91
					end

					if Magnitude > 20 and not list._dodging then
						local stepAmount = HumanoidRootPart.Position + Vector3.new(0, 0.6, 0)
						local stepAmount2 = (stepAmount - Position):Dot(vector) / (Magnitude * Magnitude)

						if stepAmount2 > 0 and stepAmount2 < 0.9 and (stepAmount - (Position + vector * stepAmount2)).Magnitude < 3.2 then
							list:_dodge(Position, vector, stepAmount2)
						end
					end
				end

				if knive.last and now - knive.lastT > 0.001 and (Position - knive.last).Magnitude > 0.05 then
					knive.dir = (Position - knive.last).Unit
				end

				knive.last = Position
				knive.lastT = now
			else
				list._knives[k] = nil
			end
		end
	end
	ControlsClass._guard = function(list)
		if not list.State.AutoDodge or list._dodging then
			return
		end

		if list.Roles:AmMurderer() then
			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not HumanoidRootPart or Humanoid.Health <= 0 then
			return
		end

		local MoveDirection = Humanoid.MoveDirection

		if MoveDirection.Magnitude < 0.05 then
			return
		end

		local Position = HumanoidRootPart.Position
		local moveDirection = MoveDirection

		for _, knive in pairs(list._knives) do
			if knive.dir and knive.last then
				local dir = knive.dir
				local vector = Position - knive.last
				local dot = vector:Dot(dir)

				if dot > -2 and dot / 91 < 1 then
					local vector2 = vector - dir * dot
					local vector3 = Vector3.new(vector2.X, 0, vector2.Z)
					local Magnitude = vector3.Magnitude

					if Magnitude < 5.2 and Magnitude > 0.001 then
						local unit = -vector3.Unit
						local dot2 = moveDirection:Dot(unit)

						if dot2 > 0 then
							moveDirection -= unit * dot2
						end
					end
				end
			end
		end

		if moveDirection ~= MoveDirection then
			local humanoid = Humanoid
			local Move = Humanoid.Move
			local guardValue = moveDirection.Magnitude > 0.05

			Move(humanoid, guardValue and moveDirection.Unit * math.min(moveDirection.Magnitude, 1) or Vector3.zero, false)
		end
	end
	ControlsClass.Start = function(self)
		if self._conns then
			return
		end

		self._conns = {}
		RunService:BindToRenderStep("LowHubMM2DodgeGuard", Enum.RenderPriority.Character.Value + 1, function()
			pcall(self._guard, self)
		end)
		self._guardBound = true
		table.insert(self._conns, workspace.ChildAdded:Connect(function(child)
			if child.Name == "ThrowingKnife" then
				self._knives[child] = {}
			end
		end))

		for _, child in ipairs(workspace:GetChildren()) do
			if child.Name == "ThrowingKnife" then
				self._knives[child] = {}
			end
		end

		table.insert(self._conns, RunService.Heartbeat:Connect(function()
			pcall(self._step, self)
		end))
	end
	ControlsClass.Stop = function(self)
		if self._guardBound then
			pcall(function()
				RunService:UnbindFromRenderStep("LowHubMM2DodgeGuard")
			end)
			self._guardBound = false
		end

		local ipairs_ = ipairs
		local _conns = self._conns or {}

		for _, _conn in ipairs_(_conns) do
			pcall(function()
				_conn:Disconnect()
			end)
		end

		self._conns = nil
		table.clear(self._knives)

		if self._dodging then
			local controlsResult = self:_controls()

			if controlsResult then
				pcall(function()
					controlsResult:Enable()
				end)
			end

			self._dodging = false
		end
	end

	return ControlsClass
end
moduleDefs["Games.MM2.MM2ESP"] = function()
	local Players = game_:GetService("Players")
	local CoreGui = game_:GetService("CoreGui")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local hui = gethui and gethui() or CoreGui
	local RoleOfClass = {}

	RoleOfClass.__index = RoleOfClass

	local boldSemiConfig = {
		bold = fontNew("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold),
		semi = fontNew("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold),
		med = fontNew("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Medium)
	}
	local murdererSheriffConfig = {
		Murderer = Color3.fromRGB(255, 77, 94),
		Sheriff = Color3.fromRGB(77, 163, 255),
		Hero = Color3.fromRGB(255, 201, 77),
		Innocent = Color3.fromRGB(91, 228, 155),
		Gun = Color3.fromRGB(255, 216, 77),
		Trap = Color3.fromRGB(255, 122, 69)
	}
	local color3 = Color3.fromRGB(12, 12, 16)
	local color32 = Color3.fromRGB(240, 240, 245)
	local color33 = Color3.fromRGB(150, 150, 165)

	local function fn_unnamed(arg1, list, frame)
		local instance = Instance.new(arg1)

		for k, v in pairs(list) do
			instance[k] = v
		end

		if frame then
			instance.Parent = frame
		end

		return instance
	end
	local function fn_handleBillboardGui(head, arg2)
		local BillboardGui = fn_unnamed("BillboardGui", {
			Name = "LowHub_MM2_Plate",
			Adornee = head,
			AlwaysOnTop = true,
			LightInfluence = 0,
			Size = UDim2.fromOffset(280, 28),
			StudsOffsetWorldSpace = Vector3.new(0, arg2 or 2.6, 0),
			MaxDistance = 2000,
			ResetOnSpawn = false
		}, hui)
		local Frame = fn_unnamed("Frame", {
			Name = "Pill",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color3,
			BackgroundTransparency = 0.22,
			BorderSizePixel = 0
		}, BillboardGui)

		fn_unnamed("UICorner", {
			CornerRadius = UDim.new(0, 7)
		}, Frame)

		local UIStroke = fn_unnamed("UIStroke", {
			Thickness = 1,
			Transparency = 0.5,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		}, Frame)

		fn_unnamed("UIPadding", {
			PaddingLeft = UDim.new(0, 9),
			PaddingRight = UDim.new(0, 9)
		}, Frame)
		fn_unnamed("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6)
		}, Frame)

		local value = fn_unnamed

		return {
			bb = BillboardGui,
			pill = Frame,
			stroke = UIStroke,
			role = fn_unnamed("TextLabel", {
				Name = "Role",
				LayoutOrder = 2,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 24),
				FontFace = boldSemiConfig.bold,
				TextSize = 11,
				Text = ""
			}, Frame),
			sep = fn_unnamed("Frame", {
				Name = "Sep",
				LayoutOrder = 3,
				Size = UDim2.fromOffset(1, 11),
				BackgroundColor3 = color32,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0
			}, Frame),
			name = fn_unnamed("TextLabel", {
				Name = "Name",
				LayoutOrder = 4,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 24),
				FontFace = boldSemiConfig.semi,
				TextSize = 13,
				TextColor3 = color32,
				Text = ""
			}, Frame),
			dist = value("TextLabel", {
				Name = "Dist",
				LayoutOrder = 5,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 24),
				FontFace = boldSemiConfig.med,
				TextSize = 12,
				TextColor3 = color33,
				Text = ""
			}, Frame)
		}
	end
	local function fn_applyColorTextColor3(plate, gun, text, displayName, text2, arg6)
		plate.stroke.Color = gun
		plate.role.TextColor3 = gun
		plate.role.Text = text
		plate.role.Visible = text ~= ""
		plate.sep.Visible = text ~= "" and displayName ~= ""
		plate.name.Text = displayName
		plate.name.Visible = displayName ~= ""
		plate.dist.Text = text2

		local textTransparency = arg6 or 0

		plate.pill.BackgroundTransparency = 0.22 + textTransparency * 0.5
		plate.stroke.Transparency = 0.5 + textTransparency * 0.4
		plate.role.TextTransparency = textTransparency * 0.6
		plate.name.TextTransparency = textTransparency * 0.6
		plate.dist.TextTransparency = textTransparency * 0.6
	end
	local function fn_handleHighlight(character, gun, fillTransparency)
		local value = fn_unnamed
		local s2 = "Highlight"

		return value(s2, {
			Name = "LowHub_MM2_Outline",
			Adornee = character,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			FillColor = gun,
			OutlineColor = gun,
			FillTransparency = fillTransparency and 0.92 or 0.8,
			OutlineTransparency = fillTransparency and 0.55 or 0.1
		}, hui)
	end
	local function fn_unnamed2(magnitude)
		return math.clamp((magnitude - 80) / 170, 0, 1) * 0.6
	end

	RoleOfClass.new = function(position)
		local obj = setmetatable({}, RoleOfClass)

		obj.State = position.State
		obj.Roles = position.Roles
		obj.Notify = position.Notify
		obj._players = {}
		obj.Objects = {
			Gun = {},
			Traps = {}
		}

		return obj
	end
	RoleOfClass._roleOf = function(self, player)
		if self.Roles:HasWeapon(player, "Weapon_Knife") then
			return "Murderer"
		end

		if self.Roles:HasWeapon(player, "Weapon_Gun") then
			return self.Roles:GetRole(player) == "Hero" and "Hero" or "Sheriff"
		end

		local role = self.Roles:GetRole(player)

		return murdererSheriffConfig[role] and role or "Innocent"
	end

	local function fn_hasTag(player)
		local Character = player.Character

		if not Character then
			return false
		end

		for _, child in ipairs(Character:GetChildren()) do
			if child:IsA("Tool") and (child:HasTag("Weapon_Knife") or child:HasTag("Weapon_Gun")) then
				return true
			end
		end

		return false
	end

	RoleOfClass._dropPlayer = function(self, player)
		local playerEntry = self._players[player]

		if playerEntry then
			pcall(function()
				playerEntry.hl:Destroy()
			end)
			pcall(function()
				playerEntry.plate.bb:Destroy()
			end)
			self._players[player] = nil
		end
	end
	RoleOfClass._updatePlayer = function(obj, player, part)
		local Character = player.Character
		local Head = Character and (Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart"))
		local playerEntry = obj._players[player]

		if playerEntry and playerEntry.char ~= Character then
			obj:_dropPlayer(player)
			playerEntry = nil
		end

		if Head then
			if obj.Roles:IsAlive(player) then
				local roleOfResult = obj:_roleOf(player)
				local fillColor = murdererSheriffConfig[roleOfResult]
				local fillTransparency = roleOfResult == "Innocent"

				if not playerEntry then
					playerEntry = {
						char = Character,
						plate = fn_handleBillboardGui(Head, 2.4),
						hl = fn_handleHighlight(Character, fillColor, fillTransparency)
					}
					obj._players[player] = playerEntry
				end

				if playerEntry.role ~= roleOfResult then
					playerEntry.role = roleOfResult

					local hl = playerEntry.hl

					playerEntry.hl.FillColor = fillColor
					hl.OutlineColor = fillColor
					playerEntry.hl.FillTransparency = fillTransparency and 0.92 or 0.8
					playerEntry.hl.OutlineTransparency = fillTransparency and 0.55 or 0.1
				end

				local Magnitude = part and (Head.Position - part.Position).Magnitude or 0
				local updatePlayerFlag = fillTransparency and ""

				if not updatePlayerFlag then
					updatePlayerFlag = roleOfResult:upper() .. (fn_hasTag(player) and "  ·  ARMED" or "")
				end

				fn_applyColorTextColor3(playerEntry.plate, fillColor, updatePlayerFlag, player.DisplayName, string.format("%dm", math.floor(Magnitude + 0.5)), fn_unnamed2(Magnitude))

				return
			end
		end

		obj:_dropPlayer(player)
	end
	RoleOfClass._tickPlayers = function(self)
		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				pcall(self._updatePlayer, self, player, HumanoidRootPart)
			end
		end

		for k in pairs(self._players) do
			if k.Parent ~= Players then
				self:_dropPlayer(k)
			end
		end
	end
	RoleOfClass.ReloadPlayers = function(self)
		if not self.State.PlayerESP then
			for k in pairs(self._players) do
				self:_dropPlayer(k)
			end

			return
		end

		self:_tickPlayers()

		if self._loop then
			return
		end

		self._loop = true
		task.spawn(function()
			while self.State.PlayerESP do
				task.wait(0.15)
				pcall(self._tickPlayers, self)
			end

			self._loop = false

			for k in pairs(self._players) do
				self:_dropPlayer(k)
			end
		end)
	end

	local function fn_handleScreenGui()
		local ScreenGui = fn_unnamed("ScreenGui", {
			Name = "LowHub_MM2_Edge",
			ResetOnSpawn = false,
			IgnoreGuiInset = true
		}, hui)
		local Frame = fn_unnamed("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color3,
			BackgroundTransparency = 0.18,
			BorderSizePixel = 0,
			Visible = false
		}, ScreenGui)

		fn_unnamed("UICorner", {
			CornerRadius = UDim.new(0, 8)
		}, Frame)
		fn_unnamed("UIStroke", {
			Thickness = 1,
			Transparency = 0.45,
			Color = murdererSheriffConfig.Gun
		}, Frame)
		fn_unnamed("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 9)
		}, Frame)
		fn_unnamed("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder
		}, Frame)

		local value = fn_unnamed

		return {
			gui = ScreenGui,
			chip = Frame,
			arrow = fn_unnamed("TextLabel", {
				LayoutOrder = 1,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(10, 24),
				FontFace = boldSemiConfig.bold,
				TextSize = 13,
				TextColor3 = murdererSheriffConfig.Gun,
				Text = "›"
			}, Frame),
			label = value("TextLabel", {
				LayoutOrder = 2,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 24),
				FontFace = boldSemiConfig.semi,
				TextSize = 11,
				TextColor3 = color32,
				Text = "GUN"
			}, Frame)
		}
	end

	RoleOfClass.CreateGunESP = function(self, instance)
		if not instance or not self.State.GunESP then
			return
		end

		local isBasePart = instance:IsA("BasePart") and instance or instance:FindFirstChildWhichIsA("BasePart", true) or instance
		local fnhandleBillboard = fn_handleBillboardGui(isBasePart, 1.6)
		local fn_handleHighlightResult = fn_handleHighlight(instance, murdererSheriffConfig.Gun, false)
		local fn_handleScreenGuiResult = fn_handleScreenGui()
		local dropPlateState = {
			drop = instance,
			plate = fnhandleBillboard,
			hl = fn_handleHighlightResult,
			edge = fn_handleScreenGuiResult
		}

		table.insert(self.Objects.Gun, dropPlateState)
		dropPlateState.conn = RunService.RenderStepped:Connect(function()
			if not instance.Parent then
				return
			end

			local CurrentCamera = workspace.CurrentCamera
			local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local Position = isBasePart.Position
			local Magnitude = HumanoidRootPart and (Position - HumanoidRootPart.Position).Magnitude or 0

			fn_applyColorTextColor3(fnhandleBillboard, murdererSheriffConfig.Gun, "DROPPED GUN", "", string.format("%dm", math.floor(Magnitude + 0.5)), 0)

			local screenPoint, createGunESPFlag2 = CurrentCamera:WorldToViewportPoint(Position)

			if createGunESPFlag2 then
				fn_handleScreenGuiResult.chip.Visible = false

				return
			end

			local ViewportSize = CurrentCamera.ViewportSize
			local createGunESPAmount = ViewportSize / 2
			local vector = Vector2.new(screenPoint.X, screenPoint.Y) - createGunESPAmount

			if screenPoint.Z < 0 then
				vector = -vector
			end

			if vector.Magnitude < 1 then
				vector = Vector2.new(0, 1)
			end

			local Unit = vector.Unit
			local vector2 = createGunESPAmount + Unit * math.min((ViewportSize.X / 2 - 40) / math.max(math.abs(Unit.X), 0.001), (ViewportSize.Y / 2 - 40) / math.max(math.abs(Unit.Y), 0.001))

			fn_handleScreenGuiResult.chip.Position = UDim2.fromOffset(vector2.X, vector2.Y)
			fn_handleScreenGuiResult.arrow.Rotation = math.deg(math.atan2(Unit.Y, Unit.X))
			fn_handleScreenGuiResult.label.Text = string.format("GUN  %dm", math.floor(Magnitude + 0.5))
			fn_handleScreenGuiResult.chip.Visible = true
		end)

		if self.Notify then
			self.Notify("LowHub", "The gun dropped.")
		end
	end
	RoleOfClass._destroyGun = function(self, obj)
		pcall(function()
			obj.conn:Disconnect()
		end)
		pcall(function()
			obj.plate.bb:Destroy()
		end)
		pcall(function()
			obj.hl:Destroy()
		end)
		pcall(function()
			obj.edge.gui:Destroy()
		end)
	end
	RoleOfClass.ReloadGun = function(self)
		self:ClearGroup("Gun")

		if not self.State.GunESP then
			return
		end

		local findGunDropResult = self.Roles:FindGunDrop()

		if findGunDropResult then
			self:CreateGunESP(findGunDropResult)
		end
	end
	RoleOfClass._trapOf = function(self, descendant)
		if descendant.Name == "TrapVisual" and descendant:IsA("BasePart") then
			return descendant
		end

		if descendant.Name == "Trap" and descendant.Parent then
			if descendant.Parent:IsA("Folder") then
				return descendant
			end
		end

		return nil
	end
	RoleOfClass.AddTrapESP = function(self, flag, flag2)
		if not flag or not self.State.TrapESP then
			return
		end

		local fnhandleBillboard = fn_handleBillboardGui(flag, 1.4)

		fn_applyColorTextColor3(fnhandleBillboard, murdererSheriffConfig.Trap, "TRAP", "", "", 0)
		table.insert(self.Objects.Traps, {
			trap = flag,
			plate = fnhandleBillboard,
			hl = fn_handleHighlight(flag, murdererSheriffConfig.Trap, false)
		})

		if flag2 ~= false and self.Notify then
			self.Notify("LowHub", "The murderer placed a trap.")
		end
	end
	RoleOfClass.RefreshTraps = function(self)
		self:ClearGroup("Traps")

		if not self.State.TrapESP then
			return
		end

		for _, descendant in ipairs(workspace:GetDescendants()) do
			local trapOfResult = self:_trapOf(descendant)

			if trapOfResult then
				self:AddTrapESP(trapOfResult, false)
			end
		end
	end
	RoleOfClass.ClearGroup = function(self, mode)
		if mode == "Players" then
			for k in pairs(self._players) do
				self:_dropPlayer(k)
			end

			return
		end

		local objectEntry = self.Objects[mode]

		if not objectEntry then
			return
		end

		for _, objectEntryItem in ipairs(objectEntry) do
		if mode == "Gun" then
			self:_destroyGun(objectEntryItem)
		else
			pcall(function()
				objectEntryItem.plate.bb:Destroy()
			end)
			pcall(function()
				objectEntryItem.hl:Destroy()
			end)
		end
		end

		table.clear(objectEntry)
	end
	RoleOfClass.HandleDescendantAdded = function(self, descendant)
		if self.State.TrapESP then
			local trapOfResult = self:_trapOf(descendant)

			if trapOfResult then
				self:AddTrapESP(trapOfResult, true)
			end
		end

		if self.Roles:IsGunDrop(descendant) then
			if self.State.GunESP then
				self:CreateGunESP(descendant)
			end

			if self.OnGunDropped and self.State.AutoGetGun then
				self.OnGunDropped(descendant)
			end
		end
	end
	RoleOfClass.HandleDescendantRemoving = function(self, descendant)
		if self.State.TrapESP then
			for i = #self.Objects.Traps, 1, -1 do
				local trapEntry = self.Objects.Traps[i]

				if trapEntry.trap == descendant then
					pcall(function()
						trapEntry.plate.bb:Destroy()
					end)
					pcall(function()
						trapEntry.hl:Destroy()
					end)
					table.remove(self.Objects.Traps, i)
				end
			end
		end

		local handleDescendantRemoving = false

		for _, v in ipairs(self.Objects.Gun) do
			if v.drop == descendant then
				handleDescendantRemoving = true
			end
		end

		if not handleDescendantRemoving and descendant.Name ~= "GunDrop" then
			return
		end

		for i = #self.Objects.Gun, 1, -1 do
			local gunEntry = self.Objects.Gun[i]

			if gunEntry.drop == descendant then
				self:_destroyGun(gunEntry)
				table.remove(self.Objects.Gun, i)
			end
		end

		if self.OnGunRemoved then
			self.OnGunRemoved(descendant)
		end
	end

	return RoleOfClass
end
moduleDefs["Games.MM2.MM2Roles"] = function()
	local Players = game_:GetService("Players")
	local CollectionService = game_:GetService("CollectionService")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local playerDataService = {
		PlayerData = {}
	}
	local obj

	local function fn_handleModules()
		if obj == nil then
			local ok, result = pcall(function()
				local Modules = ReplicatedStorage:FindFirstChild("Modules")
				local CurrentRoundClient = Modules and Modules:FindFirstChild("CurrentRoundClient")

				return CurrentRoundClient and requireModule(CurrentRoundClient)
			end)

			obj = ok and type_(result) == "table" and result or false
		end

		if obj and type_(obj.PlayerData) == "table" then
			return obj.PlayerData
		end

		return playerDataService.PlayerData
	end

	playerDataService.SetPlayerData = function(self, flag)
		self.PlayerData = type_(flag) == "table" and flag or {}
	end
	playerDataService.GetData = function(self, localPlayer)
		if localPlayer then
			return fn_handleModules()[localPlayer.Name]
		end

		return nil
	end
	playerDataService.GetRole = function(self, localPlayer)
		local data = self:GetData(localPlayer)

		return data and data.Role or nil
	end

	local function fn_hasTag(character, arg2)
		if not character then
			return false
		end

		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and child:HasTag(arg2) then
				return true
			end
		end

		return false
	end

	playerDataService.HasWeapon = function(self, player, arg3)
		if player then
			return fn_hasTag(player.Character, arg3) or player == LocalPlayer and fn_hasTag(player:FindFirstChild("Backpack"), arg3)
		end

		return false
	end
	playerDataService.IsAlive = function(self, player)
		local data = self:GetData(player)

		if data and data.Dead == true then
			return false
		end

		local Character = player and player.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		return Humanoid ~= nil and Humanoid.Health > 0 and Character:FindFirstChild("HumanoidRootPart") ~= nil
	end
	playerDataService.IsRoundActive = function()
		for _ in pairs(fn_handleModules()) do
			return true
		end

		return false
	end

	local function fn_unnamed(items)
		for k, v in pairs(fn_handleModules()) do
			if items[v.Role] then
				if v.Dead == true then
					continue
				end

				local findFirstChildResult = Players:FindFirstChild(k)

				if findFirstChildResult then
					return findFirstChildResult
				end
			end
		end

		return nil
	end

	playerDataService.FindMurderer = function(self)
		local findMurdererFlag = fn_unnamed({
			Murderer = true
		})

		if not findMurdererFlag then
			local function fn_getPlayers()
				for _, player in ipairs(Players:GetPlayers()) do
					if self:HasWeapon(player, "Weapon_Knife") then
						return player
					end
				end
			end

			findMurdererFlag = fn_getPlayers()
		end

		return findMurdererFlag
	end
	playerDataService.FindSheriff = function(self)
		for _, player in ipairs(Players:GetPlayers()) do
			if self:HasWeapon(player, "Weapon_Gun") and self:IsAlive(player) then
				return player
			end
		end

		return fn_unnamed({
			Sheriff = true,
			Hero = true
		})
	end
	playerDataService.FindSheriffThatsNotMe = function(self)
		local findSheriffResult = self:FindSheriff()

		if findSheriffResult ~= LocalPlayer then
			return findSheriffResult
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and self:HasWeapon(player, "Weapon_Gun") then
				return player
			end
		end

		return nil
	end
	playerDataService.AmMurderer = function(self)
		return self:GetRole(LocalPlayer) == "Murderer" or self:HasWeapon(LocalPlayer, "Weapon_Knife")
	end
	playerDataService.AmSheriff = function(self)
		return self:HasWeapon(LocalPlayer, "Weapon_Gun")
	end
	playerDataService.GetMap = function()
		local tagged = CollectionService:GetTagged("CurrentMap")

		for _, v in ipairs(tagged) do
			if v.Parent == workspace then
				return v
			end
		end

		for _, child in ipairs(workspace:GetChildren()) do
			if child:FindFirstChild("CoinContainer") then
				return child
			end
		end

		return nil
	end
	playerDataService.IsGunDrop = function(self, descendant)
		if not descendant or not descendant.Parent then
			return false
		end

		if descendant.Name == "GunDrop" then
			return true
		end

		if not descendant:IsA("Tool") or not descendant:HasTag("Weapon_Gun") then
			return false
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and descendant:IsDescendantOf(player.Character) or descendant:IsDescendantOf(player) then
				return false
			end
		end

		return descendant:IsDescendantOf(workspace)
	end
	playerDataService.FindGunDrop = function(self)
		local GunDrop = workspace:FindFirstChild("GunDrop", true)

		if GunDrop then
			return GunDrop
		end

		for _, v in ipairs(CollectionService:GetTagged("Weapon_Gun")) do
			if self:IsGunDrop(v) then
				return v
			end
		end

		return nil
	end
	playerDataService.FindNearestPlayer = function(self, number)
		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return nil
		end

		local player2
		local huge = number or math.huge

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and self:IsAlive(player) then
				local Magnitude = (player.Character.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude

				if Magnitude < huge then
					player2 = player
					huge = Magnitude
				end
			end
		end

		return player2, huge
	end

	return playerDataService
end
moduleDefs["Games.MM2.MM2Service"] = function()
	local Players = game_:GetService("Players")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local RunService = game_:GetService("RunService")
	local StarterGui = game_:GetService("StarterGui")
	local CoreGui = game_:GetService("CoreGui")
	local VirtualUser = game_:GetService("VirtualUser")

	game_:GetService("PathfindingService")

	local LocalPlayer = Players.LocalPlayer
	local MM2Roles = requireModule("Games.MM2.MM2Roles")
	local MM2ArrowESP = requireModule("Games.MM2.MM2ArrowESP")
	local mM2ESP = requireModule("Games.MM2.MM2ESP")
	local MM2Aim = requireModule("Games.MM2.MM2Aim")
	local MM2Combat = requireModule("Games.MM2.MM2Combat")
	local MM2Dodge = requireModule("Games.MM2.MM2Dodge")
	local MM2CoinFarm = requireModule("Games.MM2.MM2CoinFarm")
	local stateIsAvailableService = {
		State = {
			AutoShoot = false,
			ShotMode = "Legit",
			KillAura = false,
			AuraRange = 7,
			AutoThrow = false,
			ThrowMode = "Legit",
			ThrowAnim = true,
			AutoThrowRange = 30,
			KnifeSpeed = 91,
			AimPrediction = 100,
			AimLeadBase = 0.1,
			AimPart = "Auto",
			AimTarget = "Auto",
			AssistOn = false,
			AssistFOV = 150,
			CamLock = false,
			CamKey = "MB2",
			CamActivation = "Hold",
			CamSmooth = 30,
			CamFOV = 150,
			CamSticky = true,
			ShowFOV = true,
			PlayerESP = false,
			GunESP = false,
			TrapESP = false,
			AutoDodge = false,
			AutoGetGun = false,
			AntiAFK = false,
			AutoClaim = true,
			EndRoundWhenFull = true,
			CoinFarm = false,
			CoinFarmSpeed = 22,
			FarmStartPos = nil
		}
	}
	local hui = gethui and gethui() or CoreGui

	local function fn_setCore(arg1, arg2)
		pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = arg1,
				Text = arg2,
				Duration = 3
			})
		end)
	end

	stateIsAvailableService.IsAvailable = function()
		return game_.PlaceId == 142823291
	end
	stateIsAvailableService.SetNotifier = function(self, notify)
		self._notify = notify
	end
	stateIsAvailableService.Notify = function(self, arg2, arg3)
		(self._notify or fn_setCore)(arg2, arg3)
	end
	stateIsAvailableService.GetState = function(self)
		return self.State
	end
	stateIsAvailableService.Init = function(self)
		if not self._initialized then
			if self:IsAvailable() then
				self._initialized = true

				local function fn_runNotify(arg1, arg2)
					self:Notify(arg1, arg2)
				end

				self.Roles = MM2Roles
				self.Aim = MM2Aim.new({
					State = self.State,
					Roles = MM2Roles
				})
				self.ESP = mM2ESP.new({
					State = self.State,
					Roles = MM2Roles,
					ArrowESP = MM2ArrowESP,
					Notify = fn_runNotify
				})
				self.Combat = MM2Combat.new({
					State = self.State,
					Roles = MM2Roles,
					Aim = self.Aim,
					Notify = fn_runNotify
				})
				self.CoinFarm = MM2CoinFarm.new({
					State = self.State,
					Roles = MM2Roles,
					Notify = fn_runNotify
				})
				self.Dodge = MM2Dodge.new({
					State = self.State,
					Roles = MM2Roles
				})
				self.Dodge:Start()
				self.ESP.OnGunDropped = function(descendant)
					self:HandleGunDropped(descendant)
				end
				self.ESP.OnGunRemoved = function()
					task.delay(1, function()
						local findSheriffResult = MM2Roles:FindSheriff()

						if findSheriffResult then
							self:Notify("LowHub", "The hero is " .. findSheriffResult.DisplayName .. ".")
						end
					end)
				end
				pcall(function()
					local LowHub_MM2_Timer = hui:FindFirstChild("LowHub_MM2_Timer")

					if LowHub_MM2_Timer then
						LowHub_MM2_Timer:Destroy()
					end
				end)
				self.Aim:InstallAssist()
				self.Aim:StartCamera()
				self:BindPlayerData()
				self:BindWorkspace()
				self:StartLoops()

				return
			end
		end
	end
	stateIsAvailableService.Stop = function(self)
		self._stopped = true
		self.State.CoinFarm = false

		if self.CoinFarm then
			pcall(function()
				self.CoinFarm:ReturnFromFarm()
			end)

			if self.Aim then
				self.Aim:Stop()
			end
		elseif self.Aim then
			self.Aim:Stop()
		end

		if self.Dodge then
			self.Dodge:Stop()
		end

		self.State.PlayerESP = false

		if self.ESP then
			pcall(function()
				self.ESP:ReloadPlayers()
				self.ESP:ClearGroup("Gun")
				self.ESP:ClearGroup("Traps")
			end)
		end

		local ipairs_ = ipairs
		local _conns = self._conns or {}

		for _, _conn in ipairs_(_conns) do
			pcall(function()
				_conn:Disconnect()
			end)
		end

		self._conns = {}
		pcall(function()
			local LowHub_MM2_Timer = hui:FindFirstChild("LowHub_MM2_Timer")

			if LowHub_MM2_Timer then
				LowHub_MM2_Timer:Destroy()
			end
		end)
	end
	stateIsAvailableService._track = function(self, connection)
		self._conns = self._conns or {}
		table.insert(self._conns, connection)

		return connection
	end
	stateIsAvailableService.BindPlayerData = function(self)
		task.spawn(function()
			local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
			local Gameplay = Remotes and Remotes:WaitForChild("Gameplay", 10)
			local PlayerDataChanged = Gameplay

			PlayerDataChanged = PlayerDataChanged and Gameplay:WaitForChild("PlayerDataChanged", 10)

			if PlayerDataChanged then
				self:_track(PlayerDataChanged.OnClientEvent:Connect(function(arg1)
					MM2Roles:SetPlayerData(arg1)
				end))
			end

			local CoinCollected = Gameplay and Gameplay:FindFirstChild("CoinCollected")
			local CoinsStarted = Gameplay and Gameplay:FindFirstChild("CoinsStarted")

			if CoinCollected then
				self:_track(CoinCollected.OnClientEvent:Connect(function(arg1, arg2, arg3)
					self.CoinFarm:OnBag(arg2, arg3)
				end))
			end

			if CoinsStarted then
				self:_track(CoinsStarted.OnClientEvent:Connect(function()
					self.CoinFarm:OnBag(0, 1)
					self.CoinFarm._spots = nil
				end))
			end

			pcall(function()
				for _, child in ipairs(LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container:GetChildren()) do
					local Full = child:IsA("Frame") and child.Visible and child:FindFirstChild("Full")

					if Full and Full.Visible then
						self.CoinFarm:OnBag(1, 1)
					end
				end
			end)
		end)
	end
	stateIsAvailableService.EndRoundWhenFull = function(self)
		local data = MM2Roles:GetData(LocalPlayer)

		if not data or data.Dead == true or not MM2Roles:IsAlive(LocalPlayer) then
			return
		end

		if data.Role == "Murderer" then
			if os.clock() - (self._endRoundAt or 0) < 3 then
				return
			end

			self._endRoundAt = os.clock()

			local Humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

			if Humanoid then
				Humanoid.Health = 0
			end
		elseif MM2Roles:AmSheriff() then
			local CoinFarm = self.CoinFarm

			if not CoinFarm._surfaced then
				CoinFarm:Surface()

				return
			end

			if not CoinFarm._returning then
				if not (os.clock() - (CoinFarm._returnedAt or 0) < 0.5) then
					self.Combat:ShootAt(nil, "Rage", true)

					return
				end
			end

			return
		end
	end
	stateIsAvailableService.ClaimPopups = function(self)
		if self._claiming then
			return
		end

		local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
		local CrossPlatform = PlayerGui and PlayerGui:FindFirstChild("CrossPlatform")
		local NewItem = CrossPlatform and CrossPlatform:FindFirstChild("NewItem")
		local Medium = NewItem and NewItem:FindFirstChild("Medium")
		local Container = Medium and Medium:FindFirstChild("Container")
		local Claim = Container and Container:FindFirstChild("Claim")

		if not Claim or not Medium.Visible then
			return
		end

		self._claiming = true
		task.spawn(function()
			local claimPopupsAmount = 0

			if self.State.AutoClaim then
				if Medium.Visible then
					if Claim.Parent then
						local exitTo

						repeat
							task.wait(0.3)

							if getconnections then
								exitTo = 1

								break
							end

							if firesignal then
								pcall(firesignal, Claim.Activated)
							end

							claimPopupsAmount += 1
						until not self.State.AutoClaim or not Medium.Visible or not Claim.Parent or not (claimPopupsAmount < 30)

						if exitTo == 1 then
							while true do
								for _, connection in ipairs(getconnections(Claim.Activated)) do
								pcall(function()
									connection:Fire()
								end)
								end

								claimPopupsAmount += 1

								if not self.State.AutoClaim or not Medium.Visible or not Claim.Parent or not (claimPopupsAmount < 30) then
									break
								end

								while true do
									task.wait(0.3)

									if getconnections then
										break
									end

									if firesignal then
										pcall(firesignal, Claim.Activated)
									end

									claimPopupsAmount += 1

									if self.State.AutoClaim and Medium.Visible and Claim.Parent and claimPopupsAmount < 30 then
										continue
									end

									self._claiming = false

									return
								end
							end
						end
					end
				end
			end

			self._claiming = false
		end)
	end
	stateIsAvailableService.BindWorkspace = function(self)
		self:_track(workspace.DescendantAdded:Connect(function(descendant)
			self.ESP:HandleDescendantAdded(descendant)
		end))
		self:_track(workspace.DescendantRemoving:Connect(function(descendant)
			self.ESP:HandleDescendantRemoving(descendant)
		end))
	end
	stateIsAvailableService.StartLoops = function(self)
		task.spawn(function()
			local enabled = false

			while not self._stopped do
				local State = self.State

				pcall(function()
					if State.CoinFarm then
						enabled = true
						self.CoinFarm:CollectCoins()
					elseif enabled then
						enabled = false
						self.CoinFarm:ReturnFromFarm()
					end

					self._tick = (self._tick or 0) + 1

					if State.AutoClaim and self._tick % 30 == 0 then
						self:ClaimPopups()
					end

					if State.CoinFarm then
						if State.EndRoundWhenFull and self._tick % 15 == 0 then
							if self.CoinFarm:IsBagFull() then
								self:EndRoundWhenFull()
							end
						end
					end

					if State.AutoShoot and self._tick % 2 == 0 and MM2Roles:AmSheriff() then
						self.Combat:ShootAt(nil, State.ShotMode, true)
					end

					if MM2Roles:AmMurderer() then
						for _, player in ipairs(Players:GetPlayers()) do
							if player ~= LocalPlayer then
								self.Aim:Consistency(player)
							end
						end

						if State.KillAura then
							self.Combat:KillAuraStep()
						end

						if State.AutoThrow and not self._throwTask then
							self._throwTask = true
							task.spawn(function()
								pcall(self.Combat.ThrowKnife, self.Combat, nil, State.ThrowMode, true, tonumber(State.AutoThrowRange) or 30)
								self._throwTask = false
							end)
						end
					end
				end)
				RunService.Heartbeat:Wait()
			end
		end)
	end

	local function fnrunFind(instance)
		if instance:IsA("BasePart") then
			return instance
		end

		return instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart", true)
	end

	stateIsAvailableService.WalkToGun = function(self, descendant2, flag)
		local findGunDropResult = descendant2 or MM2Roles:FindGunDrop()

		if not findGunDropResult then
			self:Notify("LowHub", "No dropped gun found.")

			return
		end

		if MM2Roles:AmMurderer() or MM2Roles:AmSheriff() or self._walking then
			return
		end

		local data = MM2Roles:GetData(LocalPlayer)
		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local fnrunFindResult = fnrunFind(findGunDropResult)

		if data and data.Dead ~= true then
			if HumanoidRootPart and fnrunFindResult and not ((fnrunFindResult.Position - HumanoidRootPart.Position).Magnitude > 250) then
				self._walking = true
				task.spawn(function()
					local Character = LocalPlayer.Character
					local HumanoidRootPart2 = Character and Character:FindFirstChild("HumanoidRootPart")
					local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

					if not HumanoidRootPart2 or not Humanoid then
						self._walking = false

						return
					end

					self.CoinFarm.Paused = true

					local fnrunFindResult2 = fnrunFind(findGunDropResult)

					if fnrunFindResult2 and firetouchinterest then
						-- RECONSTRUCTED: the iteration count was lost by the decompiler; 10 is an estimate
						for _ = 1, 10 do
							pcall(function()
								firetouchinterest(HumanoidRootPart2, fnrunFindResult2, 0)
								firetouchinterest(HumanoidRootPart2, fnrunFindResult2, 1)
							end)
							task.wait(0.15)

							if not MM2Roles:IsGunDrop(findGunDropResult) then
								break
							end
						end

						if not MM2Roles:IsGunDrop(findGunDropResult) then
							self._walking = false
							self.CoinFarm.Paused = false

							if MM2Roles:AmSheriff() then
								self:Notify("LowHub", "Got the gun!")
							end

							return
						end
					elseif not MM2Roles:IsGunDrop(findGunDropResult) then
						self._walking = false
						self.CoinFarm.Paused = false

						if MM2Roles:AmSheriff() then
							self:Notify("LowHub", "Got the gun!")

							return
						end

						return
					end

					local connection = RunService.Stepped:Connect(function()
						for _, descendant in ipairs(Character:GetDescendants()) do
							if descendant:IsA("BasePart") then
								descendant.CanCollide = false
							end
						end
					end)
					local walkToGunAmount = os.clock() + 25
					local connection2 = RunService.Heartbeat:Connect(function(dt)
						local Parent = findGunDropResult.Parent and fnrunFind(findGunDropResult)

						if not Parent or not MM2Roles:IsGunDrop(findGunDropResult) or Humanoid.Health <= 0 or walkToGunAmount < os.clock() then
							return
						end

						local vector = Parent.Position - HumanoidRootPart2.Position
						local walkToGunAmount2 = 18 * dt
						local Position = vector.Magnitude <= walkToGunAmount2 and Parent.Position or HumanoidRootPart2.Position + vector.Unit * walkToGunAmount2
						local vector3 = Vector3.new(vector.X, 0, vector.Z)

						HumanoidRootPart2.CFrame = CFrame.lookAt(Position, Position + (vector3.Magnitude > 0.5 and vector3.Unit or HumanoidRootPart2.CFrame.LookVector))
						HumanoidRootPart2.AssemblyLinearVelocity = Vector3.zero

						if vector.Magnitude < 3 and firetouchinterest then
							pcall(function()
								firetouchinterest(HumanoidRootPart2, Parent, 0)
								firetouchinterest(HumanoidRootPart2, Parent, 1)
							end)
						end
					end)

					while os.clock() < walkToGunAmount and Humanoid.Health > 0 and findGunDropResult.Parent and MM2Roles:IsGunDrop(findGunDropResult) do
						task.wait(0.1)
					end

					connection2:Disconnect()
					connection:Disconnect()
					HumanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
					self._walking = false
					self.CoinFarm.Paused = false

					if MM2Roles:AmSheriff() then
						self:Notify("LowHub", "Got the gun!")
					end
				end)

				return
			end
		end

		if not flag then
			self:Notify("LowHub", "The dropped gun is not reachable from here.")
		end
	end
	stateIsAvailableService.HandleGunDropped = function(self, descendant)
		if not self.State.AutoGetGun then
			return
		end

		task.delay(0.3, function()
			if MM2Roles:IsGunDrop(descendant) then
				self:WalkToGun(descendant, true)
			end
		end)
	end
	stateIsAvailableService.SetPlayerESP = function(self, playerESP)
		self.State.PlayerESP = playerESP == true
		self.ESP:ReloadPlayers()
	end
	stateIsAvailableService.SetGunESP = function(self, gunESP)
		self.State.GunESP = gunESP == true

		if self.State.GunESP then
			self.ESP:ReloadGun()
		else
			self.ESP:ClearGroup("Gun")
		end
	end
	stateIsAvailableService.SetTrapESP = function(self, trapESP)
		self.State.TrapESP = trapESP == true
		self.ESP:RefreshTraps()
	end
	stateIsAvailableService.SetAutoGetGun = function(self, autoGetGun)
		self.State.AutoGetGun = autoGetGun == true

		if self.State.AutoGetGun then
			local findGunDropResult = MM2Roles:FindGunDrop()

			if findGunDropResult then
				self:HandleGunDropped(findGunDropResult)
			end
		end
	end
	stateIsAvailableService.SetCoinFarm = function(self, flag)
		if flag then
			local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

			if HumanoidRootPart then
				self.State.FarmStartPos = HumanoidRootPart.CFrame
			end

			self.State.CoinFarm = true

			if not MM2Roles:IsRoundActive() then
				self:Notify("LowHub", "Match hasn't started yet. Waiting...")
			end
		else
			self.State.CoinFarm = false
			self.CoinFarm:ReturnFromFarm()
		end
	end
	stateIsAvailableService.SetAntiAFK = function(self, antiAFK)
		self.State.AntiAFK = antiAFK == true

		if self._antiAfkConnection then
			self._antiAfkConnection:Disconnect()
			self._antiAfkConnection = nil
		end

		if not self.State.AntiAFK then
			return
		end

		self._antiAfkConnection = self:_track(LocalPlayer.Idled:Connect(function()
			if not self.State.AntiAFK then
				return
			end

			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end))
	end
	stateIsAvailableService.FlingMurderer = function(self)
		local findMurdererResult = MM2Roles:FindMurderer()

		if findMurdererResult then
			self.Combat:SkidFling(findMurdererResult, true)
		else
			self:Notify("LowHub", "No murderer found.")
		end
	end
	stateIsAvailableService.FlingSheriff = function(self)
		local findSheriffResult = MM2Roles:FindSheriff()

		if findSheriffResult then
			self.Combat:SkidFling(findSheriffResult, true)
		else
			self:Notify("LowHub", "No sheriff found.")
		end
	end
	stateIsAvailableService.ToggleFlingAll = function(self)
		self.State.FlingAll = not self.State.FlingAll

		if not self.State.FlingAll then
			self:Notify("LowHub", "Stopping Fling Everyone...")

			return
		end

		self:Notify("LowHub", "Fling Everyone: ENABLED")

		local Character = LocalPlayer.Character
		local pivot = Character and Character:GetPivot()
		local FallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight

		workspace.FallenPartsDestroyHeight = (0/0)
		task.spawn(function()
			while self.State.FlingAll do
				local toggleFlingAllFlag = false
				for _, player in ipairs(Players:GetPlayers()) do
					if not self.State.FlingAll then
						break
					end

					if player ~= LocalPlayer and player.Character then
						if player.Character:FindFirstChild("HumanoidRootPart") then
							toggleFlingAllFlag = true
							self.Combat:SkidFling(player, false)
						end
					end
				end

				if not toggleFlingAllFlag then
					task.wait(1)
				end

				task.wait()
			end

			workspace.FallenPartsDestroyHeight = FallenPartsDestroyHeight

			if Character and pivot then
				Character:PivotTo(pivot)

				for _, v in ipairs(Character:GetChildren()) do
					if v:IsA("BasePart") then
						v.Velocity = Vector3.zero
						v.RotVelocity = Vector3.zero
					end
				end
			end

			self:Notify("LowHub", "Fling Everyone: STOPPED")
		end)
	end

	return stateIsAvailableService
end
moduleDefs["Games.Mushyo.AutoCandy"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local onStatusChangedState = {
		Enabled = false,
		OnStatusChanged = nil,
		OnTotal = nil,
		Status = "Idle",
		Collected = 0,
		Config = {
			speed = 350,
			returnToStart = true
		}
	}
	local thread
	local flag2

	local function fn_applyStatus(status)
		onStatusChangedState.Status = status

		if onStatusChangedState.OnStatusChanged then
			pcall(onStatusChangedState.OnStatusChanged, status)
		end
	end
	local function fn_handleHumanoidRootPart()
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if HumanoidRootPart and Humanoid and Humanoid.Health > 0 then
			return HumanoidRootPart
		end

		return nil
	end
	local function getCandies()
		return workspace:FindFirstChild("Candies")
	end
	local function fn_handleConfiguration()
		local Configuration = ReplicatedStorage:FindFirstChild("Configuration")
		local Battlepass = Configuration and Configuration:FindFirstChild("Battlepass")

		if not Battlepass then
			return false
		end

		local ok, result = pcall(requireModule, Battlepass)

		return ok and type_(result) == "table" and result.ACTIVE == true
	end
	local function fnhandleReliability()
		local ReliabilityStorage = ReplicatedStorage:FindFirstChild("ReliabilityStorage")
		local Functions = ReliabilityStorage and ReliabilityStorage:FindFirstChild("Functions")
		local RequestPlayerData = Functions and Functions:FindFirstChild("RequestPlayerData")

		if not RequestPlayerData then
			return nil
		end

		local ok, result = pcall(RequestPlayerData.InvokeServer, RequestPlayerData)

		if ok and type_(result) == "table" and type_(result.Halloween2026Candy) == "number" then
			return result.Halloween2026Candy
		end

		return nil
	end
	local function fn_unnamed()
		local fnhandleReliabilityResult = fnhandleReliability()

		if not fnhandleReliabilityResult then
			return
		end

		if not flag2 then
			flag2 = fnhandleReliabilityResult
		end

		if onStatusChangedState.OnTotal then
			pcall(onStatusChangedState.OnTotal, fnhandleReliabilityResult, fnhandleReliabilityResult - flag2)
		end
	end
	local function fn_handleBasePart(part, items, now)
		local candies = getCandies()

		if not candies then
			return nil
		end

		local child2
		local flag

		for _, child in ipairs(candies:GetChildren()) do
			local itemEntry = items[child]

			if child:IsA("BasePart") and (not itemEntry or now - itemEntry > 8) then
				local Magnitude = (child.Position - part.Position).Magnitude

				if not flag or Magnitude < flag then
					child2 = child
					flag = Magnitude
				end
			end
		end

		return child2, flag
	end

	local connection
	local lookup = {}

	local function fn_applyCanCollide(flag)
		if flag then
			if connection then
				return
			end

			connection = RunService.Stepped:Connect(function()
				local Character = LocalPlayer.Character

				if not Character then
					return
				end

				for _, descendant in ipairs(Character:GetDescendants()) do
					if descendant:IsA("BasePart") and descendant.CanCollide then
						if lookup[descendant] == nil then
							lookup[descendant] = true
						end

						descendant.CanCollide = false
					end
				end
			end)
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end

			for k in pairs(lookup) do
				if k.Parent then
					k.CanCollide = true
				end
			end

			table.clear(lookup)
		end
	end
	local function fnapplyC(instance, amount)
		local Parent = instance.Parent
		local fnhandleHumanoid = fn_handleHumanoidRootPart()

		if not fnhandleHumanoid then
			return false
		end

		local amount2 = instance.Position + Vector3.new(0, 2, 0)

		if amount <= 60 then
			fnhandleHumanoid.CFrame = CFrame.new(amount2)
			fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
		end

		local clamped = math.clamp(tonumber(onStatusChangedState.Config.speed) or 350, 50, 800)

		fn_applyCanCollide(true)

		local now = os.clock()

		while onStatusChangedState.Enabled and instance.Parent == Parent and os.clock() - now < 6 do
			local result = RunService.Heartbeat:Wait()
			local fnhandleHumanoid2 = fn_handleHumanoidRootPart()

			if not fnhandleHumanoid2 then
				return false
			end

			local vector = amount2 - fnhandleHumanoid2.Position
			local Magnitude = vector.Magnitude

			if Magnitude < 1 then
				fnhandleHumanoid2.AssemblyLinearVelocity = Vector3.zero
			else
				local assemblyLinearVelocity = vector / Magnitude

				fnhandleHumanoid2.CFrame = CFrame.new(fnhandleHumanoid2.Position + assemblyLinearVelocity * math.min(Magnitude, clamped * result)) * (fnhandleHumanoid2.CFrame - fnhandleHumanoid2.CFrame.Position)
				fnhandleHumanoid2.AssemblyLinearVelocity = assemblyLinearVelocity * math.min(clamped, 200)
			end
		end

		local fnhandleHumanoid2 = fn_handleHumanoidRootPart()

		if fnhandleHumanoid2 then
			fnhandleHumanoid2.AssemblyLinearVelocity = Vector3.zero
		end

		return instance.Parent ~= Parent
	end
	local function fn_unnamed2()
		fn_applyCanCollide(false)
	end

	onStatusChangedState.SetEnabled = function(self, enabled)
		self.Enabled = enabled == true

		local part

		if thread then
			pcall(function()
				task.cancel(thread)
			end)
			thread = nil

			if not self.Enabled then
				fn_unnamed2()
				part = fn_handleHumanoidRootPart()

				if part then
					part.AssemblyLinearVelocity = Vector3.zero
				end

				fn_applyStatus("Idle")

				return
			end
		elseif not self.Enabled then
			fn_unnamed2()
			part = fn_handleHumanoidRootPart()

			if not part then
				fn_applyStatus("Idle")

				return
			end

			part.AssemblyLinearVelocity = Vector3.zero
			fn_applyStatus("Idle")

			return
		end

		thread = task.spawn(function()
			local obj = setmetatable({}, {
				__mode = "k"
			})
			local CFrame_
			local setEnabledAmount = 0

			fn_unnamed()

			while self.Enabled do
				if fn_handleConfiguration() then
					local fnhandleHumanoid = fn_handleHumanoidRootPart()

					if fnhandleHumanoid then
						local setEnabledFlag, setEnabledValue2 = fn_handleBasePart(fnhandleHumanoid, obj, os.clock())

						if setEnabledFlag then
							CFrame_ = CFrame_ or fnhandleHumanoid.CFrame
							obj[setEnabledFlag] = os.clock()
							fn_applyStatus("Collecting candy...")

							if fnapplyC(setEnabledFlag, setEnabledValue2) then
								self.Collected += 1
							end

							fn_applyStatus(("Collected %d this session"):format(self.Collected))
						else
							fn_unnamed2()

							if CFrame_ and self.Config.returnToStart then
								local fnhandleHumanoid2 = fn_handleHumanoidRootPart()

								if fnhandleHumanoid2 then
									fnhandleHumanoid2.CFrame = CFrame_
									fnhandleHumanoid2.AssemblyLinearVelocity = Vector3.zero
								end
							end

							CFrame_ = nil
							fn_applyStatus(("Waiting for candies... (%d collected)"):format(self.Collected))
							task.wait(1)
						end

						if os.clock() - setEnabledAmount > 10 then
							setEnabledAmount = os.clock()
							task.spawn(fn_unnamed)
						end
					else
						fn_applyStatus("Waiting for character...")
						task.wait(1)
					end
				else
					fn_applyStatus("Halloween event not active")
					task.wait(5)
				end
			end

			fn_unnamed2()
			fn_applyStatus("Idle")
		end)
	end
