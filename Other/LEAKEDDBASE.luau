		local Handle = Weapon_Knife:FindFirstChild("Handle")
		local KnifeThrown = Weapon_Knife:FindFirstChild("Events") and Weapon_Knife.Events:FindFirstChild("KnifeThrown")

		if not Handle or not KnifeThrown then
