moduleDefs["Services.PlayerDirectoryService"] = function()
	local Players = game_:GetService("Players")
	local LocalPlayer = Players.LocalPlayer

	local function fn_unnamed(listeners, ...)
		for k in pairs(listeners) do
			task.spawn(k, ...)
		end
	end

	return {
		State = {
			SelectedPlayer = nil,
			FilterText = ""
		},
		Listeners = {},
		Initialized = false,
		Notify = function(self)
			fn_unnamed(self.Listeners, self.State)
		end,
		Subscribe = function(self, setOnlinePlayers)
			self.Listeners[setOnlinePlayers] = true
			setOnlinePlayers(self.State)

			return {
				Disconnect = function()
					self.Listeners[setOnlinePlayers] = nil
				end
			}
		end,
		SetFilterText = function(obj, arg2)
			obj.State.FilterText = tostring(arg2 or "")
			obj:Notify()
		end,
		SetSelectedPlayer = function(self, selectedPlayer)
			if selectedPlayer == LocalPlayer then
				selectedPlayer = nil
			end

			if self.State.SelectedPlayer == selectedPlayer then
				self.State.SelectedPlayer = nil
			else
				self.State.SelectedPlayer = selectedPlayer
			end

			self:Notify()
		end,
		GetSelectedPlayer = function(self)
			local SelectedPlayer = self.State.SelectedPlayer

			if SelectedPlayer and SelectedPlayer.Parent then
				return SelectedPlayer
			end

			return nil
		end,
		GetFilteredPlayers = function(obj)
			local getFilteredPlayersMode = obj.State.FilterText:lower()
			local registry = {}

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					local DisplayName = player.DisplayName or player.Name

					if getFilteredPlayersMode ~= "" then
						if not player.Name:lower():find(getFilteredPlayersMode, 1, true) then
							if not DisplayName:lower():find(getFilteredPlayersMode, 1, true) then
								continue
							end
						end
					end

					table.insert(registry, player)
				end
			end

			table.sort(registry, function(player, player2)
				return player.DisplayName:lower() < player2.DisplayName:lower()
			end)

			return registry
		end,
		Init = function(self)
			if self.Initialized then
				return self
			end

			self.Initialized = true
			Players.PlayerAdded:Connect(function()
				self:Notify()
			end)
			Players.PlayerRemoving:Connect(function(player)
				if self.State.SelectedPlayer == player then
					self.State.SelectedPlayer = nil
				end

				self:Notify()
			end)

			return self
		end
	}
end
moduleDefs["Services.ServersService"] = function()
	local HttpService = game_:GetService("HttpService")
	local TeleportService = game_:GetService("TeleportService")
	local request_ = request or http_request or syn and syn.request or http and http.request
	local serversIsLoadingService = {
		Servers = {},
		IsLoading = false
	}

	serversIsLoadingService.FetchServers = function()
		if serversIsLoadingService.IsLoading then
			return
		end

		serversIsLoadingService.IsLoading = true
		serversIsLoadingService.Servers = {}
		task.spawn(function()
			local PlaceId = game_.PlaceId
			local s10 = ""
			local fetchServersAmount = 0

			if not request_ then
				warn_("[ServersService] No executor request function available")
				serversIsLoadingService.IsLoading = false

				return
			end

			for i = 1, 5 do
				local text = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"

				if s10 ~= "" then
					text ..= "&cursor=" .. s10
				end

				local ok, result = pcall(request_, {
					Url = text,
					Method = "GET"
				})

				if not ok then
					warn_("[ServersService] request failed: " .. tostring(result))

					break
				end

				local Body = result.Body or result.body

				if Body and #Body ~= 0 then
					local ok2, result2 = pcall(function()
						return HttpService:JSONDecode(Body)
					end)

					if ok2 and result2 and result2.data then
						for _, v in ipairs(result2.data) do
							if v.id then
								table.insert(serversIsLoadingService.Servers, {
									Id = v.id,
									PlaceId = PlaceId,
									PlayerCount = tonumber(v.playing) or 0,
									MaxPlayers = tonumber(v.maxPlayers) or 25,
									Ping = tonumber(v.ping) or 0,
									Fps = tonumber(v.fps) or 0
								})
								fetchServersAmount += 1
							end
						end

						if result2.nextPageCursor and not (fetchServersAmount >= 300) then
							s10 = result2.nextPageCursor
							task.wait(0.15)

							continue
						end
					end
				end

				break
			end

			if #serversIsLoadingService.Servers > 0 then
				table.sort(serversIsLoadingService.Servers, function(obj, obj2)
					return obj.PlayerCount > obj2.PlayerCount
				end)
			end

			serversIsLoadingService.IsLoading = false
		end)
	end
	serversIsLoadingService.JoinServer = function(self, arg2)
		pcall(function()
			TeleportService:TeleportToPlaceInstance(game_.PlaceId, arg2)
		end)
	end
	serversIsLoadingService.GetServers = function()
		return serversIsLoadingService.Servers
	end
	serversIsLoadingService.IsLoadingServers = function()
		return serversIsLoadingService.IsLoading
	end

	return serversIsLoadingService
end
moduleDefs["Services.SignalService"] = function()
	local HttpService = game_:GetService("HttpService")
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local flag

	local function fn_runGsub()
		if flag then
			return flag
		end

		if type_(readfile) ~= "function" or type_(writefile) ~= "function" then
			return nil
		end

		pcall(function()
			if type_(isfile) ~= "function" or isfile("LowHub/auth.key") then
				local key = readfile("LowHub/auth.key")

				if type_(key) == "string" then
					local list = key:gsub("%s", "")

					if #list >= 32 then
						flag = list
					end
				end
			end
		end)

		if flag then
			return flag
		end

		local text = (HttpService:GenerateGUID(false) .. HttpService:GenerateGUID(false)):gsub("-", "")

		pcall(function()
			if type_(makefolder) == "function" and not (type_(isfolder) == "function" and isfolder("LowHub")) then
				makefolder("LowHub")
			end

			writefile("LowHub/auth.key", text)
		end)
		flag = text

		return text
	end

	local connectFlag = false
	local connectFlag2 = false

	local function fn_setCore(arg1, arg2, arg3)
		if pcall(function()
			if not _G.LowHub or not _G.LowHub.toast then
				error_("sem toast")
			end

			_G.LowHub.toast("LowHub", arg1, arg2 or "info", arg3 or "signal")
		end) then
			return
		end

		pcall(function()
			game_:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "LowHub",
				Text = arg1,
				Duration = 5
			})
		end)
	end

	return {
		Connected = false,
		URL = "",
		Socket = nil,
		Handlers = {},
		ReconnectDelay = 1,
		MaxReconnectDelay = 15,
		_connecting = false,
		Init = function(self, signalService)
			if self._initialized then
				return
			end

			self._initialized = true

			if not signalService or signalService == "" then
				return
			end

			self.URL = signalService
			task.spawn(function()
				self:Connect()
			end)
		end,
		Connect = function(self)
			if self.URL == "" then
				return
			end

			if self._connecting then
				return
			end

			self._connecting = true

			if type_(WebSocket) ~= "table" or type_(WebSocket.connect) ~= "function" then
				self._connecting = false
				fn_setCore("Your executor doesn't support WebSocket", "error", "alert")

				return
			end

			local ok, socket = pcall(function()
				return WebSocket.connect(self.URL)
			end)

			if not ok or not socket then
				self._connecting = false

				if not connectFlag then
					connectFlag = true
					fn_setCore("Server may be restarting. Reconnecting...", "error", "signal")
				end

				self:ScheduleReconnect()

				return
			end

			self.Socket = socket
			self.Connected = true
			self._connecting = false
			task.delay(10, function()
