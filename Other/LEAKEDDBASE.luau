			end
		end

		return nil
	end
	local function fnapplyFilter(weaponGun, part)
		local CantShoot = weaponGun and weaponGun:FindFirstChild("CantShoot")

		if CantShoot and CantShoot:IsA("BillboardGui") and CantShoot.Enabled then
			return true
		end

		local Character = LocalPlayer.Character
		local Head = Character and Character:FindFirstChild("Head")

