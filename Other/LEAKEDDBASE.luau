				Tier = self.State.Tier,
				ExpiresAt = self.State.ExpiresAt,
				Frozen = self.State.Frozen,
				Connected = self.State.Connected,
				FreeMode = self.State.FreeMode,
				AllFeatures = self.State.AllFeatures,
				AllowedFeatures = fn_handleTable(self.State.AllowedFeatures),
