	local function fn_applyDeathNoteMask()
		local deathNoteMaskConfig3 = {}
		local Map = workspace:FindFirstChild("Map")
		local House = Map and Map:FindFirstChild("House")
		local House2 = House and House:FindFirstChild("House")

		if not House2 then
			return deathNoteMaskConfig3
		end

		local Basement1 = House2:FindFirstChild("Basement 1")

		if Basement1 then
			local exitTo
			local DeathBook, _InteractivePromptPart
			for _, child in ipairs(Basement1:GetChildren()) do
				if child.Name == "Bookshelf" then
					local INTERACTIVE = child:FindFirstChild("INTERACTIVE")

					if INTERACTIVE then
						DeathBook = INTERACTIVE:FindFirstChild("Death Book")
						_InteractivePromptPart = INTERACTIVE:FindFirstChild("_InteractivePromptPart")

						if DeathBook and _InteractivePromptPart then
							exitTo = 1

							break
						end
					end
				end
			end

			if exitTo == 1 then
				local descendant2

				for _, descendant in ipairs(_InteractivePromptPart:GetDescendants()) do
