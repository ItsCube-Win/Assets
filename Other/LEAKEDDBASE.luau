			ensureEntryResult._boxFrames = (ensureEntryResult._boxFrames or 60) + 1

			if ensureEntryResult._boxFrames >= 60 or not ensureEntryResult._boxHW then
				ensureEntryResult._boxFrames = 0

				local boxHW, boxHH, v4787 = fn_handleHumanoidRootPart(adornee)

				if boxHW then
