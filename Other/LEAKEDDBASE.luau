		local seasonalCollectibles = getSeasonalCollectibles()

		return seasonalCollectibles ~= nil and seasonalCollectibles:GetAttribute("Active") == true
	end
	local function fn_getAttribute2(child, serverTimeNow)
		local flag = child:GetAttribute("SeasonalNode") == true and child:GetAttribute("Available") == true

		if flag then
			flag = (child:GetAttribute("ReadyAt") or 0) <= serverTimeNow
		end

		return flag
	end
	local function fn_getServerTimeNow(part, items)
		local seasonalCollectibles = getSeasonalCollectibles()

		if not seasonalCollectibles then
			return nil
		end

		local serverTimeNow = workspace:GetServerTimeNow()
		local now = os.clock()
		local child2
		local flag

		for _, child in ipairs(seasonalCollectibles:GetChildren()) do
			local itemEntry = items[child]

			if child:IsA("BasePart") and (not itemEntry or now - itemEntry > 20) and fn_getAttribute2(child, serverTimeNow) then
				local Magnitude = (child.Position - part.Position).Magnitude

				if not flag or Magnitude < flag then
					child2 = child
					flag = Magnitude
				end
			end
		end

		return child2, flag
	end

	local connection2
	local lookup2 = {}

	local function fn_applyCanCollide(flag)
		if flag then
