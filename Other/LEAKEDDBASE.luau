				ensureEntryResult.TLV.Visible = true
				ensureEntryResult.TRH.Color = BoxColor
				ensureEntryResult.TRH.From = vector22
				ensureEntryResult.TRH.To = vector22 + Vector2.new(-updateEntryAmount7, 0)
				ensureEntryResult.TRH.Visible = true
				ensureEntryResult.TRV.Color = BoxColor
				ensureEntryResult.TRV.From = vector22
				ensureEntryResult.TRV.To = vector22 + Vector2.new(0, updateEntryAmount8)
				ensureEntryResult.TRV.Visible = true
				ensureEntryResult.BLH.Color = BoxColor
				ensureEntryResult.BLH.From = vector23
				ensureEntryResult.BLH.To = vector23 + Vector2.new(updateEntryAmount7, 0)
				ensureEntryResult.BLH.Visible = true
				ensureEntryResult.BLV.Color = BoxColor
				ensureEntryResult.BLV.From = vector23
				ensureEntryResult.BLV.To = vector23 + Vector2.new(0, -updateEntryAmount8)
				ensureEntryResult.BLV.Visible = true
				ensureEntryResult.BRH.Color = BoxColor
				ensureEntryResult.BRH.From = vector24
				ensureEntryResult.BRH.To = vector24 + Vector2.new(-updateEntryAmount7, 0)
				ensureEntryResult.BRH.Visible = true
				ensureEntryResult.BRV.Color = BoxColor
				ensureEntryResult.BRV.From = vector24
				ensureEntryResult.BRV.To = vector24 + Vector2.new(0, -updateEntryAmount8)
				ensureEntryResult.BRV.Visible = true
			else
				ensureEntryResult.TLH.Visible = false
				ensureEntryResult.TLV.Visible = false
				ensureEntryResult.TRH.Visible = false
				ensureEntryResult.TRV.Visible = false
				ensureEntryResult.BLH.Visible = false
				ensureEntryResult.BLV.Visible = false
				ensureEntryResult.BRH.Visible = false
				ensureEntryResult.BRV.Visible = false
			end

			if ShowName then
				updateEntryObj3.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

				local DisplayName = State.UseDisplayName and player.DisplayName or player.Name

				if updateEntryObj then
					local tag = updateEntryObj:GetTag(player.UserId)

					if tag and tag.Name and tag.Name ~= "User" then
