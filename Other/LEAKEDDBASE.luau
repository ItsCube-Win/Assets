		local ThrowMode = arg3 or self.State.ThrowMode
		local throwKnifeFlag = (ThrowMode or "Legit") == "Rage"
		local Position = Weapon_Knife.Parent == LocalPlayer.Character and Handle.Position or self.Aim:KnifeOrigin(nil)

		if not Position then
			return false
		end

		local throwTargetResult = self:_throwTarget(Position, flag)

		if not throwTargetResult and throwKnifeFlag then
			throwTargetResult = flag or self.Roles:FindNearestPlayer()
		end

		if not throwTargetResult then
			self:_say("No visible target.", arg4)

			return false
		end

		if flag2 and not throwKnifeFlag then
