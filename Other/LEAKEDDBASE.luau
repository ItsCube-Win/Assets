		for _, child in ipairs(Balls:GetChildren()) do
			local attribute = child:GetAttribute("BallId")
			local PrimaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")

			if typeof(attribute) == "number" and PrimaryPart then
				lookup[#lookup + 1] = {
					id = attribute,
					pos = obj3.WorldToLocal(frame, PrimaryPart.Position),
					pocketed = child:GetAttribute("Pocketed") == true
