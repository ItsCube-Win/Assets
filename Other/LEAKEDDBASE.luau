			for _, subTab in ipairs_(subTabs) do
				local ipairs_2 = ipairs
				local sections = subTab.sections or {}

				for _, section in ipairs_2(sections) do
					local ipairs_3 = ipairs
					local rows = section.rows or {}

					for _, row in ipairs_3(rows) do
						local type_2 = row.type

						if type_2 == "toggle" or type_2 == "togglekey" or type_2 == "slider" or type_2 == "dropdown" or type_2 == "color" or type_2 == "segment" then
							local valEntry = valsCurrentGameConfig.vals[row.id]

							if valEntry ~= nil then
								fn_unnamed4(row.id, valEntry)
							end
						end
					end
				end
			end
		end
	end

	local lookup6 = {}

	do
		for _, tab in ipairs(brandGamesConfig.tabs) do
			local ipairs_ = ipairs
			local subTabs = tab.subTabs or {}

			for _, subTab in ipairs_(subTabs) do
				local ipairs_2 = ipairs
				local sections = subTab.sections or {}

				for _, section in ipairs_2(sections) do
					for _, row in ipairs(section.rows) do
						if row.type == "togglekey" then
							table.insert(lookup6, {
								sid = row.id,
								key = row.id .. "_key",
								label = row.label,
								kind = "toggle"
							})
							fn_runUpper(row.id, valsCurrentGameConfig.vals[row.id .. "_key"] or "", function()
								fn_unnamed6(row.id, not valsCurrentGameConfig.vals[row.id])
							end)
						elseif row.type == "toggleslider" and row.key ~= nil then
							table.insert(lookup6, {
								sid = row.id .. "_on",
								key = row.id .. "_key",
								label = row.label,
								kind = "toggle"
							})
							fn_runUpper(row.id .. "_on", valsCurrentGameConfig.vals[row.id .. "_key"] or "", function()
								fn_unnamed6(row.id .. "_on", not valsCurrentGameConfig.vals[row.id .. "_on"])
							end)
						elseif row.type == "keybind" then
							table.insert(lookup6, {
								sid = row.id,
								key = row.id,
								label = row.label,
								kind = "bind"
							})
							fn_runUpper(row.id, valsCurrentGameConfig.vals[row.id] or "", function()
								fn_unnamed7(row.id)
							end)
						end
					end
				end
			end
		end
	end

	for _, v in ipairs(lookup6) do
		palette3.permaIds[v.sid] = true
		palette3.permaIds[v.key] = true
	end

	_G.LowHub.rebindKeys = function()
		for _, v in ipairs(lookup6) do
			local valEntry = valsCurrentGameConfig.vals[v.key] or ""

			if v.kind == "toggle" then
				fn_runUpper(v.sid, valEntry, function()
					fn_unnamed6(v.sid, not valsCurrentGameConfig.vals[v.sid])
				end)
			else
				fn_runUpper(v.sid, valEntry, function()
					fn_unnamed7(v.sid)
				end)
			end
		end
	end
