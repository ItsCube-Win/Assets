moduleDefs["Modules.Interactions.Sync"] = function()
	local Players = game_:GetService("Players")
	local AttachmentRuntime = requireModule("Modules.Interactions.AttachmentRuntime")
	local LocalPlayer = Players.LocalPlayer
	local pairsByIdConfig = {
		Pairs = {
			{
				id = "carry",
				name = "Carry",
				a = {
					label = "Hold",
					anim = "86827544363701"
				},
				b = {
					label = "Be Held",
					anim = "106568138056022"
				},
				lead = "a",
				offset = CFrame.new(0, 0, -1),
				anchor = Vector3.new(0.05, -0.27, 0.26)
			},
			{
				id = "armcarry",
				name = "Arm Carry",
				a = {
					label = "Hold",
					anim = "139814360255364"
				},
				b = {
					label = "Be Held",
					anim = "78533516804583"
				},
				lead = "a",
				offset = CFrame.new(-2.08, -0.17, 0.16),
				anchor = Vector3.new(-0.902, 0.266, 0.063)
			},
			{
				id = "onshoulders",
				name = "On Shoulders",
				a = {
					label = "Hold",
					anim = "138559309139635"
				},
				b = {
					label = "Ride",
					anim = "105038787943792"
				},
				lead = "a",
				offset = CFrame.new(0, 0, 0.9),
				anchor = Vector3.new(-0.044, 0.403, 0.88)
			}
		},
		ById = {}
	}

	for _, pair in ipairs(pairsByIdConfig.Pairs) do
		pairsByIdConfig.ById[pair.id] = pair
	end

	pairsByIdConfig.Current = nil
	pairsByIdConfig.OnEnd = nil

	local track
	local startAmount = 0
	local NoDelay

	local function fngetPlaying(instance, anim)
		local Humanoid = instance and instance:FindFirstChildOfClass("Humanoid")
		local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

		if not Animator then
			return false
		end

		for _, v in ipairs(Animator:GetPlayingAnimationTracks()) do
			if v.Animation then
				if tostring(v.Animation.AnimationId):match("%d+$") == anim then
					return true
				end
			end
		end

		return false
	end
	local function bodyPlace(items)
		local anim = items[items.lead].anim
		local Position = items.offset.Position
		local vector
		local bodyPlaceFlag = false
		local bodyPlaceAmount = 0

		local function fn_runPointToObjectSpace(instance, instance2)
			local HumanoidRootPart = instance2.HumanoidRootPart
			local now = os.clock()

			if bodyPlaceAmount <= now then
				bodyPlaceAmount = now + 0.5
				bodyPlaceFlag = fngetPlaying(instance2, anim)
			end

			local position = Position
			local LeftLowerArm = instance2:FindFirstChild("LeftLowerArm")
			local RightLowerArm = instance2:FindFirstChild("RightLowerArm")
			local HumanoidRootPart2 = instance:FindFirstChild("HumanoidRootPart")
			local LowerTorso = instance:FindFirstChild("LowerTorso")

			if bodyPlaceFlag and items.anchor and LeftLowerArm and RightLowerArm and HumanoidRootPart2 and LowerTorso then
				local pointToObjectSpaceResult = HumanoidRootPart.CFrame:PointToObjectSpace((LeftLowerArm.Position + RightLowerArm.Position) / 2)
				local pointToObjectSpaceResult2 = HumanoidRootPart2.CFrame:PointToObjectSpace(LowerTorso.Position)
				local UpperTorso = instance2:FindFirstChild("UpperTorso")
				local UpperTorso2 = instance:FindFirstChild("UpperTorso")

				position = pointToObjectSpaceResult + items.anchor * (((UpperTorso and UpperTorso.Size.Y or 1.44) + (UpperTorso2 and UpperTorso2.Size.Y or 1.44)) / 2.88) - pointToObjectSpaceResult2
			end

			vector = vector and vector:Lerp(position, 0.25) or position

			return HumanoidRootPart.CFrame * CFrame.new(vector)
		end

		return fn_runPointToObjectSpace
	end

	pairsByIdConfig.BodyPlace = bodyPlace

	local function fn_handleHumanoid(character)
		local Humanoid = character and character:FindFirstChildOfClass("Humanoid")

		return Humanoid ~= nil and Humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") ~= nil
	end
	local function fn_applyNoDelayCurrent()
		startAmount += 1

		if track then
			pcall(function()
				track:Stop()
			end)
			track = nil
		end

		if AttachmentRuntime:IsActive("Sync") then
			AttachmentRuntime:Stop("Sync")
		end

		if NoDelay ~= nil then
			AttachmentRuntime.NoDelay = NoDelay
			NoDelay = nil
		end

		pairsByIdConfig.Current = nil
	end

	pairsByIdConfig.Stop = function()
		fn_applyNoDelayCurrent()
	end

	local function fn_unnamed(arg1)
		if not pairsByIdConfig.Current then
			return
		end

		fn_applyNoDelayCurrent()

		if pairsByIdConfig.OnEnd then
			pcall(pairsByIdConfig.OnEnd, arg1)
		end
	end

	pairsByIdConfig.Start = function(self, selectedPlayer, player)
		local byIdEntry = pairsByIdConfig.ById[self]
		local byIdEntryEntry = byIdEntry and byIdEntry[selectedPlayer]

		if not byIdEntryEntry or not player or not fn_handleHumanoid(player.Character) or not fn_handleHumanoid(LocalPlayer.Character) then
			return false
		end

		fn_applyNoDelayCurrent()

		for k in pairs(AttachmentRuntime.Active) do
			AttachmentRuntime:Stop(k)
		end

		local startFlag = selectedPlayer ~= byIdEntry.lead

		if startFlag then
			NoDelay = AttachmentRuntime.NoDelay
			AttachmentRuntime.NoDelay = true

			if not AttachmentRuntime:Toggle("Sync", {
				AnimationId = byIdEntryEntry.anim,
				Direct = true,
				Priority = Enum.AnimationPriority.Action4,
				Offset = byIdEntry.offset,
				Place = bodyPlace(byIdEntry),
				PlatformStand = true
			}, function()
				return player
			end) then
				fn_applyNoDelayCurrent()

				return false
			end
		else
			track = AttachmentRuntime:PlayLoopedAnimation(byIdEntryEntry.anim, nil, Enum.AnimationPriority.Action4, false, nil, true)

			if not track then
				fn_applyNoDelayCurrent()

				return false
			end
		end

		pairsByIdConfig.Current = {
			pairId = self,
			side = selectedPlayer,
			partner = player
		}
		startAmount += 1

		local startValue = startAmount

		task.spawn(function()
			while true do
				if startAmount ~= startValue or not pairsByIdConfig.Current then
					return
				end

				task.wait(0.25)

				if startAmount ~= startValue then
					return
				end

				if not player.Parent or not fn_handleHumanoid(player.Character) then
					break
				end

				if not fn_handleHumanoid(LocalPlayer.Character) then
					return fn_unnamed("self")
				end

				if startFlag and not AttachmentRuntime:IsActive("Sync") then
					return fn_unnamed("interrupted")
				end

				if not startFlag and (not track or not track.IsPlaying) then
					return fn_unnamed("interrupted")
				end
			end

			return fn_unnamed("partner")
		end)

		return true
	end

	return pairsByIdConfig
end
moduleDefs["Modules.Interactions.SyncEmote"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local lookup = {}
	local lookup2 = {}

	local function fn_handleHumanoid(character)
		local Humanoid = character and character:FindFirstChildOfClass("Humanoid")

		return Humanoid and Humanoid:FindFirstChildOfClass("Animator") or nil
	end
	local function fngetPlaying()
		local fn_handleHumanoidResult = fn_handleHumanoid(LocalPlayer.Character)

		if fn_handleHumanoidResult then
			for _, v in ipairs(fn_handleHumanoidResult:GetPlayingAnimationTracks()) do
				pcall(function()
					v:Stop(0)
				end)
			end
		end

		for _, v in pairs(lookup) do
			pcall(function()
				v:Stop(0)
				v:Destroy()
			end)
		end

		table.clear(lookup)
	end
	local function fn_handleAnimate()
		local Character = LocalPlayer.Character
		local Animate = Character and Character:FindFirstChild("Animate")

		if not Animate then
			return
		end

		table.clear(lookup2)

		for _, child in pairs(Animate:GetChildren()) do
			if child:IsA("StringValue") then
				local Animation = child:FindFirstChildOfClass("Animation")

				if Animation then
					lookup2[child.Name] = Animation.AnimationId
				end
			end
		end
	end
	local function fn_applyAnimationId(character2, character)
		local Animate = character2 and character2:FindFirstChild("Animate")
		local Animate2 = character and character:FindFirstChild("Animate")

		if not Animate or not Animate2 then
			return
		end

		for _, child in pairs(Animate:GetChildren()) do
			if child:IsA("StringValue") then
				local Animation = child:FindFirstChildOfClass("Animation")

				if Animation then
					local ChildName = Animate2:FindFirstChild(child.Name)

					if ChildName then
						local Animation2 = ChildName:FindFirstChildOfClass("Animation")

						if Animation2 then
							Animation2.AnimationId = Animation.AnimationId
						end
					end
				end
			end
		end
	end
	local function fn_applyAnimationId2()
		local Character = LocalPlayer.Character
		local Animate = Character and Character:FindFirstChild("Animate")

		if not Animate then
			return
		end

		for k, v in pairs(lookup2) do
			local findFirstChildResult = Animate:FindFirstChild(k)

			if findFirstChildResult then
				local Animation = findFirstChildResult:FindFirstChildOfClass("Animation")

				if Animation then
					Animation.AnimationId = v
				end
			end
		end
	end

	return {
		State = {
			Active = false
		},
		Connection = nil,
		Stop = function(self)
			self.State.Active = false

			if self.Connection then
				self.Connection:Disconnect()
				self.Connection = nil
			end

			fngetPlaying()
			fn_applyAnimationId2()

			local Character = LocalPlayer.Character
			local Animate = Character and Character:FindFirstChild("Animate")

			if Animate then
				Animate.Disabled = true
				task.wait()
				Animate.Disabled = false
			end
		end,
		Toggle = function(self, self2)
			if self.State.Active then
				self:Stop()

				return false
			end

			if not self2 or not self2.Character then
				return false
			end

			self.State.Active = true
			fn_handleAnimate()

			local Character = LocalPlayer.Character
			local Character2 = self2.Character

			fn_applyAnimationId(Character2, Character)

			local Animate = Character and Character:FindFirstChild("Animate")

			if Animate then
				Animate.Disabled = true
				task.wait()
				Animate.Disabled = false
			end

			self.Connection = RunService.Heartbeat:Connect(function()
				if not self.State.Active then
					return
				end

				Character2 = self2.Character
				Character = LocalPlayer.Character

				if not Character2 or not Character then
					self:Stop()

					return
				end

				local l = fn_handleHumanoid(Character2)
				local i = fn_handleHumanoid(Character)

				if not l or not i then
					return
				end

				local K = {}

				for M, M in ipairs(l:GetPlayingAnimationTracks()) do
					local l = M.Animation

					if l and l.AnimationId ~= "" then
						local x = l.AnimationId

						K[x] = true

						local l = lookup[x]

						if not l or not l.IsPlaying then
							if l then
								pcall(function()
									l:Stop(0)
									l:Destroy()
								end)
							end

							local Y = Instance.new("Animation")

							Y.AnimationId = x
							l = i:LoadAnimation(Y)
							l.Priority = M.Priority
							l.Looped = M.Looped
							l:Play(0.1)
							lookup[x] = l
						end

						pcall(function()
							l.TimePosition = M.TimePosition
							l:AdjustSpeed(M.Speed)
						end)
					end
				end

				for l, W in pairs(lookup) do
					if not K[l] then
						pcall(function()
							W:Stop(0.1)
							W:Destroy()
						end)
						lookup[l] = nil
					end
				end
			end)

			return true
		end,
		IsActive = function(self)
			return self.State.Active
		end
	}
end
moduleDefs["Modules.Interactions.Troll"] = function()
	local AttachmentRuntime = requireModule("Modules.Interactions.AttachmentRuntime")

	local function getCosine(amount)
		return math.cos(2.2439947525641379 * amount)
	end
	local function fn_runPointToWorldSpace(arg1, character, amount)
		local HumanoidRootPart = character.HumanoidRootPart
		local value = 66.8 * amount
		local amount2 = 8.95 - 4.4 * getCosine(amount)

		return CFrame.lookAt(HumanoidRootPart.CFrame:PointToWorldSpace(Vector3.new(math.sin(value) * amount2, 2, math.cos(value) * amount2)), HumanoidRootPart.Position)
	end
	local function fn_runPointToWorldSpace2(part, amount)
		local value = -0.9 * amount
		local amount2 = 5.8 - 2.1 * getCosine(amount)

		return CFrame.lookAt(part.CFrame:PointToWorldSpace(Vector3.new(math.sin(value) * amount2, 2.5, math.cos(value) * amount2)), part.Position)
	end
	local function fn_runPointToWorldSpace3(arg1, character, amount)
		local HumanoidRootPart = character.HumanoidRootPart
		local value = -3 * amount
		local pointToWorldSpaceResult = HumanoidRootPart.CFrame:PointToWorldSpace(Vector3.new(math.sin(value) * 7, 0, math.cos(value) * 7))

		return CFrame.lookAt(pointToWorldSpaceResult, pointToWorldSpaceResult + (HumanoidRootPart.Position - pointToWorldSpaceResult) * Vector3.new(1, 0, 1))
	end
	local function fn_unnamed(arg1, character)
		return character.HumanoidRootPart.CFrame * CFrame.new(0, -23.8, 0)
	end
	local function fn_runPointToObjectSpace(instance, instance2)
		local HumanoidRootPart = instance2.HumanoidRootPart
		local Head = instance2:FindFirstChild("Head")
		local Head2 = instance:FindFirstChild("Head")
		local amount = 0

		if Head and Head2 then
			amount = HumanoidRootPart.CFrame:PointToObjectSpace(Head.Position).Y - instance.HumanoidRootPart.CFrame:PointToObjectSpace(Head2.Position).Y
		end

		return HumanoidRootPart.CFrame * CFrame.new(0, amount, -1.5)
	end

	local toggleObj

	toggleObj = {
		Configs = {
			Orbit = {
				Place = fn_runPointToWorldSpace,
				Camera = fn_runPointToWorldSpace2,
				PlatformStand = true
			},
			Spin = {
				Place = fn_runPointToWorldSpace3,
				PlatformStand = true
			},
			Ghost = {
				Place = fn_unnamed,
				SpectateTarget = true,
				PlatformStand = true
			},
			["Block View"] = {
				Place = fn_runPointToObjectSpace,
				PlatformStand = true
			},
			Slap = {
				AnimationId = "108225134235478",
				Priority = Enum.AnimationPriority.Action4,
				Offset = CFrame.new(0, 0, -2.52) * CFrame.Angles(0, 3.1415926535897931, 0),
				PlatformStand = true,
				Once = true
			}
		},
		Toggle = function(self, self2)
			local configEntry = toggleObj.Configs[self]

			if not configEntry then
				return false
			end

			configEntry.Direct = true

			return AttachmentRuntime:Toggle(self, configEntry, self2)
		end
	}

	return toggleObj
end
moduleDefs["Modules.Movement.ClickTP"] = function()
	local UserInputService = game_:GetService("UserInputService")
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local setEnabledService = {
		Enabled = false
	}

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		if not setEnabledService.Enabled then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and not UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
			return
		end

		local mouse = LocalPlayer:GetMouse()

		if LocalPlayer.Character and mouse.Target then
			LocalPlayer.Character:PivotTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
		end
	end)
	setEnabledService.SetEnabled = function(self, enabled)
		self.Enabled = enabled
	end

	return setEnabledService
end
