local function fn_runJSONDecode()
	if type_(queueonteleport) ~= "function" then
		return false
	end

	if type_(readfile) ~= "function" then
		return false
	end

	local ok, result = pcall(readfile, "LowHub/settings.json")

	if ok and result and result ~= "" then
		local ok2, result2 = pcall(function()
			return game_:GetService("HttpService"):JSONDecode(result)
		end)

		if ok2 and type_(result2) == "table" then
			return result2.autoExecute == true
		end
	end

	return false
end

pcall(function()
	if fn_runJSONDecode() then
		queueonteleport([[                repeat task.wait(1) until game:IsLoaded() and game.Players.LocalPlayer
                task.wait(2)
                -- RE-CHECA a setting no servidor novo: a fila do queueonteleport persiste mesmo
                -- depois de desligar a toggle, entao sem isso o auto-exec disparava 1x a mais.
                -- Desligar Auto-Execute (settings.json autoExecute=false) cancela a execucao.
                local stillOn = false
                pcall(function()
                    if type(readfile) == "function" then
                        local raw = readfile("LowHub/settings.json")
                        if raw and raw ~= "" then
                            local data = game:GetService("HttpService"):JSONDecode(raw)
                            if type(data) == "table" then stillOn = data.autoExecute == true end
                        end
                    end
                end)
                if not stillOn then return end
                _G.LowHubPortLoaded = nil
                pcall(function()
                    local ok, code = pcall(function() return game:HttpGet("https://lowhub.online/script") end)
                    if ok and code and code ~= "" then
                        local fn = loadstring(code)
                        if fn then fn() end
                    end
                end)
            ]])
	end
end)

local moduleDefs = {}
local moduleCache = {}

local function requireModule(arg1)
	if typeof(arg1) == "Instance" then
		return require(arg1)
	end

	if moduleCache[arg1] ~= nil then
		return moduleCache[arg1]
	end

	if moduleDefs[arg1] then
		local requireModuleValue = moduleDefs[arg1]()

		moduleCache[arg1] = requireModuleValue

		return requireModuleValue
	end

	error_("Module not found: " .. tostring(arg1))
end

local devLoadedConfig = {
	dev = false,
	loaded = false,
	proxies = {},
	reals = {}
}

devLoadedConfig.makeProxy = function(arg1, list)
	local lookup = {}

	for _, v in ipairs(list) do
		lookup[v] = true
	end

	local makeProxyItems
	local lookup2 = {}
	local lookup3 = {}
	local lookup4 = {}
	local lookup5 = {}
	local registry = {}

	local function fn_handleFunction(arg1_2)
		local lookup5Entry = lookup5[arg1_2]

		if lookup5Entry then
			return lookup5Entry
		end

		local function fn_handleFunction2(arg1_3, ...)
			if makeProxyItems then
				local entry = makeProxyItems[arg1_2]

				if type_(entry) ~= "function" then
					return nil
				end

				if rawequal(arg1_3, registry) then
					return entry(makeProxyItems, ...)
				end

				return entry(arg1_3, ...)
			end

			if lookup3[arg1_2] == nil then
				lookup4[#lookup4 + 1] = arg1_2
			end

			lookup3[arg1_2] = table.pack(arg1_3, ...)

			return nil
		end

		lookup5[arg1_2] = fn_handleFunction2

		return fn_handleFunction2
	end

	setmetatable(registry, {
		__index = function(arg1_2, arg2)
			if makeProxyItems then
				local entry = makeProxyItems[arg2]

				if type_(entry) == "function" then
					return fn_handleFunction(arg2)
				end

				return entry
			end

			if lookup2[arg2] == nil then
				if lookup[arg2] then
					return fn_handleFunction(arg2)
				end

				return nil
			end

			return lookup2[arg2]
		end,
		__newindex = function(arg1_2, arg2, arg3)
			if makeProxyItems then
				makeProxyItems[arg2] = arg3
			else
				lookup2[arg2] = arg3
			end
		end
	})

	local function fn_handleTable(items)
		if makeProxyItems or type_(items) ~= "table" then
			return
		end

		makeProxyItems = items

		for k, v in pairs(lookup2) do
			items[k] = v
		end

		for _, v in ipairs(lookup4) do
			local lookup3Entry = lookup3[v]
			local itemEntry = items[v]

			if type_(itemEntry) == "function" then
				pcall(itemEntry, rawequal(lookup3Entry[1], registry) and items or lookup3Entry[1], table.unpack(lookup3Entry, 2, lookup3Entry.n))
			end
		end

		lookup2 = {}
		lookup3 = {}
		lookup4 = {}
	end

	local attachProxyConfig = {
		attach = fn_handleTable,
		proxy = registry
	}

	devLoadedConfig.proxies[arg1] = attachProxyConfig

	if devLoadedConfig.reals[arg1] then
		attachProxyConfig.attach(devLoadedConfig.reals[arg1])
	end

	return registry
end
devLoadedConfig.install = function(list)
	for k, v in pairs(list) do
		devLoadedConfig.reals[k] = v

		local proxyEntry = devLoadedConfig.proxies[k]

		if proxyEntry then
			proxyEntry.attach(v)
		end
	end

	devLoadedConfig.loaded = true
end
