				elseif mode == "neon" then
					local Y = 0.7 + (math.sin(M * 12) * 0.3)

					UIGradient.Rotation = (M * 240) % 360
					TextLabel.TextTransparency = math.clamp(1 - Y, 0, 0.4)

					local Y = math.floor(M * 2) % #createBillboardGuiList + 1

					UIStroke.Color = createBillboardGuiList[Y]
					UIStroke.Thickness = 2.5 + (math.sin(M * 15) * 0.5)
				elseif mode == "sheen" then
					local c = createBillboardGuiList[1]
					local Y = createBillboardGuiList[#createBillboardGuiList]

					UIGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c), ColorSequenceKeypoint.new(0.4, Y), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.6, Y), ColorSequenceKeypoint.new(1, c) })
					UIGradient.Rotation = 0
					UIGradient.Offset = Vector2.new((M * 0.8) % 2 - 1, 0)
				elseif mode == "crystal" then
					local c = createBillboardGuiList[1]
					local Y = createBillboardGuiList[2] or Color3.fromRGB(0, 100, 255)

					UIGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c), ColorSequenceKeypoint.new(0.4, Y), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.6, Y), ColorSequenceKeypoint.new(1, c) })
					UIGradient.Rotation = (M * 60) % 360
					UIGradient.Offset = Vector2.new(0, (M * 1.2) % 2 - 1)
				elseif mode == "majestic" then
					local i = createBillboardGuiList[1]
					local c = createBillboardGuiList[2] or createBillboardGuiList[1]

					UIGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, i), ColorSequenceKeypoint.new(0.45, c), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.55, c), ColorSequenceKeypoint.new(1, i) })
					UIGradient.Rotation = 90 + (math.sin(M * 2) * 20)
					UIGradient.Offset = Vector2.new(0, (M * 0.8) % 2 - 1)
				elseif mode == "ocean" then
					UIGradient.Offset = Vector2.new((M * 1) % 2 - 1, 0)
				elseif mode == "fire" then
					UIGradient.Rotation = -90.0 + (math.sin(M * 8) * 15)
				elseif mode == "matrix" then
					UIGradient.Rotation = 90
					UIGradient.Offset = Vector2.new(0, (M * 1) % 2 - 1)
				elseif mode == "diagonal" then
					UIGradient.Rotation = 45
					UIGradient.Offset = Vector2.new((M * 0.8) % 2 - 1, 0)
				elseif mode == "spin" then
					UIGradient.Rotation = (M * 40) % 360
				elseif mode == "pulse" then
					TextLabel.TextTransparency = 0.1 + (math.sin(M * 3) + 1) * 0.15
				elseif mode == "glitch" then
					createBillboardGuiAmount2 += 1

					if createBillboardGuiAmount2 % 12 == 0 then
						if math.random() > 0.7 then
							local i = {}

							for M = 1, #text do
								if math.random() > 0.6 then
									table.insert(i, tbl[math.random(1, #tbl)])
								else
									table.insert(i, text:sub(M, M))
								end
							end

							TextLabel.Text = table.concat(i)
						else
							TextLabel.Text = text
						end
					end

					if math.random() > 0.8 then
						UIGradient.Offset = Vector2.new(math.random() * 0.05 - 0.025, math.random() * 0.05 - 0.025)
					end

					if math.random() > 0.95 then
