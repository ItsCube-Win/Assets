moduleDefs["Modules.Exploit.InstantInteract"] = function()
	local ProximityPromptService = game_:GetService("ProximityPromptService")
	local connection
	local lookup = {}

	return {
		Enabled = false,
		SetEnabled = function(self, enabled)
			self.Enabled = enabled == true

			if self.Enabled then
				lookup = {}
				connection = ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
					if lookup[prompt] == nil then
						lookup[prompt] = prompt.HoldDuration
					end

					prompt.HoldDuration = 0
				end)

				return
			end

			if connection then
				connection:Disconnect()
				connection = nil
			end

			for k, v in pairs(lookup) do
				if k and k.Parent then
					k.HoldDuration = v
				end
			end

			lookup = {}
		end
	}
end
moduleDefs["Modules.Exploit.Invisibility"] = function()
	game_:GetService("Players")
	game_:GetService("RunService")

	local flag = game_.PlaceId == 17274762379
	local setEnabledService = {
		Enabled = false
	}
	local flag2 = false
	local flag3 = false
	local instance
	local clone
	local Seat
	local Weld
	local connection
	local connection2

	local function fn_applyTransparencyCFrame()
		if flag then
			if Weld then
				pcall(function()
					Weld:Destroy()
				end)
				Weld = nil
			end

			if Seat then
				pcall(function()
					Seat:Destroy()
				end)
				Seat = nil
			end

			local Character = game_.Players.LocalPlayer.Character or instance

			if Character then
				local Humanoid = Character:FindFirstChildOfClass("Humanoid")

				if Humanoid then
					pcall(function()
						Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
					end)
				end

				for _, descendant in pairs(Character:GetDescendants()) do
					if not descendant:IsA("BasePart") and not descendant:IsA("MeshPart") then
						if descendant:IsA("Decal") or descendant:IsA("Texture") then
							descendant.Transparency = 0
						end
					elseif descendant.Name ~= "HumanoidRootPart" then
						descendant.Transparency = 0
					end
				end

				for _, child in pairs(Character:GetChildren()) do
					if child:IsA("Accessory") then
						local Handle = child:FindFirstChild("Handle")

						if Handle then
							Handle.Transparency = 0
						end
					end
				end
			end
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end

			if connection2 then
				connection2:Disconnect()
				connection2 = nil
			end

			local LocalPlayer = game_.Players.LocalPlayer

			if instance and instance.Parent ~= nil then
				local HumanoidRootPart = instance:FindFirstChild("HumanoidRootPart")

				if clone then
					local HumanoidRootPart2 = clone:FindFirstChild("HumanoidRootPart")

					if HumanoidRootPart and HumanoidRootPart2 then
						HumanoidRootPart.CFrame = HumanoidRootPart2.CFrame
					end
				end

				instance.Parent = workspace
				LocalPlayer.Character = instance

				local Humanoid = instance:FindFirstChildOfClass("Humanoid")

				if Humanoid then
					workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
					workspace.CurrentCamera.CameraSubject = Humanoid
				end
			end

			if clone then
				pcall(function()
					clone:Destroy()
				end)
				clone = nil
			end
		end

		flag3 = false
		flag2 = false
		setEnabledService.Enabled = false
	end
	local function fnapplyArchivable()
		if flag2 then
			return
		end

		flag2 = true

		local LocalPlayer = game_.Players.LocalPlayer

		repeat
			task.wait(0.1)
		until LocalPlayer.Character

		local Character = LocalPlayer.Character

		if not flag then
			Character.Archivable = true
			flag3 = false
			instance = Character
			clone = Character:Clone()
			clone.Parent = game_:GetService("Lighting")
			clone.Name = ""

			local FallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight

			connection = game_:GetService("RunService").Stepped:Connect(function()
				pcall(function()
					if not LocalPlayer.Character then
						return
					end

					local l = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

					if not l then
						return
					end

					local K = l.Position.Y
					local l = tostring(FallenPartsDestroyHeight):find("-")

					if (l and K <= FallenPartsDestroyHeight) or (not l and K >= FallenPartsDestroyHeight) then
						fn_applyTransparencyCFrame()
					end
				end)
			end)

			for _, descendant in pairs(clone:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant.Transparency = descendant.Name == "HumanoidRootPart" and 1 or 0.5
				elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
					descendant.Transparency = 0.5
				end
			end

			local Humanoid = clone:FindFirstChildOfClass("Humanoid")

			if Humanoid then
				connection2 = Humanoid.Died:Connect(function()
					fn_applyTransparencyCFrame()
				end)
			end

			flag3 = true

			local CFrame_ = Character:FindFirstChild("HumanoidRootPart").CFrame
			local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

			if HumanoidRootPart then
				HumanoidRootPart.CFrame = CFrame_ * CFrame.new(0, -200, 0)
			end

			workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
			task.wait(0.1)
			Character.Parent = game_:GetService("Lighting")
			clone.Parent = workspace

			local HumanoidRootPart2 = clone:FindFirstChild("HumanoidRootPart")

			if HumanoidRootPart2 then
				HumanoidRootPart2.CFrame = CFrame_
			end

			LocalPlayer.Character = clone
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
			workspace.CurrentCamera.CameraSubject = clone:FindFirstChildOfClass("Humanoid")

			local Animate = LocalPlayer.Character:FindFirstChild("Animate")

			if Animate then
				Animate.Disabled = true
				Animate.Disabled = false
			end

			local Humanoid2 = instance:FindFirstChildOfClass("Humanoid")
			local Humanoid3 = clone:FindFirstChildOfClass("Humanoid")

			if Humanoid2 and Humanoid3 then
				Humanoid3.WalkSpeed = Humanoid2.WalkSpeed
				Humanoid3.JumpPower = Humanoid2.JumpPower
				Humanoid3.JumpHeight = Humanoid2.JumpHeight
			end

			task.spawn(function()
				while flag3 and clone and instance do
					pcall(function()
						local Humanoid4 = instance:FindFirstChildOfClass("Humanoid")
						local Humanoid5 = clone:FindFirstChildOfClass("Humanoid")

						if Humanoid4 and Humanoid5 then
							Humanoid5.WalkSpeed = Humanoid4.WalkSpeed
							Humanoid5.JumpPower = Humanoid4.JumpPower
						end
					end)
					task.wait(0.5)
				end
			end)

			return
		end

		flag3 = true
		instance = Character

		local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
		local Torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		local CFrame_ = HumanoidRootPart and HumanoidRootPart.CFrame or CFrame.new()

		if HumanoidRootPart and Torso then
			local cFrame = CFrame.new(-25.95, 84, 3537.55)

			HumanoidRootPart.CFrame = cFrame
			task.wait(0.1)

			for i = 1, 5 do
				if not ((HumanoidRootPart.Position - cFrame.Position).Magnitude > 10) then
					break
				end

				HumanoidRootPart.CFrame = cFrame
				task.wait(0.05)
			end

			task.wait(0.1)
			Seat = Instance.new("Seat")
			Seat.Name = "InvisChair_" .. LocalPlayer.Name
			Seat.Anchored = false
			Seat.CanCollide = false
			Seat.Transparency = 1
			Seat.Position = Vector3.new(-25.95, 84, 3537.55)
			Seat.Parent = workspace
			task.spawn(function()
				while Seat and Seat.Parent do
					Seat.Transparency = 1
					task.wait(0.1)
				end
			end)

			local InvisWeld = Torso:FindFirstChild("InvisWeld")

			if InvisWeld then
				InvisWeld:Destroy()
			end

			Weld = Instance.new("Weld")
			Weld.Name = "InvisWeld"
			Weld.Part0 = Seat
			Weld.Part1 = Torso
			Weld.Parent = Seat
			task.wait()
			Seat.CFrame = CFrame_
			task.wait(0.1)

			if (HumanoidRootPart.Position - CFrame_.Position).Magnitude > 50 then
				HumanoidRootPart.CFrame = CFrame_
			end

			local rightLegRight = {
				RightLeg = true,
				RightUpperLeg = true,
				RightLowerLeg = true,
				RightFoot = true
			}
			local flag4 = false

			pcall(function()
				local appliedDescription = Character:FindFirstChildOfClass("Humanoid"):GetAppliedDescription()

				if appliedDescription and appliedDescription.RightLeg == 139607718 then
					flag4 = true
				end
			end)

			for _, descendant in pairs(Character:GetDescendants()) do
				if not flag4 or not rightLegRight[descendant.Name] then
					if not descendant:IsA("BasePart") and not descendant:IsA("MeshPart") then
						if descendant:IsA("Decal") or descendant:IsA("Texture") then
							descendant.Transparency = 0.6
						end
					elseif descendant.Name == "HumanoidRootPart" then
						descendant.Transparency = 1
					else
						descendant.Transparency = 0.6
					end
				end
			end

			for _, child in pairs(Character:GetChildren()) do
				if child:IsA("Accessory") then
					local Handle = child:FindFirstChild("Handle")

					if Handle then
						Handle.Transparency = 0.6
					end
				end
			end

			workspace.CurrentCamera.CameraSubject = Character:FindFirstChildOfClass("Humanoid")
		end
	end
	local function fn_unnamed()
		fn_applyTransparencyCFrame()
	end

	game_.Players.LocalPlayer.CharacterAdded:Connect(function()
		if setEnabledService.Enabled then
			fn_applyTransparencyCFrame()
		end
	end)
	setEnabledService.SetEnabled = function(self, enabled)
		if self.Enabled == enabled then
			return
		end

		self.Enabled = enabled

		if enabled then
			fnapplyArchivable()
		else
			fn_unnamed()
		end
	end

	return setEnabledService
end
