local function fn_applyLowHubAntiDetect()
	local UserInputService = game_:GetService("UserInputService")
	local TweenService = game_:GetService("TweenService")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = game_:GetService("Players").LocalPlayer

	_G.LowHub = _G.LowHub or {}
	_G.LowHub.antiDetect = _G.LowHub.antiDetect or {}

	local antiDetect = _G.LowHub.antiDetect

	local function fn_unnamed()
		local function getRandomValue()
			return math.random(0, 65535)
		end

		return string.format("%04x%04x-%04x-%04x-%04x-%04x%04x%04x", getRandomValue(), getRandomValue(), getRandomValue(), getRandomValue(), getRandomValue(), getRandomValue(), getRandomValue(), getRandomValue())
	end

	antiDetect.hubGuiName = antiDetect.hubGuiName or fn_unnamed()

	local Players = game_:GetService("Players")
	local StarterGui = game_:GetService("StarterGui")
	local LocalPlayer2 = Players.LocalPlayer
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")

	local function fn_handleFunction()
		local ok, result = pcall(function()
			if type_(identifyexecutor) == "function" then
				local executorName = identifyexecutor()

				return executorName
			end

			if type_(getexecutorname) == "function" then
				return getexecutorname()
			end

			return nil
		end)
		local result2 = ok and type_(result) == "string" and result or nil

		return result2
	end

	antiDetect.execName = antiDetect.execName or fn_handleFunction()

	local function fn_runLower()
		local execName = antiDetect.execName

		if not execName then
			return false
		end

		if execName:lower():find("xeno") then
			return true
		end

		return false
	end

	antiDetect.execSafeForAdonis = fn_runLower()

	local function fn_runMatch(child)
		if not child then
			return false
		end

		if not child:IsA("RemoteEvent") and not child:IsA("RemoteFunction") then
			return false
		end

		if child.Name:match("^[%x][%x][%x][%x][%x][%x][%x][%x]%-[%x][%x][%x][%x]%-[%x][%x][%x][%x]%-[%x][%x][%x][%x]%-[%x][%x][%x][%x][%x][%x][%x][%x][%x][%x][%x][%x]$") then
			return child:FindFirstChild("__FUNCTION") ~= nil
		end

		return false
	end
	local function fn_runMatch2(child)
		if not child or not child:IsA("ScreenGui") then
			return false
		end

		if not child.Name:match("^[%x][%x][%x][%x][%x][%x][%x][%x]%-") then
			return false
		end

		local OriginalReference = child:FindFirstChild("OriginalReference")

		if OriginalReference and OriginalReference:IsA("ObjectValue") and OriginalReference.Value then
			local fullName = OriginalReference.Value:GetFullName()

			if fullName:match("Client%.UI%.") or fullName:match("Adonis") then
				return true
			end
		end

		local Entry = child:FindFirstChild("Entry")

		if Entry and Entry:IsA("TextButton") then
			if (Entry.Text or ""):match("^:") then
				return true
			end
		end

		return false
	end
	local function fn_handleRemote()
		for _, v in ipairs({
			ReplicatedStorage,
			workspace
		}) do
			for _, child in ipairs(v:GetChildren()) do
				if fn_runMatch(child) then
					return "remote", child
				end
			end
		end

		local PlayerGui = LocalPlayer2:FindFirstChild("PlayerGui")

		if PlayerGui then
			for _, child in ipairs(PlayerGui:GetChildren()) do
				if fn_runMatch2(child) then
					return "panel", child
				end
			end
		end

		return nil
	end
