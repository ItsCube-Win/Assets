		Unlock = function(self)
			if self.Unlocked then
				return true
			end

			self.Unlocked = true
			EmoteWheel.Init()

			return true
		end
	}
end
moduleDefs["Modules.Interactions.AttachmentRuntime"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local VIPProtectionService = requireModule("Services.VIPProtectionService")
	local activeAnimationCache = {
		Active = {},
		AnimationCache = {},
		NoDelay = false,
		OnAutoStop = nil
	}
	local sethiddenproperty_ = sethiddenproperty
	local applyNoDelayFlag = type_(sethiddenproperty_) == "function" and typeof(InstanceHandle) == "table"

	activeAnimationCache.ApplyNoDelay = function(humanoidRootPart2, humanoidRootPart)
		if not applyNoDelayFlag then
			return
		end

		local Parent = humanoidRootPart2.Parent

		if Parent then
			for _, descendant in ipairs(Parent:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant.CanCollide = false
				end
			end
		end

		pcall(sethiddenproperty_, humanoidRootPart2, "PhysicsRepRootPart", humanoidRootPart)
		pcall(sethiddenproperty_, humanoidRootPart2, "PhysicsRepRootRef", InstanceHandle.new(humanoidRootPart))
	end
	activeAnimationCache.ClearNoDelay = function(humanoidRootPart)
		if not applyNoDelayFlag or not humanoidRootPart then
			return
		end

		pcall(sethiddenproperty_, humanoidRootPart, "PhysicsRepRootPart", humanoidRootPart)
		pcall(sethiddenproperty_, humanoidRootPart, "PhysicsRepRootRef", InstanceHandle.new(humanoidRootPart))
	end

	local function fn_handleHumanoid()
		local Character = LocalPlayer.Character

		return Character and Character:FindFirstChildOfClass("Humanoid")
	end
	local function fn_applySitPlatformStand()
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if HumanoidRootPart then
			activeAnimationCache.ClearNoDelay(HumanoidRootPart)

			for _, child in ipairs(HumanoidRootPart:GetChildren()) do
				if child.Name:sub(1, 5) == "Troll" then
					child:Destroy()
				end
			end
		end

		if Humanoid then
			Humanoid.Sit = false
			Humanoid.PlatformStand = false

			for _, v in ipairs(Humanoid:GetPlayingAnimationTracks()) do
				local Priority = v.Priority

				if Priority == Enum.AnimationPriority.Action or Priority == Enum.AnimationPriority.Action2 or Priority == Enum.AnimationPriority.Action3 or Priority == Enum.AnimationPriority.Action4 then
					v:Stop()
				end
			end
		end
	end

	activeAnimationCache.ResolveAnimationId = function(self, animationId)
		local match = tostring(animationId or ""):match("%d+")

		if not match then
			return animationId
		end

		if self.AnimationCache[match] then
			return self.AnimationCache[match]
		end

		local ok, result = pcall(function()
			return game_:GetObjects("rbxassetid://" .. match)
		end)

		if ok and result and result[1] then
			local AnimationId

			local function fn_handleAnimation(child2)
				if child2:IsA("Animation") then
					AnimationId = child2.AnimationId

					return
				end

				for _, child in ipairs(child2:GetChildren()) do
					fn_handleAnimation(child)

					if AnimationId then
						return
					end
				end
			end

			for _, v in ipairs(result) do
				fn_handleAnimation(v)

				if AnimationId then
					break
				end
			end

			if AnimationId then
				self.AnimationCache[match] = AnimationId

				return AnimationId
			end
		end

		local text = "rbxassetid://" .. match

		self.AnimationCache[match] = text

		return text
	end
	activeAnimationCache.PlayLoopedAnimation = function(self, animationId, timePosition, priority, once, speed, direct)
		local fn_handleHumanoidResult = fn_handleHumanoid()

		if not fn_handleHumanoidResult or not animationId then
			return nil
		end

		local Animation = Instance.new("Animation")

		if direct then
			local match = tostring(animationId):match("%d+")

			Animation.AnimationId = match and "rbxassetid://" .. match or animationId
		else
			Animation.AnimationId = self:ResolveAnimationId(animationId)
		end

		local Animator = fn_handleHumanoidResult:FindFirstChildOfClass("Animator")

		if not Animator then
			Animator = Instance.new("Animator")
			Animator.Parent = fn_handleHumanoidResult
		end

		local animationTrack = Animator:LoadAnimation(Animation)

		animationTrack.Priority = priority or Enum.AnimationPriority.Action

		if once then
			animationTrack.Looped = false
			animationTrack:Play()
		elseif timePosition then
			animationTrack.Looped = false
			animationTrack:Play()
			animationTrack.TimePosition = timePosition
			animationTrack:AdjustSpeed(0)
		else
			animationTrack.Looped = true
			animationTrack:Play()
		end

		if speed and not timePosition then
			animationTrack:AdjustSpeed(speed)
		end

		return animationTrack
	end
	activeAnimationCache.IsActive = function(self, active)
		return self.Active[active] ~= nil
	end
	activeAnimationCache.Stop = function(self, active)
		local activeEntry = self.Active[active]

		if not activeEntry then
			return false
		end

		self.Active[active] = nil
		fn_applySitPlatformStand()

		if activeEntry.Track then
			pcall(function()
				activeEntry.Track:Stop()
			end)
		end

		if activeEntry.Config and activeEntry.Config.OnStop then
			pcall(activeEntry.Config.OnStop, activeEntry)
		end

		if self.OnStateChange then
			pcall(self.OnStateChange, active, false)
		end

		return false
	end
	activeAnimationCache.Toggle = function(self, active, humanoid, callback)
		if self:IsActive(active) then
			return self:Stop(active)
		end

		local callbackResult = callback and callback() or nil

		if callbackResult and VIPProtectionService:IsProtectedFrom(callbackResult, active) then
			VIPProtectionService:NotifyBlocked(active, callbackResult)

			return false
		end

		for k in pairs(self.Active) do
			if k ~= active then
				self:Stop(k)
			end
		end

		fn_applySitPlatformStand()

		local configTrackConfig = {
			Config = humanoid
		}

		configTrackConfig.Track = humanoid.AnimationId and self:PlayLoopedAnimation(humanoid.AnimationId, humanoid.TimePosition, humanoid.Priority, humanoid.Once, humanoid.Speed, humanoid.Direct) or nil
		configTrackConfig.TargetUserId = callbackResult and callbackResult.UserId or nil
		self.Active[active] = configTrackConfig

		if self.OnStateChange then
			pcall(self.OnStateChange, active, true)
		end

		if humanoid.Once and configTrackConfig.Track then
			configTrackConfig.Track.Stopped:Once(function()
				if self.Active[active] ~= configTrackConfig then
					return
				end

				self:Stop(active)

				if self.OnAutoStop then
					pcall(self.OnAutoStop, active)
				end
			end)
		end

		task.spawn(function()
			local Attachment
			local Attachment2
			local AlignPosition
			local AlignOrientation
			local now = os.clock()

			local function fn_runToObjectSpace(humanoidRootPart2, humanoidRootPart)
				if humanoid.Place and humanoidRootPart2 and humanoidRootPart then
					local ok, result = pcall(humanoid.Place, humanoidRootPart2.Parent, humanoidRootPart.Parent, os.clock() - now)

					if ok and result then
						return humanoidRootPart.CFrame:ToObjectSpace(result)
					end
				end

				return humanoid.Offset or CFrame.new()
			end

			while self.Active[active] == configTrackConfig do
				local callbackResult2 = callback and callback() or nil

				if configTrackConfig.TargetUserId and callbackResult2 and callbackResult2.UserId ~= configTrackConfig.TargetUserId then
					self:Stop(active)

					break
				end

				if callbackResult2 and VIPProtectionService:IsProtectedFrom(callbackResult2, active) then
					VIPProtectionService:NotifyBlocked(active, callbackResult2)
					self:Stop(active)

					break
				end

				local Character = callbackResult2 and callbackResult2.Character
				local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
				local Character2 = LocalPlayer.Character
				local HumanoidRootPart2 = Character2 and Character2:FindFirstChild("HumanoidRootPart")
				local Humanoid = Character2 and Character2:FindFirstChildOfClass("Humanoid")

				if not HumanoidRootPart or not HumanoidRootPart2 then
					self:Stop(active)

					break
				end

				if not AlignPosition or not AlignPosition.Parent then
					for _, child in ipairs(HumanoidRootPart2:GetChildren()) do
						if child.Name:sub(1, 5) == "Troll" then
							child:Destroy()
						end
					end

					for _, child in ipairs(HumanoidRootPart:GetChildren()) do
						if child.Name == "TrollAtt1" then
							child:Destroy()
						end
					end

					Attachment = Instance.new("Attachment")
					Attachment.Name = "TrollAtt0"
					Attachment.Parent = HumanoidRootPart2
					Attachment2 = Instance.new("Attachment")
					Attachment2.Name = "TrollAtt1"
					Attachment2.CFrame = fn_runToObjectSpace(HumanoidRootPart2, HumanoidRootPart)
					Attachment2.Parent = HumanoidRootPart
					AlignPosition = Instance.new("AlignPosition")
					AlignPosition.Name = "TrollAlignPos"
					AlignPosition.Attachment0 = Attachment
					AlignPosition.Attachment1 = Attachment2
					AlignPosition.MaxForce = math.huge
					AlignPosition.MaxVelocity = math.huge
					AlignPosition.Responsiveness = 200
					AlignPosition.Parent = HumanoidRootPart2
					AlignOrientation = Instance.new("AlignOrientation")
					AlignOrientation.Name = "TrollAlignOri"
					AlignOrientation.Attachment0 = Attachment
					AlignOrientation.Attachment1 = Attachment2
					AlignOrientation.MaxTorque = math.huge
					AlignOrientation.Responsiveness = 200
					AlignOrientation.Parent = HumanoidRootPart2
				end

				if humanoid.Sit and Humanoid then
					Humanoid.Sit = true
				end

				if humanoid.PlatformStand and Humanoid then
					Humanoid.PlatformStand = true
				end

				local fn_runToObjectSpaceResult = fn_runToObjectSpace(HumanoidRootPart2, HumanoidRootPart)

				if humanoid.Place then
					Attachment2.CFrame = fn_runToObjectSpaceResult
				end

				HumanoidRootPart2.CFrame = HumanoidRootPart.CFrame * fn_runToObjectSpaceResult

				if humanoid.Step then
					pcall(humanoid.Step, Character2, Character, configTrackConfig)
				end

				if humanoid.SpectateTarget then
					local CurrentCamera = workspace.CurrentCamera
					local Humanoid2 = HumanoidRootPart.Parent:FindFirstChildOfClass("Humanoid")

					if Humanoid2 and CurrentCamera.CameraSubject ~= Humanoid2 then
						CurrentCamera.CameraSubject = Humanoid2
					end

					if CurrentCamera.CameraType ~= Enum.CameraType.Follow then
						CurrentCamera.CameraType = Enum.CameraType.Follow
					end
				end

				if humanoid.Camera then
					local ok, cFrame = pcall(humanoid.Camera, HumanoidRootPart, os.clock() - now)

					if ok and cFrame then
						local CurrentCamera = workspace.CurrentCamera

						CurrentCamera.CameraType = Enum.CameraType.Scriptable
						CurrentCamera.CFrame = cFrame
					end
				end

				HumanoidRootPart2.AssemblyLinearVelocity = HumanoidRootPart.AssemblyLinearVelocity
				HumanoidRootPart2.AssemblyAngularVelocity = Vector3.zero

				if self.NoDelay then
					self.ApplyNoDelay(HumanoidRootPart2, HumanoidRootPart)
					RunService.Heartbeat:Wait()
				else
					if configTrackConfig.NoDelayOn then
						self.ClearNoDelay(HumanoidRootPart2)
					end

					RunService.Stepped:Wait()
				end

				configTrackConfig.NoDelayOn = self.NoDelay
			end

			if humanoid.Camera or humanoid.SpectateTarget then
				pcall(function()
					local CurrentCamera = workspace.CurrentCamera

					CurrentCamera.CameraType = Enum.CameraType.Custom

					local fn_handleHumanoidResult = fn_handleHumanoid()

					if fn_handleHumanoidResult then
						CurrentCamera.CameraSubject = fn_handleHumanoidResult
					end
				end)
			end

			pcall(function()
				if Attachment then
					Attachment:Destroy()
				end

				if Attachment2 then
					Attachment2:Destroy()
				end

				if AlignPosition then
					AlignPosition:Destroy()
				end

				if AlignOrientation then
					AlignOrientation:Destroy()
				end
			end)
		end)

		return true
	end

	return activeAnimationCache
end
