moduleDefs["Modules.Interactions.Love"] = function()
	local AttachmentRuntime = requireModule("Modules.Interactions.AttachmentRuntime")

	local function getUpperTorso(instance)
		return instance:FindFirstChild("UpperTorso") or instance:FindFirstChild("Torso")
	end
	local function fn_handleHumanoid(instance, humanoidRootPart)
		local Humanoid = instance:FindFirstChildOfClass("Humanoid")
		local HipHeight = Humanoid and Humanoid.HipHeight or 2

		if Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R6 then
			HipHeight = 2
		end

		return humanoidRootPart.Size.Y / 2 + HipHeight
	end
	local function fn_runPointToObjectSpace(character, character2)
		local HumanoidRootPart = character.HumanoidRootPart
		local HumanoidRootPart2 = character2.HumanoidRootPart
		local upperTorso = getUpperTorso(character)
		local upperTorso2 = getUpperTorso(character2)

		if not upperTorso or not upperTorso2 then
			return HumanoidRootPart2.CFrame * CFrame.new(0, 0, 1.07)
		end

		local pointToObjectSpaceResult = HumanoidRootPart2.CFrame:PointToObjectSpace(upperTorso2.Position)
		local value = pointToObjectSpaceResult.Z + (upperTorso2.Size.Z + upperTorso.Size.Z) / 2 - 0.15 - HumanoidRootPart.CFrame:PointToObjectSpace(upperTorso.Position).Z

		return HumanoidRootPart2.CFrame * CFrame.new(pointToObjectSpaceResult.X, fn_handleHumanoid(character, HumanoidRootPart) - fn_handleHumanoid(character2, HumanoidRootPart2), value)
	end
	local function getFindFirstChildResult(instance, arg2)
		return instance:FindFirstChild(arg2 .. "UpperArm") or instance:FindFirstChild(arg2 .. " Arm")
	end
	local function fn_handleHumanoid2(instance, humanoidRootPart)
		local Humanoid = instance:FindFirstChildOfClass("Humanoid")
		local HipHeight = Humanoid and Humanoid.HipHeight or 2

		if Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R6 then
			HipHeight = 2
		end

		return humanoidRootPart.Size.Y / 2 + HipHeight
	end
	local function fn_runPointToObjectSpace2(character, character2)
		local HumanoidRootPart = character.HumanoidRootPart
		local HumanoidRootPart2 = character2.HumanoidRootPart
		local right = getFindFirstChildResult(character2, "Right")
		local left = getFindFirstChildResult(character, "Left")
		local amount = 2.5

		if right and left then
			amount = HumanoidRootPart2.CFrame:PointToObjectSpace(right.Position).X + (right.Size.X + left.Size.X) / 2 + 0.1 - HumanoidRootPart.CFrame:PointToObjectSpace(left.Position).X
		end

		return HumanoidRootPart2.CFrame * CFrame.new(amount, fn_handleHumanoid2(character, HumanoidRootPart) - fn_handleHumanoid2(character2, HumanoidRootPart2), 0)
	end
	local function fn_handleAnimate(instance)
		local Animate = instance:FindFirstChild("Animate")
		local walk = Animate and Animate:FindFirstChild("walk")
		local Animation = walk and walk:FindFirstChildOfClass("Animation")

		return Animation and Animation.AnimationId or "rbxassetid://507777826"
	end

	local toggleObj

	toggleObj = {
		Configs = {
			Hug = {
				AnimationId = "106015468107052",
				Priority = Enum.AnimationPriority.Action4,
				Offset = CFrame.new(0, 0, -1.37) * CFrame.Angles(0, 3.1415926535897931, 0),
				PlatformStand = true
			},
			["Back Hug"] = {
				AnimationId = "135666457483077",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_runPointToObjectSpace,
				PlatformStand = true
			},
			Kiss = {
				AnimationId = "134766680518078",
				Priority = Enum.AnimationPriority.Action4,
				Offset = CFrame.new(0, 0, -1.52) * CFrame.Angles(0, 3.1415926535897931, 0),
				PlatformStand = true
			},
			["Hold Hands"] = {
				Place = fn_runPointToObjectSpace2,
				Step = function(fn_applyPocketedResult, character, obj)
					local Humanoid = fn_applyPocketedResult:FindFirstChildOfClass("Humanoid")
					local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

					if not Animator then
						return
					end

					local AssemblyLinearVelocity = character.HumanoidRootPart.AssemblyLinearVelocity
					local Magnitude = Vector3.new(AssemblyLinearVelocity.X, 0, AssemblyLinearVelocity.Z).Magnitude

					if not obj.Walk then
						local Animation = Instance.new("Animation")

						Animation.AnimationId = fn_handleAnimate(fn_applyPocketedResult)
						obj.Walk = Animator:LoadAnimation(Animation)
						obj.Walk.Priority = Enum.AnimationPriority.Movement
						obj.Walk.Looped = true
					end

					if Magnitude > 1 then
						if not obj.Walk.IsPlaying then
							obj.Walk:Play(0.15)
						end

						obj.Walk:AdjustSpeed(Magnitude / 16)
					elseif obj.Walk.IsPlaying then
						obj.Walk:Stop(0.2)
					end
				end,
				OnStop = function(obj)
					if obj.Walk then
						obj.Walk:Stop(0.2)
					end
				end
			},
			["Quick Kiss"] = {
				AnimationId = "134766680518078",
				Priority = Enum.AnimationPriority.Action4,
				Offset = CFrame.new(0, 0, -1.52) * CFrame.Angles(0, 3.1415926535897931, 0),
				PlatformStand = true,
				Once = true
			},
			["Quick Hug"] = {
				AnimationId = "105695191147981",
				Priority = Enum.AnimationPriority.Action4,
				Offset = CFrame.new(0, 0, -1.52) * CFrame.Angles(0, 3.1415926535897931, 0),
				PlatformStand = true,
				Once = true
			}
		},
		Toggle = function(self, self2)
			local configEntry = toggleObj.Configs[self]

			if not configEntry then
				return false
			end

			configEntry.Direct = true

			return AttachmentRuntime:Toggle(self, configEntry, self2)
		end
	}
	toggleObj.IsActive = function(self)
		return AttachmentRuntime:IsActive(self)
	end

	return toggleObj
end
moduleDefs["Modules.Interactions.Nsfw"] = function()
	local AttachmentRuntime = requireModule("Modules.Interactions.AttachmentRuntime")
	local cFrame = CFrame.Angles(0, 3.1415926535897931, 0)

	local function getLowerTorso(instance)
