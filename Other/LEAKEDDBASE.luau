				return
			end

			local updateEntryFlag2, updateEntryAmount2, updateEntryAmount3, updateEntryAmount4, updateEntryAmount5, v4793 = fn_runWorldToViewportPoint(currentCamera, part, updateEntryObj3, ensureEntryResult._boxHW, ensureEntryResult._boxHH, ensureEntryResult._boxOffY)

			if not updateEntryFlag2 then
				fn_applyVisible(ensureEntryResult)

				return
			end

			local updateEntryAmount = updateEntryAmount3 - updateEntryFlag2
			local updateEntryAmount6 = updateEntryAmount4 - updateEntryAmount2
			local updateEntryValue = (updateEntryFlag2 + updateEntryAmount3) * 0.5

			if ShowBox then
				local BoxColor = State.BoxColor
				local updateEntryAmount7 = updateEntryAmount * 0.25
				local updateEntryAmount8 = updateEntryAmount6 * 0.25
				local vector2 = Vector2.new(updateEntryFlag2, updateEntryAmount2)
				local vector22 = Vector2.new(updateEntryAmount3, updateEntryAmount2)
