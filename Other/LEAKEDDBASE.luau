			ImageLabel.Parent = TextButton

			local ok, result = pcall(function()
				return game_:GetService("TextService"):GetTextSize(text, 100, Enum.Font.FredokaOne, Vector2.new(100000, 100))
			end)

			if ok and result and result.X > 0 then
				createBillboardGuiAmount = result.X / 100
			end
		end

		local tbl = {
			"!",
			"@",
			"#",
			"$",
			"%",
			"&",
			"*",
			"?",
			"/",
			"|",
			"~"
		}
		local createBillboardGuiAmount2 = 0
		local createBillboardGuiAmount3 = 0
		local createBillboardGuiAmount4 = 1

		if not mode or mode == "" then
			mode = "none"
		end

		if mode == "neon" then
			local colorSequence

			if #createBillboardGuiList >= 3 then
				colorSequence = ColorSequence.new({
					ColorSequenceKeypoint.new(0, createBillboardGuiList[1]),
					ColorSequenceKeypoint.new(0.5, createBillboardGuiList[2]),
					ColorSequenceKeypoint.new(1, createBillboardGuiList[3])
				})
			elseif #createBillboardGuiList >= 2 then
				colorSequence = ColorSequence.new({
					ColorSequenceKeypoint.new(0, createBillboardGuiList[1]),
					ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(1, createBillboardGuiList[2])
				})
			end

			if colorSequence then
				UIGradient.Color = colorSequence
			end
		end

		local createBillboardGuiAmount5 = 0
		local connection

		connection = RunService.RenderStepped:Connect(function(l)
			if not BillboardGui or not BillboardGui.Parent then
				if connection then
					connection:Disconnect()
				end

				return
			end

			if ImageLabel and ImageLabel.Parent then
				local l, I = BillboardGui.AbsoluteSize.X, BillboardGui.AbsoluteSize.Y

				if I > 0 then
					local M = tick()
					local n = 0.86 + 0.14 * (math.sin(M * 3) + 1) / 2
					local k = I * 0.92 * n

					ImageLabel.Size = UDim2.fromOffset(k, k)

					local n = math.min(createBillboardGuiAmount * I, l)

					ImageLabel.Position = UDim2.fromOffset((l - n) / 2 - k * 0.10, I / 2)

					local l = createBillboardGuiList[1] or Color3.new(1, 1, 1)
					local p = createBillboardGuiList[2] or l

					ImageLabel.ImageColor3 = l:Lerp(p, (math.sin(M * 2) + 1) / 2)
				end
			end

			if mode == "none" then
				return
			end

			if not UIGradient or not UIGradient.Parent then
