								end

								fn_applyStatus(("Collected %d souls this session"):format(self.Collected))
							else
								fn_applyCanCollide(false)
								fn_applyStatus(("Waiting for souls to respawn... (%d collected)"):format(self.Collected))
								task.wait(1)
							end
						else
							fn_applyCanCollide(false)
							fn_applyStatus("Waiting for character...")
							task.wait(1)
						end
					else
						fn_applyCanCollide(false)
						fn_applyStatus("Halloween event not active")
						task.wait(5)
					end
				end

				fn_applyCanCollide(false)
				fn_applyStatus("Idle")
			end)

			return
		end

		fn_applyCanCollide(false)

		local fnhandleHumanoid = fn_handleHumanoidRootPart()

		if fnhandleHumanoid then
			fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
		end

		fn_applyStatus("Idle")
	end
	onStatusChangedState.SetOption = function(self, arg2, arg3)
		if self.Config[arg2] ~= nil then
			self.Config[arg2] = arg3
		end
	end
	onStatusChangedState.Stop = function(self)
		self:SetEnabled(false)

		if connection then
			connection:Disconnect()
			connection = nil
		end
	end

	return onStatusChangedState
end
