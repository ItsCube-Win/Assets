			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Humanoid and Humanoid.RootPart
			local _, humanoid, part, part2, v4844 = fn_handleHumanoid(player)

			if not Character or not Humanoid or not RootPart then
				return
			end

			if not humanoid and not part and not part2 and not flingPlayerFlag5 then
				return
			end

			local CFrame_ = RootPart.CFrame
			local FallenPartsDestroyHeight = Workspace.FallenPartsDestroyHeight

			Workspace.FallenPartsDestroyHeight = (0/0)

			local BodyVelocity = Instance.new("BodyVelocity")

			BodyVelocity.Name = "LowHubFlingVelocity"
			BodyVelocity.Parent = RootPart
			BodyVelocity.Velocity = Vector3.new(900000000, 900000000, 900000000)
			BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

			local function fn_applyCFrameVelocity(part3, cframe, cframe2)
				RootPart.CFrame = CFrame.new(part3.Position) * cframe * cframe2
				Character:SetPrimaryPartCFrame(CFrame.new(part3.Position) * cframe * cframe2)
				RootPart.Velocity = Vector3.new(90000000, 900000000, 90000000)
				RootPart.RotVelocity = Vector3.new(900000000, 900000000, 900000000)
			end
			local function fn_unnamed(part2_2)
				local flingPlayerAmount = tick() + 2
				local flingPlayerAmount2 = 0

				while RootPart and humanoid do
					if part2_2.Velocity.Magnitude < 50 then
						flingPlayerAmount2 += 100

						local cFrame = CFrame.Angles

						fn_applyCFrameVelocity(part2_2, CFrame.new(0, 1.5, 0), cFrame(math.rad(flingPlayerAmount2), 0, 0))
						task.wait()

						local cFrame2 = CFrame.Angles

						fn_applyCFrameVelocity(part2_2, CFrame.new(0, -1.5, 0), cFrame2(math.rad(flingPlayerAmount2), 0, 0))
						task.wait()

						local cFrame3 = CFrame.Angles

						fn_applyCFrameVelocity(part2_2, CFrame.new(2.25, 1.5, -2.25), cFrame3(math.rad(flingPlayerAmount2), 0, 0))
						task.wait()

						local cFrame4 = CFrame.Angles

						fn_applyCFrameVelocity(part2_2, CFrame.new(-2.25, -1.5, 2.25), cFrame4(math.rad(flingPlayerAmount2), 0, 0))
						task.wait()
					else
						fn_applyCFrameVelocity(part2_2, CFrame.new(0, 1.5, humanoid.WalkSpeed), CFrame.Angles(1.5707963267948966, 0, 0))
						task.wait()
						fn_applyCFrameVelocity(part2_2, CFrame.new(0, -1.5, -humanoid.WalkSpeed), CFrame.new())
						task.wait()
					end

					if part2_2.Velocity.Magnitude > 500 or part2_2.Parent ~= player.Character or player.Parent ~= Players or humanoid.Sit or Humanoid.Health <= 0 or flingPlayerAmount < tick() then
						break
					end
				end
			end

			if part and part2 then
				if (part.Position - part2.Position).Magnitude > 5 then
					fn_unnamed(part2)
				else
					fn_unnamed(part)
				end
			elseif part then
				fn_unnamed(part)
			elseif part2 then
				fn_unnamed(part2)
			elseif flingPlayerFlag5 then
				fn_unnamed(flingPlayerFlag5)
			end

			BodyVelocity:Destroy()
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
			Workspace.CurrentCamera.CameraSubject = Humanoid

			if flag then
				repeat
					RootPart.CFrame = CFrame_ * CFrame.new(0, 0.5, 0)
					Character:SetPrimaryPartCFrame(CFrame_ * CFrame.new(0, 0.5, 0))
					Humanoid:ChangeState("GettingUp")

					for _, child in ipairs(Character:GetChildren()) do
						if child:IsA("BasePart") then
							child.Velocity = Vector3.zero
							child.RotVelocity = Vector3.zero
						end
					end

					task.wait()
				until (RootPart.Position - CFrame_.Position).Magnitude < 15
			end

			Workspace.FallenPartsDestroyHeight = FallenPartsDestroyHeight
		end,
		ToggleFlingAll = function(self)
			self.State.FlingAll = not self.State.FlingAll

			if self.State.FlingAll then
				local toggleFlingAllAmount = 0

				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= LocalPlayer and VIPProtectionService:IsProtectedFrom(player, "FlingAll") then
						toggleFlingAllAmount += 1
					end
				end

				if toggleFlingAllAmount > 0 then
					VIPProtectionService:NotifyBlocked("FlingAll", nil, {
						Scope = "global",
						Message = toggleFlingAllAmount == 1 and "Fling All skipped 1 protected VIP target." or string.format("Fling All skipped %d protected VIP targets.", toggleFlingAllAmount)
					})
				end

				task.spawn(function()
					local pivot = LocalPlayer.Character and LocalPlayer.Character:GetPivot()
					local FallenPartsDestroyHeight = Workspace.FallenPartsDestroyHeight

					Workspace.FallenPartsDestroyHeight = (0/0)

					while self.State.FlingAll do
						local toggleFlingAllFlag = false
						for _, player in ipairs(Players:GetPlayers()) do
							if not self.State.FlingAll then
								break
							end

							if player ~= LocalPlayer and not VIPProtectionService:IsProtectedFrom(player, "FlingAll") and player.Character then
								if player.Character:FindFirstChild("HumanoidRootPart") then
									toggleFlingAllFlag = true
									self:FlingPlayer(player, false)
								end
							end
						end

						if not toggleFlingAllFlag then
							task.wait(1)
						end

						task.wait()
					end

					Workspace.FallenPartsDestroyHeight = FallenPartsDestroyHeight

					if LocalPlayer.Character and pivot then
						LocalPlayer.Character:PivotTo(pivot)

						for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
							if v:IsA("BasePart") then
								v.Velocity = Vector3.zero
								v.RotVelocity = Vector3.zero
							end
						end
					end
				end)
			end

			return self.State.FlingAll
		end,
		IsFlingAllActive = function(self)
			return self.State.FlingAll
		end
	}
end
