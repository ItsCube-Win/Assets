			if type_(desired) ~= "table" then
				return
			end

			for k, v in pairs(desired) do
				local applyConfigObj = self.LocalDefinitions[k] or self.Definitions[k]
				local DesiredStates = self.DesiredStates
				local applyConfigFlag = v == true

				if applyConfigFlag then
					applyConfigFlag = not (applyConfigObj and applyConfigObj.ManualOnly)
				end

				DesiredStates[k] = applyConfigFlag
			end

			self:ReconcileAll(false)
		end
	}
end
moduleDefs["Services.VIPProtectionService"] = function()
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local bangHeadsitConfig = {
		Bang = true,
		Headsit = true,
		Stand = true,
		Backpack = true,
		Hug = true,
		["Back Hug"] = true,
		["Quick Kiss"] = true,
		["Quick Hug"] = true,
		["Hold Hands"] = true,
		Kiss = true,
		Piggyback = true,
		["Piggyback 2"] = true,
		["Carry High"] = true,
		["Shoulder Sit"] = true,
		["Sit on Head"] = true,
		Headstand = true,
		Orbit = true,
		Spin = true,
		Ghost = true,
		["Block View"] = true,
		Slap = true,
		Backshots = true,
		Licking = true,
		["Suck It"] = true,
		["Face Fuck"] = true,
		["Doggy+"] = true,
		Lay = true,
		Spread = true,
		Spectate = true,
		FlingTarget = true,
		FlingAll = true,
		ESP = true
	}
	local bangHeadsitConfig2 = {
		Bang = "Bang",
		Headsit = "Headsit",
		Stand = "Stand",
		Backpack = "Backpack",
		Spectate = "Spectate",
		FlingTarget = "Fling OP",
		FlingAll = "Fling All",
		ESP = "ESP"
	}

	local function fn_handleInstance(player)
		if typeof(player) == "Instance" and player:IsA("Player") then
			return player.UserId
		end

		if type_(player) == "number" then
			return player
		end

		if type_(player) == "string" then
			return tonumber(player)
		end

		return nil
	end

	return {
		FeatureId = "sanctum_shield",
		Enabled = false,
		ProtectedUsers = {},
		Notifier = nil,
		NotifyCooldown = 1.35,
		NotifyCache = {},
		GetDefinition = function(self)
			return {
				Id = self.FeatureId,
				Title = "Sanctum Shield",
				Description = "Blocks hub interactions and ESP against protected VIP users.",
				Tier = "VIP",
				Runtime = self
			}
		end,
		SetEnabled = function(self, enabled)
			self.Enabled = enabled == true
			self.ProtectedUsers[LocalPlayer.UserId] = self.Enabled or nil
		end,
		SetNotifier = function(self, notifier)
			self.Notifier = notifier
		end,
		GetActionLabel = function(self, active)
			local getActionLabelFlag = bangHeadsitConfig2[active]

			if not getActionLabelFlag then
				getActionLabelFlag = tostring(active or "Action")
			end

			return getActionLabelFlag
		end,
		NotifyBlocked = function(self, active, self2, obj)
			if type_(self.Notifier) ~= "function" then
				return
			end

			local fn_handleInstanceResult = fn_handleInstance(self2)
			local Scope = obj and obj.Scope or "target"
			local text = string.format("%s:%s", tostring(active), fn_handleInstanceResult or Scope)
			local now = os.clock()

			if now < (self.NotifyCache[text] or 0) + self.NotifyCooldown then
				return
			end

			self.NotifyCache[text] = now

			local DisplayName

			if typeof(self2) == "Instance" and self2:IsA("Player") then
				DisplayName = self2.DisplayName
			elseif type_(self2) == "string" and self2 ~= "" then
				DisplayName = self2
			end

			local actionLabel = self:GetActionLabel(active)
			local Message

			if obj and obj.Message then
				Message = obj.Message
			elseif DisplayName then
				Message = string.format("%s unavailable against %s.", actionLabel, DisplayName)
			else
				Message = string.format("%s skipped protected VIP targets.", actionLabel)
			end

			self.Notifier({
				Action = actionLabel,
				Target = DisplayName,
				Message = Message,
				Feature = self.FeatureId
			})
		end,
		IsProtectedFrom = function(self, player, active)
			if not bangHeadsitConfig[active] then
				return false
			end

			if type_(self.Bypass) == "function" then
				local ok, result = pcall(self.Bypass)

				if ok and result then
					return false
				end
			end

			local fn_handleInstanceResult = fn_handleInstance(player)

			if fn_handleInstanceResult then
				return self.ProtectedUsers[fn_handleInstanceResult] == true
			end

			return false
		end,
		ApplyFeatureState = function(self, userId, featureId, flag)
			local fn_handleInstanceResult = fn_handleInstance(userId)

			if not fn_handleInstanceResult or featureId ~= self.FeatureId then
				return
			end

			self.ProtectedUsers[fn_handleInstanceResult] = flag == true or nil
		end,
		ApplySnapshot = function(self, users)
			if type_(users) ~= "table" then
				return
			end

			local protectedUsers = {}

			for k, v in pairs(users) do
				local fn_handleInstanceResult = fn_handleInstance(k)

				if fn_handleInstanceResult then
					if type_(v) == "table" then
						if v[self.FeatureId] == true or v.active == true then
							protectedUsers[fn_handleInstanceResult] = true
						end
					elseif v == true then
						protectedUsers[fn_handleInstanceResult] = true
					end
				end
			end

			if self.Enabled then
				protectedUsers[LocalPlayer.UserId] = true
			end

			self.ProtectedUsers = protectedUsers
		end,
		Init = function(self, signalService)
			if self._initialized then
				return
			end

			self._initialized = true
			signalService:OnMessage("vip_feature_state", function(obj)
				self:ApplyFeatureState(obj.userId or obj.targetUserId or obj.id, obj.featureId, obj.active == true)
			end)
			signalService:OnMessage("vip_feature_update", function(obj)
				self:ApplyFeatureState(obj.userId or obj.targetUserId or obj.id, obj.featureId, obj.active == true)
			end)
			signalService:OnMessage("vip_feature_snapshot", function(obj)
				self:ApplySnapshot(obj.users or obj.data or obj.states)
			end)
		end
	}
end
