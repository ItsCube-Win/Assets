	SayClass._equip = function(self, weaponGun)
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not weaponGun or not Humanoid then
			return false
		end

		if weaponGun.Parent ~= Character then
			Humanoid:EquipTool(weaponGun)

			local equipAmount = os.clock() + 1

			while weaponGun.Parent ~= Character and os.clock() < equipAmount do
				RunService.Heartbeat:Wait()
			end

			RunService.Heartbeat:Wait()
		end

		return weaponGun.Parent == Character
	end
	SayClass.GunReady = function(self)
