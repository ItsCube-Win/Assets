	end
	local function fn_unnamed2(instance, arg2)
		local ok, result = pcall(instance.GetChildren, instance)

		if not ok then
			return
		end

		for i = 1, #result do
			local resultEntry = result[i]

			if resultEntry.Name == arg2 then
				pcall(resultEntry.Destroy, resultEntry)
			end
		end
	end
	local function createLine(color, thickness, zIndex)
		local Line = Drawing.new("Line")

		Line.Color = color or Color3.fromRGB(155, 135, 215)
		Line.Thickness = thickness or 1.5
		Line.ZIndex = zIndex or 2
		Line.Visible = false

		return Line
	end
	local function createText(color, size)
		local Text = Drawing.new("Text")

		Text.Color = color or Color3.new(1, 1, 1)
		Text.Size = size or 13
		Text.Center = true
		Text.Outline = true
		Text.OutlineColor = Color3.new(0, 0, 0)
		Text.ZIndex = 3
		Text.Visible = false

		return Text
	end
	local function fn_handleHumanoidRootPart(instance)
		local HumanoidRootPart = instance:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return nil
		end

		local Position = HumanoidRootPart.Position
		local vector3
		local vector32

		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") then
				local Parent = descendant.Parent

				if not (Parent and (Parent:IsA("Accessory") or Parent:IsA("Tool"))) and (descendant.Position - Position).Magnitude < 9 then
					local Size = descendant.Size
					local CFrame_ = descendant.CFrame

					for i = -1, 1, 2 do
						for i2 = -1, 1, 2 do
							for i3 = -1, 1, 2 do
								local Position2 = (CFrame_ * CFrame.new(Size.X * 0.5 * i, Size.Y * 0.5 * i2, Size.Z * 0.5 * i3)).Position

								if vector3 then
									vector3 = Vector3.new(math.min(vector3.X, Position2.X), math.min(vector3.Y, Position2.Y), math.min(vector3.Z, Position2.Z))
									vector32 = Vector3.new(math.max(vector32.X, Position2.X), math.max(vector32.Y, Position2.Y), math.max(vector32.Z, Position2.Z))
								else
									vector3 = Position2
									vector32 = Position2
								end
							end
						end
					end
				end
			end
		end

		if not vector3 then
			return nil
		end

		local vector = vector32 - vector3

		if vector.X > 10 or vector.Y > 14 or vector.Z > 10 then
			return math.min(vector.X, 10) * 0.5, math.min(vector.Y, 14) * 0.5, 0
		end

		return vector.X * 0.5, vector.Y * 0.5, (vector3.Y + vector32.Y) * 0.5 - Position.Y
	end
	local function fn_runWorldToViewportPoint(camera, part, humanoid, boxHW, boxHH, boxOffY)
		local Position = part.Position

		if camera:WorldToViewportPoint(Position).Z <= 0 then
			return nil
		end

		local vector3 = Vector3.new(Position.X, Position.Y + boxOffY, Position.Z)
		local amount = camera.CFrame.RightVector * boxHW
		local vector32 = Vector3.new(vector3.X, vector3.Y + boxHH, vector3.Z)
		local vector33 = Vector3.new(vector3.X, vector3.Y - boxHH, vector3.Z)

		local function fn_runWorldToViewportPoint2(worldPosition)
			local screenPoint = camera:WorldToViewportPoint(worldPosition)

			return Vector2.new(screenPoint.X, screenPoint.Y)
		end

		local fnrunWorld = fn_runWorldToViewportPoint2(vector32 - amount)
		local fnrunWorld2 = fn_runWorldToViewportPoint2(vector32 + amount)
		local fnrunWorld3 = fn_runWorldToViewportPoint2(vector33 - amount)
		local fnrunWorld4 = fn_runWorldToViewportPoint2(vector33 + amount)
		local minValue = math.min(fnrunWorld.X, fnrunWorld3.X)
		local maxValue = math.max(fnrunWorld2.X, fnrunWorld4.X)
		local minValue2 = math.min(fnrunWorld.Y, fnrunWorld2.Y)
		local maxValue2 = math.max(fnrunWorld3.Y, fnrunWorld4.Y)

		if maxValue - minValue < 2 or maxValue2 - minValue2 < 2 then
			return nil
		end

		return minValue, minValue2, maxValue, maxValue2, humanoid.Health, humanoid.MaxHealth
	end
	local function fn_handleTool(instance, instance2)
		local Tool = instance2 and instance2:FindFirstChildOfClass("Tool")

		if Tool then
			return Tool.Name
		end

		local Backpack = instance and instance:FindFirstChildOfClass("Backpack")

		if Backpack then
			local Tool2 = Backpack:FindFirstChildOfClass("Tool")

			if Tool2 then
				return Tool2.Name
			end
		end
	end
	local function fn_applyVisible(obj)
