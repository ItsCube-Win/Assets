moduleDefs["Modules.VIP.FeatureCatalog"] = function()
	local function fn_runGsub(arg1)
		local text = tostring(arg1 or "")
		local text2 = text:gsub("[_%-%./]+", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")

		if text2 == "" then
			return "VIP Feature"
		end

		local function fn_runUpper(text3, text4)
			return text3:upper() .. text4:lower()
		end

		return text2:gsub("(%a)([%w']*)", fn_runUpper)
	end

	return {
		Normalize = function(featureDefinitions)
			local lookup = {}
			local registry = {}
			local normalizeActive = false

			local function fnhandleRemote(mode, gui)
				if not mode or mode == "" then
					return
				end

				if lookup[mode] == nil then
					table.insert(registry, mode)
				end

				lookup[mode] = {
					Id = mode,
					Title = gui and gui.Title or fn_runGsub(mode),
					Description = gui and gui.Description or "Remote premium command",
					Tier = gui and gui.Tier or "VIP",
					Visible = gui == nil or gui.Visible ~= false
				}
				normalizeActive = true
			end

			if type_(featureDefinitions) ~= "table" then
				return lookup, registry, normalizeActive
			end

			if #featureDefinitions > 0 then
				for _, v in ipairs(featureDefinitions) do
					if type_(v) == "string" then
						fnhandleRemote(v)
					elseif type_(v) == "table" then
						local id = v.id or v.key or v.name or v.featureId

						fnhandleRemote(id, {
							Title = v.title or v.label,
							Description = v.description,
							Tier = v.tier or v.plan,
							Visible = v.visible
						})
					end
				end
			else
				for k, v in pairs(featureDefinitions) do
					if type_(v) == "boolean" then
						if v == true then
							fnhandleRemote(tostring(k))
						end
					elseif type_(v) == "table" then
						fnhandleRemote(tostring(k), {
							Title = v.title or v.label,
							Description = v.description,
							Tier = v.tier or v.plan,
							Visible = v.visible
						})
					elseif type_(v) == "string" then
						fnhandleRemote(tostring(k), {
							Title = v
						})
					end
				end
			end

			return lookup, registry, normalizeActive
		end
	}
end
moduleDefs["Services.ConfigService"] = function()
	local HttpService = game_:GetService("HttpService")
	local activeProfileConfig = {
		activeProfile = "default",
		autoExecute = false,
		autoSave = true,
		permashowEnabled = true
	}
	local thread

	local function fn_handleFunction()
		return type_(writefile) == "function" and type_(readfile) == "function"
	end
	local function fn_unnamed(arg1)
		if not fn_handleFunction() then
			return
		end

		pcall(function()
			if not isfolder(arg1) then
				makefolder(arg1)
			end
		end)
	end
	local function fn_unnamed2(arg1)
		if not fn_handleFunction() then
			return nil
		end

		local ok, result = pcall(readfile, arg1)

		return ok and result or nil
	end
	local function fn_unnamed3(arg1, fn_runJSONEncodeResult)
		if not fn_handleFunction() then
			return
		end

		pcall(writefile, arg1, fn_runJSONEncodeResult)
	end
	local function fn_unnamed4(arg1)
		if not fn_handleFunction() then
			return
		end

		pcall(delfile, arg1)
	end
	local function fn_unnamed5(arg1)
		if not fn_handleFunction() then
			return false
		end

		local ok, result = pcall(isfile, arg1)

		return ok and result
	end
	local function fn_runJSONEncode(collectStateResult)
		local ok, result = pcall(function()
			return HttpService:JSONEncode(collectStateResult)
		end)
		local result2 = ok and result or "{}"

		return result2
	end
	local function fn_runJSONDecode2(json)
		local ok, result = pcall(function()
			return HttpService:JSONDecode(json)
		end)
		local result2 = ok and result or nil

		return result2
	end
	local function fn_unnamed6(color)
		return {
			math.floor(color.R * 255),
			math.floor(color.G * 255),
			math.floor(color.B * 255)
		}
	end
	local function fn_handleTable(list)
		if type_(list) ~= "table" or #list < 3 then
			return nil
		end

		return Color3.fromRGB(list[1], list[2], list[3])
	end
	local function fn_runGsub(activeProfile)
		local mode = tostring(activeProfile):gsub("[^%w%-_]", ""):sub(1, 32)

		if mode == "" then
			mode = "unnamed"
		end

		return mode
	end

	return {
		ActiveProfile = "default",
		Settings = {},
		ProfileData = {},
		Registry = {},
		UIHandles = {},
		Listeners = {},
		KeybindCollector = nil,
		KeybindLoader = nil,
		Init = function(self)
			if self._initialized then
				return
			end

			self._initialized = true
			fn_unnamed("LowHub/")
			fn_unnamed("LowHub/profiles/")

			local json = fn_unnamed2("LowHub/settings.json")

			if json then
				self.Settings = fn_runJSONDecode2(json) or {}
			end

			for k, v in pairs(activeProfileConfig) do
				if self.Settings[k] == nil then
					self.Settings[k] = v
				end
			end

			self.ActiveProfile = self.Settings.activeProfile or "default"
			self:SaveSettings()
		end,
		RegisterModule = function(obj, text, arg3, arg4, arg5)
			obj.Registry[text] = {
				Type = "module",
				Ref = arg3,
				SetterTarget = arg5 or arg3,
				Properties = arg4,
				DisplayName = text:match("[^%.]+$") or text
			}
		end,
		RegisterCustomState = function(self, text, obj)
			self.Registry[text] = {
				Type = "custom",
				Serialize = obj and obj.Serialize or nil,
				Apply = obj and obj.Apply or nil,
				DisplayName = text:match("[^%.]+$") or text
			}
		end,
		RegisterUIHandle = function(obj, arg2, arg3)
			obj.UIHandles[arg2] = arg3
		end,
		GetRegistry = function(obj)
			return obj.Registry
		end,
		CollectState = function(self)
			local modulesKeybindsConfig = {
				modules = {},
				keybinds = self.KeybindCollector and self.KeybindCollector() or {}
			}

			for k, v in pairs(self.Registry) do
				if v.Type == "custom" then
					if type_(v.Serialize) == "function" then
						local ok, result = pcall(v.Serialize)

						if ok and result ~= nil then
							modulesKeybindsConfig.modules[k] = result
						end
					end
				else
					local lookup = {}

					for _, property in ipairs(v.Properties) do
						local refEntry = v.Ref[property.Key]

						if property.Type == "color3" and typeof(refEntry) == "Color3" then
							refEntry = fn_unnamed6(refEntry)
						end

						lookup[property.Key] = refEntry
					end

					modulesKeybindsConfig.modules[k] = lookup
				end
			end

			return modulesKeybindsConfig
		end,
		ApplyState = function(self, list)
			if not list or not list.modules then
				return
			end

			for k, module in pairs(list.modules) do
				local registryEntry = self.Registry[k]

				if registryEntry then
					if registryEntry.Type == "custom" then
						if type_(registryEntry.Apply) == "function" then
							pcall(registryEntry.Apply, module)
						end
					else
						for _, property in ipairs(registryEntry.Properties) do
							local moduleEntry = module[property.Key]

							if moduleEntry ~= nil then
								if property.Type == "color3" and type_(moduleEntry) == "table" then
									moduleEntry = fn_handleTable(moduleEntry)
								end

								if moduleEntry ~= nil and property.Setter then
									local SetterTarget = registryEntry.SetterTarget or registryEntry.Ref
									local setterTargetEntry = SetterTarget[property.Setter]

									if type_(setterTargetEntry) == "function" then
										pcall(setterTargetEntry, SetterTarget, moduleEntry)
									end
								end
							end
						end

						local uIHandleEntry = self.UIHandles[k]

						if uIHandleEntry then
							if uIHandleEntry.SetState and registryEntry.Ref and registryEntry.Ref.Enabled ~= nil then
								pcall(uIHandleEntry.SetState, registryEntry.Ref.Enabled)
							end

							if uIHandleEntry.SetSlider and registryEntry.Ref then
								for _, property in ipairs(registryEntry.Properties) do
									if property.Type == "number" and property.Key ~= "Enabled" then
										local refEntry = registryEntry.Ref[property.Key]

										if refEntry then
											pcall(uIHandleEntry.SetSlider, refEntry)
										end

										break
									end
								end
							end
						end
					end
				end
			end

			if list.keybinds and self.KeybindLoader then
				pcall(self.KeybindLoader, list.keybinds)
			end

			self:NotifyListeners("profileLoaded", self.ActiveProfile)
		end,
		Save = function(self, activeProfile)
			local ActiveProfile = activeProfile or self.ActiveProfile
			local collectStateResult = self:CollectState()

			collectStateResult.name = ActiveProfile
			collectStateResult.createdAt = os.time()
			fn_unnamed3("LowHub/profiles/" .. fn_runGsub(ActiveProfile) .. ".json", fn_runJSONEncode(collectStateResult))
			self:NotifyListeners("profileSaved", ActiveProfile)
		end,
		SaveActive = function(self)
			self:Save(self.ActiveProfile)
		end,
		AutoSave = function(obj)
			if obj.Settings.autoSave == false then
				return
			end

			if thread then
				pcall(function()
					task.cancel(thread)
				end)
			end

			thread = task.delay(0.5, function()
				obj:SaveActive()
				thread = nil
			end)
		end,
		Load = function(self, s40)
			local activeProfile = s40 or "default"
			local loadFlag = fn_unnamed2("LowHub/profiles/" .. fn_runGsub(activeProfile) .. ".json")

			if not loadFlag then
				return false
			end

			local fn_runJSONDecode2Result = fn_runJSONDecode2(loadFlag)

			if not fn_runJSONDecode2Result then
				return false
			end

			self.ActiveProfile = activeProfile
			self.ProfileData = fn_runJSONDecode2Result
			self.Settings.activeProfile = activeProfile
			self:SaveSettings()
			self:ApplyState(fn_runJSONDecode2Result)

			return true
		end,
		GetProfileList = function()
			local getProfileListList = {}

			if not fn_handleFunction() then
				table.insert(getProfileListList, "default")

				return getProfileListList
			end

			local ok, result = pcall(function()
				return listfiles("LowHub/profiles/")
			end)

			if ok and result then
				for _, v in ipairs(result) do
					local match = v:match("([^/\\]+)%.json$")

					if match then
						table.insert(getProfileListList, match)
					end
				end
			end

			if #getProfileListList == 0 then
				table.insert(getProfileListList, "default")
			end

			table.sort(getProfileListList)

			return getProfileListList
		end,
		CreateProfile = function(self, s41)
			local fn_runGsubResult = fn_runGsub(s41)

			self.ActiveProfile = fn_runGsubResult
			self.Settings.activeProfile = fn_runGsubResult
			self:SaveSettings()
			self:Save(fn_runGsubResult)

			return fn_runGsubResult
		end,
		DeleteProfile = function(self, s40)
			if s40 == "default" then
				return false
			end

			fn_unnamed4("LowHub/profiles/" .. fn_runGsub(s40) .. ".json")

			if self.ActiveProfile == s40 then
				self.ActiveProfile = "default"
				self.Settings.activeProfile = "default"
				self:SaveSettings()
			end

			self:NotifyListeners("profileDeleted", s40)

			return true
		end,
		ExportProfile = function(self, s40)
			local ActiveProfile = s40 or self.ActiveProfile
			local fn_runJSONEncodeResult = fn_unnamed2("LowHub/profiles/" .. fn_runGsub(ActiveProfile) .. ".json") or fn_runJSONEncode(self:CollectState())

			pcall(function()
				setclipboard(fn_runJSONEncodeResult)
			end)

			return fn_runJSONEncodeResult
		end,
		ImportProfile = function(self, s42, arg3)
			local fn_runJSONDecode2Result = fn_runJSONDecode2(s42)

			if not fn_runJSONDecode2Result or type_(fn_runJSONDecode2Result.modules) ~= "table" then
				return false
			end

			local fn_runGsubResult = fn_runGsub(arg3 or fn_runJSONDecode2Result.name or "imported")

			fn_runJSONDecode2Result.name = fn_runGsubResult
			fn_unnamed3("LowHub/profiles/" .. fn_runGsubResult .. ".json", fn_runJSONEncode(fn_runJSONDecode2Result))
			self:NotifyListeners("profileImported", fn_runGsubResult)

			return true, fn_runGsubResult
		end,
		GetSetting = function(self, theme)
			return self.Settings[theme]
		end,
		SetSetting = function(self, loop, val)
			self.Settings[loop] = val
			self:SaveSettings()
		end,
		SaveSettings = function(self)
			fn_unnamed3("LowHub/settings.json", fn_runJSONEncode(self.Settings))
		end,
		Subscribe = function(self, setOnlinePlayers)
			table.insert(self.Listeners, setOnlinePlayers)
		end,
		NotifyListeners = function(self, arg2, activeProfile)
			for _, listener in ipairs(self.Listeners) do
				pcall(listener, arg2, activeProfile)
			end
		end
	}
end
moduleDefs["Services.ESPService"] = function()
	local Players = game_:GetService("Players")
