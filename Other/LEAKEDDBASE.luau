moduleDefs["Modules.Interactions.Carry"] = function()
	local AttachmentRuntime = requireModule("Modules.Interactions.AttachmentRuntime")

	local function fn_runPointToObjectSpace(instance)
		local HumanoidRootPart = instance.HumanoidRootPart
		local UpperTorso = instance:FindFirstChild("UpperTorso") or instance:FindFirstChild("Torso")
		local Head = instance:FindFirstChild("Head")

		return HumanoidRootPart, UpperTorso and HumanoidRootPart.CFrame:PointToObjectSpace(UpperTorso.Position) or Vector3.zero, UpperTorso and UpperTorso.Size or Vector3.new(2, 2, 1), Head and HumanoidRootPart.CFrame:PointToObjectSpace(Head.Position).Y + Head.Size.Y / 2 or 1.93
	end
	local function fn_unnamed(arg1, arg2)
		local part, vector, vector2 = fn_runPointToObjectSpace(arg2)

		return part.CFrame * CFrame.new(vector.X, vector.Y + vector2.Y / 2 - 0.73, vector.Z + vector2.Z / 2 + 0.55)
	end
	local function fn_unnamed2(arg1, arg2)
		local part, vector, vector2 = fn_runPointToObjectSpace(arg2)

		return part.CFrame * CFrame.new(vector.X + 0.45, vector.Y + vector2.Y / 2 + 0.03, vector.Z - vector2.Z / 2 - 0.73)
	end
	local function fn_unnamed3(arg1, arg2)
		local part, vector, vector2, amount4 = fn_runPointToObjectSpace(arg2)

		return part.CFrame * CFrame.new(vector.X + vector2.X / 2 + 0.9, amount4 + 0.23, vector.Z - 0.17)
	end
	local function fn_unnamed4(arg1, arg2)
		local part, vector, _, amount4 = fn_runPointToObjectSpace(arg2)

		return part.CFrame * CFrame.new(vector.X, amount4 + 0.49, vector.Z)
	end
	local function fn_unnamed5(arg1, arg2)
		local part, vector, _, amount4 = fn_runPointToObjectSpace(arg2)

		return part.CFrame * CFrame.new(vector.X, amount4 + 0.69, vector.Z) * CFrame.Angles(0, 0, 3.1415926535897931)
	end

	local toggleObj

	toggleObj = {
		Configs = {
			Piggyback = {
				AnimationId = "120027485463142",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_unnamed,
				PlatformStand = true
			},
			["Piggyback 2"] = {
				AnimationId = "115900505866868",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_unnamed,
				PlatformStand = true
			},
			["Carry High"] = {
				AnimationId = "110931537942183",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_unnamed2,
				PlatformStand = true
			},
			["Shoulder Sit"] = {
				AnimationId = "78710299150565",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_unnamed3,
				PlatformStand = true
			},
			["Sit on Head"] = {
				AnimationId = "78710299150565",
				Priority = Enum.AnimationPriority.Action4,
				Place = fn_unnamed4,
				PlatformStand = true
			},
			Headstand = {
				Place = fn_unnamed5,
				PlatformStand = true
			}
		},
		Toggle = function(self, self2)
			local configEntry = toggleObj.Configs[self]

			if not configEntry then
				return false
			end

			configEntry.Direct = true

			return AttachmentRuntime:Toggle(self, configEntry, self2)
		end
	}

	return toggleObj
end
