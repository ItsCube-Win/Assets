			local attribute = instance:GetAttribute("ClaimedBy")

			if attribute and attribute ~= 0 and attribute ~= UserId then
				exitTo = 1

				break
			elseif amount == 30 then
				local fnrunFind2Result2 = fnrunFind2(instance)

				if not (fnrunFind2Result2 >= 0) or not (fnrunFind2Result >= 0) or not (fnrunFind2Result - 0.05 < fnrunFind2Result2) then
					continue
				end
			else
