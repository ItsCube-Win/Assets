				return
			end

			local vector2 = Vector2.new(input.Position.X, input.Position.Y)
			local AbsolutePosition = gui.AbsolutePosition
			local AbsoluteSize = gui.AbsoluteSize

			if not (not not (vector2.X >= AbsolutePosition.X and vector2.X <= AbsolutePosition.X + AbsoluteSize.X) and vector2.Y >= AbsolutePosition.Y and vector2.Y <= AbsolutePosition.Y + AbsoluteSize.Y) then
				return
			end

			local vector = AbsolutePosition + AbsoluteSize / 2
			local amount = vector2.X - vector.X
			local amount5 = vector2.Y - vector.Y

			if math.sqrt(amount * amount + amount5 * amount5) < AbsoluteSize.X * 0.1 then
				return
			end

			fn_handleAnimation5(math.floor((math.deg(math.atan2(amount5, amount)) + 90 + 22.5) % 360 / 45) + 1)
		end)

