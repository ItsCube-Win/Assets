			if self.OnDurability then
				pcall(self.OnDurability, durability3, repairPickValue2, repairPickFlag3, repairPickValue4)
			end
		end

		return true
	end
	statusCountService.Start = function(self)
		if self.Enabled then
			return
		end

		self.Enabled = true
		fn_applyStatus("Mining...")

		local startObj = fn_unnamed2()

		if not startObj then
			fn_applyStatus("Events not found")
			self.Enabled = false

			return
		end

		if MiningMinigame then
			pcall(function()
				MiningMinigame:Disconnect()
			end)
		end

		MiningMinigame = startObj:Bind("MiningMinigame", function()
			statusCountService._mgFired = true
		end)
		fn_runBind()
		thread = task.spawn(function()
			while self.Enabled do
				local now = os.clock()

				if now - startAmount > 4 then
					startAmount = now

					local signal = fn_unnamed2()

					if signal then
						pcall(function()
							signal:Fire("RequestMiningData")
						end)
					end
				end

				local durability, startValue2, startFlag3, startValue4, startValue5 = self:GetDurability()

				if startFlag3 and self.OnDurability then
					pcall(self.OnDurability, durability, startValue2, startFlag3, startValue4, startValue5)
				end

				if self.AutoRepair then
					local fn_equipToolResult = fn_equipTool()
					local startFlag = startFlag3 and startValue5

					if startFlag then
						startFlag = startFlag3 <= (self.RepairAt or 20)
					end

					if (startFlag or not fn_equipToolResult and (durability == nil or startFlag3 and startFlag3 <= 5)) and now - startAmount2 > 20 then
						startAmount2 = now
						self:RepairPick(not fn_equipToolResult)

						continue
					end
				end

				if fn_equipTool() then
					local bagStats, startAmount2_2 = self:GetBagStats()

					if self.OnBag then
						pcall(self.OnBag, bagStats, startAmount2_2)
					end

					if not self:IsBackpackFull() and (not (startAmount2_2 > 0) or not (startAmount2_2 <= bagStats)) then
						local startFlag, startValue2_2 = fn_getTagged()

						if startFlag then
							fn_applyCFrameMgFired(startFlag, startValue2_2)

							local bagStats2, startValue2_3 = self:GetBagStats()

							if self.OnBag then
								pcall(self.OnBag, bagStats2, startValue2_3)
							end

							task.wait(0.1)
						else
							fn_applyStatus("No free ore...")
							task.wait(1.5)
						end
					elseif self.AutoSell then
						self:SellAll()

						local now2 = os.clock()

						while self:IsBackpackFull() and os.clock() - now2 < 4 do
							task.wait(0.2)
						end

						local bagStats2, startValue2_3 = self:GetBagStats()

						if self.OnBag then
							pcall(self.OnBag, bagStats2, startValue2_3)
						end
					else
						fn_applyStatus("Backpack full — turn on Auto Sell")
						task.wait(1.5)
					end
				else
					fn_applyStatus("No pickaxe")
					task.wait(1)
				end
			end
		end)
	end
	statusCountService.Stop = function(self)
		self.Enabled = false

		if MiningMinigame then
			pcall(function()
				MiningMinigame:Disconnect()
			end)
			MiningMinigame = nil
		end

		if MiningDataChanged then
			pcall(function()
				MiningDataChanged:Disconnect()
			end)
			MiningDataChanged = nil
		end

		fn_applyStatus("Idle")
	end
	statusCountService.SetEnabled = function(self, flag)
		if flag then
			self:Start()
		else
			self:Stop()
		end
	end
	statusCountService.SetOnlyRarest = function(self, onlyRarest)
		self.OnlyRarest = onlyRarest == true
	end
	statusCountService.SetRarestFirst = function(obj, rarestFirst)
		obj.RarestFirst = rarestFirst == true
	end
	statusCountService.SetAutoSell = function(self, autoSell)
		self.AutoSell = autoSell == true
	end
	statusCountService.SetAutoRepair = function(self, autoRepair)
		self.AutoRepair = autoRepair == true

		if self.AutoRepair then
			fn_runBind()
		end
	end
	statusCountService.SetRepairAt = function(self, arg2)
		local number = tonumber(arg2)

		if number then
			self.RepairAt = math.clamp(number, 1, 90)
		end
	end

	return statusCountService
end
moduleDefs["Games.Mushyo.AutoMusic"] = function()
	local Workspace = game_:GetService("Workspace")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local active = {
		Enabled = false,
		Legit = false,
		Precisao = 100,
		Good = 15,
		ComboMax = 0,
		Lead = 0,
		Status = "Idle",
		OnStatusChanged = nil,
		Stats = {
			Perfect = 0,
			Great = 0,
			Good = 0,
			Bad = 0,
			Miss = 0
		}
	}
	local __LHMushMusic = _G.__LHMushMusic

	if not __LHMushMusic then
		__LHMushMusic = {}
		_G.__LHMushMusic = __LHMushMusic
	end

	__LHMushMusic.epoch = (__LHMushMusic.epoch or 0) + 1

	local epoch = __LHMushMusic.epoch

	__LHMushMusic.active = active

	local function fn_unnamed()
		return __LHMushMusic.epoch == epoch
	end

	local random = Random.new()
	local dropObj
	local dropFlag
	local dropAmount = 0
	local onStartedFlag = false
	local Session
	local flag2 = false
	local onJudgementAmount = 0

	local function fn_applyStatus(l)
		active.Status = l

		if active.OnStatusChanged then
			pcall(active.OnStatusChanged, l)
		end
	end
	local function fn_unnamed2()
		for l in pairs(active.Stats) do
			active.Stats[l] = 0
		end
	end
	local function fn_handleTable(l)
		local K = 0

		for M, M in pairs(l) do
			local l = M.Position

			if type_(l) == "table" then
				local i = l[#l]

				if type_(i) == "number" and i > K then
					K = i
				end
			end
		end

		return K
	end
	local function fn_getServerTimeNow()
		local l, x = nil, nil

		pcall(function()
			local i = getgc(true)

			for Y = 1, #i do
				local h = i[Y]

				if type_(h) == "table" then
					local i = rawget(h, "Sheet")
					local p = rawget(h, "StartAt")

					if i and type_(p) == "number" and (rawget(h, "OnJudgement") ~= nil or rawget(h, "OnNote") ~= nil) then
						local K = Workspace:GetServerTimeNow() - p
						local W = fn_handleTable(i)

						if W > 0 and K > -6.5 and K < W + 3 then
							if not x or p > x then
								l, x = h, p
							end
						end
					end
				end

				if (Y % 2000) == 0 then
					task.wait()
				end
			end
		end)

		return l
	end
	local function fn_handleFunction(l)
		local G = getgc(false)

		for x = 1, #G do
			local Y = G[x]

			if type_(Y) == "function" then
				local G, h = pcall(debug.info, Y, "a")

				if G and h == 1 then
					local W, G = false, false

					for h = 1, 16 do
						local p, y = pcall(debug.getupvalue, Y, h)

						if not p then
							break
						end

						if y == l then
							W = true
						elseif type_(y) == "number" and y > 0.1 and y < 0.35 then
							G = true
						end

						if W and G then
							return Y
						end
					end
				end
			end

			if (x % 3000) == 0 then
				task.wait()
			end
		end

		return nil
	end
	local function fnapplyLh(obj)
		if obj.__lhHooked then
			return
		end

		obj.__lhHooked = true

		local OnJudgement = obj.OnJudgement

		obj.OnJudgement = function(l)
			if l and l.Judgement and active.Stats[l.Judgement] ~= nil then
				active.Stats[l.Judgement] = active.Stats[l.Judgement] + 1
			end

			local G = os.clock()

			if G - onJudgementAmount >= 0.4 then
				onJudgementAmount = G

				local i = active.Stats

				fn_applyStatus(("%dP  %dG  %dg  %dM"):format(i.Perfect, i.Great, i.Good, i.Miss))
			end

			if OnJudgement then
				return OnJudgement(l)
			end
		end
	end
	local function fn_applyExtraMiss(l)
		local G = {}

		for x, x in pairs(l.Sheet) do
			local l = x.Position

			if x.Key and type_(l) == "table" and type_(l[1]) == "number" then
				G[#G + 1] = { key = x.Key, t = l[1] }
			end
		end

		table.sort(G, function(l, i)
			return l.t < i.t
		end)

		local l = 0
		local i = active.Legit
		local K = active.ComboMax
		local M = active.Precisao
		local x = active.Good

		for W = 1, #G do
			local Y = G[W]

			Y.miss, Y.extra = false, 0

			if i then
				if K > 0 and l >= K then
					Y.miss = true
				elseif random:NextNumber() * 100 > M then
					Y.miss = true
				elseif x > 0 and random:NextNumber() * 100 < x then
					Y.extra = 0.06 + random:NextNumber() * 0.09
				end
			end

			l = Y.miss and 0 or (l + 1)
		end

		return G
	end
	local function fn_getServerTimeNow2()
		local l = dropObj
		local W = rawget(l, "StartAt")

		if type_(W) ~= "number" then
			return
		end

		local y = dropAmount
		local S = fn_applyExtraMiss(l)

		fn_applyStatus(("Playing · %d notes"):format(#S))

		local i = Workspace:GetServerTimeNow()
		local c = active.Lead or 0
		local x = dropFlag

		for M = 1, #S do
			local U = S[M]

			if not U.miss then
				local M = (W + U.t + c + U.extra) - i

				if M < 0 then
					M = 0
				end

				task.delay(M, function()
					if not fn_unnamed() or y ~= dropAmount or not active.Enabled then
						return
					end

					pcall(x, U.key)
				end)
			end
		end

		local M = (W + fn_handleTable(l.Sheet) + 3) - i

		if M < 1 then
			M = 1
		end

		task.delay(M, function()
			if fn_unnamed() and y == dropAmount then
				active._drop()
			end
		end)
	end

	active._drop = function()
		dropAmount += 1

		if dropObj and dropObj.__lhHooked then
			pcall(function()
				dropObj.__lhHooked = nil
			end)
		end

		dropObj = nil
		dropFlag = nil
	end

	local function fn_unnamed3()
		if flag2 or dropObj or not fn_unnamed() then
			return
		end

		flag2 = true
		task.spawn(function()
			local l = 0

			while fn_unnamed() and active.Enabled and onStartedFlag and not dropObj and l < 16 do
				l = l + 1

				local W = fn_getServerTimeNow()
				local Y = W and fn_handleFunction(W)

				if W and Y then
					dropObj, dropFlag = W, Y
					dropAmount = dropAmount + 1
					fn_unnamed2()
					fnapplyLh(W)
					fn_getServerTimeNow2()

					break
				end

				task.wait(l <= 10 and 0.05 or 0.30)
			end

			flag2 = false
		end)
	end

	active._onStarted = function(obj)
		if not active.Enabled then
			return
		end

		Session = obj and obj.Session
		onStartedFlag = true
		fn_unnamed3()
	end
	active._onEnded = function(arg1)
		if Session ~= nil and arg1 ~= Session then
			return
		end

		onStartedFlag = false
		Session = nil
		active._drop()

		if active.Enabled then
			fn_applyStatus("Waiting for music")
		end
	end

	if not __LHMushMusic.connected then
		pcall(function()
			local requireModule2 = requireModule(ReplicatedStorage.Blink.Client)
			local Music = requireModule2 and requireModule2.Music

			if not Music then
				return
			end

			if Music.Started and Music.Started.On then
				Music.Started.On(function(l)
					local K = __LHMushMusic.active

					if not K or not K.Enabled then
						return
					end

					if l and l.Player ~= nil and l.Player ~= LocalPlayer then
						return
					end

					K._onStarted(l)
				end)
			end

			if Music.Ended and Music.Ended.On then
				Music.Ended.On(function(l)
					local i = __LHMushMusic.active

					if i then
						i._onEnded(l)
					end
				end)
			end

			__LHMushMusic.connected = true
		end)
	end

	local startAmount = 0

	local function fn_handleStartAt(l)
		while startAmount == l and active.Enabled and fn_unnamed() do
			if not dropObj then
				local l = fn_getServerTimeNow()

				if l then
					onStartedFlag = true
					fn_unnamed3()
				end

				task.wait(1)
			else
				local l = fn_getServerTimeNow()

				if l and l ~= dropObj then
					local W = rawget(l, "StartAt")
					local l = rawget(dropObj, "StartAt")

					if type_(W) == "number" and type_(l) == "number" and W > l then
						active._drop()
						onStartedFlag = true
						fn_unnamed3()
					end
				end

				task.wait(2)
			end
		end
	end

	active.Start = function(self)
		if self.Enabled then
			return
		end

		self.Enabled = true
		__LHMushMusic.active = self

		if not onStartedFlag and fn_getServerTimeNow() then
			onStartedFlag = true
		end

		if onStartedFlag then
			fn_unnamed3()
		else
			fn_applyStatus("Waiting for music")
		end

		startAmount += 1
		task.spawn(fn_handleStartAt, startAmount)
	end
	active.Stop = function(self)
		self.Enabled = false
		startAmount += 1
		active._drop()
		fn_applyStatus("Idle")
	end
	active.SetEnabled = function(self, flag)
		if flag then
			self:Start()
		else
			self:Stop()
		end
	end
	active.SetLegit = function(self, legit)
		self.Legit = legit == true
	end
	active.SetPrecisao = function(self, arg2)
		self.Precisao = math.clamp(tonumber(arg2) or 100, 50, 100)
	end
	active.SetGood = function(self, arg2)
		self.Good = math.clamp(tonumber(arg2) or 15, 0, 60)
	end
	active.SetComboMax = function(self, arg2)
		self.ComboMax = math.max(0, math.floor(tonumber(arg2) or 0))
	end

	return active
end
moduleDefs["Games.Mushyo.AutoSnooker"] = function()
