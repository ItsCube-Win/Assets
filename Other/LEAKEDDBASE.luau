							skidFlingValue12(part, CFrame.new(2.25, 1.5, -2.25) + Humanoid2.MoveDirection * part.Velocity.Magnitude / 1.25, cFrame3(math.rad(skidFlingAmount), 0, 0))
							task.wait()

