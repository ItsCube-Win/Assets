	local function fn_getAttribute(item)
		return item:GetAttribute("Available") == true
	end
	local function fn_runLower(obj, arg2)
		local fn_handleClientResult = fn_handleClient()

		if not fn_handleClientResult or not obj or not obj.prompt then
			return false, "no interV/prompt"
		end

		local text = (obj.prompt.ActionText or ""):lower()
		local obj2 = fn_handleClientResult[text]

		if type_(obj2) ~= "table" or type_(obj2.Actions) ~= "function" then
			return false, "no entry " .. text
		end

		local Name = deathNoteMaskConfig2[arg2] or obj.item and obj.item.Name
		local ok, result = pcall(obj2.Actions)

		if not ok or type_(result) ~= "table" then
			return false, "actions call err"
		end

		for _, v in ipairs(result) do
			local ok2, result2 = pcall(v)

			if ok2 and type_(result2) == "table" and result2.Id == Name and type_(result2.OnActivated) == "function" then
				local ok3, result3 = pcall(result2.Enabled)

				if ok3 and result3 == false then
					return false, "disabled"
				end

				local ok4, result4 = pcall(result2.OnActivated)

				return ok4, result4 and tostring(result4):sub(1, 60) or nil
			end
		end

		return false, "action id not found"
	end
	local function fnapplyPlatform(arg1, obj)
		local part, humanoid = fn_handleHumanoidRootPart()

		if not part or not obj or not obj.item or not obj.promptPart then
			return false, "no char/target"
		end

		if not fn_getAttribute(obj.item) then
			return false, "not available"
		end

		local promptPart = obj.promptPart

		pcall(function()
			if humanoid then
				humanoid.PlatformStand = false
			end
		end)
		part.CFrame = promptPart.CFrame + Vector3.new(0, 1, 0)
		task.wait(0.2)

		local flag, value2 = fn_runLower(obj, arg1)

		task.wait(0.3)

		local fn_getAttributeResult = not fn_getAttribute(obj.item)
		local value = value2 or flag and "activated" or "no result"

		return fn_getAttributeResult, value
	end

	local list = {}

	local function fn_unnamed3()
		for _, v in ipairs(list) do
			pcall(function()
				v:Disconnect()
			end)
		end

		table.clear(list)
	end
	local function fngetAttribute()
		fn_unnamed3()

		local fnapplyDeath = fn_applyDeathNoteMask()

		for k, v in pairs(fnapplyDeath) do
			if v.item then
				if onStatusChangedState.Enabled[k] and fn_getAttribute(v.item) and fn_handleConfiguration() then
					task.spawn(function()
						fn_unnamed(("Grabbing %s..."):format(deathNoteMaskConfig[k] or k))

						if fnapplyPlatform(k, v) then
							if onStatusChangedState.OnItemPicked then
								pcall(onStatusChangedState.OnItemPicked, k)
							end

							fn_unnamed(("Grabbed %s"):format(deathNoteMaskConfig[k] or k))
						else
							fn_unnamed(("Watching %s..."):format(deathNoteMaskConfig[k] or k))
						end
					end)
				end

				local connection = v.item:GetAttributeChangedSignal("Available"):Connect(function()
					if not onStatusChangedState.Enabled[k] then
						return
					end

					if not fn_handleConfiguration() then
						return
					end

					if fn_getAttribute(v.item) then
						fn_unnamed(("%s spawned! grabbing..."):format(deathNoteMaskConfig[k] or k))

						if fnapplyPlatform(k, v) then
							if onStatusChangedState.OnItemPicked then
								pcall(onStatusChangedState.OnItemPicked, k)
							end

							fn_unnamed(("Grabbed %s"):format(deathNoteMaskConfig[k] or k))
						end
					end
				end)

				table.insert(list, connection)

				local connection2 = v.item.AncestryChanged:Connect(function(child, parent)
					if not parent then
						task.delay(1, function()
							if fn_unnamed2() then
								fngetAttribute()
							end
						end)
					end
				end)

				table.insert(list, connection2)
			end
		end

		if fn_unnamed2() then
			fn_unnamed("Watching rares...")
		else
			fn_unnamed("Idle")
		end
	end

	onStatusChangedState.SetItem = function(self, arg2, flag)
		if self.Enabled[arg2] == nil then
			return
		end

		self.Enabled[arg2] = flag == true

		if fn_unnamed2() then
			fngetAttribute()
		else
			fn_unnamed3()
			fn_unnamed("Idle")
		end
	end
	onStatusChangedState.Stop = function(self)
		for k in pairs(self.Enabled) do
			self.Enabled[k] = false
		end

		fn_unnamed3()
		fn_unnamed("Idle")
	end

	return onStatusChangedState
end
