end
moduleDefs["Services.FlingService"] = function()
	local Players = game_:GetService("Players")
	local Workspace = game_:GetService("Workspace")
	local LocalPlayer = Players.LocalPlayer
	local VIPProtectionService = requireModule("Services.VIPProtectionService")

	local function fn_handleHumanoid(player)
		local Character = player.Character

		if not Character then
			return
		end

		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
		local RootPart = Humanoid and Humanoid.RootPart
		local Head = Character:FindFirstChild("Head")
		local Accessory = Character:FindFirstChildOfClass("Accessory")

		return Character, Humanoid, RootPart, Head, Accessory and Accessory:FindFirstChild("Handle")
	end

	return {
		State = {
