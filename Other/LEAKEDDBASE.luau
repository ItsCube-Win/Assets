				"is_sirhurt_closure",
				"secure_call",
				"pebc_execute",
				"fluxus",
				"identifyexecutor"
			}
			local list = {}

			pcall(function()
				table.insert(list, _G)
			end)
			pcall(function()
				table.insert(list, shared)
			end)
			pcall(function()
				if typeof(getgenv) == "function" then
