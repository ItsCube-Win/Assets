		end,
		OnChanged = function(self, features)
			table.insert(self.Listeners, features)
		end,
		SetConnectionState = function(self, isConnected)
			self.State.Connected = isConnected == true
			self:Notify()
		end,
		SetFreeMode = function(self, freeMode)
			self.State.FreeMode = freeMode == true
			self:Notify()
		end,
		Clear = function(self)
			self.State.Active = false
			self.State.Plan = nil
			self.State.Tier = nil
			self.State.ExpiresAt = nil
			self.State.Frozen = false
			self.State.AllFeatures = false
			self.State.AllowedFeatures = {}
			self.State.FeatureDefinitions = {}
			self.State.FeatureOrder = {}
			self.State.LastSyncAt = os.time()
			self:Notify()
		end,
