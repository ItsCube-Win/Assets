					else
						UIGradient.Color = fn_unnamed(createBillboardGuiList)
					end
				elseif mode == "typing" then
					createBillboardGuiAmount2 += 1

					if createBillboardGuiAmount4 == 1 then
						if createBillboardGuiAmount2 % 8 == 0 then
							createBillboardGuiAmount3 += 1

							if createBillboardGuiAmount3 > #text then
