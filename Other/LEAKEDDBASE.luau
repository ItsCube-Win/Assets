			local ShowBox = State.ShowBox
			local ShowHealthBar = State.ShowHealthBar
			local ShowName = State.ShowName
			local ShowDistance = State.ShowDistance
			local ShowItem = State.ShowItem

			if not ShowBox and not ShowHealthBar and not ShowName and not ShowDistance and not ShowItem then
