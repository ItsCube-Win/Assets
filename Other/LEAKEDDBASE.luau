	SayClass.ThrowKnife = function(self, flag, arg3, arg4, flag2)
		if not self.Roles:AmMurderer() then
			self:_say("You are not the murderer.", arg4)

			return false
		end

		local Weapon_Knife = fn_hasTag("Weapon_Knife")

		if not Weapon_Knife or Weapon_Knife:GetAttribute("Disabled") == true then
			return false
