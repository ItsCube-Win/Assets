			return
		end

		local fn_handleSharedResult = fn_handleShared()

		if not fn_handleSharedResult then
			return
		end

		connection = fn_handleSharedResult.OnClientEvent:Connect(function(player)
			if type_(player) == "table" and player.UserId == LocalPlayer.UserId and type_(player.NodeId) == "string" then
				lookup[player.NodeId] = os.clock()
			end
		end)
	end
	local function fnapplyAssembly(part, amount)
		local clamped = math.clamp(tonumber(onStatusChangedState.Config.speed) or 16, 8, 60)
		local Name = part.Name
		local amount2 = os.clock() + amount / clamped + 4.5

		lookup[Name] = nil

		while onStatusChangedState.Enabled and not lookup[Name] and os.clock() < amount2 do
			local result = RunService.Heartbeat:Wait()
			local fnhandleHumanoid = fn_handleHumanoidRootPart()

			if not fnhandleHumanoid then
				return false
			end

			local vector = part.Position - fnhandleHumanoid.Position
			local Magnitude = vector.Magnitude

			if Magnitude < 0.5 then
				fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
			else
				local assemblyLinearVelocity = vector / Magnitude

				fnhandleHumanoid.CFrame = CFrame.new(fnhandleHumanoid.Position + assemblyLinearVelocity * math.min(Magnitude, clamped * result)) * (fnhandleHumanoid.CFrame - fnhandleHumanoid.CFrame.Position)
				fnhandleHumanoid.AssemblyLinearVelocity = assemblyLinearVelocity * clamped
			end
		end

		local fnhandleHumanoid = fn_handleHumanoidRootPart()

		if fnhandleHumanoid then
			fnhandleHumanoid.AssemblyLinearVelocity = Vector3.zero
		end

		return lookup[Name] ~= nil
	end

