moduleDefs["Games.Rovibes.AutoClicador"] = function()
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local Workspace = game_:GetService("Workspace")
	local onStatusChangedService = {
		Enabled = false,
		OnStatusChanged = nil,
		Status = "Idle",
		Config = {
			autoPopWrinklers = true,
			autoClickGoldens = true,
			autoBuyGens = true,
			autoBuyUpgrades = true,
			autoBuyCrystalBall = true,
			autoBuyMarket = true,
			autoSellJunk = true,
			autoCast = true,
			autoHarvestLump = true,
			autoLevelUp = true,
			autoAscend = true,
			autoBuyHeavenly = true,
			autoClick = true,
