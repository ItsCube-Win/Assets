				end

				mode = "none"
				TextLabel.Text = text

				if UIGradient and UIGradient.Parent then
					UIGradient.Color = fn_unnamed(createBillboardGuiList)
					UIGradient.Rotation = 0
				end
			end
		end)

		return BillboardGui
	end

	tagsBillboardsService.Init = function(self)
		if self._initialized then
			return
		end

		self._initialized = true
		self._conns = {}

		local function fn_unnamed2(connection)
			self._conns[#self._conns + 1] = connection

			return connection
		end

		fn_unnamed2(Players.PlayerRemoving:Connect(function(player)
			self:RemoveTag(player.UserId)
		end))

		local function fn_isHiddenFor(player, character)
			if character and not character:FindFirstChild("Head") then
				local now = os.clock()

				while true do
					task.wait(0.05)

					if character:FindFirstChild("Head") then
						break
					elseif os.clock() - now > 3 or not character.Parent then
						break
					end
				end
			end

			local tagEntry = self.Tags[player.UserId]

			if tagEntry and character and character.Parent then
				if self.Billboards[player.UserId] then
					pcall(function()
						self.Billboards[player.UserId]:Destroy()
					end)
				end

				self.Billboards[player.UserId] = createBillboardGui(character, tagEntry.Name, tagEntry.Color, tagEntry.Effect, tagEntry.Tier, tagEntry.Colors)

				if (player.UserId == LocalPlayer.UserId and self.HideOwnTag or self:IsHiddenFor(player.UserId)) and self.Billboards[player.UserId] then
					pcall(function()
						self.Billboards[player.UserId]:Destroy()
					end)
					self.Billboards[player.UserId] = nil
				end
			end
		end

		fn_unnamed2(Players.PlayerAdded:Connect(function(player)
			fn_unnamed2(player.CharacterAdded:Connect(function(character)
				fn_isHiddenFor(player, character)
			end))

			if player.Character then
				task.spawn(fn_isHiddenFor, player, player.Character)
			end
		end))

		for _, player in ipairs(Players:GetPlayers()) do
			fn_unnamed2(player.CharacterAdded:Connect(function(character)
				fn_isHiddenFor(player, character)
			end))
		end

		task.spawn(function()
			while not self._dead do
				task.wait(0.25)

				for k, tag in pairs(self.Tags) do
					local HideOwnTag = k == LocalPlayer.UserId and self.HideOwnTag or self:IsHiddenFor(k)

					if tag and not HideOwnTag then
						local ok, result = pcall(function()
							return Players:GetPlayerByUserId(k)
						end)
						local Character = ok and result and result.Character
						local Head = Character and Character:FindFirstChild("Head")

						if Head and not Head:FindFirstChild("LowHub_Tag") then
							local billboardGui = createBillboardGui(Character, tag.Name, tag.Color, tag.Effect, tag.Tier, tag.Colors)

							if billboardGui then
								self.Billboards[k] = billboardGui
							end
						end
					end
				end
			end
		end)
	end
	tagsBillboardsService.SetTag = function(self, userId, tag, color, effect, tier, colors)
		if self._dead then
			return
		end

		if type_(color) == "table" and typeof(color) ~= "Color3" then
			color = Color3.fromRGB(color[1] or 255, color[2] or 255, color[3] or 255)
		end

		local tbl = { color }

		if colors and type_(colors) == "table" then
			tbl = {}

			for _, v in ipairs(colors) do
				if type_(v) == "table" and typeof(v) ~= "Color3" then
					table.insert(tbl, Color3.fromRGB(v[1] or 255, v[2] or 255, v[3] or 255))
				elseif typeof(v) == "Color3" then
					table.insert(tbl, v)
				end
			end

			if #tbl == 0 then
				tbl = { color }
			end
		end

		if not effect or effect == "" then
			effect = ({
				Owner = "majestic",
				Admin = "ocean",
				Staff = "neon"
			})[tag] or "none"
		end

		self.Tags[userId] = {
			Name = tag,
			Color = color,
			Colors = tbl,
			Effect = effect,
			Tier = tier or "User"
		}

		if self.Billboards[userId] then
			pcall(function()
				self.Billboards[userId]:Destroy()
			end)
			self.Billboards[userId] = nil
		end

		local HideOwnTag = userId == LocalPlayer.UserId and self.HideOwnTag or self:IsHiddenFor(userId)

		for _, player in ipairs(Players:GetPlayers()) do
			if player.UserId == userId and player.Character then
				if not HideOwnTag then
					self.Billboards[userId] = createBillboardGui(player.Character, tag, color, effect, tier, tbl)
				end

				break
			end
		end
	end
	tagsBillboardsService.RemoveTag = function(self, userId)
		self.Tags[userId] = nil
		self.HiddenTags[userId] = nil

		if self.Billboards[userId] then
			pcall(function()
				self.Billboards[userId]:Destroy()
			end)
			self.Billboards[userId] = nil
		end
	end
	tagsBillboardsService.Destroy = function(self)
		self._dead = true

		local ipairs_ = ipairs
		local _conns = self._conns or {}

		for _, _conn in ipairs_(_conns) do
			pcall(function()
				_conn:Disconnect()
			end)
		end

		self._conns = {}

		local lookup = {}

		for k in pairs(self.Billboards) do
			lookup[#lookup + 1] = k
		end

		for k in pairs(self.Tags) do
			lookup[#lookup + 1] = k
		end

		for _, v in ipairs(lookup) do
			self:RemoveTag(v)
		end
	end
	tagsBillboardsService.GetTag = function(self, userId)
		return self.Tags[userId]
	end
	tagsBillboardsService.GetAllTags = function(obj)
		return obj.Tags
	end
	tagsBillboardsService.SetHideOwnTag = function(self, hideOwnTag)
		self.HideOwnTag = hideOwnTag == true

		local UserId = LocalPlayer.UserId

