					if createBillboardGuiAmount5 == 0 then
						local h = M * 0.5 + ((playerFromCharacter and playerFromCharacter.UserId or 0) % 100) / 10

						UIGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHSV(h % 1, 0.8, 1)), ColorSequenceKeypoint.new(1, Color3.fromHSV((h + 0.5) % 1, 0.8, 1)) })
