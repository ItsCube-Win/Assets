		local Events = Weapon_Knife:FindFirstChild("Events")
		local KnifeStabbed = Events and Events:FindFirstChild("KnifeStabbed")
		local HandleTouched = Events and Events:FindFirstChild("HandleTouched")
		local HumanoidRootPart = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		if KnifeStabbed then
