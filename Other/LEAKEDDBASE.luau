	do
		local lookup = {}

		packsStateService.GetAnimationId = function(idleEntry)
			local match = tostring(idleEntry):match("%d+")

			if not match then
				return idleEntry
			end

			if lookup[match] then
				return lookup[match]
			end

			local ok, result = pcall(function()
				return game_:GetObjects("rbxassetid://" .. match)
			end)

			if ok and result and result[1] then
				local AnimationId

				local function fn_handleAnimation(child2)
					if child2:IsA("Animation") then
						AnimationId = child2.AnimationId

						return
					end

					for _, child in pairs(child2:GetChildren()) do
						fn_handleAnimation(child)

						if AnimationId then
							return
						end
					end
				end

				for _, v in pairs(result) do
					fn_handleAnimation(v)

					if AnimationId then
						break
					end
				end

				if AnimationId then
					lookup[match] = AnimationId
					packsStateService.Save()

					return AnimationId
				end
			end

			local text = "rbxassetid://" .. match

			lookup[match] = text
			packsStateService.Save()

			return text
		end

		local function fn_applyAnimationId(animationId, childName, childName2)
			if not animationId then
				return
			end

			local Character = LocalPlayer.Character

			if not Character then
				return
			end

			local Animate = Character:FindFirstChild("Animate")

			if not Animate then
				return
			end

			local findFirstChildResult = Animate:FindFirstChild(childName)

			if not findFirstChildResult then
				findFirstChildResult = Animate:FindFirstChild(childName:sub(1, 1):upper() .. childName:sub(2))
			end

			findFirstChildResult = findFirstChildResult or Animate:FindFirstChild(childName:lower())

			if findFirstChildResult then
				if childName2 then
					local findFirstChildResult2 = findFirstChildResult:FindFirstChild(childName2)

					if findFirstChildResult2 then
						findFirstChildResult2.AnimationId = animationId
					end
				else
					for _, child in pairs(findFirstChildResult:GetChildren()) do
						if child:IsA("Animation") then
							child.AnimationId = animationId
						end
					end
				end
			else
				warn_("[LowHub UI] Animation Value NOT FOUND for:", childName)
			end
		end

		packsStateService.ApplyPack = function(self)
			local Character = LocalPlayer.Character

			if Character then
				local Humanoid = Character:FindFirstChildOfClass("Humanoid")

				if Humanoid then
					for _, v in pairs(Humanoid:GetPlayingAnimationTracks()) do
						v:Stop(0)
						v:Destroy()
					end
				end
			end

			fn_applyAnimationId(packsStateService.GetAnimationId(self.idle[1]), "idle", "Animation1")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.idle[2] or self.idle[1]), "idle", "Animation2")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.run), "run")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.walk), "walk")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.jump), "jump")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.fall), "fall")
			fn_applyAnimationId(packsStateService.GetAnimationId(self.climb), "climb")

			if self.swim then
				fn_applyAnimationId(packsStateService.GetAnimationId(self.swim), "swim")
			end

			if Character then
				local Animate = Character:FindFirstChild("Animate")

				if Animate then
					Animate.Disabled = true
					task.wait()
					Animate.Disabled = false
				end
			end
		end
		packsStateService.PlayEmote = function(flag)
			local _, playEmoteList2 = fn_handleHumanoid()

			if not playEmoteList2 or not flag then
				return
			end

			for _, v in pairs(playEmoteList2:GetPlayingAnimationTracks()) do
				v:Stop()
			end

			local animationId = packsStateService.GetAnimationId(flag)
			local Animation = Instance.new("Animation")

			Animation.AnimationId = animationId
			track = playEmoteList2:LoadAnimation(Animation)
			track.Priority = Enum.AnimationPriority.Action

			if visible then
				track:AdjustSpeed(tonumber(SpeedBox.Text) or 1)
			else
				track:AdjustSpeed(packsStateService.State.CurrentEmoteSpeed or 1)
			end

			track:Play()
		end
		packsStateService.StopAll = function()
			local _, stopAllList2 = fn_handleHumanoid()

			if stopAllList2 then
				for _, v in pairs(stopAllList2:GetPlayingAnimationTracks()) do
					v:Stop()
				end
			end

			track = nil
		end
		packsStateService.DebugAnimate = function()
			local Character = LocalPlayer.Character

			if not Character then
				warn_("No Character")

				return
			end

			local Animate = Character:FindFirstChild("Animate")

			if not Animate then
				warn_("No Animate Script")

				return
			end

			print("--- ANIMATE SCRIPT DUMP (UI) ---")

			for _, child in pairs(Animate:GetChildren()) do
				print(" > " .. child.Name .. " (" .. child.ClassName .. ")")

				if child:IsA("ValueBase") or child:IsA("Model") or child:IsA("Folder") or child:IsA("Configuration") then
					for _, child2 in pairs(child:GetChildren()) do
						if child2:IsA("Animation") then
							print("    >> " .. child2.Name .. ": " .. child2.AnimationId)
						end
					end
				end
			end

			print("--------------------------------")
		end
		packsStateService.Save = function()
			if writefile then
				pcall(function()
					writefile("vibe_anims.json", HttpService:JSONEncode(packsStateService.State.FavoriteAnims))
