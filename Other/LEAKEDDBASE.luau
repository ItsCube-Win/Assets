	StaticParamsClass.__index = StaticParamsClass

	local tbl = {
		"UpperTorso",
		"HumanoidRootPart",
		"LowerTorso",
		"Head",
		"RightUpperArm",
		"LeftUpperArm",
		"RightUpperLeg",
		"LeftUpperLeg",
		"RightLowerArm",
		"LeftLowerArm",
		"RightLowerLeg",
