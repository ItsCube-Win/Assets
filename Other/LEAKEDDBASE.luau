		local function fn_applyWH(wantName, list)
			local lookup9Entry = lookup9[wantName]

			if lookup9Entry then
				return lookup9Entry
			end

			local lookup11 = {}

			for i = 1, #list.layers do
				local layerEntry = list.layers[i]
				local anchor = layerEntry.anchor
				local pos = layerEntry.pos
				local size = layerEntry.size

				if layerEntry.file and layerEntry.kind ~= "gradient" and layerEntry.kind ~= "particles" and anchor and pos and size and anchor[1] == 0.5 and anchor[2] == 0.5 then
					local obj

					for i2 = 1, #lookup11 do
						local lookup11Entry = lookup11[i2]

						if abs(lookup11Entry.cx - pos[1]) < 0.06 and abs(lookup11Entry.cy - pos[2]) < 0.06 then
							obj = lookup11Entry

							break
						end
					end

					if not obj then
						obj = {
							cx = pos[1],
							cy = pos[2],
							n = 0,
							set = {}
						}
						lookup11[#lookup11 + 1] = obj
					end

					obj.n += 1
					obj.set[layerEntry] = true

					if not obj.h or size[2] < obj.h then
						local sizeEntry = size[2]

						obj.w = size[1]
						obj.h = sizeEntry
					end
				end
			end

			local obj

			for i = 1, #lookup11 do
				local lookup11Entry = lookup11[i]

				if not obj or obj.n < lookup11Entry.n or lookup11Entry.n == obj.n and obj.h < lookup11Entry.h then
					obj = lookup11Entry
				end
			end

			if not obj then
				local amount, amount2, amount3_2, amount4 = fn_handleTable(list)

				obj = {
					cx = (amount + amount3_2) / 2,
					cy = (amount2 + amount4) / 2,
					w = amount3_2 - amount,
					h = amount4 - amount2,
					n = 0,
					set = {}
				}
			end

			local hero = list.stage and list.stage.hero
			local obj2 = type_(hero) == "table" and #hero == 4 and {
				cx = hero[1],
				cy = hero[2],
				w = hero[3],
				h = hero[4]
			} or lavandaEclipseConfig[wantName]

			if obj2 then
				obj = {
					cx = getNumber(obj2.cx, obj.cx),
					cy = getNumber(obj2.cy, obj.cy),
					w = getNumber(obj2.w, obj.w),
					h = getNumber(obj2.h, obj.h),
					n = obj.n,
					set = obj.set
				}
			end

			lookup9[wantName] = obj

			return obj
		end
		local function fn_handleTable3(wantName, floored, floored2, obj)
			local text = wantName .. "|" .. floored .. "|" .. floored2 .. "|" .. (obj.tag or "")
			local lookup10Entry = lookup10[text]

			if lookup10Entry ~= nil then
				return lookup10Entry
			end

			local fnHandleTable3Active = false
			local manifest = scene.manifest(wantName)

			if manifest and type_(manifest.layers) == "table" then
				local fn_applyWHResult = fn_applyWH(wantName, manifest)
				local stage = manifest.stage or {}
				local amount = getNumber(stage.w, 860) / getNumber(stage.h, 560)
				local pad = obj.pad or 0
				local maxValue = math.max(floored + 2 * pad, floored2 * amount)
				local maxValue2 = math.max(math.min(floored2 * (obj.hk or 1) / math.max(0.05, fn_applyWHResult.h) * amount, floored * 4), maxValue)
				local amount2 = maxValue2 / amount
				local clamped = math.clamp(floored - fn_applyWHResult.w * maxValue2 * (0.5 - (obj.cut or 0.25)) - fn_applyWHResult.cx * maxValue2, floored + pad - maxValue2, 0 - pad)
				local clamped2 = math.clamp(floored2 * (obj.hy or 0.5) - fn_applyWHResult.cy * amount2, floored2 - amount2, 0)
				local amount4 = (0 - clamped) / maxValue2
				local amount5 = (floored - clamped) / maxValue2
				local amount6 = (0 - clamped2) / amount2
				local amount7 = (floored2 - clamped2) / amount2
				local amount8 = (amount5 - amount4) * (amount7 - amount6)
				local lookup11 = {}
				local lookup12 = {}

				for i = 1, #manifest.layers do
					local layerEntry = manifest.layers[i]

					if layerEntry.kind == "gradient" then
						lookup11[#lookup11 + 1] = layerEntry
					elseif layerEntry.kind ~= "particles" and layerEntry.file and layerEntry.name ~= "veil" and scene.image(wantName, layerEntry.file) then
						if fn_applyWHResult.set[layerEntry] then
							lookup11[#lookup11 + 1] = layerEntry
						else
							local size = layerEntry.size or {
								1,
								1
							}
							local pos = layerEntry.pos or {
								0,
								0
							}
							local anchor = layerEntry.anchor or {
								0,
								0
							}
							local amount9 = pos[1] - anchor[1] * size[1]
							local amount10 = pos[2] - anchor[2] * size[2]
							local value = amount9 + size[1]
							local value2 = amount10 + size[2]
							local type_2 = layerEntry.anim and layerEntry.anim.type

							if type_2 == "scroll" then
								amount9 = amount4
								value = amount5
							end

							local amount11 = math.min(value, amount5) - math.max(amount9, amount4)
							local amount12 = math.min(value2, amount7) - math.max(amount10, amount6)

							if amount11 > 0 and amount12 > 0 then
								local amount13 = amount11 * amount12 / amount8 * (1 - getNumber(layerEntry.transparency, 0)) * (type_2 == "twinkle" and 0.5 or 1)

								if amount13 > 0.02 then
									lookup12[#lookup12 + 1] = {
										L = layerEntry,
										sc = amount13
									}
								end
							end
						end
					end
				end

				table.sort(lookup12, function(obj2, obj3)
					if obj2.sc == obj3.sc then
						return getNumber(obj2.L.z, 0) < getNumber(obj3.L.z, 0)
					end

					return obj2.sc > obj3.sc
				end)

				local amount9 = 1
				local min = math.min
				local lookup12Count = #lookup12
				local extra = obj.extra or 4

				for i = amount9, min(lookup12Count, extra) do
					lookup11[#lookup11 + 1] = lookup12[i].L
				end

				table.sort(lookup11, function(obj2, obj3)
					return getNumber(obj2.z, 0) < getNumber(obj3.z, 0)
				end)
				fnHandleTable3Active = {
					cw = maxValue2,
					ch = amount2,
					ox = clamped,
					oy = clamped2,
					pad = pad,
					layers = lookup11,
					pal = scene.palette(manifest)
				}
			end

			amount3 += 1

			if amount3 > 48 then
				lookup10 = {}
				amount3 = 1
			end

			lookup10[text] = fnHandleTable3Active

			return fnHandleTable3Active
		end

