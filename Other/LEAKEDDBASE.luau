					end
				end)
			end

			self._throwing = false

			return true
		end

		if throwKnifeObj then
			pcall(function()
				throwKnifeObj.charge:Stop(0.1)
			end)
		end

		self._throwing = false
		self:_say(throwKnifeFlag and "No clear angle." or "Target hid behind cover.", arg4)

		return false
	end
	SayClass.KillAll = function(self)
