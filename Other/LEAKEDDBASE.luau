		if not getgenv().LH_getgcWrapped then
			getgenv().LH_getgcWrapped = true
			pcall(function()
				if type_(getgc) ~= "function" then
					return
				end

				local getgc_ = getgc
				local getgcAmount = 0
				local getgcAmount2 = 0

				getgc = function(...)
					local now = tick()

					getgcAmount2 += 1

					if now - getgcAmount >= 1 then
						getgcAmount2 = 0
						getgcAmount = now
					end

					if getgcAmount2 > 5 then
						task.wait(math.random(50, 150) / 1000)
					end

					getgcAmount = tick()

					return getgc_(...)
				end
			end)
		end

