			paybackMaxSec = 86400,
			actionGapSec = 0.35,
			planEverySec = 1,
			ascendFirstLevel = 10,
			ascendRatio = 1.3,
			junkRatio = 0.01,
			wrinklerCashoutSec = 300,
			clickSteadyMin = 2.4,
			clickSteadyMax = 3.6,
			clickBurstMin = 8,
			clickBurstMax = 11
		}
	}
	local tbl = {
		"luckyStreak",
		"compoundVibes",
		"greedySquatters",
		"muscleMemory",
		"crowdedHouse",
		"generationalWealth",
		"secondNature",
		"lastingFortune",
		"oldMoney",
		"fourLeaf",
		"crewAngels",
		"dynasty",
		"gluttonTax",
		"packedLot",
		"legend",
		"fenceNetwork",
		"earlyHarvest",
		"nightShift",
		"goldenHour",
		"sugarVault"
	}
	local constants = {
		HUGE_COINS = 1e300,
		UTILITY_SECONDS = 60,
		BULK = 10,
		CLICK_BASE = 1,
		SURGE_BAND = 25,
		STEADY_DUTY = 0.9,
		STORM_CATCH = 0.85,
		LUCKY_SHARE = 0.15,
		LUCKY_SECONDS = 900
	}
	local CoinClicker = ReplicatedStorage:FindFirstChild("Features") and ReplicatedStorage.Features:FindFirstChild("CoinClicker")

	local function fn_unnamed(remotes)
		if not remotes then
			return nil
		end

		local ok, result = pcall(requireModule, remotes)

		return ok and result or nil
	end

	local obj2
	local planPurchaseObj
	local obj3
	local obj4
	local obj5
	local obj6
	local get
	local planPurchaseItems
	local planPurchaseObj2

	local function fn_handleRemotes()
		if not CoinClicker then
			return false
		end

		obj2 = obj2 or fn_unnamed(CoinClicker:FindFirstChild("Remotes"))
		planPurchaseObj = planPurchaseObj or fn_unnamed(CoinClicker:FindFirstChild("Catalog"))
		obj3 = obj3 or fn_unnamed(CoinClicker:FindFirstChild("Rules"))
		obj4 = obj4 or fn_unnamed(CoinClicker:FindFirstChild("Upgrades"))
		obj5 = obj5 or fn_unnamed(CoinClicker:FindFirstChild("Fortunes"))
		obj6 = obj6 or fn_unnamed(CoinClicker:FindFirstChild("Heavenly"))
		planPurchaseItems = planPurchaseItems or fn_unnamed(CoinClicker:FindFirstChild("Engine"))
		planPurchaseObj2 = planPurchaseObj2 or fn_unnamed(CoinClicker:FindFirstChild("Snapshot"))

		if not obj2 or not planPurchaseObj or not obj3 or not planPurchaseItems or not planPurchaseObj2 then
			return false
		end

		get = get or obj2.get and obj2.get() or obj2

		return get and get.Action and get.Open ~= nil
	end

	local random = Random.new()

	local function fn_runNextNumber(clickBurstMin, clickBurstMax)
		return clickBurstMin + (clickBurstMax - clickBurstMin) * random:NextNumber()
	end
	local function getServerTimeNow()
		return Workspace:GetServerTimeNow()
	end
	local function fn_handle2e(bank)
		local number = tonumber(bank) or 0
		local absValue = math.abs(number)

		if absValue >= 1e18 then
			return string.format("%.2e", number)
		end

		if absValue >= 1e15 then
			return string.format("%.2fQ", number / 1e15)
		end

		if absValue >= 1e12 then
			return string.format("%.2fT", number / 1e12)
		end

		if absValue >= 1e9 then
			return string.format("%.2fB", number / 1e9)
		end

		if absValue >= 1000000 then
			return string.format("%.2fM", number / 1000000)
