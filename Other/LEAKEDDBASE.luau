								createBillboardGuiAmount4 = 0
								createBillboardGuiAmount2 = 0
								createBillboardGuiAmount3 = 0
								TextLabel.Text = "|"
							else
								TextLabel.Text = text:sub(1, createBillboardGuiAmount3) .. "|"
							end
						end
					else
						TextLabel.Text = math.floor(createBillboardGuiAmount2 / 20) % 2 == 0 and "|" or ""

						if createBillboardGuiAmount2 > 60 then
							createBillboardGuiAmount4 = 1
							createBillboardGuiAmount2 = 0
							createBillboardGuiAmount3 = 0
						end
					end
				end
			end)

			if not l then
				if connection then
