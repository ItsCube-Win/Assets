			for _, section in ipairs_2(sections) do
				for _, row in ipairs(section.rows) do
					if row.type == "keybind" then
						valsCurrentGameConfig.vals[row.id] = row.key or ""
					elseif row.type == "togglekey" then
						valsCurrentGameConfig.vals[row.id] = row.value == true
						valsCurrentGameConfig.vals[row.id .. "_key"] = row.key or ""
					elseif row.type == "toggleslider" then
						valsCurrentGameConfig.vals[row.id] = row.value
						valsCurrentGameConfig.vals[row.id .. "_on"] = false
						valsCurrentGameConfig.vals[row.id .. "_key"] = row.key or ""
					elseif row.type ~= "button" and row.type ~= "buttons" and row.type ~= "status" and row.type ~= "note" then
						valsCurrentGameConfig.vals[row.id] = row.value
					end
				end
			end
		end
	end

	local registry = {}
	local lookup = {}
	local lookup2 = {}

	local function fn_unnamed2(sid, toggle)
		local registryEntry = registry[sid]

		if not registryEntry then
			registryEntry = {}
			registry[sid] = registryEntry
		end

		for i = #registryEntry, 1, -1 do
			if not registryEntry[i].Parent then
				table.remove(registryEntry, i)
			end
		end

		registryEntry[#registryEntry + 1] = toggle
	end
	local function fn_runUpper(sid, valEntry, arg3)
		local lookup2Entry = lookup2[sid]

		if lookup2Entry and lookup[lookup2Entry] and lookup[lookup2Entry].id == sid then
			lookup[lookup2Entry] = nil
		end

		local mode = (valEntry or ""):upper()

		if mode == "" then
			lookup2[sid] = nil
		else
			lookup[mode] = {
				id = sid,
				fn = arg3
			}
			lookup2[sid] = mode
		end
	end

	local lookup3 = {}
	local lookup4 = {}
	local lookup5 = {}
	local onUnloadList = {}

	local function fn_handleNumber(mode, valEntry)
		local kind = type_(valEntry)

		if kind == "number" then
			return valEntry == valEntry and math.abs(valEntry) ~= math.huge
		end

		if kind == "table" then
			return mode == "__ui_hud"
		end

		return kind == "boolean" or kind == "string" or kind == "nil"
	end
	local function fn_unnamed3(sid, valEntry)
		local registryEntry = registry[sid]

		if not registryEntry then
			return
		end

		for i = #registryEntry, 1, -1 do
			local registryEntryEntry = registryEntry[i]

			if registryEntryEntry.Parent then
				pcall(registryEntryEntry.Set, registryEntryEntry, valEntry)
			else
				table.remove(registryEntry, i)
			end
		end
	end
	local function fn_unnamed4(sid, selected)
		local lookup3Entry = lookup3[sid]

		if lookup3Entry then
			for _, v in ipairs(lookup3Entry) do
				pcall(v, selected)
			end
		end
	end
	local function fn_unnamed5(arg1, dropdown)
		local lookup5Entry = lookup5[arg1]

		if not lookup5Entry then
			lookup5Entry = {}
			lookup5[arg1] = lookup5Entry
		end

		for i = #lookup5Entry, 1, -1 do
			if not lookup5Entry[i].Parent then
				table.remove(lookup5Entry, i)
			end
		end

		lookup5Entry[#lookup5Entry + 1] = dropdown
	end
	local function fn_unnamed6(sid, valEntry)
		if not fn_handleNumber(sid, valEntry) then
			return
		end

		valsCurrentGameConfig.vals[sid] = valEntry
		fn_unnamed3(sid, valEntry)
		fn_unnamed4(sid, valEntry)

		if palette3.permaIds[sid] then
			pcall(palette3.syncPerma)
		end

		if valsCurrentGameConfig.onValChanged then
			pcall(valsCurrentGameConfig.onValChanged, sid, valEntry)
		end
	end
	local function fn_unnamed7(sid)
		local lookup4Entry = lookup4[sid]

		if lookup4Entry then
			for _, v in ipairs(lookup4Entry) do
				pcall(v)
			end
		end

		local api = valsCurrentGameConfig.api

		if api and api.toastForButton then
			pcall(api.toastForButton, sid)
		end
	end

	_G.LowHub = {
		on = function(arg1, arg2)
			lookup3[arg1] = lookup3[arg1] or {}
			table.insert(lookup3[arg1], arg2)
		end,
		onClick = function(arg1, inviteOpen)
			lookup4[arg1] = lookup4[arg1] or {}
			table.insert(lookup4[arg1], inviteOpen)
		end,
		set = function(loop, val)
			fn_unnamed6(loop, val)
		end,
		setSilent = function(lookupEntry, enabled)
			if not fn_handleNumber(lookupEntry, enabled) then
				return
			end

			valsCurrentGameConfig.vals[lookupEntry] = enabled
			fn_unnamed3(lookupEntry, enabled)
		end,
		get = function(theme)
			return valsCurrentGameConfig.vals[theme]
		end,
		setDropdownOptions = function(arg1, profileList, activeProfile)
			if type_(profileList) ~= "table" then
				return
			end

			valsCurrentGameConfig.dropOpts[arg1] = profileList

			local lookup5Entry = lookup5[arg1]

			if lookup5Entry then
				for i = #lookup5Entry, 1, -1 do
					local lookup5EntryEntry = lookup5Entry[i]

					if lookup5EntryEntry.Parent then
						pcall(lookup5EntryEntry.SetOptions, profileList)

						if activeProfile ~= nil then
							pcall(lookup5EntryEntry.SetValue, activeProfile)
						end
					else
						table.remove(lookup5Entry, i)
					end
				end
			end

			if activeProfile ~= nil then
				valsCurrentGameConfig.vals[arg1] = activeProfile
			end
		end,
		setFavorites = function(favorites)
			valsCurrentGameConfig.favorites = favorites or {}

			if valsCurrentGameConfig.favRender then
				pcall(valsCurrentGameConfig.favRender)
			end
		end,
		setStatus = function(arg1, reason, enabled, visible)
			local statusCache = valsCurrentGameConfig.statusCache
			local statusCacheEntry = statusCache[arg1]

			if visible == nil and statusCacheEntry then
				visible = statusCacheEntry.sub
			end

			if enabled == nil then
				enabled = true
			end

			statusCache[arg1] = {
				value = reason,
				ok = enabled,
				sub = visible
			}

			local statusRowEntry = valsCurrentGameConfig.statusRows[arg1]

			if not statusRowEntry then
				return
			end

			if statusRowEntry.lbl then
				statusRowEntry.lbl.Text = reason == nil and "—" or tostring(reason)
			end

			if statusRowEntry.dot then
				statusRowEntry.dot.BackgroundColor3 = palette3.statusColor(enabled)
			end

			local sub = statusRowEntry.sub

			if visible ~= nil and sub then
				if sub:IsA("TextLabel") then
					sub.Text = tostring(visible)
					sub.Visible = visible ~= ""

					if statusRowEntry.fit then
						pcall(statusRowEntry.fit)
					end
				else
					local part

					for _, child in ipairs(sub:GetChildren()) do
						if child:IsA("TextLabel") and (not part or part.Position.Y.Offset < child.Position.Y.Offset) then
							part = child
						end
					end

					if part and part.Position.Y.Offset >= 20 then
						part.Text = tostring(visible)
					end
				end
			end
		end,
		suppressKeys = function(suppressKeys)
			valsCurrentGameConfig.suppressKeys = suppressKeys == true
		end,
		state = valsCurrentGameConfig
	}
	valsCurrentGameConfig.api = _G.LowHub
