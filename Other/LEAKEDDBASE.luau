	SayClass.ShootAt = function(self, arg2, shotMode, arg4)
		if not self.Roles:AmSheriff() then
			self:_say("You don't have the gun.", arg4)

			return false
		end

		local findMurdererResult = arg2 or self.Roles:FindMurderer()

		if findMurdererResult then
			if self.Roles:IsAlive(findMurdererResult) then
				if not self:GunReady() then
					return false
				end

				local Weapon_Gun = fn_hasTag("Weapon_Gun")
				local Shoot = Weapon_Gun and Weapon_Gun:FindFirstChild("Shoot")

				if not Shoot then
					return false
				end

				local muzzleResult = self.Aim:Muzzle()

				if not muzzleResult then
					if not self:_equip(Weapon_Gun) then
						return false
					end

					muzzleResult = self.Aim:Muzzle()

					if not muzzleResult then
						return false
					end
				end

				local ShotMode = shotMode or self.State.ShotMode
				local shotMode2 = ShotMode or "Legit"

				if shotMode2 == "Rage" then
					local remoteArg, shootAtValue2 = self.Aim:WithShotParams(findMurdererResult, self.Aim.RageRay, self.Aim, findMurdererResult)

					if remoteArg then
						if not self:_equip(Weapon_Gun) then
							return false
						end

						self._lastShot = os.clock()
						Shoot:FireServer(remoteArg, shootAtValue2)

						return true
					end
				end

				local fnapplyFilterResult = fnapplyFilter(Weapon_Gun, muzzleResult)
				local solveResult = not fnapplyFilterResult and self.Aim:Solve(findMurdererResult, muzzleResult.Position, "gun") or nil
				local cFrame = muzzleResult

				if not solveResult and fnapplyFilterResult then
					local Character = LocalPlayer.Character

					for _, v in ipairs({
						"Head",
						"UpperTorso",
						"Torso"
					}) do
						local findFirstChildResult = Character and Character:FindFirstChild(v)

						if findFirstChildResult then
							local solveResult2 = self.Aim:Solve(findMurdererResult, findFirstChildResult.Position, "gun")

							if solveResult2 then
								solveResult = solveResult2
								cFrame = CFrame.lookAt(findFirstChildResult.Position, solveResult2)

								break
							end
						end
					end
				end

				if not solveResult then
					if shotMode2 ~= "Rage" then
						self:_say("Murderer not visible from your gun.", arg4)

						return false
					end

					solveResult = self.Aim:Solve(findMurdererResult, workspace.CurrentCamera.CFrame.Position, "gun") or findMurdererResult.Character.HumanoidRootPart.Position + self.Aim:PredictDelta(findMurdererResult, self.Aim:GunLead())
