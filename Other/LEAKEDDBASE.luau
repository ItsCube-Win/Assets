	end
	legitDelayService.SetEnabled = function(self, enabled)
		self.Enabled = enabled == true

		if self.Enabled then
			self:Start()
		end
	end
	legitDelayService.PlayNow = function(self)
		startFlag2 = true
		self:Start()
	end
	legitDelayService.SetLegit = function(self, legit)
		self.Legit = legit == true
	end
	legitDelayService.SetDelay = function(self, arg2)
		local clamp = math.clamp

		self.Delay = clamp(tonumber(arg2) or 0.8, 0, 5)
	end
	legitDelayService.SetAimTime = function(self, arg2)
		self.AimTime = math.clamp(tonumber(arg2) or 0.9, 0.2, 3)
	end

	return legitDelayService
end
moduleDefs["Games.Mushyo.FishFilter"] = function()
	local Players = game_:GetService("Players")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local getAllFishList
	local signal
	local LocalPlayer = Players.LocalPlayer

	local function fn_unnamed()
		if not getAllFishList then
			pcall(function()
				getAllFishList = requireModule(ReplicatedStorage.Configuration.Fish)
			end)
		end

		if not signal then
			pcall(function()
				signal = requireModule(ReplicatedStorage.Modules.Events)
			end)
		end

		return signal ~= nil
	end
	local function fn_runBind(arg1, arg2, arg3)
		if not fn_unnamed() then
			return nil
		end

		local flag
		local bindResult = signal:Bind(arg2, function(arg1_2)
			if type_(arg1_2) == "table" then
				flag = arg1_2
			end
		end)

		pcall(function()
			signal:Fire(arg1)
		end)

		local now = os.clock()

		while not flag do
			if not (os.clock() - now < (arg3 or 3)) then
				break
			end

			task.wait(0.1)
		end

		pcall(function()
			bindResult:Disconnect()
		end)

		return flag
	end
	local function fnrunFind()
		local NPCS = workspace:FindFirstChild("NPCS")
		local Fisherman = NPCS and NPCS:FindFirstChild("Fisherman")

		if Fisherman then
			return Fisherman.PrimaryPart or Fisherman:FindFirstChild("HumanoidRootPart") or Fisherman:FindFirstChildWhichIsA("BasePart")
		end

		return nil
	end

	return {
		LockedTypes = {},
		GetInventory = function()
			return fn_runBind("SendFishes", "FishesChanged", 3) or {}
		end,
		GetServerLocks = function()
			return fn_runBind("GetLockedFishes", "LockedFishesUpdated", 3) or {}
		end,
		GetAllFish = function()
			fn_unnamed()

			if not getAllFishList then
				return {}
			end

			local registry = {}

			for k, fishe in pairs(getAllFishList.fishes) do
				table.insert(registry, {
					name = k,
					rarity = fishe.Rarity or "Common",
					weight = fishe.Weight or 1,
					priceMin = fishe.Price and fishe.Price.Min or 0,
					priceMax = fishe.Price and fishe.Price.Max or 0
				})
			end

			local commonUncommonConfig = {
				Common = 1,
				Uncommon = 2,
				Rare = 3,
				Legendary = 4,
				Mythical = 5
			}

			table.sort(registry, function(obj, obj2)
				local getAllFishAmount = commonUncommonConfig[obj.rarity] or 0
				local getAllFishAmount2 = commonUncommonConfig[obj2.rarity] or 0

				if getAllFishAmount == getAllFishAmount2 then
					return obj.name < obj2.name
				end

				return getAllFishAmount < getAllFishAmount2
			end)

			return registry
		end,
		IsLocked = function(self, name)
			return self.LockedTypes[name] == true
		end,
		ToggleLock = function(self, name)
			if self.LockedTypes[name] then
				self.LockedTypes[name] = nil
			else
				self.LockedTypes[name] = true
			end
		end,
		GetLockedTypes = function(self)
			return self.LockedTypes
		end,
		HasFilter = function(self)
			for _ in pairs(self.LockedTypes) do
				return true
			end

			return false
		end,
		ApplyLocks = function(self)
			if not fn_unnamed() then
				return 0, 0, 0
			end

			local inventory = self:GetInventory()
			local serverLocks = self:GetServerLocks()
			local lookup = {}
			local applyLocksAmount = 0
			local applyLocksAmount2 = 0

			for k, v in pairs(inventory) do
				applyLocksAmount2 += 1

				local applyLocksFlag = self.LockedTypes[v.Name] == true

				if applyLocksFlag then
					applyLocksAmount += 1
				end

				if applyLocksFlag ~= (serverLocks[k] == true) then
					lookup[#lookup + 1] = {
						idx = k,
						ligar = applyLocksFlag
					}
				end
			end

			local applyLocksAmount3 = 0
			local applyLocksAmount4 = 0

			for _, v in ipairs(lookup) do
				pcall(function()
					signal:Fire("LockFish", v.idx)
				end)

				if v.ligar then
					applyLocksAmount3 += 1
				else
					applyLocksAmount4 += 1
				end

				task.wait(0.12)
			end

			if #lookup > 0 then
				local now = os.clock()

				while os.clock() - now < 2 do
					local serverLocks2 = self:GetServerLocks()
					local applyLocksFlag = true

					for k, v in pairs(inventory) do
						if self.LockedTypes[v.Name] == true ~= (serverLocks2[k] == true) then
							applyLocksFlag = false

							break
						end
					end

					if not applyLocksFlag then
						task.wait(0.2)

						continue
					end

					break
				end
			end

			return applyLocksAmount, applyLocksAmount2, applyLocksAmount4
		end,
		SmartSell = function(self)
			if not fn_unnamed() then
				return false
			end

			local Character = LocalPlayer.Character
			local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

			if not HumanoidRootPart then
				return false
			end

			local smartSellAmount, v1592 = self:ApplyLocks()

			if smartSellAmount2 == 0 then
				return false
			end

			if smartSellAmount2 <= smartSellAmount then
				return false
			end

			local CFrame_ = HumanoidRootPart.CFrame
			local fnrunFindResult = fnrunFind()

			HumanoidRootPart.CFrame = fnrunFindResult and fnrunFindResult.CFrame * CFrame.new(0, 0, 6) or CFrame.new(4989, 181, -84)
			task.wait(0.5)
			pcall(function()
				signal:Fire("SellAllFishes")
			end)
			task.wait(0.6)

			if HumanoidRootPart.Parent then
				HumanoidRootPart.CFrame = CFrame_
			end

			task.wait(0.4)
			self:ApplyLocks()

			return true
		end
	}
end
