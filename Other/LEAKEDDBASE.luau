					fn_applyGSf(g, g.input, g.committed, false)
				end
			end
			frame4.InputBegan:Connect(function(input)
				local UserInputType = input.UserInputType

				if UserInputType ~= MouseButton1 and UserInputType ~= Touch or cancelService.g then
					return
				end

				local toLayer = palette3.L.toLayer(input.Position)

				if dragObj.begin and dragObj.begin(input, toLayer) == false then
					return
				end

				local g = {
					handle = cancelService,
					gui = frame4,
					opts = dragObj,
					input = input,
					mouse = UserInputType == MouseButton1,
					start = toLayer,
					committed = false,
					th = dragObj.threshold or palette3.tok.drag,
					axis = dragObj.axis
				}

				cancelService.g = g
				lookup8[#lookup8 + 1] = g

				if dragObj.immediate and dragObj.move then
					dragObj.move(input, Vector2.zero, toLayer)
				end
			end)

			return cancelService
		end
		palette3.track(UserInputService.InputChanged:Connect(function(l)
			local y = #lookup8

			if y == 0 then
				return
			end

			local S = l.UserInputType
			local b = S == MouseMovement

			if not b and S ~= Touch then
				return
			end

			local W = palette3.layer.app
			local K = W and W.AbsolutePosition or Vector2.zero
			local W = l.Position
			local c = Vector2.new(W.X - K.X, W.Y - K.Y)

			for W = y, 1, -1.0 do
				local K = lookup8[W]

				if K and ((b and K.mouse) or ((not b) and K.input == l)) then
					if not K.gui.Parent then
						fn_applyGSf(K, l, K.committed, false)
					else
						local W = c - K.start

						if not K.committed then
							local M = K.th
							local G = K.axis

							if G then
								local Y, y = math.abs(W.X), math.abs(W.Y)
								local h = (G == "x") and Y or y
								local S = (G == "x") and y or Y

								if h > M and h >= S then
									fn_applyCommittedSf(K)
								elseif S > M and S > h then
