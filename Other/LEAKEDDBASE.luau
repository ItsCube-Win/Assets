	local function fn_handleNumber(expiresAt)
		if type_(expiresAt) == "number" then
			return expiresAt
		end

		if type_(expiresAt) == "string" then
			local number = tonumber(expiresAt)

			if number then
				return number
			end
		end

		return nil
	end

	return {
		Listeners = {},
		State = {
			Active = false,
			Owner = false,
			Plan = nil,
			Tier = nil,
			ExpiresAt = nil,
			Frozen = false,
			Connected = false,
