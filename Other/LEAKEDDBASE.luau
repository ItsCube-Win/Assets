			if type_(obj) ~= "table" then
				return
			end

			local featureDefinitions, featureOrder, v5488 = FeatureCatalog.Normalize(obj.featureDefinitions or obj.features or obj.allowedFeatures or obj.allowed_features)
			local fn_handleNumberResult = fn_handleNumber(obj.expiresAt or obj.expires_at or obj.expiration)
			local plan = obj.plan or obj.tier or self.State.Plan
			local active = obj.active
			local frozen = obj.frozen == true

			if active == nil then
				if plan == "lifetime" or frozen then
					active = true
				elseif fn_handleNumberResult == nil then
					active = plan ~= nil
				else
					active = fn_handleNumberResult > os.time()
				end
			end

			self.State.Active = active == true
			self.State.Plan = plan
			self.State.Tier = obj.tier or plan
			self.State.ExpiresAt = fn_handleNumberResult
			self.State.Frozen = frozen
			self.State.AllFeatures = obj.allFeatures == true or obj.all_features == true or obj.fullAccess == true or obj.full_access == true or self.State.Active and not updateFromPayloadFlag3
			self.State.AllowedFeatures = {}
			self.State.FeatureDefinitions = featureDefinitions
			self.State.FeatureOrder = featureOrder
			self.State.LastSyncAt = os.time()

			for k in pairs(featureDefinitions) do
				self.State.AllowedFeatures[k] = true
			end

			if self.State.Owner then
				self.State.Active = true
				self.State.AllFeatures = true
				self.State.Tier = "Owner"
			end

			self:Notify()
		end,
		SetOwner = function(self, owner)
			self.State.Owner = owner == true

			if self.State.Owner then
				self.State.Active = true
				self.State.AllFeatures = true
				self.State.Plan = self.State.Plan or "lifetime"
				self.State.Tier = "Owner"
			end

			self:Notify()
		end,
		IsVIPActive = function(self)
			if self.State.Owner then
				return true
			end

			if self.State.FreeMode then
				return true
			end

			if self.State.Plan == "lifetime" then
				return true
			end

			if self.State.Frozen then
				return self.State.Active == true
			end

			if self.State.ExpiresAt and self.State.ExpiresAt <= os.time() then
				return false
			end

			return self.State.Active == true
		end,
		CanUse = function(self, arg2)
			if self.State.Owner then
				return true
			end

			if not self:IsVIPActive() then
				return false
			end

			if self.State.AllFeatures then
				return true
			end

			return self.State.AllowedFeatures[arg2] == true
		end,
		FormatRemaining = function(obj)
			if obj.State.FreeMode then
				return "Free mode"
			end

			if obj.State.Plan == "lifetime" then
				return "Lifetime"
			end

			if not obj.State.ExpiresAt then
				return "Awaiting sync"
			end

			local formatRemainingAmount = obj.State.ExpiresAt - os.time()

			if formatRemainingAmount <= 0 then
				return "Expired"
			end

			local floored = math.floor(formatRemainingAmount / 86400)
			local floored2 = math.floor(formatRemainingAmount % 86400 / 3600)
			local floored3 = math.floor(formatRemainingAmount % 3600 / 60)

			if floored > 0 then
				return string.format("%dd %dh", floored, floored2)
			end

			if floored2 > 0 then
				return string.format("%dh %dm", floored2, floored3)
			end

			return string.format("%dm", floored3)
		end
	}
end
