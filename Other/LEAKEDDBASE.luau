	end
	local function fnrunFind3()
		local NPCS = workspace:FindFirstChild("NPCS")
		local Miner = NPCS and NPCS:FindFirstChild("Miner")

		if not Miner then
			return nil
		end

		local PrimaryPart = Miner.PrimaryPart or Miner:FindFirstChild("HumanoidRootPart")

