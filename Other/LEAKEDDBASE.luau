			if type_(obj.idle) == "table" then
				fn_applyAnimationId(fn_runMatch(obj.idle[1]), "idle", "Animation1")
				fn_applyAnimationId(fn_runMatch(obj.idle[2] or obj.idle[1]), "idle", "Animation2")
			elseif obj.idle then
				fn_applyAnimationId(fn_runMatch(obj.idle), "idle")
			end

			fn_applyAnimationId(fn_runMatch(obj.run), "run")
			fn_applyAnimationId(fn_runMatch(obj.walk), "walk")
			fn_applyAnimationId(fn_runMatch(obj.jump), "jump")
			fn_applyAnimationId(fn_runMatch(obj.fall), "fall")
			fn_applyAnimationId(fn_runMatch(obj.climb), "climb")

			if obj.swim then
				fn_applyAnimationId(fn_runMatch(obj.swim), "swim")
			end

			fn_applyDisabled()
		end,
		ApplyFullPack = function(self, activePack)
			local packEntry = self.Packs[activePack]

			if not packEntry then
				return false
			end

			self.ActivePack = activePack
			self.CustomMix = {}
			self:ApplyPack(packEntry)

			return true
		end,
		ApplyCustomMix = function(self, customMix)
			local walkConfig = {}

			for _, animType in ipairs(self.AnimTypes) do
				local customMixEntry = customMix[animType]

				if customMixEntry and self.Packs[customMixEntry] then
					local packEntryEntry = self.Packs[customMixEntry][animType]

					if packEntryEntry then
						walkConfig[animType] = packEntryEntry
					end
				end
			end

			if walkConfig.run then
				walkConfig.walk = walkConfig.run
			end

			self.ActivePack = nil
			self.CustomMix = customMix
			self:ApplyPack(walkConfig)
		end,
		ResetAll = function(self)
			self.ActivePack = nil
			self.CustomMix = {}
			fn_applyDisabled2()
			fn_applyAnimationId2()
			fn_applyDisabled()
		end,
		GetPackNames = function(self)
			return self.PackOrder
		end
	}
end
