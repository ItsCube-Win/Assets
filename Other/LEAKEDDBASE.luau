		end

		table.sort(lookup2, function(amount4, amount5)
			return math.abs(amount4 - (amount + 1) / 2) < math.abs(amount5 - (amount + 1) / 2)
		end)

		local lookup2Entry = lookup2[1]
		local flag2 = mode == "eu" and flag or arg9
		local huge = mode == "eu" and -math.huge or math.huge

		for _, v in ipairs(lookup2) do
			local value = getEntryCount(items, v) + 1

			items[v][value] = flag2

			local amount4

			if fn_unnamed4(items, amount, amount2, v, value, flag2) then
				amount4 = mode == "eu" and 1000 - amount3 or amount3 - 1000
			elseif amount3 >= 6 then
				amount4 = fn_unnamed5(items, amount, amount2, flag, arg9)
			else
				amount4 = fn_handleEu(items, amount, amount2, amount3 + 1, huge2, huge3, mode == "eu" and "ele" or "eu", flag, arg9)
			end

			items[v][value] = nil

			if mode == "eu" then
				if huge < amount4 then
					huge = amount4
					lookup2Entry = v
				end

				if huge2 < huge then
					huge2 = huge
				end
			else
				if amount4 < huge then
					huge = amount4
					lookup2Entry = v
				end

				if huge < huge3 then
					huge3 = huge
				end
			end

			if huge3 <= huge2 then
				break
			end
		end

		return huge, lookup2Entry
	end

	ticTacToeConnect4Config.Connect4 = {
		nome = "Connect 4",
		kindPayload = "connect4",
		detect = function(instance)
			local ActiveBoard = instance:FindFirstChild("ActiveBoard")

			if not ActiveBoard then
				return false
			end

			for _, descendant in ipairs(ActiveBoard:GetDescendants()) do
				if descendant:IsA("BasePart") and descendant:GetAttribute("C4Column") then
					return true
				end
			end

			return false
		end,
		minhaVez = function(obj)
			return obj.kind == "connect4" and obj.turnUserId == LocalPlayer.UserId and not obj.winnerUserId and not obj.draw
		end,
		jogada = function(obj, legit, remoteArg)
			local jogadaMode = obj.redUserId == LocalPlayer.UserId and "Red" or "Blue"
			local jogadaValue = jogadaMode == "Red" and "Blue" or "Red"
			local jogadaItems, jogadaValue2, v3050 = fn_getAttribute(remoteArg)

			if not jogadaItems then
				return nil
			end

			local _, v3052 = fn_handleEu(jogadaItems, jogadaValue2, jogadaAmount3, 0, -math.huge, math.huge, "eu", jogadaMode, jogadaValue)

			if not jogadaFlag2 then
				return nil
			end

			if legit and random:NextNumber() < 0.2 then
				local lookup2 = {}

				for i = 1, jogadaValue2 do
					if i ~= jogadaFlag2 and getEntryCount(jogadaItems, i) < jogadaAmount3 then
						local jogadaValue3 = getEntryCount(jogadaItems, i) + 1

						jogadaItems[i][jogadaValue3] = jogadaValue

						local jogadaFlag = fn_unnamed4(jogadaItems, jogadaValue2, jogadaAmount3, i, jogadaValue3, jogadaValue)

						jogadaItems[i][jogadaValue3] = nil

						if not jogadaFlag then
							lookup2[#lookup2 + 1] = i
						end
					end
				end

				if #lookup2 > 0 then
					jogadaFlag2 = lookup2[random:NextInteger(1, #lookup2)]
				end
			end

			return {
				kind = "drop",
				column = jogadaFlag2
			}
		end
	}

	local function fn_hasTag()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local SeatPart = Humanoid and Humanoid.SeatPart

		if not SeatPart then
			return nil
		end

		local Parent = SeatPart

		while Parent do
			if Parent:IsA("Model") and CollectionService:HasTag(Parent, "MinigameStation") then
				return Parent
			end

			Parent = Parent.Parent
		end

		return nil
	end
	local function fn_getAttribute2(instance, obj)
		for _, v in pairs(ticTacToeConnect4Config) do
			if v.detect and v.detect(instance) then
				return v
			end
		end

		if obj and obj.kind then
			for _, v in pairs(ticTacToeConnect4Config) do
				if v.kindPayload == obj.kind then
					return v
				end
			end
		end

		local attribute = instance:GetAttribute("MinigameId")

		return attribute and ticTacToeConnect4Config[attribute] or nil
	end

	legitDelayService.Describe = function(self)
		local fn_hasTagResult = fn_hasTag()

		if not fn_hasTagResult then
			return self.Enabled and "On — sit at a table" or "Idle"
		end

		local attribute = fn_hasTagResult:GetAttribute("MgState") or "?"
		local lookupEntry = lookup[fn_hasTagResult]
		local fn_getAttribute2Result = fn_getAttribute2(fn_hasTagResult, lookupEntry)

		if fn_getAttribute2Result then
			return ("%s · %s · %s"):format(fn_getAttribute2Result.nome, attribute, lookupEntry and fn_getAttribute2Result.minhaVez(lookupEntry) and "your turn" or "waiting")
		end

		return ("%s — not supported yet"):format(attribute)
	end

	local function fn_runNextNumber(remoteArg, arg2)
		local fn_getAttribute2Result = fn_getAttribute2(remoteArg, arg2)

		if not fn_getAttribute2Result then
			return
		end

		if not fn_getAttribute2Result.minhaVez(arg2) then
			return
		end

		local now = os.clock()

		if now - amount6 < 0.6 then
			return
		end

		local jogada = fn_getAttribute2Result.jogada(arg2, legitDelayService.Legit, remoteArg)

		if not jogada then
			return
		end

		amount6 = now

		local Delay = legitDelayService.Delay

		if legitDelayService.Legit then
			Delay += random:NextNumber() * 1.5
		end

		task.delay(Delay, function()
			if not legitDelayService.Enabled then
				return
			end

			local lookupEntry = lookup[remoteArg]

			if not lookupEntry or not fn_getAttribute2Result.minhaVez(lookupEntry) then
				return
			end

			pcall(function()
				ClientInput:FireServer(remoteArg, jogada)
			end)
			fn_applyStatus(legitDelayService:Describe())
		end)
	end

	legitDelayService.Start = function(self)
		if self.Enabled then
			return
		end

		if not ClientInput or not StateUpdate then
			fn_applyStatus("Framework not found")

			return
		end

		self.Enabled = true

		if connection then
			pcall(function()
				connection:Disconnect()
			end)
		end

		connection = StateUpdate.OnClientEvent:Connect(function(arg1, obj)
			if not legitDelayService.Enabled then
				return
			end

			if typeof(arg1) ~= "Instance" or typeof(obj) ~= "table" then
				return
			end

			local payload = obj.payload

			if typeof(payload) ~= "table" then
				return
			end

			lookup[arg1] = payload
			fn_applyStatus(legitDelayService:Describe())
			pcall(fn_runNextNumber, arg1, payload)
		end)
		fn_applyStatus(self:Describe())
	end
	legitDelayService.Stop = function(self)
		self.Enabled = false

		if connection then
			pcall(function()
				connection:Disconnect()
			end)
			connection = nil
		end

		table.clear(lookup)
		fn_applyStatus("Idle")
	end
	legitDelayService.SetEnabled = function(self, flag)
		if flag then
			self:Start()
		else
			self:Stop()
		end
	end
	legitDelayService.SetLegit = function(self, legit)
		self.Legit = legit == true
	end
	legitDelayService.SetDelay = function(self, arg2)
		self.Delay = math.clamp(tonumber(arg2) or 1.2, 0, 5)
	end
	legitDelayService.Suportados = function()
		local lookup2 = {}

		for _, v in pairs(ticTacToeConnect4Config) do
			lookup2[#lookup2 + 1] = v.nome
		end

		table.sort(lookup2)

		return lookup2
	end

	return legitDelayService
end
moduleDefs["Games.VozParque.ParkHero"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local statusOnStatus = {
		Enabled = false,
		Status = "Idle",
		OnStatusChanged = nil,
		Legit = false,
		Precisao = 95,
		Good = 15,
		ComboMax = 0
	}
	local connection
	local thread
	local startAmount = 0
	local random = Random.new()
	local getMatchFlag
	local startFlag
	local value
	local rawValue = 5
	local startAmount2 = 0

	local function fn_handlePress(l)
		local x = rawget(l, "press")

		if type_(x) ~= "function" then
			return nil
		end

		for l = 1, 15 do
			local K, Y = pcall(debug.getupvalue, x, l)

			if not K then
				break
			end

			if type_(Y) == "function" then
				local l, W = pcall(debug.info, Y, "a")

				if l and W == 3 then
					local l, W = pcall(debug.getconstants, Y)

					if l and type_(W) == "table" then
						for l = 1, #W do
							if W[l] == 1.2 then
								return Y
							end
						end
					end
				end
			end
		end

		return nil
	end
	local function fn_handleTable()
		local l, M = nil, nil

		pcall(function()
			local i = getgc(true)

			for c = 1, #i do
				local G = i[c]

				if type_(G) == "table" then
					local i = rawget(G, "press")

					if type_(i) == "function" then
						local i = rawget(G, "chart")

						if type_(i) == "table" then
							local i = rawget(G, "laneCount")

							if type_(i) == "number" and rawget(G, "over") ~= true then
								local i = rawget(G, "startAt")

								if type_(i) == "number" and i == i and i ~= Infinity then
									if not M or i > M then
										l, M = G, i
									end
								end
							end
						end
					end
				end
			end
		end)

		return l
	end

	statusOnStatus.GetMatch = function()
		return getMatchFlag
	end

	local function fn_applyStatus(l)
		statusOnStatus.Status = l

		if statusOnStatus.OnStatusChanged then
			pcall(statusOnStatus.OnStatusChanged, l)
		end
	end

	statusOnStatus.Describe = function(self)
		local describeFlag = getMatchFlag

		if not describeFlag then
			return self.Enabled and "On (waiting for music)" or "Idle"
		end

		local text = self.Legit and "Legit " .. self.Precisao .. "%" or "Perfect"

		return ("%s · combo %s · %sP %sG %sM"):format(text, tostring(rawget(describeFlag, "combo") or 0), tostring(rawget(describeFlag, "perfect") or 0), tostring(rawget(describeFlag, "good") or 0), tostring(rawget(describeFlag, "miss") or 0))
	end
	statusOnStatus.SetLegit = function(self, legit)
		self.Legit = legit == true
	end
	statusOnStatus.SetPrecisao = function(self, arg2)
		self.Precisao = math.clamp(tonumber(arg2) or 95, 50, 100)
	end
	statusOnStatus.SetGood = function(self, arg2)
		self.Good = math.clamp(tonumber(arg2) or 15, 0, 60)
	end
	statusOnStatus.SetComboMax = function(self, arg2)
		self.ComboMax = math.max(0, math.floor(tonumber(arg2) or 0))
	end

	local function fn_applyAutoHit(l)
		if not l.Enabled then
			return
		end

		if not getMatchFlag or not startFlag then
			return
		end

		if rawget(getMatchFlag, "over") then
			getMatchFlag = nil
			startFlag = nil
			value = nil

			return
		end

		local b = getMatchFlag

		if rawget(b, "loading") then
			return
		end

		local y = rawget(b, "startAt")

		if type_(y) ~= "number" or y == Infinity then
			return
		end

		local U = rawget(b, "clockOff") or 0
		local _ = os.clock() - y + U
		local y = rawget(b, "chart")

		if not y then
			return
		end

		local U = rawget(b, "visualCursor") or 1
		local t = rawget(b, "autoRel")
		local H = startFlag
		local h = l.Legit
		local j = l.ComboMax
		local E = l.Precisao
		local q = l.Good
		local V = #y

		for A = U, V do
			local U = y[A]

			if type_(U) ~= "table" then
				break
			end

			local y = U.t
			local V = U.l

			if type_(y) ~= "number" or type_(V) ~= "number" then
				continue
			end

			if y - _ > 0.2 then
				break
			end

			if U.hit or U.dead or U.autoHit then
				continue
			end

			if y > _ then
				continue
			end

			if h then
				local h = rawget(b, "combo") or 0
				local A = false

				if j > 0 and h >= j then
					A = true
				end

				if not A and random:NextNumber() * 100 > E then
					A = true
				end

				if A then
					U.autoHit = true
				else
					U.autoHit = true

					local h = (random:NextNumber() * 100 < q) and (0.09 + random:NextNumber() * 0.05) or 0

					pcall(H, U, h, false)

					if t then
						local M = U.d

						t[V] = (type_(M) == "number" and M > 0) and (y + M + 0.05) or (_ + 0.09)
					end
				end
			else
				U.autoHit = true
				pcall(H, U, 0, false)

				if t then
					local M = U.d

					t[V] = (type_(M) == "number" and M > 0) and (y + M + 0.05) or (_ + 0.09)
				end
			end
		end

		if t and value then
			for M = 1, rawValue do
				local K = t[M]

				if type_(K) == "number" and K <= _ then
					t[M] = nil
					pcall(value, M)
				end
			end
		end

		local W = rawget(b, "rock") or 0

		if W < 80 then
			rawset(b, "rock", 100)
		end

		if (rawget(b, "flub") or 0) > 0 then
			rawset(b, "flub", 0)
		end

		local W = os.clock()

		if W - startAmount2 > 0.5 then
			startAmount2 = W
			fn_applyStatus(l:Describe())
		end
	end
	local function fn_getAttribute(l, y)
		while l.Enabled and startAmount == y do
			if LocalPlayer:GetAttribute("PHGameUI") ~= true then
				task.wait(1)

				continue
			end

			if not getMatchFlag then
				local l = fn_handleTable()

				if l then
					local G = fn_handlePress(l)

					if G then
						getMatchFlag = l
						startFlag = G
						value = rawget(l, "release")
						rawValue = rawget(l, "laneCount") or 5
					end
				end

				task.wait(0.4)
			else
				task.wait(2)
			end
		end
	end

	statusOnStatus.Start = function(self)
		if self.Enabled then
			return
		end

		self.Enabled = true
		getMatchFlag = nil
		startFlag = nil
		value = nil
		rawValue = 5
		startAmount2 = 0

		if connection then
			pcall(function()
				connection:Disconnect()
			end)
		end

		local self2 = self

		connection = RunService.Heartbeat:Connect(function()
			pcall(fn_applyAutoHit, self2)
		end)
		startAmount += 1
		thread = task.spawn(fn_getAttribute, self, startAmount)
		fn_applyStatus(self:Describe())
	end
	statusOnStatus.Stop = function(self)
		self.Enabled = false
		startAmount += 1
		thread = nil

		if connection then
			pcall(function()
				connection:Disconnect()
			end)
			connection = nil
		end

		getMatchFlag = nil
		startFlag = nil
		value = nil
		fn_applyStatus("Idle")
	end
	statusOnStatus.SetEnabled = function(self, flag)
		if flag then
			self:Start()
		else
			self:Stop()
		end
	end

	return statusOnStatus
end
