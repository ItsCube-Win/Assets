					if not cFrame then
						self:_say("No clear angle for the rage shot.", arg4)

						return false
					end
				end

				local shootAtFlag = Weapon_Gun.Parent == LocalPlayer.Character

				if not self:_equip(Weapon_Gun) then
					return false
				end

				if cFrame == muzzleResult then
					local muzzleResult2 = self.Aim:Muzzle() or muzzleResult

					if fnapplyFilter(Weapon_Gun, muzzleResult2) then
						return false
					end

					if not shootAtFlag or (muzzleResult2.Position - muzzleResult.Position).Magnitude > 0.3 then
						solveResult = self.Aim:Solve(findMurdererResult, muzzleResult2.Position, "gun")

						if not solveResult then
							return false
						end
					end

					cFrame = muzzleResult2
				end

				self._lastShot = os.clock()
				Shoot:FireServer(cFrame, CFrame.new(solveResult))

				return true
			end
		end

		self:_say("No murderer to shoot.", arg4)

		return false
	end

	local s1 = "ShootBuffered"

	local function fn_applyArmed(obj, arg2)
		if obj._armed then
			obj._armed = nil
			obj:_say("Shot cancelled.")

			return
		end

		if not obj.Roles:AmSheriff() then
			obj:_say("You don't have the gun.")

			return
		end

		if obj:ShootAt(nil, nil, true) then
			return
		end

		local armed = {}

		obj._armed = armed
		obj:_say("Shot armed - fires on the first clear shot.")
		task.spawn(function()
			local amount = os.clock() + (arg2 or 2)
			local exitTo

			while true do
				if obj._armed ~= armed or not (os.clock() < amount) then
					exitTo = 1

					break
				end

				if obj.Roles:AmSheriff() then
					if not obj:ShootAt(nil, nil, true) then
						RunService.Heartbeat:Wait()
						RunService.Heartbeat:Wait()

						continue
					end
				else
					exitTo = 1

					break
				end

				break
			end

			if exitTo ~= 1 then
				obj._armed = nil

				return
			end

			if obj._armed == armed then
				obj._armed = nil
				obj:_say("No clear shot - cancelled.")
			end
		end)
	end

	SayClass[s1] = fn_applyArmed
	SayClass.DelayedShoot = function(obj)
		if not obj.Roles:AmSheriff() then
			return
		end

		obj:_say("Waiting for the murderer to be visible...")

		local delayToken = {}

		obj._delayToken = delayToken
		task.spawn(function()
