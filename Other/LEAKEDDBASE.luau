moduleDefs["Modules.Exploit.AntiJoker"] = function()
	local RunService = game_:GetService("RunService")
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local setEnabledService = {
		Enabled = false
	}

	RunService.Stepped:Connect(function()
		if not setEnabledService.Enabled then
			return
		end

		local l = LocalPlayer.Character

		if not l then
			return
		end

		local K = l:FindFirstChild("HumanoidRootPart")
		local G = l:FindFirstChild("Humanoid")

		if not K or not G then
			return
		end

		local l = G.MoveDirection
		local x = G.WalkSpeed
		local Y = K.AssemblyLinearVelocity.Y

		if math.abs(Y) > 250 then
			Y = 0
		end

		K.AssemblyLinearVelocity = Vector3.new(l.X * x, Y, l.Z * x)
		K.RotVelocity = Vector3.zero
		G:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		G:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	end)
	setEnabledService.SetEnabled = function(self, enabled)
		self.Enabled = enabled
	end

	return setEnabledService
end
