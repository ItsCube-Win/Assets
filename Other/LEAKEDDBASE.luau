		}
	}

	return {
		VIPs = {},
		FreeMode = false,
		Init = function(self)
			if self._initialized then
				return
			end

			self._initialized = true
		end,
		GetPlanInfo = function(arg1, arg2)
			return lifetimeConfig[arg2]
		end,
		GetPlanLabels = function()
			return {
				"3 Days",
				"1 Week",
				"1 Month",
				"3 Months",
				"6 Months",
				"Lifetime"
			}
		end,
		GetPlanKeys = function()
			return {
				"3d",
				"1w",
				"1m",
				"3m",
				"6m",
				"lifetime"
			}
		end,
		SetVIP = function(self, number, plan, expiresAt)
			self.VIPs[number] = {
				Plan = plan,
				ExpiresAt = expiresAt,
				FrozenAt = nil
			}
		end,
		RemoveVIP = function(self, number)
			self.VIPs[number] = nil
		end,
		GetVIP = function(obj, arg2)
			local vIPEntry = obj.VIPs[arg2]

			if not vIPEntry then
				return nil
			end

			local maxValue

			if vIPEntry.Plan == "lifetime" then
				maxValue = -1
			elseif vIPEntry.ExpiresAt then
				maxValue = math.max(0, vIPEntry.ExpiresAt - os.time())

				if vIPEntry.FrozenAt then
					maxValue = math.max(0, vIPEntry.ExpiresAt - vIPEntry.FrozenAt)
				end
			end

			return {
				Plan = vIPEntry.Plan,
				ExpiresAt = vIPEntry.ExpiresAt,
				FrozenAt = vIPEntry.FrozenAt,
				Remaining = maxValue
			}
		end,
		IsVIP = function(obj, arg2)
			local vIPEntry = obj.VIPs[arg2]

			if not vIPEntry then
				return obj.FreeMode
			end

			if vIPEntry.Plan == "lifetime" then
				return true
			end

			if vIPEntry.FrozenAt then
				return true
			end

			return vIPEntry.ExpiresAt and vIPEntry.ExpiresAt > os.time()
		end,
		GetAllVIPs = function(obj)
			return obj.VIPs
		end,
		SetFreeMode = function(self, freeMode)
			self.FreeMode = freeMode
		end,
		FormatRemaining = function(arg1, amount)
			if amount == nil then
				return "N/A"
			end

			if amount < 0 then
				return "Lifetime"
			end

			if amount <= 0 then
				return "Expired"
			end

			local floored = math.floor(amount / 86400)
			local floored2 = math.floor(amount % 86400 / 3600)

			if floored > 0 then
				return floored .. "d " .. floored2 .. "h"
			end

			return floored2 .. "h " .. math.floor(amount % 3600 / 60) .. "m"
		end
	}
end
moduleDefs["Services.VIPSyncService"] = function()
	local LocalPlayer = game_:GetService("Players").LocalPlayer

	local function fn_handleTable(obj)
		if type_(obj) ~= "table" then
			return nil
		end

		if type_(obj.data) == "table" then
			local dataEntry = obj.data[tostring(LocalPlayer.UserId)]

			if type_(dataEntry) == "table" then
				return dataEntry
			end

			local dataEntry2 = obj.data[LocalPlayer.UserId]

			if type_(dataEntry2) == "table" then
				return dataEntry2
			end
		end

		if tonumber(obj.userId or obj.targetUserId or obj.id) == LocalPlayer.UserId then
			return obj
		end

		return nil
	end

	return {
		Init = function(self, signalService, vIPAccessService)
			if self._initialized then
				return
			end

			self._initialized = true
			self.SignalService = signalService
			self.AccessService = vIPAccessService
			vIPAccessService:Init()
			vIPAccessService:SetConnectionState(signalService:IsConnected())
			signalService:OnMessage("socket_state", function(obj)
				local flag = obj.connected == true

				vIPAccessService:SetConnectionState(flag)

				if flag then
					self:RequestSnapshot()
				end
			end)
			signalService:OnMessage("vip_status", function(arg1)
				local fn_handleTableResult = fn_handleTable(arg1)

				if fn_handleTableResult then
					vIPAccessService:UpdateFromPayload(fn_handleTableResult)
				else
					vIPAccessService:Clear()
				end
			end)
			signalService:OnMessage("vip_update", function(obj)
				local fn_handleTableResult = fn_handleTable(obj)

				if fn_handleTableResult then
					vIPAccessService:UpdateFromPayload(fn_handleTableResult)
				elseif tonumber(obj.userId or obj.targetUserId or obj.id) == LocalPlayer.UserId then
					vIPAccessService:Clear()
				end
			end)
			signalService:OnMessage("free_vip", function(obj)
				vIPAccessService:SetFreeMode(obj.enabled == true)
			end)

			if signalService:IsConnected() then
				self:RequestSnapshot()
			end
		end,
		RequestSnapshot = function(self)
			if not self.SignalService then
				return
			end

			self.SignalService:Send("vip_request", {
				userId = LocalPlayer.UserId
			})
		end,
		SendFeatureState = function(self, arg2)
			if not self.SignalService then
				return
			end

			self.SignalService:Send("vip_feature_state", arg2)
		end
	}
end
