		Head = true
	}
	local keyAliases = {
		LCTRL = Enum.KeyCode.LeftControl,
		RCTRL = Enum.KeyCode.RightControl,
		LSHIFT = Enum.KeyCode.LeftShift,
		RSHIFT = Enum.KeyCode.RightShift,
		LALT = Enum.KeyCode.LeftAlt,
		RALT = Enum.KeyCode.RightAlt,
		SPACE = Enum.KeyCode.Space
	}

	local function fn_runUpper(camKey)
		if not camKey or camKey == "" then
			return false
		end

		local mode = tostring(camKey):upper()

		if mode == "MB1" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		end

		if mode == "MB2" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		end

		if mode == "MB3" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
		end

		local keyAliaseEntry = keyAliases[mode]

		if not keyAliaseEntry then
			local ok, result = pcall(function()
				return Enum.KeyCode[camKey]
			end)

			if ok then
				keyAliaseEntry = result
			end
		end

		if keyAliaseEntry then
			local ok, result = pcall(function()
				return UserInputService:IsKeyDown(keyAliaseEntry)
			end)

			if ok then
				return result
			end
		end

		return false
	end

	StaticParamsClass.new = function(position)
		local obj = setmetatable({}, StaticParamsClass)

		obj.State = position.State
		obj.Roles = position.Roles
		obj._vel = {}
		obj._paramsAt = -1

		return obj
	end
	StaticParamsClass._staticParams = function(self)
		local now = os.clock()

		if self._params and now - self._paramsAt < 0.25 then
			return self._params
		end

		local filterDescendantsInstances = {}

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				table.insert(filterDescendantsInstances, player.Character)
			end
		end

		for _, v in ipairs(CollectionService:GetTagged("WeaponPassthrough")) do
			table.insert(filterDescendantsInstances, v)
		end

		local raycastParams = RaycastParams.new()

		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = filterDescendantsInstances
		raycastParams.IgnoreWater = true
		self._invisible = self._invisible or {}

		local copy = table.clone(filterDescendantsInstances)

		for k in pairs(self._invisible) do
			if k.Parent then
				table.insert(copy, k)
			else
				self._invisible[k] = nil
			end
		end

		local raycastParams2 = RaycastParams.new()

		raycastParams2.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams2.FilterDescendantsInstances = copy
		raycastParams2.IgnoreWater = true
		self._params = raycastParams
		self._paramsAt = now
		self._exclude = filterDescendantsInstances
		self._paramsSee = raycastParams2
		self._excludeSee = copy

		return raycastParams
	end
	StaticParamsClass.Clear = function(l, i, K, M)
		local M = workspace:Raycast(i, K - i, l._clearParams or l:_staticParams())

		if M then
			return false, M
		end

		return true
	end
	StaticParamsClass._targetParams = function(self, player)
		local now = os.clock()

		self._tp = self._tp or {}

		local tpEntry = self._tp[player]

		if tpEntry and now - tpEntry.t < 0.25 and tpEntry.char == player.Character then
			return tpEntry.params
		end

		local filterDescendantsInstances = {}

		if LocalPlayer.Character then
			table.insert(filterDescendantsInstances, LocalPlayer.Character)
		end

		if player.Character then
			table.insert(filterDescendantsInstances, player.Character)
		end

		for _, v in ipairs(CollectionService:GetTagged("WeaponPassthrough")) do
			table.insert(filterDescendantsInstances, v)
		end

		local raycastParams = RaycastParams.new()

		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = filterDescendantsInstances
		raycastParams.IgnoreWater = true
		self._tp[player] = {
			t = now,
			char = player.Character,
			params = raycastParams
		}

		return raycastParams
	end
	StaticParamsClass.WithShotParams = function(self, clearParams, solve, ...)
		local _clearParams = self._clearParams

		self._clearParams = clearParams and self:_targetParams(clearParams) or nil

		local withShotParamsValue, withShotParamsValue2, withShotParamsValue3 = solve(...)

		self._clearParams = _clearParams

		return withShotParamsValue, withShotParamsValue2, withShotParamsValue3
	end
	StaticParamsClass.ClearFat = function(self, origin, amount, arg4)
		if not self:Clear(origin, amount, true) then
			return false
		end

		if (amount - origin).Magnitude < 0.1 then
			return true
		end

		local cFrame = CFrame.lookAt(origin, amount)
		local clearFatAmount = arg4 or 0.6

		for _, v in ipairs({
			cFrame.RightVector * clearFatAmount,
			-cFrame.RightVector * clearFatAmount,
			cFrame.UpVector * clearFatAmount,
			-cFrame.UpVector * clearFatAmount
		}) do
			if not self:Clear(origin + v, amount + v, true) then
				return false
			end
		end

		return true
	end
	StaticParamsClass.Velocity = function(self, player)
		local HumanoidRootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return Vector3.zero
		end

		local AssemblyLinearVelocity = HumanoidRootPart.AssemblyLinearVelocity
		local velEntry = self._vel[player]
		local lerped = velEntry and velEntry:Lerp(AssemblyLinearVelocity, 0.6) or AssemblyLinearVelocity

		self._vel[player] = lerped

		return lerped
	end
	StaticParamsClass.Consistency = function(self, player)
		local HumanoidRootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return 1
		end

		self._hist = self._hist or {}

		local histEntry = self._hist[player]

		if not histEntry then
			histEntry = {}
			self._hist[player] = histEntry
		end

		local now = os.clock()
		local consistencyValue = HumanoidRootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)

		if #histEntry == 0 or now - histEntry[#histEntry].t > 0.05 then
			table.insert(histEntry, {
				t = now,
				v = consistencyValue
			})
		end

		while #histEntry > 0 and now - histEntry[1].t > 1 do
			table.remove(histEntry, 1)
		end

		if #histEntry < 4 then
			return 1
		end

		local vector3 = Vector3.zero
		local consistencyAmount = 0

		for _, v in ipairs(histEntry) do
			vector3 += v.v
			consistencyAmount += v.v.Magnitude
		end

		if consistencyAmount < 0.001 then
			return 1
		end

		return math.clamp((vector3 / #histEntry).Magnitude / (consistencyAmount / #histEntry), 0, 1)
	end
	StaticParamsClass.GunLead = function(self)
		local gunLeadAmount = (tonumber(self.State.AimPrediction) or 100) / 100

		return ((tonumber(self.State.AimLeadBase) or 0.1) + LocalPlayer:GetNetworkPing()) * gunLeadAmount
	end
	StaticParamsClass.PredictDelta = function(self, player, gunLeadResult)
		local Character = player.Character
		local HumanoidRootPart = Character

		HumanoidRootPart = HumanoidRootPart and Character:FindFirstChild("HumanoidRootPart")

		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if HumanoidRootPart then
			if Humanoid and not (gunLeadResult <= 0) then
				local velocityResult = self:Velocity(player)
				local staticParamsResult = self:_staticParams()
				local vector = Vector3.new(velocityResult.X, 0, velocityResult.Z) * gunLeadResult

				if vector.Magnitude > 0.05 then
					local hit = workspace:Raycast(HumanoidRootPart.Position, vector, staticParamsResult)

					if hit then
						vector = vector.Unit * math.max(0, (hit.Position - HumanoidRootPart.Position).Magnitude - 1.5)
					end
				end

				local predictDeltaAmount = 0

				if Humanoid.FloorMaterial == Enum.Material.Air then
					predictDeltaAmount = velocityResult.Y * gunLeadResult - 0.5 * workspace.Gravity * gunLeadResult * gunLeadResult

					local vector2 = HumanoidRootPart.Position + vector
					local vector3New = Vector3.new
					local hit = workspace:Raycast(vector2 + Vector3.new(0, 1, 0), vector3New(0, math.min(predictDeltaAmount, 0) - 8, 0), staticParamsResult)
					local predictDeltaAmount2 = Humanoid.HipHeight + HumanoidRootPart.Size.Y / 2

					if hit and vector2.Y + predictDeltaAmount < hit.Position.Y + predictDeltaAmount2 then
						predictDeltaAmount = hit.Position.Y + predictDeltaAmount2 - vector2.Y
					end
				end

				return vector + Vector3.new(0, predictDeltaAmount, 0)
			end
		end

		return Vector3.zero
	end
	StaticParamsClass.Solve = function(l, h, p, y)
		if y == "gun" and l._clearParams == nil and h then
			return l:WithShotParams(h, l.Solve, l, h, p, y)
		end

		local S = h and h.Character
		local b = S and S:FindFirstChild("HumanoidRootPart")

		if not b or not p then
			return nil
		end

		local U = 0

		if y == "gun" then
			U = l:GunLead()
		elseif y == "knife" then
			local _ = tonumber(l.State.KnifeSpeed) or 91
			local t = (tonumber(l.State.AimPrediction) or 100) / 100
			local H = tonumber(l.State.AimLeadBase) or 0.1

			U = ((b.Position - p).Magnitude / _ + H + LocalPlayer:GetNetworkPing()) * t
		end

		local G = l:PredictDelta(h, U)

		if y == "knife" then
			local x = 1 - 0.5 * math.clamp((U - 0.25) / 0.35, 0, 1)
			local i = l:Consistency(h)

			x = x * (0.25 + 0.75 * i)
			G = G * x
		end

		local i = S:FindFirstChild("UpperTorso") and tbl or tbl2
		local c = l.State.AimPart or "Auto"

		if c == "Head" then
			local x = S:FindFirstChild("Head")
			local Y = x and l:_exposedPoint(x, G, p, y)

			if Y then
				return Y, x
			end
		end

		if y == "knife" and c == "Auto" then
			local x = {}

			for Y, Y in ipairs(i) do
				if not headConfig[Y] then
					table.insert(x, Y)
				end
			end

			table.insert(x, "Head")
			i = x
		end

		for K, K in ipairs(i) do
			if not (c == "Torso" and headConfig[K]) then
				local W = S:FindFirstChild(K)

				if W and W:IsA("BasePart") then
					local i = l:_exposedPoint(W, G, p, y)

					if i then
						return i, W
					end
				end
			end
		end

		return nil
	end

	local tbl3 = {
		Vector3.new(0, 0, 0),
		Vector3.new(0.7, 0, 0),
		Vector3.new(-0.7, 0, 0),
		Vector3.new(0, 0.7, 0),
		Vector3.new(0, -0.7, 0)
	}
	local tbl4 = {
		1,
		0.6,
		1.4
	}
	local exposedPointAmount = 0.5

	StaticParamsClass._exposedPoint = function(l, x, Y, h, p)
		local y = x.Size / 2
		local S = Y.Magnitude > 0.3
		local b = p == "knife"

		local function p(U, _)
			if b then
				return l:ClearFat(U, _, 0.6)
			end

			return l:Clear(U, _)
		end

		for l, l in ipairs(tbl3) do
			local i = x.CFrame:PointToWorldSpace(y * l)
			local l = i + Y

			if p(h, l) then
				if not S then
					return l
				end

				local K = true

				for x = 2, #tbl4 do
					if not p(h, i + Y * tbl4[x]) then
						K = false

						break
					end
				end

				if K and not b then
					local i = l - h
					local c = i.Magnitude > 0.1 and i.Unit:Cross(Vector3.yAxis) or Vector3.zero

					if c.Magnitude > 0.1 then
						c = c.Unit * exposedPointAmount
						K = p(h, l + c) and p(h, l - c)
					end
				end

				if K then
					return l
				end
			end
		end

		return nil
	end
	StaticParamsClass.Muzzle = function()
		local Character = LocalPlayer.Character

		Character = Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		local GunRaycastAttachment = Character and Character:FindFirstChild("GunRaycastAttachment")

		return GunRaycastAttachment and GunRaycastAttachment.WorldCFrame or nil
	end
	StaticParamsClass.EquippedKind = function()
		local Character = LocalPlayer.Character

		if not Character then
			return nil
		end

		for _, child in ipairs(Character:GetChildren()) do
			if child:IsA("Tool") then
				if child:HasTag("Weapon_Gun") then
					return "gun", child
				end

				if child:HasTag("Weapon_Knife") then
					return "knife", child
				end
			end
		end

		return nil
	end
	StaticParamsClass.KnifeOrigin = function(self, instance)
		local Handle = instance and instance:FindFirstChild("Handle")

		if Handle then
			return Handle.Position
		end

		local Character = LocalPlayer.Character
		local RightHand = Character and (Character:FindFirstChild("RightHand") or Character:FindFirstChild("Right Arm"))

		return RightHand and RightHand.Position or nil
	end
	StaticParamsClass.RageOrigin = function(self, amount)
		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local vector3 = HumanoidRootPart and HumanoidRootPart.Position - amount or Vector3.new(0, 0, 1)
		local vector32 = Vector3.new(vector3.X, 0, vector3.Z)
		local Unit = vector32.Magnitude > 0.1 and vector32.Unit
		local vector33 = Unit or Vector3.new(0, 0, 1)
		local vector34 = Vector3.new(-vector33.Z, 0, vector33.X)
		local vector35 = Vector3.new(0, 1, 0)

		for _, v in ipairs({
			vector33 * 4 + vector35 * 1.5,
			vector35 * 5,
			vector33 * 3 + vector35 * 4,
			vector34 * 4 + vector35 * 1.5,
			-vector34 * 4 + vector35 * 1.5,
			-vector33 * 4 + vector35 * 1.5,
			vector33 * 2
		}) do
			local origin = amount + v

			if self:Clear(origin, amount) then
				return CFrame.lookAt(origin, amount)
			end
		end

		return nil
	end
	StaticParamsClass._torsoAt = function(self, player, amount)
		local Character = player.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local UpperTorso = Character and (Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso")) or HumanoidRootPart

		if not HumanoidRootPart or not Humanoid then
			return nil
		end

		local velocityResult = self:Velocity(player)
		local torsoAtValue = UpperTorso.Position + Vector3.new(velocityResult.X, 0, velocityResult.Z) * amount

		if Humanoid.FloorMaterial == Enum.Material.Air then
			torsoAtValue += Vector3.new(0, velocityResult.Y * amount - 0.5 * workspace.Gravity * amount * amount, 0)
		end

		return torsoAtValue
	end
	StaticParamsClass.RageRay = function(self, player)
		local Character = player.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not Humanoid then
			return nil
		end

		local rageRayAmount = -0.05
		local rageRayAmount2 = 0.45

		if Humanoid.FloorMaterial == Enum.Material.Air then
			rageRayAmount = 0
			rageRayAmount2 = 0.3
		end

		local torsoAtResult = self:_torsoAt(player, rageRayAmount)
		local torsoAtResult2 = self:_torsoAt(player, rageRayAmount2)

		if not torsoAtResult or not torsoAtResult2 or (torsoAtResult2 - torsoAtResult).Magnitude < 2 then
			return nil
		end

		local Unit = (torsoAtResult2 - torsoAtResult).Unit
		local origin = torsoAtResult2 + Unit * 1.5
		local rageRayValue = torsoAtResult - Unit * 1.5

		if self:Clear(origin, rageRayValue) then
			return CFrame.lookAt(origin, rageRayValue), CFrame.new(rageRayValue)
		end

		return nil
	end
	StaticParamsClass.Candidates = function(self, arg2)
		local Roles = self.Roles
		local registry = {}

		local function fn_isAlive(player)
			if player and player ~= LocalPlayer then
				if Roles:IsAlive(player) then
					table.insert(registry, player)
				end
			end
		end

		local candidatesMode = arg2 or "Auto"

		if candidatesMode == "Auto" then
			if Roles:AmMurderer() then
				for _, player in ipairs(Players:GetPlayers()) do
					fn_isAlive(player)
				end
			else
				fn_isAlive(Roles:FindMurderer())

				if not Roles:AmSheriff() then
					fn_isAlive(Roles:FindSheriffThatsNotMe())
				end
			end
		elseif candidatesMode == "Murderer" then
			fn_isAlive(Roles:FindMurderer())
		elseif candidatesMode == "Sheriff" then
			fn_isAlive(Roles:FindSheriffThatsNotMe())
		else
			for _, player in ipairs(Players:GetPlayers()) do
				fn_isAlive(player)
			end
		end

		return registry
	end
	StaticParamsClass.AimCenter = function()
		local CurrentCamera = workspace.CurrentCamera

		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return CurrentCamera.ViewportSize / 2
		end

		if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
			return CurrentCamera.ViewportSize / 2
		end

		return UserInputService:GetMouseLocation()
	end
	StaticParamsClass.Pick = function(self, obj)
		local CurrentCamera = workspace.CurrentCamera
		local candidatesResultItem2
		local worldPosition2
		local pickValue
		local pickFlag
		for _, candidatesResultItem in ipairs(self:Candidates(obj.mode or self.State.AimTarget)) do
		local worldPosition, pickValue2 = self:Solve(candidatesResultItem, obj.from, obj.kind)

		if not worldPosition then
			continue
		end

		local pickFlag2

		if obj.center then
			local screenPoint, pickFlag2_2 = CurrentCamera:WorldToViewportPoint(worldPosition)
			local Magnitude = (Vector2.new(screenPoint.X, screenPoint.Y) - obj.center).Magnitude

			if pickFlag2_2 and (not obj.fov or obj.fov <= 0 or Magnitude <= obj.fov) then
				pickFlag2 = Magnitude
			end

			if pickFlag2 and (not pickFlag or pickFlag2 < pickFlag) then
				candidatesResultItem2 = candidatesResultItem
				worldPosition2 = worldPosition
				pickValue = pickValue2
				pickFlag = pickFlag2
			end

			continue
		end

		local Magnitude = (worldPosition - obj.from).Magnitude

		if Magnitude and (not pickFlag or Magnitude < pickFlag) then
			candidatesResultItem2 = candidatesResultItem
			worldPosition2 = worldPosition
			pickValue = pickValue2
			pickFlag = Magnitude
		end
		end

		return candidatesResultItem2, worldPosition2, pickValue
	end
	StaticParamsClass._assistCF = function(obj, arg2)
		local _forced = obj._forced
		local assistCFMode, assistCFValue2 = obj:EquippedKind()

		if not assistCFMode then
			return nil
		end

		local Position = assistCFMode == "gun" and obj:Muzzle() and obj:Muzzle().Position or obj:KnifeOrigin(assistCFValue2)

		if not Position then
			return nil
		end

		if _forced then
			local solveResult = obj:Solve(_forced, Position, assistCFMode)

			return solveResult and CFrame.new(solveResult) or nil
		end

		if not obj.State.AssistOn then
			return nil
		end

		local _, assistCFValue2_2 = obj:Pick({
			from = Position,
			kind = assistCFMode,
			center = arg2 or obj:AimCenter(),
			fov = tonumber(obj.State.AssistFOV) or 150
		})

		return assistCFValue2_2 and CFrame.new(assistCFValue2_2) or nil
	end
	StaticParamsClass.InstallAssist = function(self)
		if self._ws then
			return true
		end

		local ok, ws = pcall(function()
			return requireModule(ReplicatedStorage:WaitForChild("ClientServices", 10):WaitForChild("WeaponService", 10))
		end)

		if not ok or type_(ws) ~= "table" or type_(ws.GetMouseTargetCFrame) ~= "function" then
			return false
		end

		self._ws = ws
		self._origMouse = ws.GetMouseTargetCFrame
		self._origTap = ws.GetTargetPosition

		local _origMouse = self._origMouse
		local _origTap = self._origTap

		ws.GetMouseTargetCFrame = function(arg1, ...)
			local ok2, result = pcall(self._assistCF, self, nil)

			if ok2 and result then
				return result
			end

			return _origMouse(arg1, ...)
		end
		ws.GetTargetPosition = function(arg1, arg2, flag, ...)
			local ok2, result = pcall(self._assistCF, self, arg2 and flag and Vector2.new(arg2, flag) or nil)

			if ok2 and result then
				return result
			end

			return _origTap(arg1, arg2, flag, ...)
		end

		return true
	end
	StaticParamsClass.UninstallAssist = function(self)
		if not self._ws then
			return
		end

		self._ws.GetMouseTargetCFrame = self._origMouse
		self._ws.GetTargetPosition = self._origTap
		self._ws = nil
	end
	StaticParamsClass.SetForcedTarget = function(obj, forced)
		obj._forced = forced
	end
	StaticParamsClass._camActive = function(self)
		local State = self.State

		if not State.CamLock then
			return false
		end

		local CamActivation = State.CamActivation or "Hold"

		if CamActivation == "Hold" and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			CamActivation = "Weapon Out"
		end

		if CamActivation == "Always" then
			return true
		end

		if CamActivation == "Weapon Out" then
			return self:EquippedKind() ~= nil
		end

		return fn_runUpper(State.CamKey or "MB2")
	end
	StaticParamsClass._drawFov = function(obj)
		local State = obj.State

		if not (State.ShowFOV ~= false and (State.AssistOn or State.CamLock)) then
			if obj._fov then
				obj._fov.Visible = false
			end

			return
		end

		if not obj._fov then
			local ok, fov = pcall(function()
				return Drawing.new("Circle")
			end)

			if not ok or not fov then
				return
			end

			fov.Thickness = 1.6
			fov.NumSides = 64
			fov.Filled = false
			fov.Transparency = 1
			obj._fov = fov
		end

		obj._fov.Radius = State.AssistOn and (tonumber(State.AssistFOV) or 150) or tonumber(State.CamFOV) or 150
		obj._fov.Position = obj:AimCenter()
		obj._fov.Color = obj._camTarget and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(201, 162, 255)
		obj._fov.Visible = true
	end
	StaticParamsClass.StartCamera = function(self)
		if self._camBound then
			return
		end

		self._camBound = true
		RunService:BindToRenderStep("LowHubMM2Aim", Enum.RenderPriority.Camera.Value + 1, function(l)
			local Y = pcall(self._drawFov, self)

			if not Y then
				return
			end

			if not self:_camActive() then
				self._camTarget = nil

				return
			end

			local G = workspace.CurrentCamera
			local M = G.CFrame.Position
			local Y = self:EquippedKind() or "gun"
			local h
			local p = self._camTarget

			if p and self.State.CamSticky ~= false and self.Roles:IsAlive(p) then
				h = self:Solve(p, M, Y)
			end

			if not h then
				p, h = self:Pick({ from = M, kind = Y, center = self:AimCenter(), fov = tonumber(self.State.CamFOV) or 150 })
			end

			self._camTarget = h and p or nil

			if not h then
				return
			end

			local Y = math.clamp(tonumber(self.State.CamSmooth) or 30, 0, 100) / 100
			local i = 60 * (1 - Y) ^ 2 + 2
			local K = 1 - math.exp(-i * l)

			G.CFrame = G.CFrame:Lerp(CFrame.lookAt(M, h), K)
		end)
	end
	StaticParamsClass.Stop = function(self)
		pcall(function()
			RunService:UnbindFromRenderStep("LowHubMM2Aim")
		end)
		self._camBound = false

		if self._fov then
			pcall(function()
				self._fov:Remove()
			end)
			self._fov = nil
		end

		self:UninstallAssist()
	end

	return StaticParamsClass
end
moduleDefs["Games.MM2.MM2ArrowESP"] = function()
	local RunService = game_:GetService("RunService")
	local Players = game_:GetService("Players")
	local CoreGui = game_:GetService("CoreGui")
	local LocalPlayer = Players.LocalPlayer
	local hui = gethui and gethui() or CoreGui
	local ActiveArrowsClass = {}

	ActiveArrowsClass.__index = ActiveArrowsClass
	ActiveArrowsClass.ActiveArrows = {}
	ActiveArrowsClass.new = function(position)
		local obj = setmetatable({}, ActiveArrowsClass)

		obj.Target = position
		obj.GUI = Instance.new("ScreenGui")
		obj.GUI.Name = "LowHub_MM2_ArrowESP"
		obj.GUI.ResetOnSpawn = false
		obj.GUI.Parent = hui
		obj.Arrow = Instance.new("ImageLabel")
		obj.Arrow.AnchorPoint = Vector2.new(0.5, 0.5)
		obj.Arrow.BackgroundTransparency = 1
		obj.Arrow.Size = UDim2.new(0, 40, 0, 40)
		obj.Arrow.Image = "rbxassetid://97136202386756"
		obj.Arrow.ImageColor3 = Color3.fromRGB(243, 255, 19)
		obj.Arrow.Visible = false
		obj.Arrow.Parent = obj.GUI
		obj.DistanceLabel = Instance.new("TextLabel")
		obj.DistanceLabel.BackgroundTransparency = 1
		obj.DistanceLabel.Position = UDim2.new(0, 0, 1, 5)
		obj.DistanceLabel.Size = UDim2.new(1, 0, 0, 20)
		obj.DistanceLabel.TextColor3 = Color3.fromRGB(243, 255, 19)
		obj.DistanceLabel.TextSize = 14
		obj.DistanceLabel.Font = Enum.Font.GothamBold
		obj.DistanceLabel.TextStrokeTransparency = 0
		obj.DistanceLabel.Parent = obj.Arrow
		table.insert(ActiveArrowsClass.ActiveArrows, obj)
		obj.UpdateConnection = RunService.RenderStepped:Connect(function()
			obj:Update()
		end)

		return obj
	end
	ActiveArrowsClass.Update = function(self)
		if not self.Target or not self.Target.Parent then
			self:Destroy()

			return
		end

		local CurrentCamera = workspace.CurrentCamera

		if not CurrentCamera then
			return
		end

		local Position = self.Target:GetPivot().Position
		local screenPoint, updateFlag2 = CurrentCamera:WorldToViewportPoint(Position)
		local vector2 = Vector2.new(CurrentCamera.ViewportSize.X * 0.5, CurrentCamera.ViewportSize.Y * 0.5)

		if updateFlag2 and screenPoint.Z > 0 then
			self.Arrow.Visible = false

			return
		end

		self.Arrow.Visible = true

		local pointToObjectSpaceResult = CurrentCamera.CFrame:PointToObjectSpace(Position)
		local angle = math.atan2(pointToObjectSpaceResult.Y, pointToObjectSpaceResult.X)
		local vector = vector2 + Vector2.new(math.cos(angle), math.sin(angle)) * 500
		local clamped = math.clamp(vector.X, 50, CurrentCamera.ViewportSize.X - 50)
		local clamped2 = math.clamp(vector.Y, 50, CurrentCamera.ViewportSize.Y - 50)

		self.Arrow.Position = UDim2.new(0, clamped, 0, clamped2)
		self.Arrow.Rotation = math.deg(math.atan2(clamped2 - vector2.Y, clamped - vector2.X)) + 90

		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		self.DistanceLabel.Text = string.format("%dm", math.floor(HumanoidRootPart and (HumanoidRootPart.Position - Position).Magnitude or 0))
	end

	local function destroy(obj)
		if obj.UpdateConnection then
			obj.UpdateConnection:Disconnect()
			obj.UpdateConnection = nil
		end

		if obj.GUI then
			obj.GUI:Destroy()
			obj.GUI = nil
		end

		for i, activeArrow in ipairs(ActiveArrowsClass.ActiveArrows) do
			if activeArrow == obj then
				table.remove(ActiveArrowsClass.ActiveArrows, i)

				break
			end
		end
	end

	ActiveArrowsClass.Destroy = destroy

	return ActiveArrowsClass
end
moduleDefs["Games.MM2.MM2CoinFarm"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local OnBagClass = {}

	OnBagClass.__index = OnBagClass
	OnBagClass.new = function(position)
		local obj = setmetatable({}, OnBagClass)

		obj.State = position.State
		obj.Roles = position.Roles
		obj.Notify = position.Notify
		obj._sent = {}
		obj._bagFull = false

		return obj
	end

	local function onBag(obj, arg2, arg3)
		local number = tonumber(arg2)
		local number2 = tonumber(arg3)

		obj._bagFull = number ~= nil and number2 ~= nil and number2 > 0 and number >= number2

		if not obj._bagFull then
			obj._surfaced = false
		end
	end

	OnBagClass.OnBag = onBag
	OnBagClass.Surface = function(self)
		if self._surfaced then
			return
		end

		self._surfaced = true
		self:ReturnFromFarm()
	end
	OnBagClass.IsBagFull = function(self)
		return self._bagFull
	end
	OnBagClass._container = function(self)
		local map = self.Roles:GetMap()

		return map and map:FindFirstChild("CoinContainer")
	end

	local function fn_getAttribute(child)
		return child.Parent and child:IsA("BasePart") and child:GetAttribute("Collected") ~= true
	end

	OnBagClass._pickTarget = function(self, position, instance)
		local child2
		local pickTargetFlag

		for _, child in ipairs(instance:GetChildren()) do
			if fn_getAttribute(child) and (not self._sent[child] or not (os.clock() - self._sent[child] < 1.5)) then
				local Magnitude = (child.Position - position).Magnitude

				if not pickTargetFlag or Magnitude < pickTargetFlag then
					child2 = child
					pickTargetFlag = Magnitude
				end
			end
		end

		return child2
	end
	OnBagClass._collectNear = function(self, humanoidRootPart, instance)
		local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local Gameplay = Remotes and Remotes:FindFirstChild("Gameplay")
		local GetCoin = Gameplay and Gameplay:FindFirstChild("GetCoin")
		local now = os.clock()

		for _, child in ipairs(instance:GetChildren()) do
			if fn_getAttribute(child) and (child.Position - humanoidRootPart.Position).Magnitude <= 4.5 and (not self._sent[child] or now - self._sent[child] > 1.5) then
				self._sent[child] = now
				self._spots = self._spots or {}
				table.insert(self._spots, 1, child.Position)
				self._spots[13] = nil

				if GetCoin then
					pcall(function()
						GetCoin:FireServer(child)
					end)
				end

				if firetouchinterest then
					pcall(function()
						firetouchinterest(humanoidRootPart, child, 0)
						firetouchinterest(humanoidRootPart, child, 1)
					end)
				end
			end
		end
	end
	OnBagClass._start = function(self)
		if not self._hb then
			if not self._returning then
				local Character = LocalPlayer.Character

				self._char = Character
				self._cc = {}

				if Character then
					for _, descendant in ipairs(Character:GetDescendants()) do
						if descendant:IsA("BasePart") then
							self._cc[descendant] = descendant.CanCollide
						end
					end
				end

				self._noclip = RunService.Stepped:Connect(function()
					local l = LocalPlayer.Character

					if not l then
						return
					end

					for i, i in ipairs(l:GetDescendants()) do
						if i:IsA("BasePart") then
							i.CanCollide = false
						end
					end
				end)
				self._hb = RunService.Heartbeat:Connect(function(l)
					pcall(self._step, self, l)
				end)

				return
			end
		end
	end
	OnBagClass._stop = function(self)
		if self._hb then
			self._hb:Disconnect()
			self._hb = nil
		end

		if self._noclip then
			self._noclip:Disconnect()
			self._noclip = nil
		end

		local pairs_ = pairs
		local _cc = self._cc or {}

		for k, v in pairs_(_cc) do
			if k.Parent then
				pcall(function()
					k.CanCollide = v
				end)
			end
		end

		self._cc = nil
		self._target = nil
		self._hold = nil
	end
	OnBagClass._step = function(obj, amount)
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if HumanoidRootPart and Humanoid then
			if not (Humanoid.Health <= 0) and Character == obj._char then
				if obj.Paused then
					obj._hold = nil

					return
				end

				local containerResult = obj:_container()
				local _target

				if containerResult and not obj._bagFull then
					obj:_collectNear(HumanoidRootPart, containerResult)
					_target = obj._target

					if _target and obj._sent[_target] and (_target.Position - Vector3.new(0, 3.5, 0) - HumanoidRootPart.Position).Magnitude < 2 then
						_target = nil
					end

					if not _target or not fn_getAttribute(_target) then
						_target = obj:_pickTarget(HumanoidRootPart.Position, containerResult)
						obj._target = _target
					end
				end

				local stepFlag

				if _target then
					obj._hold = nil
					stepFlag = _target.Position - Vector3.new(0, 3.5, 0)
				else
					if obj._hold and (obj._hold - HumanoidRootPart.Position).Magnitude > 60 then
						obj._hold = nil
					end

					if not obj._hold then
						obj._hold = HumanoidRootPart.Position

						if not containerResult then
							local raycastParams = RaycastParams.new()

							raycastParams.FilterType = Enum.RaycastFilterType.Exclude
							raycastParams.FilterDescendantsInstances = { Character }

							local hit = workspace:Raycast(HumanoidRootPart.Position, Vector3.new(0, -12, 0), raycastParams)

							if hit then
								local Y = hit.Position.Y
								local hit2 = workspace:Raycast(Vector3.new(HumanoidRootPart.Position.X, Y - 30, HumanoidRootPart.Position.Z), Vector3.new(0, 30, 0), raycastParams)

								obj._hold = Vector3.new(HumanoidRootPart.Position.X, (hit2 and math.min(hit2.Position.Y, Y) or Y - 1) - 4, HumanoidRootPart.Position.Z)
							end
						end
					end

					stepFlag = obj._hold
				end

				local minValue = math.min(tonumber(obj.State.CoinFarmSpeed) or 22.9, 22.9)
				local Position = HumanoidRootPart.Position
				local vector = stepFlag - Position
				local stepAmount = minValue * amount
				local origin = vector.Magnitude <= stepAmount and stepFlag or Position + vector.Unit * stepAmount
				local vector3 = Vector3.new(vector.X, 0, vector.Z)

				if vector3.Magnitude > 0.5 then
					obj._look = vector3.Unit
				end

				HumanoidRootPart.CFrame = CFrame.lookAt(origin, origin + (obj._look or HumanoidRootPart.CFrame.LookVector)) * CFrame.Angles(-1.5707963267948966, 0, 0)
				HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero

				return
			end
		end

		obj:_stop()
	end
	OnBagClass.CollectCoins = function(self)
		if not self.State.CoinFarm then
			return
		end

		local map = self.Roles:GetMap()

		if not self.Roles:IsRoundActive() or not map then
			if self._hb then
				self:_stop()
			end

			return
		end

		local data = self.Roles:GetData(LocalPlayer)

		if data and data.Dead ~= true then
			if self.Roles:IsAlive(LocalPlayer) then
				if self._bagFull and self._surfaced then
					return
				end

				if not self._hb and not self:_onMap(map) then
					return
				end

				self:_start()

				return
			end
		end

		if self._hb then
			self:ReturnFromFarm()
		end
	end

	local function onMap(obj, character)
		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return false
		end

		if obj._boxMap ~= character then
			local ok, boxCf, boxSize = pcall(character.GetBoundingBox, character)

			if not ok then
				return false
			end

			obj._boxMap = character
			obj._boxCf = boxCf
			obj._boxSize = boxSize
		end

		local pointToObjectSpaceResult = obj._boxCf:PointToObjectSpace(HumanoidRootPart.Position)
		local vector = obj._boxSize / 2 + Vector3.new(20, 20, 20)

		return math.abs(pointToObjectSpaceResult.X) <= vector.X and math.abs(pointToObjectSpaceResult.Y) <= vector.Y and math.abs(pointToObjectSpaceResult.Z) <= vector.Z
	end

	OnBagClass._onMap = onMap

	local lookup = {}

	-- RECONSTRUCTED: the loop bounds were lost; 0..7 inferred from the pi/4 step (8 directions)
	for i = 0, 7 do
		local angle = i * math.pi / 4

		lookup[#lookup + 1] = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 3
	end

	local function fn_runRaycast(vector, raycastParams)
		local hit = workspace:Raycast(vector + Vector3.new(0, 1, 0), Vector3.new(0, -20, 0), raycastParams)

		if not hit then
			return nil
		end

		local Y = hit.Position.Y
		local vector3 = Vector3.new(vector.X, Y + 3.5, vector.Z)

		for _, v in ipairs(lookup) do
			if workspace:Raycast(vector3, v, raycastParams) then
				return nil
			end
		end

		if workspace:Raycast(Vector3.new(vector.X, Y + 0.5, vector.Z), Vector3.new(0, 7, 0), raycastParams) then
			return nil
		end

		return Y
	end

	OnBagClass.ReturnFromFarm = function(self)
		if self._returning then
			return
		end

		local returnFromFarmFlag = self._hb ~= nil
		local _char = self._char

		if self._hb then
			self._hb:Disconnect()
			self._hb = nil
		end

		self._target = nil
		self._hold = nil

		local HumanoidRootPart = _char and _char:FindFirstChild("HumanoidRootPart")
		local Humanoid = _char and _char:FindFirstChildOfClass("Humanoid")

		if not returnFromFarmFlag or _char ~= LocalPlayer.Character or not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then
			self:_stop()

			return
		end

		local raycastParams = RaycastParams.new()

		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { _char }

		local function getVec3(position)
			return Vector3.new(position.X, 0, position.Z)
		end

		local Position
		local Y
		local copy = table.clone(self._spots or {})

		table.sort(copy, function(arg1, arg2)
			return (getVec3(arg1) - getVec3(HumanoidRootPart.Position)).Magnitude < (getVec3(arg2) - getVec3(HumanoidRootPart.Position)).Magnitude
		end)

		for _, v in ipairs(copy) do
			if (getVec3(v) - getVec3(HumanoidRootPart.Position)).Magnitude > 60 then
				break
			end

			local fn_runRaycastResult = math.abs(v.Y - HumanoidRootPart.Position.Y) < 15 and fn_runRaycast(v, raycastParams)

			if fn_runRaycastResult then
				Position = v
				Y = fn_runRaycastResult

				break
			end
		end

		if not Position then
			local hit = workspace:Raycast(HumanoidRootPart.Position + Vector3.new(0, 5, 0), Vector3.new(0, -80, 0), raycastParams)

			if not hit then
				self:_stop()

				if typeof(self.State.FarmStartPos) == "CFrame" then
					HumanoidRootPart.CFrame = self.State.FarmStartPos
					HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				end

				return
			end

			Position = HumanoidRootPart.Position
			Y = hit.Position.Y
		end

		local returnFromFarmValue = Y + Humanoid.HipHeight + HumanoidRootPart.Size.Y / 2 + 0.2
		local tbl = {
			Vector3.new(Position.X, math.min(HumanoidRootPart.Position.Y, Y - 2), Position.Z),
			Vector3.new(Position.X, returnFromFarmValue, Position.Z)
		}
		local value = select(2, HumanoidRootPart.CFrame:ToOrientation())
		local returnFromFarmAmount = 1
		local now = os.clock()

		self._returning = true

		local connection

		connection = RunService.Heartbeat:Connect(function(dt)
			local parent = not HumanoidRootPart.Parent or os.clock() - now > 5

			if not parent then
				local vector = tbl[returnFromFarmAmount] - HumanoidRootPart.Position

				if vector.Magnitude < 0.3 then
					returnFromFarmAmount += 1
					parent = returnFromFarmAmount > #tbl
				else
					HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position + vector.Unit * math.min(18 * dt, vector.Magnitude)) * CFrame.Angles(0, value, 0)
					HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				end
			end

			if parent then
				connection:Disconnect()

				if HumanoidRootPart.Parent then
					HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position) * CFrame.Angles(0, value, 0)
					HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				end

				self:_stop()
				self._returning = false
				self._returnedAt = os.clock()
			end
		end)
	end

	return OnBagClass
end
moduleDefs["Games.MM2.MM2Combat"] = function()
	local Players = game_:GetService("Players")
