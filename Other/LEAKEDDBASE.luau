	SayClass.ThrowReady = function(self, weaponKnife)
		local number = tonumber(weaponKnife and weaponKnife:GetAttribute("ThrowSpeed")) or 1

		return os.clock() - self._lastThrow >= number * 2
	end

	local function throwTarget(obj, arg2, flag)
		if flag then
