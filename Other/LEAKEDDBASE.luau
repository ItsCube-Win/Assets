				end

				ensureEntryResult.NameText.Text = DisplayName
				ensureEntryResult.NameText.Color = State.NameColor
				ensureEntryResult.NameText.Position = Vector2.new(updateEntryValue, updateEntryAmount2 - 15)
				ensureEntryResult.NameText.Visible = true
			else
				updateEntryObj3.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
				ensureEntryResult.NameText.Visible = false
			end

			if ShowDistance or ShowItem then
				local registry = {}

				if ShowDistance and humanoidRootPart then
					local distInt = math.floor((humanoidRootPart.Position - part.Position).Magnitude)

					if distInt ~= ensureEntryResult._distInt then
						ensureEntryResult._distInt = distInt
						ensureEntryResult._distText = distInt .. "m"
					end

					table.insert(registry, ensureEntryResult._distText)
				end

				local fn_handleToolResult = ShowItem and fn_handleTool(player, adornee)

				if fn_handleToolResult then
