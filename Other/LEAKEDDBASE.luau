	valsCurrentGameConfig.applyTier = function(mode)
		local tier = (mode == "Owner" or mode == "VIP" or mode == "Staff") and mode or "User"

		valsCurrentGameConfig.tier = tier

		local tierRings = palette3.fx.tierRings

		for i = #tierRings, 1, -1 do
			local tierRingEntry = tierRings[i]

			if tierRingEntry.root.Parent then
				pcall(tierRingEntry.set, tier)
			else
				table.remove(tierRings, i)
			end
		end

		local onTier = palette3.fx.onTier
		local applyTierAmount = 1

		while applyTierAmount <= #onTier do
			local onTierEntry = onTier[applyTierAmount]

			if onTierEntry.owner and not onTierEntry.owner.Parent then
				table.remove(onTier, applyTierAmount)
			else
				pcall(onTierEntry.fn, tier)
				applyTierAmount += 1
			end
		end
