				idle = "emote"
			},
			Ghost = {
				anim = "91212105356485",
				pose = "yawlock",
				idle = "emote"
			},
			Hero = {
				anim = "72406831106803",
				pose = "native",
				idle = "emote",
				idleAnim = "91757204092310",
				backAnim = "128035244272764"
			},
			Helicopter = {
				anim = "80902143412258",
				pose = "native",
				idle = "emote"
			},
			Flash = {
				anim = "94471184259611",
				pose = "native",
				idle = "emote",
				idleAnim = "88479057030476"
			},
			Plane = {
				anim = "111384531851888",
				pose = "native",
				idle = "emote",
				idleAnim = "110924435126683"
			},
			UFO = {
				anim = "118703314621593",
				pose = "yawlock",
				idle = "emote",
				idleAnim = "93511384652946"
			}
		},
		Style = "Default"
	}
	local connection
	local track
	local setEnabledFlag
	local track2
	local track3
	local track4
	local lookup = {}
	local flatUprightConfig = {
		flat = CFrame.fromMatrix(Vector3.zero, Vector3.xAxis, -Vector3.zAxis, Vector3.yAxis),
		upright = CFrame.new(),
		supine = CFrame.fromMatrix(Vector3.zero, -Vector3.xAxis, -Vector3.zAxis, -Vector3.yAxis)
	}

	local function fn_applyVolume(volume)
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return
		end

		for _, child in pairs(HumanoidRootPart:GetChildren()) do
			if child:IsA("Sound") and (child.Name == "Running" or child.Name == "Walking" or child.Name == "Climbing" or child.Name == "Jumping") then
				child.Volume = volume and 0 or 0.5
			end
		end
	end
	local function fnapplyTime(arg1, timePosition, arg3)
		if setEnabledFlag == arg1 and track and track.IsPlaying then
			if timePosition then
				track.TimePosition = timePosition
			end

			if arg3 ~= nil then
				track:AdjustSpeed(arg3)
			end

			return
		end

		if track then
			track:Stop()
			track = nil
		end

		setEnabledFlag = arg1

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChild("Humanoid")

		if not Humanoid then
			return
		end

		local Animation = Instance.new("Animation")

		Animation.AnimationId = "rbxassetid://" .. tostring(arg1)
		track = Humanoid:LoadAnimation(Animation)
		track.Priority = Enum.AnimationPriority.Action
		track:Play()

		if timePosition then
			track.TimePosition = timePosition
		end

		if arg3 ~= nil then
			track:AdjustSpeed(arg3)
		end
	end
	local function fn_applyPlatformStand(humanoid)
		if not humanoid then
			return
		end

		humanoid.PlatformStand = false
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Seated)
		end)
	end

	speedBoostMultiplier._ensureMobile = function(self)
		if not UserInputService.TouchEnabled or self._mobileGui then
			return
		end

		local ScreenGui = Instance.new("ScreenGui")

		ScreenGui.Name = "LowHubFlyMobile"
		ScreenGui.ResetOnSpawn = false
		ScreenGui.IgnoreGuiInset = true
		ScreenGui.DisplayOrder = 50
		ScreenGui.Parent = gethui and gethui() or game_:GetService("CoreGui")
		self._mobileGui = ScreenGui

		local function fn_applySizeAnchorPoint(text, arg2, arg3, callback)
			local TextButton = Instance.new("TextButton")

			TextButton.Size = UDim2.fromOffset(56, 56)
			TextButton.AnchorPoint = Vector2.new(1, 1)
			TextButton.Position = UDim2.new(1, arg2, 1, arg3)
			TextButton.BackgroundColor3 = Color3.fromRGB(22, 18, 30)
			TextButton.BackgroundTransparency = 0.15
			TextButton.AutoButtonColor = true
			TextButton.Text = text
			TextButton.TextColor3 = Color3.fromRGB(232, 226, 248)
			TextButton.TextSize = 15
			TextButton.Font = Enum.Font.GothamBold
			TextButton.BorderSizePixel = 0
			TextButton.Parent = ScreenGui

			local UICorner = Instance.new("UICorner")

			UICorner.CornerRadius = UDim.new(1, 0)
			UICorner.Parent = TextButton

			local UIStroke = Instance.new("UIStroke")

			UIStroke.Color = Color3.fromRGB(120, 100, 200)
			UIStroke.Transparency = 0.5
			UIStroke.Parent = TextButton
			TextButton.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then
					callback(true)
				end
			end)
			TextButton.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then
					callback(false)
				end
			end)
		end

		fn_applySizeAnchorPoint("Up", -90, -200, function(tUp)
			self._tUp = tUp
		end)
		fn_applySizeAnchorPoint("Down", -90, -136, function(tDown)
			self._tDown = tDown
		end)
		fn_applySizeAnchorPoint("Boost", -158, -168, function(tBoost)
			self._tBoost = tBoost
		end)
	end
	speedBoostMultiplier._moveVector = function(self, humanoid, currentCamera)
		local MoveDirection = humanoid and humanoid.MoveDirection or Vector3.zero
		local vector3 = Vector3.zero

		if MoveDirection.Magnitude > 0 then
			vector3 = MoveDirection

			local LookVector = currentCamera.CFrame.LookVector
			local dot = MoveDirection:Dot(LookVector * Vector3.new(1, 0, 1))

			if dot > 0.5 then
				vector3 += Vector3.new(0, LookVector.Y, 0)
			elseif dot < -0.5 then
				vector3 -= Vector3.new(0, LookVector.Y, 0)
			end
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or self._tUp then
			vector3 += Vector3.new(0, 1, 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or self._tDown then
			vector3 -= Vector3.new(0, 1, 0)
		end

		return vector3
	end
	speedBoostMultiplier._startStyled = function(self, character, humanoidRootPart, obj)
		local Humanoid = character:FindFirstChildOfClass("Humanoid")
		local LowerTorso = character:FindFirstChild("LowerTorso")
		local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

		if not Humanoid or not LowerTorso or not Animator then
			return false
		end

		if character:FindFirstChild("Animate") then
			character.Animate.Disabled = true
		end

		for _, child in ipairs(humanoidRootPart:GetChildren()) do
			if child:IsA("Sound") and lookup[child] == nil then
				lookup[child] = child.Volume
				child.Volume = 0
			end
		end

		for _, v in ipairs(Animator:GetPlayingAnimationTracks()) do
			pcall(function()
				v:Stop(0)
			end)
		end

		local Animation = Instance.new("Animation")

		Animation.AnimationId = "rbxassetid://" .. obj.anim
		track2 = Animator:LoadAnimation(Animation)
		track2.Priority = Enum.AnimationPriority.Action4
		track2.Looped = true
		track2:Play()

		local function createAnimation(idleAnim)
			if not idleAnim then
				return nil
			end

			local Animation2 = Instance.new("Animation")

			Animation2.AnimationId = "rbxassetid://" .. idleAnim

			local animationTrack = Animator:LoadAnimation(Animation2)

			animationTrack.Priority = Enum.AnimationPriority.Action4
			animationTrack.Looped = true

			return animationTrack
		end

		local animation = createAnimation(obj.idleAnim)
		local animation2 = createAnimation(obj.backAnim)

		track3 = animation
		track4 = animation2

		local s9 = "fly"
		local CurrentCamera = workspace.CurrentCamera

		CurrentCamera.CameraSubject = character:FindFirstChild("UpperTorso") or LowerTorso
		self:_ensureMobile()

		local flat = flatUprightConfig[obj.pose] or flatUprightConfig.flat
		local cFrame = CFrame.new()
		local Position = humanoidRootPart.Position
		local cFrame2 = CFrame.lookAt(Vector3.zero, Vector3.new(CurrentCamera.CFrame.LookVector.X, 0, CurrentCamera.CFrame.LookVector.Z).Unit)
		local Position2 = humanoidRootPart.Position

		fn_applyPlatformStand(Humanoid)

		local startStyledAmount = os.clock() + 0.15

		if connection then
			connection:Disconnect()
		end

		pcall(RunService.UnbindFromRenderStep, RunService, "LowHubFlyStyle")
		connection = {
			Disconnect = function()
				pcall(RunService.UnbindFromRenderStep, RunService, "LowHubFlyStyle")
			end
		}
		RunService:BindToRenderStep("LowHubFlyStyle", Enum.RenderPriority.Camera.Value - 1, function(l)
			if not self.Enabled or not character.Parent or not humanoidRootPart.Parent then
				return
			end

			if os.clock() >= startStyledAmount then
				Humanoid.PlatformStand = true
			end

			CurrentCamera = workspace.CurrentCamera

			local y = humanoidRootPart.Position - Position2

			if y.Magnitude > 4 then
				Position = Position + y
			end

			local y = self:_moveVector(Humanoid, CurrentCamera)
			local A = (UserInputService:IsKeyDown(Enum.KeyCode.Q) or self._tBoost) and (self.BoostMultiplier or 2.5) or 1

			if y.Magnitude > 0 then
				Position = Position + (y.Magnitude > 1 and y.Unit or y) * self.Speed * A * l
			end

			local c = y.Magnitude > 0.1 and y.Unit or nil

			if not c or math.abs(c.Y) > 0.95 then
				local b = CurrentCamera.CFrame.LookVector

				c = Vector3.new(b.X, 0, b.Z)
				c = c.Magnitude > 1e-3 and c.Unit or Vector3.new(0, 0, -1.0)
			end

			local b = y.Magnitude > 0
			local H = CurrentCamera.CFrame.LookVector
			local A = Vector3.new(H.X, 0, H.Z)

			A = A.Magnitude > 1e-3 and A.Unit or Vector3.new(0, 0, -1.0)

			local H = Vector3.new(y.X, 0, y.Z)
			local y = b and (obj.backAt ~= nil or obj.backAnim ~= nil) and H.Magnitude > 0.1 and H.Unit:Dot(A) < -0.5
			local C = 0

			if b and track3 and not y and H.Magnitude > 0.1 then
				local Z = Vector3.new(CurrentCamera.CFrame.RightVector.X, 0, CurrentCamera.CFrame.RightVector.Z)
				local s = Z.Magnitude > 1e-3 and H.Unit:Dot(Z.Unit) or 0

				if math.abs(s) > 0.9 then
					C = s
				end
			end

			local Z = b and track3 ~= nil and H.Magnitude <= 0.1
			local s = C ~= 0 or Z

			cFrame2 = cFrame2:Lerp(CFrame.lookAt(Vector3.zero, (y or s) and A or c), math.min(1, l * 8))

			if track3 or track4 then
				local Z = ((not b or s) and track3) and "idle" or (y and track4) and "back" or "fly"

				if Z ~= s9 then
					local P = { idle = track3, fly = track2, back = track4 }
					local h = (Z == "fly" or s9 == "fly") and 0.05 or 0.25

					if P[s9] then
						P[s9]:Stop(h)
					end

					P[Z]:Play(h)
					s9 = Z
				end
			end

			local h

			if obj.pose == "native" and s then
				cFrame = cFrame:Lerp(CFrame.Angles(0, 0, -0.3141592653589793 * C), math.min(1, l * 6))

				if CurrentCamera.CameraSubject ~= Humanoid then
					CurrentCamera.CameraSubject = Humanoid
				end

				h = CFrame.new(Position) * cFrame2 * cFrame
			elseif obj.pose == "native" and b then
				cFrame = CFrame.new()

				local E = y and A or c

				if math.abs(E.Y) > 0.98 then
					E = A
				end

				cFrame2 = cFrame2:Lerp(CFrame.lookAt(Vector3.zero, E), math.min(1, l * 8))

				if CurrentCamera.CameraSubject ~= Humanoid then
					CurrentCamera.CameraSubject = Humanoid
				end

				if track2 and track2.Speed == 0 then
					track2:AdjustSpeed(1)
				end

				h = CFrame.new(Position) * cFrame2
			elseif obj.pose == "yawlock" and (b or obj.idle ~= "emote") then
				local E = humanoidRootPart.CFrame:ToObjectSpace(LowerTorso.CFrame)
				local C = E.LookVector
				local E = Vector3.new(C.X, 0, C.Z)
				local C = E.Magnitude > 1e-3 and CFrame.lookAt(Vector3.zero, E.Unit):Inverse() or CFrame.new()
				local E, Q = 0, 0

				if b and H.Magnitude > 0.1 then
					local Z = Vector3.new(CurrentCamera.CFrame.RightVector.X, 0, CurrentCamera.CFrame.RightVector.Z)

					E = H.Unit:Dot(A)
					Q = Z.Magnitude > 1e-3 and H.Unit:Dot(Z.Unit) or 0
				end

				local H = E > 0 and -0.6108652381980153 * E or -0.3490658503988659 * E

				cFrame = cFrame:Lerp(CFrame.Angles(H, 0, -0.2617993877991494 * Q), math.min(1, l * 6))
				cFrame2 = cFrame2:Lerp(CFrame.lookAt(Vector3.zero, A), math.min(1, l * 8))

				if CurrentCamera.CameraSubject ~= Humanoid then
					CurrentCamera.CameraSubject = Humanoid
				end

				h = CFrame.new(Position) * cFrame2 * cFrame * C
			elseif obj.idle == "emote" and not b then
				local l = Vector3.new(c.X, 0, c.Z)

				h = CFrame.lookAt(Position, Position + (l.Magnitude > 1e-3 and l.Unit or Vector3.new(0, 0, -1.0)))

				if CurrentCamera.CameraSubject ~= Humanoid then
					CurrentCamera.CameraSubject = Humanoid
				end

				if track2 and track2.Speed == 0 then
					track2:AdjustSpeed(1)
				end
			else
				local l = y and obj.backAt or obj.moveAt

				if b and l and track2 then
					if track2.Speed ~= 0 then
						track2:AdjustSpeed(0)
					end

					if math.abs(track2.TimePosition - l) > 0.01 then
						track2.TimePosition = l
					end
				end

				local i = character:FindFirstChild("UpperTorso") or LowerTorso

				if CurrentCamera.CameraSubject ~= i then
					CurrentCamera.CameraSubject = i
				end

				local i = humanoidRootPart.CFrame:ToObjectSpace(LowerTorso.CFrame)
				local M = CFrame.new(0, l and 0 or i.Y, 0) * (y and flatUprightConfig.supine or flat)

				h = CFrame.new(Position) * cFrame2 * M * i:Inverse()
			end

			humanoidRootPart.CFrame = h
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
			humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
			Position2 = h.Position
		end)

		return true
	end
	speedBoostMultiplier.SetStyle = function(self, flag)
		local style = flag and self.Styles[flag] and flag or "Default"

		if style == self.Style then
			return
		end

		self.Style = style

		if self.Enabled then
			self:SetEnabled(false)
			self:SetEnabled(true)
		end
	end
	speedBoostMultiplier.SetEnabled = function(self, enabled)
		self.Enabled = enabled

		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and (Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("UpperTorso"))
		local styleEntry = self.Styles[self.Style]

		if enabled and Character and HumanoidRootPart and styleEntry and Character:FindFirstChild("LowerTorso") and self:_startStyled(Character, HumanoidRootPart, styleEntry) then
			return
		end

		if enabled and Character and HumanoidRootPart then
			local BodyGyro = Instance.new("BodyGyro", HumanoidRootPart)

			BodyGyro.Name = "FlyGyro"
			BodyGyro.P = 90000
			BodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
			BodyGyro.cframe = HumanoidRootPart.CFrame

			local BodyVelocity = Instance.new("BodyVelocity", HumanoidRootPart)

			BodyVelocity.Name = "FlyVelocity"
			BodyVelocity.velocity = Vector3.zero
			BodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)

			if Character:FindFirstChild("Animate") then
				Character.Animate.Disabled = true
			end

			fn_applyVolume(true)
			fnapplyTime(10714347256, 4, 0)
			self:_ensureMobile()
			fn_applyPlatformStand(Character:FindFirstChildOfClass("Humanoid"))

			local setEnabledAmount = os.clock() + 0.15

			if connection then
				connection:Disconnect()
			end

			local setEnabledFlag2

			connection = RunService.RenderStepped:Connect(function()
				if not self.Enabled or not Character.Parent then
					return
				end

				local l = Character:FindFirstChild("Humanoid")

				if l and os.clock() >= setEnabledAmount then
					l.PlatformStand = true
				end

				local K = workspace.CurrentCamera
				local G = l and l.MoveDirection or Vector3.zero
				local l = Vector3.zero

				if G.Magnitude > 0 then
					l = G

					local Y = K.CFrame.LookVector
					local S = G:Dot(Y * Vector3.new(1, 0, 1))

					if S > 0.5 then
						l = l + Vector3.new(0, Y.Y, 0)
					elseif S < -0.5 then
						l = l - Vector3.new(0, Y.Y, 0)
					end
				end

				if UserInputService:IsKeyDown(Enum.KeyCode.Space) or self._tUp then
					l = l + Vector3.new(0, 1, 0)
				end

				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or self._tDown then
					l = l - Vector3.new(0, 1, 0)
				end

				if not HumanoidRootPart or not HumanoidRootPart.Parent then
					return
				end

				local W = G.Magnitude > 0
				local Y = W and G:Dot(K.CFrame.RightVector) or 0
				local S = (UserInputService:IsKeyDown(Enum.KeyCode.Q) or self._tBoost) and (self.BoostMultiplier or 2.5) or 1

				BodyVelocity.Velocity = l * self.Speed * S

				local l = "Idle"

				if W then
					local W = G:Dot(K.CFrame.LookVector)
					local y = G:Dot(K.CFrame.RightVector)

					if W > 0.3 then
						l = "W"
					elseif W < -0.3 then
						l = "S"
					elseif y > 0 then
						l = "D"
					else
						l = "A"
					end
				elseif UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					l = "Vertical"
				end

				if l == "W" and BodyVelocity.Velocity.Magnitude > 1 then
					local W = BodyVelocity.Velocity.Unit
					local G = CFrame.lookAt(HumanoidRootPart.Position, HumanoidRootPart.Position + W)

					BodyGyro.CFrame = G * CFrame.Angles(-1.5707963267948966, 0, math.rad(-Y * 20))
				else
					BodyGyro.CFrame = K.CFrame * CFrame.Angles(math.rad(-Y * 20), 0, 0)
				end

				if l ~= setEnabledFlag2 then
					setEnabledFlag2 = l

					if l == "W" then
						fnapplyTime(10714177846, 4.65, 0)
					elseif l == "S" then
						fnapplyTime(10147823318, 4.11, 0)
					elseif l == "A" then
						fnapplyTime(10147823318, 3.55, 0)
					elseif l == "D" then
						fnapplyTime(10147823318, 4.81, 0)
					else
						fnapplyTime(10714347256, 4, 0)
					end
				end
			end)
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end

			if self._mobileGui then
				self._mobileGui:Destroy()
				self._mobileGui = nil
			end

			self._tUp = false
			self._tDown = false
			self._tBoost = false

			if Character and Character:FindFirstChild("Animate") then
				Character.Animate.Disabled = false
			end

			fn_applyVolume(false)

			if HumanoidRootPart then
				local FlyGyro = HumanoidRootPart:FindFirstChild("FlyGyro")

				if FlyGyro then
					FlyGyro:Destroy()
				end

				local FlyVelocity = HumanoidRootPart:FindFirstChild("FlyVelocity")

				if FlyVelocity then
					FlyVelocity:Destroy()
				end
			end

			if Character and Character:FindFirstChild("Humanoid") then
				Character.Humanoid.PlatformStand = false
				Character.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end

			if track then
				track:Stop()
				track = nil
			end

			setEnabledFlag = nil

			if track2 then
				pcall(function()
					track2:Stop()
				end)
				track2 = nil
			end

			if track3 then
				pcall(function()
					track3:Stop()
				end)
				track3 = nil
			end

			if track4 then
				pcall(function()
					track4:Stop()
				end)
				track4 = nil
			end

			for k, v in pairs(lookup) do
				pcall(function()
					k.Volume = v
				end)
			end

			table.clear(lookup)

			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local CurrentCamera = workspace.CurrentCamera

			if Humanoid and CurrentCamera.CameraSubject ~= Humanoid then
				CurrentCamera.CameraSubject = Humanoid
			end
		end
	end
	speedBoostMultiplier.SetSpeed = function(self, speed)
		self.Speed = speed
	end

	return speedBoostMultiplier
end
moduleDefs["Modules.Movement.FlyV2"] = function()
	local RunService = game_:GetService("RunService")
	local UserInputService = game_:GetService("UserInputService")
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local speedSetEnabledService = {
		Enabled = false,
		Speed = 50
	}

	RunService.RenderStepped:Connect(function()
		if not speedSetEnabledService.Enabled then
			return
		end

		local l = LocalPlayer.Character

		if not l then
			return
		end

		local x = l:FindFirstChild("HumanoidRootPart")
		local Y = l:FindFirstChild("Humanoid")

		if not x or not Y then
			return
		end

		if not x.Anchored then
			x.Anchored = true
		end

		local l = workspace.CurrentCamera
		local M = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			M = M + l.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			M = M - l.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			M = M + l.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			M = M - l.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			M = M + Vector3.new(0, 1, 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			M = M - Vector3.new(0, 1, 0)
		end

		if M.Magnitude > 0 then
			x.CFrame = x.CFrame + (M.Unit * (speedSetEnabledService.Speed * 0.02))
		end

		Y.PlatformStand = true
	end)
	speedSetEnabledService.SetEnabled = function(self, enabled)
		self.Enabled = enabled

		if not enabled and LocalPlayer.Character then
			local HumanoidRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local Humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")

			if HumanoidRootPart then
				HumanoidRootPart.Anchored = false
			end

			if Humanoid then
				Humanoid.PlatformStand = false
			end
		end
	end
	speedSetEnabledService.SetSpeed = function(self, speed)
		self.Speed = speed
	end

	return speedSetEnabledService
end
moduleDefs["Modules.Movement.Horns"] = function()
	local LocalPlayer = game_:GetService("Players").LocalPlayer
	local togglesNamesService = {
		Toggles = {
			Fiery = false,
			Poisoned = false,
			Frozen = false
		},
		Names = {}
	}
	local fieryPoisonedConfig = {
		Fiery = {
			Head = { 215718515 }
		},
		Poisoned = {
			Head = { 1744060292 }
		},
		Frozen = {
			Head = { 74891470 }
		}
	}

	local function fn_getObjects(arg1)
		local ok, result = pcall(function()
			return game_:GetObjects("rbxassetid://" .. tostring(arg1))
		end)

		if not ok or not result or #result == 0 then
			return nil
		end

		local Accessory = result[1]

		if Accessory and not Accessory:IsA("Accessory") then
			Accessory = Accessory:FindFirstChildWhichIsA("Accessory", true) or Accessory
		end

		return Accessory
	end
	local function createWeld(part0, part1, c0, c1)
		local Weld = Instance.new("Weld")

		Weld.Part0 = part0
		Weld.Part1 = part1
		Weld.C0 = c0
		Weld.C1 = c1
		Weld.Parent = part0

		return Weld
	end
	local function fn_handleAttachment(instance, name)
		for _, descendant in pairs(instance:GetDescendants()) do
			if descendant:IsA("Attachment") and descendant.Name == name then
				return descendant
			end
		end
	end
	local function fn_applyCanCollideMassless(instance)
		for _, descendant in pairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.CanCollide = false
				descendant.Massless = true
			end
		end
	end
	local function fn_handleHandle(arg1, head, character)
		if not head then
			return
		end

		local fn_getObjectsResult = fn_getObjects(arg1)

		if not fn_getObjectsResult or not character then
			return
		end

		togglesNamesService.Names[arg1] = fn_getObjectsResult.Name
		fn_getObjectsResult.Parent = workspace

		local Handle = fn_getObjectsResult:FindFirstChild("Handle")

		if Handle then
			local Attachment = Handle:FindFirstChildOfClass("Attachment")

			if Attachment then
				local fn_handleAttachmentResult = fn_handleAttachment(head, Attachment.Name)

				if fn_handleAttachmentResult then
					createWeld(head, Handle, fn_handleAttachmentResult.CFrame, Attachment.CFrame)
				end
			else
				local findFirstChildResult = character:FindFirstChild(head.Name)

				if findFirstChildResult then
					createWeld(findFirstChildResult, Handle, CFrame.new(0, 0.5, 0), CFrame.new())
				end
			end
		end

		fn_getObjectsResult.Parent = character
		fn_applyCanCollideMassless(fn_getObjectsResult)
	end
	local function fn_handleAccessory(arg1, character)
		if not character then
			return
		end

		local Name = togglesNamesService.Names[arg1]

		if not Name then
			local fn_getObjectsResult = fn_getObjects(arg1)

			if fn_getObjectsResult then
				Name = fn_getObjectsResult.Name
				togglesNamesService.Names[arg1] = Name
			end
		end

		if not Name then
			return
		end

		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Accessory") and child.Name == Name then
				child:Destroy()
			end
		end
	end
	local function fn_unnamed(fly, character)
		local character2 = fieryPoisonedConfig[fly]

		if not character2 then
			return
		end

		local Character = character or LocalPlayer.Character

		if not Character then
			return
		end

		for _, v in ipairs(character2.Head) do
			fn_handleAccessory(v, Character)
		end
	end

	togglesNamesService.Apply = function(self, arg2)
		local Character = arg2 or LocalPlayer.Character

		if not Character then
			return
		end

		fn_unnamed("Fiery", Character)
		fn_unnamed("Poisoned", Character)
		fn_unnamed("Frozen", Character)
		task.defer(function()
			local Head = Character:FindFirstChild("Head") or Character:WaitForChild("Head", 5)

			if not Head then
				return
			end

			for k, toggle in pairs(self.Toggles) do
				if toggle then
					local character = fieryPoisonedConfig[k]

					if character then
						for _, v in ipairs(character.Head) do
							fn_handleHandle(v, Head, Character)
						end
					end
				end
			end
		end)
	end
	togglesNamesService.SetEnabled = function(self, fly, flag)
		self.Toggles[fly] = flag

		if flag then
			self:Apply()
		else
			fn_unnamed(fly, LocalPlayer.Character)
		end
	end
	togglesNamesService.GetToggles = function(self)
		return self.Toggles
	end

	return togglesNamesService
end
