			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				flag = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if flag and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
				fn_applySizePosition(input.Position.X)
			end
		end)

		return LowHub_FreecamUniversalHUD
