	meshIdsList.Build = function(arg1)
		local defEntry = meshIdsList.Defs[arg1]

		if not defEntry then
			return nil
		end

		local Model = Instance.new("Model")

		Model.Name = "LHMount_" .. arg1

		local Part = Instance.new("Part")

		Part.Name = "Root"
		Part.Size = Vector3.new(2, 2, 1)
		Part.Transparency = 1
		Part.CanCollide = false
		Part.CastShadow = false
		Part.Anchored = false
		Part.Parent = Model
		Model.PrimaryPart = Part

		for _, part in ipairs(defEntry.Parts) do
			local MeshPart

			if not pcall(function()
				MeshPart = Instance.new("MeshPart")
				MeshPart.Size = Vector3.new(part[3], part[4], part[5])
				MeshPart.MeshId = part[2]
			end) or not MeshPart or MeshPart.MeshId == "" then
				if MeshPart then
					MeshPart:Destroy()
				end

				MeshPart = Instance.new("Part")
				MeshPart.Size = Vector3.new(1, 1, 1)

				local SpecialMesh = Instance.new("SpecialMesh")

				SpecialMesh.MeshType = Enum.MeshType.FileMesh
				SpecialMesh.MeshId = part[2]
				SpecialMesh.Scale = Vector3.new(part[3], part[4], part[5])
				SpecialMesh.Parent = MeshPart
			end

			MeshPart.Name = part[1]
			MeshPart.Color = Color3.fromRGB(part[6], part[7], part[8])
			MeshPart.Material = Enum.Material[part[9]] or Enum.Material.Plastic
			MeshPart.Transparency = part[10]
			MeshPart.CanCollide = false
			MeshPart.CastShadow = false
			MeshPart.Massless = true
			MeshPart.Anchored = false
			MeshPart.Parent = Model

			local Weld = Instance.new("Weld")

			Weld.Part0 = Part
			Weld.Part1 = MeshPart
			Weld.C0 = getCframe(part[11])
			Weld.Parent = Part
		end

		if defEntry.Scale and defEntry.Scale ~= 1 then
			pcall(function()
				Model:ScaleTo(defEntry.Scale)
			end)
		end

		return Model, Part, defEntry
	end

	return meshIdsList
end
moduleDefs["Modules.Exploit.Aimbot"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local UserInputService = game_:GetService("UserInputService")
	local LocalPlayer = Players.LocalPlayer
	local modeTargetPartState = {
		Enabled = false,
		Mode = "Crosshair",
		TargetPart = "Head",
		FOV = 120,
		Smoothing = 0.4,
		VisibleOnly = false,
		Prediction = false,
		PredictionFactor = 0.15,
		TeamCheck = false,
		ShowFOV = true,
		HoldKey = "MB2",
		Activation = "Hold",
		MaxDistance = 0,
		Sticky = false,
		Notify = nil
	}
	local keyAliases = {
		LCTRL = Enum.KeyCode.LeftControl,
		RCTRL = Enum.KeyCode.RightControl,
		LSHIFT = Enum.KeyCode.LeftShift,
		RSHIFT = Enum.KeyCode.RightShift,
		LALT = Enum.KeyCode.LeftAlt,
		RALT = Enum.KeyCode.RightAlt,
		SPACE = Enum.KeyCode.Space
	}

	local function fn_runUpper(holdKey)
		if not holdKey or holdKey == "" then
			return false
		end

		local mode = tostring(holdKey):upper()

		if mode == "MB1" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		end

		if mode == "MB2" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		end

		if mode == "MB3" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
		end

		local keyAliaseEntry = keyAliases[mode]

		if not keyAliaseEntry then
			local ok, result = pcall(function()
				return Enum.KeyCode[holdKey]
			end)

			if ok then
				keyAliaseEntry = result
			end
		end

		if keyAliaseEntry then
			local ok, result = pcall(function()
				return UserInputService:IsKeyDown(keyAliaseEntry)
			end)

			if ok then
				return result
			end
		end

		return false
	end

	local startFlag = false
	local gui
	local startFlag2

	local function fn_handleHead(character)
		local TargetPart = modeTargetPartState.TargetPart or "Head"
		local findFirstChildResult = character:FindFirstChild(TargetPart)

		if findFirstChildResult and findFirstChildResult:IsA("BasePart") then
			return findFirstChildResult
		end

		if TargetPart == "UpperTorso" or TargetPart == "Torso" or TargetPart == "LowerTorso" then
			return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
		end

		return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	end
	local function fnapplyFilter(character)
		local raycastParams = RaycastParams.new()

		raycastParams.FilterType = Enum.RaycastFilterType.Exclude

		local filterDescendantsInstances = { LocalPlayer.Character }

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and player.Character ~= character then
				table.insert(filterDescendantsInstances, player.Character)
			end
		end

		raycastParams.FilterDescendantsInstances = filterDescendantsInstances
		raycastParams.IgnoreWater = true

		return raycastParams
	end
	local function fn_runRaycast(character, part)
		local Position = workspace.CurrentCamera.CFrame.Position
		local hit = workspace:Raycast(Position, part.Position - Position, fnapplyFilter(character))

		if hit then
			return hit.Instance ~= nil and hit.Instance:IsDescendantOf(character)
		end

		return true
	end
	local function fn_getPlayers()
		local CurrentCamera = workspace.CurrentCamera
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local vector2 = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
		local player2
		local flag
		local fn_handleHeadResult2

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character and (not modeTargetPartState.TeamCheck or player.Team ~= LocalPlayer.Team) then
				local Humanoid = player.Character:FindFirstChildOfClass("Humanoid")
				local fn_handleHeadResult = fn_handleHead(player.Character)

				if Humanoid and Humanoid.Health > 0 and fn_handleHeadResult then
					if HumanoidRootPart then
						if (modeTargetPartState.MaxDistance or 0) > 0 then
							if modeTargetPartState.MaxDistance < (fn_handleHeadResult.Position - HumanoidRootPart.Position).Magnitude then
								continue
							end
						end
					end

					local screenPoint, flag2 = CurrentCamera:WorldToViewportPoint(fn_handleHeadResult.Position)

					if flag2 and (not modeTargetPartState.VisibleOnly or fn_runRaycast(player.Character, fn_handleHeadResult)) then
						local Magnitude

						if modeTargetPartState.Mode == "Distance" then
							Magnitude = HumanoidRootPart and (fn_handleHeadResult.Position - HumanoidRootPart.Position).Magnitude or math.huge
						else
							local Magnitude2 = (Vector2.new(screenPoint.X, screenPoint.Y) - vector2).Magnitude

							if modeTargetPartState.FOV > 0 and modeTargetPartState.FOV < Magnitude2 then
								continue
							end

							Magnitude = Magnitude2
						end

						if not flag or Magnitude < flag then
							player2 = player
							flag = Magnitude
							fn_handleHeadResult2 = fn_handleHeadResult
						end
					end
				end
			end
		end

		return player2, fn_handleHeadResult2
	end
	local function fn_runWorldToViewportPoint(player)
		if not player or player.Parent ~= Players or not player.Character then
			return nil
		end

		if modeTargetPartState.TeamCheck and player.Team == LocalPlayer.Team then
			return nil
		end

		local Humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		local fn_handleHeadResult = fn_handleHead(player.Character)

		if not Humanoid or not (Humanoid.Health > 0) or not fn_handleHeadResult then
			return nil
		end

		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

		if HumanoidRootPart then
			if (modeTargetPartState.MaxDistance or 0) > 0 and modeTargetPartState.MaxDistance < (fn_handleHeadResult.Position - HumanoidRootPart.Position).Magnitude then
				return nil
			end
		end

		local CurrentCamera = workspace.CurrentCamera
		local screenPoint, flag2 = CurrentCamera:WorldToViewportPoint(fn_handleHeadResult.Position)

		if not flag2 then
			return nil
		end

		if modeTargetPartState.Mode == "Crosshair" then
			if (modeTargetPartState.FOV or 0) > 0 then
				local vector2 = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)

				if modeTargetPartState.FOV < (Vector2.new(screenPoint.X, screenPoint.Y) - vector2).Magnitude then
					return nil
				end
			end
		end

		if modeTargetPartState.VisibleOnly then
			if not fn_runRaycast(player.Character, fn_handleHeadResult) then
				return nil
			end
		end

		return fn_handleHeadResult
	end
	local function fn_applyCFrame(part)
		local Character = LocalPlayer.Character

		if Character and part:IsDescendantOf(Character) then
			return
		end

		local CurrentCamera = workspace.CurrentCamera
		local Position = part.Position

		if modeTargetPartState.Prediction then
			local AssemblyLinearVelocity = part.AssemblyLinearVelocity
			local amount = LocalPlayer:GetNetworkPing() + (modeTargetPartState.PredictionFactor or 0.15)

			Position += Vector3.new(AssemblyLinearVelocity.X, AssemblyLinearVelocity.Y * 0.4, AssemblyLinearVelocity.Z) * amount
		end

		local cFrame = CFrame.lookAt(CurrentCamera.CFrame.Position, Position)
		local clamped = math.clamp(1 - (modeTargetPartState.Smoothing or 0.4) * 0.92, 0.06, 1)

		CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(cFrame, clamped)
	end
	local function fn_applyThicknessNumSides()
		if modeTargetPartState.ShowFOV and modeTargetPartState.Enabled and modeTargetPartState.Mode == "Crosshair" then
			if (modeTargetPartState.FOV or 0) > 0 then
				if not gui then
					local ok, result = pcall(function()
						return Drawing.new("Circle")
					end)

					if not ok or not result then
						return
					end

					gui = result
					gui.Thickness = 1.6
					gui.NumSides = 64
					gui.Filled = false
					gui.Color = Color3.fromRGB(201, 162, 255)
				end

				local CurrentCamera = workspace.CurrentCamera

				gui.Radius = modeTargetPartState.FOV
				gui.Position = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
				gui.Visible = true

				return
			end
		end

		if gui then
			gui.Visible = false
		end
	end

	modeTargetPartState.Start = function(self)
		if startFlag then
			return
		end

		startFlag = true
		RunService:BindToRenderStep("LowHubAimbot", Enum.RenderPriority.Camera.Value + 1, function()
			fn_applyThicknessNumSides()

			if not self.Enabled then
				startFlag2 = nil

				return
			end

			local l = (self.Activation == "Always") or fn_runUpper(self.HoldKey)

			if not l then
				startFlag2 = nil

				return
			end

			local l

			if self.Sticky and startFlag2 then
				l = fn_runWorldToViewportPoint(startFlag2)
			end

			if not l then
				startFlag2, l = fn_getPlayers()
			end

			if startFlag2 and l then
				fn_applyCFrame(l)
			end
		end)
	end
	modeTargetPartState.Stop = function(self)
		self.Enabled = false
		pcall(function()
			RunService:UnbindFromRenderStep("LowHubAimbot")
		end)

		if gui then
			pcall(function()
				gui.Visible = false
				gui:Remove()
			end)
			gui = nil
		end

		startFlag2 = nil
		startFlag = false
	end
	modeTargetPartState.SetEnabled = function(self, enabled)
		self.Enabled = enabled == true
	end
	modeTargetPartState.GetTarget = function()
		return startFlag2
	end

	return modeTargetPartState
end
moduleDefs["Modules.Exploit.AntiAFK"] = function()
	local Players = game_:GetService("Players")
	local UserInputService = game_:GetService("UserInputService")
	local LocalPlayer = Players.LocalPlayer
	local connection
	local setEnabledFlag
	local lookup = {}

	local function getMouseEnabled()
		return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	end
	local function fn_runDisable()
		if type_(getconnections) ~= "function" then
			return false
		end

		local ok, result = pcall(getconnections, LocalPlayer.Idled)

		if not ok or type_(result) ~= "table" then
			return false
		end

		for _, v in ipairs(result) do
			local flag = false

			pcall(function()
				flag = setEnabledFlag ~= nil and v.Function == setEnabledFlag
			end)

			if not flag and pcall(function()
				v:Disable()
			end) then
				lookup[#lookup + 1] = v
			end
		end

		return true
	end
	local function fn_runEnable()
		for _, v in ipairs(lookup) do
			pcall(function()
				v:Enable()
			end)
		end

		lookup = {}
	end

	return {
		Enabled = false,
		SetEnabled = function(self, enabled)
			self.Enabled = enabled

			if enabled and not connection then
				local mouseEnabled = getMouseEnabled()

				setEnabledFlag = function()
					if not self.Enabled then
						return
					end

					if mouseEnabled then
						fn_runDisable()
						pcall(function()
							game_:GetService("VirtualUser"):ClickButton2(Vector2.zero)
						end)

						return
					end

					pcall(function()
						local VirtualUser = game_:GetService("VirtualUser")

						VirtualUser:CaptureController()
						VirtualUser:ClickButton2(Vector2.zero)
					end)
					pcall(function()
						local GuiService = game_:GetService("GuiService")
						local thread = coroutine.create(function()
							GuiService.SelectedObject = nil
						end)

						coroutine.resume(thread)
					end)
					pcall(function()
						keypress(119)
						task.wait(0.1)
						keyrelease(119)
					end)
				end
				connection = LocalPlayer.Idled:Connect(setEnabledFlag)

				if mouseEnabled then
					fn_runDisable()
				end
			elseif not enabled and connection then
				connection:Disconnect()
				connection = nil
				fn_runEnable()
			end
		end
	}
end
moduleDefs["Modules.Exploit.AntiCrash"] = function()
	local Players = game_:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local value = rawget(_G, "sethiddenproperty")

	value = value or sethiddenproperty

	local scanHzSelf = {
		Enabled = false,
		ScanHz = 30,
		SelfDefenseDebounce = 0.5,
		_runToken = 0,
		_connections = {},
		_trackedParts = {},
		_trackedChars = {},
		_lastSelfFix = 0,
		_warnedNoShp = false
	}

	local function fn_unnamed(connection)
		if connection then
			scanHzSelf._connections[#scanHzSelf._connections + 1] = connection
		end

		return connection
	end
	local function fn_unnamed2()
		local _connections = scanHzSelf._connections

		for i = 1, #_connections do
			pcall(function()
				_connections[i]:Disconnect()
			end)
		end

		table.clear(_connections)
	end
	local function fn_unnamed3(player)
		local trackedCharEntry = scanHzSelf._trackedChars[player]

		if not trackedCharEntry then
			return
		end

		for i = 1, #trackedCharEntry do
			pcall(function()
				trackedCharEntry[i]:Disconnect()
			end)
		end

		scanHzSelf._trackedChars[player] = nil
	end
	local function fn_unnamed4(character)
		if not character then
			return
		end

		local _trackedParts = scanHzSelf._trackedParts

		for _, descendant in ipairs(character:GetDescendants()) do
			if _trackedParts[descendant] then
				_trackedParts[descendant] = nil
			end
		end
	end
	local function fngetProperty(player)
		if player == LocalPlayer then
			return
		end

		local function onCharacterAdded(character)
			if not character or not scanHzSelf.Enabled then
				return
			end

			fn_unnamed3(player)

			local _trackedParts = scanHzSelf._trackedParts

			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") then
					_trackedParts[descendant] = true
				end
			end

			local lookup = {}

			lookup[#lookup + 1] = character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("BasePart") then
					_trackedParts[descendant] = true
				end
			end)
			lookup[#lookup + 1] = character.DescendantRemoving:Connect(function(descendant)
				if _trackedParts[descendant] then
					_trackedParts[descendant] = nil
				end
			end)
			lookup[#lookup + 1] = character:GetPropertyChangedSignal("Parent"):Connect(function()
				if not scanHzSelf.Enabled then
					return
				end

				local Parent = character.Parent

				if Parent ~= workspace then
					if Parent ~= nil then
						fn_unnamed4(character)
						pcall(function()
							character:Destroy()
						end)
					end
				end
			end)
			scanHzSelf._trackedChars[player] = lookup
		end

		if player.Character then
			onCharacterAdded(player.Character)
		end

		fn_unnamed(player.CharacterAdded:Connect(onCharacterAdded))
		fn_unnamed(player.CharacterRemoving:Connect(function(character)
			fn_unnamed4(character)
		end))
	end
	local function fn_applyLastSelfFix()
		local function fn_applyLastSelfFix2(character)
			if not character then
				return
			end

			fn_unnamed(character:GetPropertyChangedSignal("Parent"):Connect(function()
				if not scanHzSelf.Enabled then
					return
				end

				if _G.__LowHubServerLaggerActive then
					return
				end

				local Parent = character.Parent

				if Parent ~= workspace and Parent ~= nil then
					local now = os.clock()

					if now - scanHzSelf._lastSelfFix < scanHzSelf.SelfDefenseDebounce then
						return
					end

					scanHzSelf._lastSelfFix = now
					pcall(function()
						character.Parent = workspace
					end)
				end
			end))
		end

		if LocalPlayer.Character then
			fn_applyLastSelfFix2(LocalPlayer.Character)
		end

		fn_unnamed(LocalPlayer.CharacterAdded:Connect(function(character)
			task.wait(0.1)

			if scanHzSelf.Enabled then
				fn_applyLastSelfFix2(character)
			end
		end))
	end
	local function fn_applyWarnedNoShp(runToken)
		if type_(value) == "function" then
			local delay = 1 / math.max(5, scanHzSelf.ScanHz)

			task.spawn(function()
				while scanHzSelf.Enabled and runToken == scanHzSelf._runToken do
					local l = scanHzSelf._trackedParts

					for K in pairs(l) do
						if K.Parent then
							pcall(value, K, "PhysicsRepRootPart", K)
						else
							l[K] = nil
						end
					end

					task.wait(delay)
				end
			end)

			return
		end

		if not scanHzSelf._warnedNoShp then
			scanHzSelf._warnedNoShp = true
			warn_("[AntiCrash] executor has no sethiddenproperty — PhysicsRep defense off; parent-watch active")
		end
	end

	scanHzSelf.SetEnabled = function(self, flag)
		local enabled = flag == true

		if enabled == self.Enabled then
			return
		end

		self.Enabled = enabled

		if enabled then
			self._runToken += 1

			local _runToken = self._runToken

			for _, player in ipairs(Players:GetPlayers()) do
				pcall(fngetProperty, player)
			end

			fn_unnamed(Players.PlayerAdded:Connect(function(player)
				pcall(fngetProperty, player)
			end))
			fn_unnamed(Players.PlayerRemoving:Connect(function(player)
				fn_unnamed3(player)
			end))
			fn_applyLastSelfFix()
			fn_applyWarnedNoShp(_runToken)
		else
			self._runToken += 1
			fn_unnamed2()

			for k in pairs(self._trackedChars) do
				fn_unnamed3(k)
			end

			table.clear(self._trackedParts)
			table.clear(self._trackedChars)
			self._lastSelfFix = 0
		end
	end

	return scanHzSelf
end
