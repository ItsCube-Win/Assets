	local function createFrame2()
		local LowHub_FreecamMobileHUD = createScreenGui("LowHub_FreecamMobileHUD", 996)
		local Frame = Instance.new("Frame")

		Frame.Size = UDim2.new(0.5, 0, 0.6, 0)
		Frame.Position = UDim2.new(0.5, 0, 0.1, 0)
		Frame.BackgroundTransparency = 1
		Frame.Parent = LowHub_FreecamMobileHUD

		local Frame2 = Instance.new("Frame")

		Frame2.Size = UDim2.new(0, 74, 0, 74)
		Frame2.Position = UDim2.new(0.5, -37, 0.5, -37)
		Frame2.BackgroundColor3 = Theme.Colors.Card
		Frame2.BackgroundTransparency = 0.24
		Frame2.Parent = Frame
		Instance.new("UICorner", Frame2).CornerRadius = UDim.new(1, 0)

		local UIStroke = Instance.new("UIStroke")

		UIStroke.Thickness = 1.5
		UIStroke.Color = Theme.Colors.Accent
		UIStroke.Transparency = 0.55
		UIStroke.Parent = Frame2

		local TextLabel = Instance.new("TextLabel")

		TextLabel.Size = UDim2.new(1, 0, 1, 0)
		TextLabel.BackgroundTransparency = 1
		TextLabel.Text = "LOOK"
		TextLabel.TextColor3 = Theme.Colors.Text
		TextLabel.Font = Theme.Fonts.BodyMedium
		TextLabel.TextSize = 15
		TextLabel.Parent = Frame2

		local flag = false
		local vector22 = Vector2.new()

		Frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				flag = true
				vector22 = input.Position
			end
		end)
		Frame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				flag = false
				vector2 = Vector2.new()
			end
		end)
		Frame.InputChanged:Connect(function(input)
			if flag and input.UserInputType == Enum.UserInputType.Touch then
				local vector = input.Position - vector22

				vector2 = Vector2.new(vector.X, vector.Y)
				vector22 = input.Position
			end
		end)
		fn_applySizePosition(LowHub_FreecamMobileHUD, "UP", UDim2.new(1, -130, 0.5, -70), function(arg1)
			toggleAmount = arg1 and 1 or 0
		end)
		fn_applySizePosition(LowHub_FreecamMobileHUD, "DN", UDim2.new(1, -130, 0.5, 10), function(arg1)
			toggleAmount = arg1 and -1 or 0
		end)

		local Frame3 = Instance.new("Frame")

		Frame3.Size = UDim2.new(0, 120, 0, 120)
		Frame3.Position = UDim2.new(0, 50, 1, -170)
		Frame3.BackgroundColor3 = Theme.Colors.Card
		Frame3.BackgroundTransparency = 0.26
		Frame3.Parent = LowHub_FreecamMobileHUD
		Instance.new("UICorner", Frame3).CornerRadius = UDim.new(1, 0)

		local UIStroke2 = Instance.new("UIStroke")

		UIStroke2.Thickness = 1.5
		UIStroke2.Color = Theme.Colors.Accent
		UIStroke2.Transparency = 0.45
		UIStroke2.Parent = Frame3

		local Frame4 = Instance.new("Frame")

		Frame4.Size = UDim2.new(0, 50, 0, 50)
		Frame4.Position = UDim2.new(0.5, -25, 0.5, -25)
		Frame4.BackgroundColor3 = Theme.Colors.Accent
		Frame4.BackgroundTransparency = 0.12
		Frame4.Parent = Frame3
		Instance.new("UICorner", Frame4).CornerRadius = UDim.new(1, 0)

		local flag2 = false

		Frame3.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				flag2 = true
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				flag2 = false
				Frame4.Position = UDim2.new(0.5, -25, 0.5, -25)
				vector3 = Vector3.new()
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if flag2 and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
				local vector = Frame3.AbsolutePosition + Frame3.AbsoluteSize / 2
				local vector23 = Vector2.new(input.Position.X - vector.X, input.Position.Y - vector.Y)
				local minValue = math.min(vector23.Magnitude, 50)
				local Unit = vector23.Magnitude > 0 and vector23.Unit or Vector2.zero
				local vector2 = Unit * minValue

				Frame4.Position = UDim2.new(0.5, -25 + vector2.X, 0.5, -25 + vector2.Y)
				vector3 = Vector3.new(Unit.X, 0, Unit.Y) * (minValue / 50)
			end
		end)

		return LowHub_FreecamMobileHUD
	end

	activeSpeedState.Toggle = function(self, self2)
		if self2 == nil then
			self2 = not activeSpeedState.Active
		end

		activeSpeedState.Active = self2 == true

		if activeSpeedState.Active then
			SpectateService:Clear()
			CurrentCamera = workspace.CurrentCamera

			if not CurrentCamera then
				activeSpeedState.Active = false

				return false
			end

			CurrentCamera.CameraType = Enum.CameraType.Scriptable

			local LookVector = CurrentCamera.CFrame.LookVector

			toggleAmount2 = math.deg(math.atan2(-LookVector.X, -LookVector.Z))
			toggleAmount3 = math.deg(math.asin(LookVector.Y))

			local Character = LocalPlayer.Character

			if Character then
				local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

				if HumanoidRootPart then
					HumanoidRootPart.Anchored = true
				end

				local PlayerModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")

				if PlayerModule then
					local controls = requireModule(PlayerModule):GetControls()

					if controls then
						pcall(function()
							controls:Disable()
						end)
					end
				end

				for _, descendant in pairs(Character:GetDescendants()) do
					if descendant:IsA("BasePart") then
						descendant.CanCollide = false
					end
				end
			end

			instance2 = createFrame()

			if UserInputService.TouchEnabled then
				instance = createFrame2()
			end

			local Position = CurrentCamera.CFrame.Position

			toggleFlag = false

			if not UserInputService.TouchEnabled then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				UserInputService.MouseIconEnabled = false
			end

			table.insert(toggleList, UserInputService.InputBegan:Connect(function(input)
				if not UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
					toggleFlag = true
					UserInputService.MouseBehavior = Enum.MouseBehavior.Default
					UserInputService.MouseIconEnabled = true
				end
			end))
			table.insert(toggleList, UserInputService.InputEnded:Connect(function(input)
				if not UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
					toggleFlag = false
					UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
					UserInputService.MouseIconEnabled = false
				end
			end))
			table.insert(toggleList, UserInputService.InputChanged:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseMovement or toggleFlag then
					if input.UserInputType == Enum.UserInputType.MouseWheel then
						activeSpeedState.Speed = math.clamp(activeSpeedState.Speed + input.Position.Z * 0.5, 0, 10)

						if toggleFlag2 then
							toggleFlag2()
						end
					end
				else
					activeSpeedState.RotVector = Vector2.new(input.Delta.X, input.Delta.Y)
				end
			end))
			table.insert(toggleList, RunService.RenderStepped:Connect(function(l)
				CurrentCamera = workspace.CurrentCamera or CurrentCamera

				if not CurrentCamera then
					return
				end

				CurrentCamera.CameraType = Enum.CameraType.Scriptable

				local _ = Vector3.new()

				if not toggleFlag then
					if UserInputService:IsKeyDown(Enum.KeyCode.W) then
						_ = _ + CurrentCamera.CFrame.LookVector
					end

					if UserInputService:IsKeyDown(Enum.KeyCode.S) then
						_ = _ - CurrentCamera.CFrame.LookVector
					end

					if UserInputService:IsKeyDown(Enum.KeyCode.A) then
						_ = _ - CurrentCamera.CFrame.RightVector
					end

					if UserInputService:IsKeyDown(Enum.KeyCode.D) then
						_ = _ + CurrentCamera.CFrame.RightVector
					end
				end

				if vector3.Magnitude > 0 then
					local t = (CurrentCamera.CFrame.RightVector * vector3.X) + (CurrentCamera.CFrame.LookVector * -vector3.Z)

					_ = _ + t
				end

				local S = 0

				if not toggleFlag then
					if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
						S = 1
					end

					if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
						S = -1.0
					end
				end

				S = S + toggleAmount
				_ = _ + Vector3.new(0, S, 0)

				local W = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1

				Position = Position + (_ * activeSpeedState.Speed * W * l * 50)

				local l = activeSpeedState.RotVector + vector2

				toggleAmount2 = toggleAmount2 - (l.X * 0.4)
				toggleAmount3 = math.clamp(toggleAmount3 - (l.Y * 0.4), -89.0, 89)
				CurrentCamera.CFrame = CFrame.new(Position) * CFrame.Angles(0, math.rad(toggleAmount2), 0) * CFrame.Angles(math.rad(toggleAmount3), 0, 0)
				activeSpeedState.RotVector = Vector2.new()
				vector2 = Vector2.new()

				if not UserInputService.TouchEnabled and not toggleFlag then
					UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				end
			end))
		else
			for _, v in pairs(toggleList) do
				v:Disconnect()
			end

			table.clear(toggleList)

			if instance2 then
				instance2:Destroy()
				instance2 = nil
			end

			if instance then
				instance:Destroy()
				instance = nil
			end

			toggleAmount = 0
			vector3 = Vector3.new()
			vector2 = Vector2.new()
			toggleFlag = false
			toggleFlag2 = nil
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			CurrentCamera = workspace.CurrentCamera or CurrentCamera

			if CurrentCamera then
				CurrentCamera.CameraType = Enum.CameraType.Custom
			end

			local Character = LocalPlayer.Character

			if Character then
				local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

				if HumanoidRootPart then
					HumanoidRootPart.Anchored = false
				end

				local PlayerModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")

				if PlayerModule then
					local controls = requireModule(PlayerModule):GetControls()

					if controls then
						pcall(function()
							controls:Enable()
						end)
					end
				end

				local Humanoid = Character:FindFirstChild("Humanoid")

				if Humanoid and CurrentCamera then
					CurrentCamera.CameraSubject = Humanoid
				end

				for _, descendant in pairs(Character:GetDescendants()) do
					if descendant:IsA("BasePart") then
						descendant.CanCollide = true
					end
				end
			end
		end

		return activeSpeedState.Active
	end

	return activeSpeedState
end
moduleDefs["Services.KeybindService"] = function()
	local UserInputService = game_:GetService("UserInputService")
	local tbl = {
		[Enum.UserInputType.MouseButton1] = true,
		[Enum.UserInputType.MouseButton2] = true,
		[Enum.UserInputType.MouseButton3] = true
	}

	local function fn_unnamed(binding)
		return binding and tbl[binding] == true
	end
	local function fn_handleEnumItem(binding)
		return binding and typeof(binding) == "EnumItem" and binding.EnumType == Enum.KeyCode
	end

	return {
		Bindings = {},
		Callbacks = {},
		Listening = false,
		ListenCallback = nil,
		Init = function(self)
			if self._initialized then
				return
			end

			self._initialized = true
			UserInputService.InputBegan:Connect(function(input, gameProcessed)
				local flag = input.UserInputType == Enum.UserInputType.Keyboard
				local flag2 = tbl[input.UserInputType] == true

				if self.Listening then
					if not flag and not flag2 then
						return
					end

					local KeyCode

					if flag then
						KeyCode = input.KeyCode

						if KeyCode == Enum.KeyCode.Escape or KeyCode == Enum.KeyCode.Backspace or KeyCode == Enum.KeyCode.Delete then
							KeyCode = nil
						end
					else
						KeyCode = input.UserInputType
					end

					self.Listening = false

					if self.ListenCallback then
						self.ListenCallback(KeyCode)
						self.ListenCallback = nil
					end

					return
				end

				if gameProcessed then
					return
				end

				for k, binding in pairs(self.Bindings) do
					local flag3 = false

					if flag and fn_handleEnumItem(binding) and input.KeyCode == binding then
						flag3 = true
					end

					if flag2 and fn_unnamed(binding) and input.UserInputType == binding then
						flag3 = true
					end

					if flag3 then
						local callbackEntry = self.Callbacks[k]

						if callbackEntry then
							pcall(callbackEntry)
						end
					end
				end
			end)
		end,
		Register = function(self, signalService, tagService)
			self.Callbacks[signalService] = tagService
		end,
		SetBind = function(obj, arg2, arg3)
			obj.Bindings[arg2] = arg3
		end,
		GetBind = function(obj, arg2)
			return obj.Bindings[arg2]
		end,
		GetBindName = function(obj, arg2)
			local bindingEntry = obj.Bindings[arg2]

			if bindingEntry then
				return bindingEntry.Name
			end

			return ""
		end,
		IsHeld = function(obj, arg2)
			local bindingEntry = obj.Bindings[arg2]

			if not bindingEntry then
				return false
			end

			if fn_handleEnumItem(bindingEntry) then
				return UserInputService:IsKeyDown(bindingEntry)
			end

			if fn_unnamed(bindingEntry) then
				return UserInputService:IsMouseButtonPressed(bindingEntry)
			end

			return false
		end,
		StartListening = function(obj, listenCallback)
			obj.Listening = true
			obj.ListenCallback = listenCallback
		end,
		StopListening = function(obj)
			obj.Listening = false
			obj.ListenCallback = nil
		end,
		LoadFromProfile = function(obj, list)
			if type_(list) ~= "table" then
				return
			end

			obj.Bindings = {}

			for k, v in pairs(list) do
				if type_(v) == "string" and v ~= "" then
					if v == "MouseButton1" or v == "MouseButton2" or v == "MouseButton3" then
						local ok, result = pcall(function()
							return Enum.UserInputType[v]
						end)

						if ok and result then
							obj.Bindings[k] = result
						end
					else
						local ok, result = pcall(function()
							return Enum.KeyCode[v]
						end)

						if ok and result then
							obj.Bindings[k] = result
						end
					end
				end
			end
		end,
		SerializeBindings = function(list)
			local lookup = {}

			for k, binding in pairs(list.Bindings) do
				lookup[k] = binding.Name
			end

			return lookup
		end
	}
end
