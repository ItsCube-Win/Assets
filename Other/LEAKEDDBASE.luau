			return nil
		end

		local match = s46:match("^%s*(.-)%s*$")
		local match2 = match:match("/users/(%d+)")

		if match2 then
			return tonumber(match2)
		end

		if match:sub(1, 1) == "@" then
			match = match:sub(2)
		end

		if tonumber(match) then
			return tonumber(match)
		end

		local ok, result = pcall(Players.GetUserIdFromNameAsync, Players, match)

		return ok and result or nil
	end
	appliedAppliedIdService.ResolveName = function(self, appliedId)
		local ok, result = pcall(Players.GetNameFromUserIdAsync, Players, appliedId)

		return ok and result or tostring(appliedId)
	end
	appliedAppliedIdService.GetRandomPresetId = function()
		return tbl[math.random(1, #tbl)]
	end
	appliedAppliedIdService.AddFavorite = function(self, appliedId, name)
		for _, favorite in ipairs(self.Favorites) do
			if favorite.id ~= appliedId then
				continue
			end

			favorite.name = name or favorite.name
			favorite.savedAt = os.time()
			self:SaveFavorites()

			return false
		end

		table.insert(self.Favorites, 1, {
			id = appliedId,
			name = name or self:ResolveName(appliedId),
			savedAt = os.time()
		})
		self:SaveFavorites()

		return true
	end
	appliedAppliedIdService.RemoveFavorite = function(self, arg2)
		for i, favorite in ipairs(self.Favorites) do
			if favorite.id ~= arg2 then
				continue
			end

			table.remove(self.Favorites, i)
			self:SaveFavorites()

			return true
		end

		return false
	end
	appliedAppliedIdService.GetFavorites = function(self)
		return self.Favorites
	end
	appliedAppliedIdService.SaveFavorites = function(self)
		local json = HttpService:JSONEncode({
			favorites = self.Favorites
		})

		fn_handleLowHub("LowHub/skinchanger.json", json)
	end
	appliedAppliedIdService.LoadFavorites = function(self)
		local json = fn_unnamed("LowHub/skinchanger.json")

		if json then
			local ok, result = pcall(function()
				return HttpService:JSONDecode(json)
			end)

			if ok and result and type_(result.favorites) == "table" then
				self.Favorites = result.favorites
			end
		end
	end

	return appliedAppliedIdService
end
moduleDefs["Services.SpectateService"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local Workspace = game_:GetService("Workspace")
	local LocalPlayer = Players.LocalPlayer
	local VIPProtectionService = requireModule("Services.VIPProtectionService")

	return {
		State = {
			Target = nil
		},
		RenderConnection = nil,
		PlayerRemovingConnection = nil,
		Clear = function(self)
			self.State.Target = nil

			if self.RenderConnection then
				self.RenderConnection:Disconnect()
				self.RenderConnection = nil
			end

			if self.PlayerRemovingConnection then
				self.PlayerRemovingConnection:Disconnect()
				self.PlayerRemovingConnection = nil
			end

			local CurrentCamera = Workspace.CurrentCamera
			local Character = LocalPlayer.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

			if CurrentCamera and Humanoid then
				CurrentCamera.CameraSubject = Humanoid
			end
		end,
		Toggle = function(self, self2)
			if self2 and VIPProtectionService:IsProtectedFrom(self2, "Spectate") then
				self:Clear()
				VIPProtectionService:NotifyBlocked("Spectate", self2)

				return false
			end

			if self2 == nil or self.State.Target == self2 then
				self:Clear()

				return false
			end

			self:Clear()
			self.State.Target = self2
			self.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
				if player == self2 then
					self:Clear()
				end
			end)
			self.RenderConnection = RunService.RenderStepped:Connect(function()
				if self.State.Target ~= self2 or not self2.Parent then
					self:Clear()

					return
				end

				if VIPProtectionService:IsProtectedFrom(self2, "Spectate") then
					VIPProtectionService:NotifyBlocked("Spectate", self2)
					self:Clear()

					return
				end

				local l = Workspace.CurrentCamera
				local W = self2.Character
				local i = W and W:FindFirstChildOfClass("Humanoid")

				if l and i and l.CameraSubject ~= i then
					l.CameraSubject = i
				end
			end)

			return true
		end,
		IsActive = function(self)
			return self.State.Target ~= nil
		end,
		GetTarget = function(obj)
			return obj.State.Target
		end
	}
end
