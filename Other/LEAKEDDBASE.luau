			end
		end

		return frame, lookup
	end
	local function fn_applyPocketed(arg1, list)
		local newState = obj3.NewState(arg1)

		for _, v in ipairs(list) do
			local addBall = obj3.AddBall(newState, v.id, v.pos)

			if v.pocketed then
				addBall.Pocketed = true
			end
		end

		return newState
	end
	local function fn_runDot(arg1, arg2, arg3, unit)
		local fn_applyPocketedResult = fn_applyPocketed(arg1, arg2)

		obj3.ApplyStrike(fn_applyPocketedResult, arg3, unit)

		local lookup = {}
		local fnRunDotActive = false
		local Id

		for i = 1, 420 do
			local step = obj3.Step(fn_applyPocketedResult)

			if step.Collisions > 0 then
				fnRunDotActive = true
			end

			if not Id then
				for _, ball in ipairs(fn_applyPocketedResult.Balls) do
					if ball.Id ~= 0 and not ball.Pocketed then
						if ball.Vel:Dot(ball.Vel) > 1e-06 then
							Id = ball.Id

							break
						end
					end
				end
			end

			for _, v in ipairs(step.Pocketed) do
				lookup[#lookup + 1] = v
			end

			if obj3.Settled(fn_applyPocketedResult) then
				break
			end
		end

		return lookup, fnRunDotActive, Id
	end
	local function fn_unnamed(list, flag, flag2, flag3, amount, arg6)
		local amount2 = 0
		local flag5 = false
		local flag6 = false
		local amount3 = 0

		for _, v in ipairs(list) do
			if v == 0 then
				flag5 = true
			elseif v == 8 then
				flag6 = true
			elseif flag3 and flag3 <= v and v <= amount then
				amount3 += 1
			elseif flag3 then
				amount2 -= 200
			else
				amount3 += 1
			end
		end

		local value = amount2 + amount3 * 1000

		if flag6 then
			value += arg6 and 100000 or -50000
		end

		if flag5 then
			value -= 5000
		end

		if not flag then
			value -= 20000
		end

		if flag3 and flag2 then
			if not (flag2 >= flag3 and flag2 <= amount or flag2 == 8 and arg6) then
				value -= 8000
			end
		end

		return value, amount3, flag5, flag6
	end
	local function getUnit(obj, vector3)
		return (obj.Long * vector3.X + obj.Short * vector3.Y).Unit
	end
	local function fn_unnamed2(vector, instance)
		local cosine = math.cos(instance)
		local sine = math.sin(instance)

		return Vector3.new(vector.X * cosine - vector.Y * sine, vector.X * sine + vector.Y * cosine, 0)
	end
	local function fn_runDot2(obj, list, amount, amount2, flag)
		local newState = obj3.NewState(obj)
		local obj2
		local lookup = {}

		for _, v in ipairs(list) do
			if not v.pocketed then
				if v.id == 0 then
					obj2 = v
				elseif v.id == 8 then
					if flag then
						lookup[#lookup + 1] = v
					end
				elseif amount == nil or amount <= v.id and v.id <= amount2 then
					lookup[#lookup + 1] = v
				end
			end
		end

		if not obj2 then
			return {}
		end

		local HalfLong = obj.HalfLong
		local HalfShort = obj.HalfShort
		local lookup2 = {}

		for _, pocket in ipairs(newState.Pockets) do
			lookup2[#lookup2 + 1] = pocket
			lookup2[#lookup2 + 1] = Vector3.new(2 * HalfLong - pocket.X, pocket.Y, 0)
			lookup2[#lookup2 + 1] = Vector3.new(-2 * HalfLong - pocket.X, pocket.Y, 0)
			lookup2[#lookup2 + 1] = Vector3.new(pocket.X, 2 * HalfShort - pocket.Y, 0)
			lookup2[#lookup2 + 1] = Vector3.new(pocket.X, -2 * HalfShort - pocket.Y, 0)
		end

		local lookup3 = {}

		for _, v in ipairs(lookup) do
			for _, instance in ipairs(lookup2) do
				local vector = instance - v.pos

				if vector.Magnitude > 0.001 then
					local vector2 = v.pos - vector.Unit * X - obj2.pos

					if vector2.Magnitude > 0.001 then
						if vector2.Unit:Dot(vector.Unit) > 0.17 then
							lookup3[#lookup3 + 1] = vector2.Unit
						end
					end
				end
			end
		end

		return lookup3
	end
	local function fn_handleNoShot(arg1)
		local amount = os.clock() + 6
		local flag, list2 = fn_getAttribute5(arg1)

		if not flag then
			return nil, "couldn't read the table"
		end

		local flag2, amount2 = fn_getAttribute4(arg1)
		local value = flag2 ~= nil

		if flag2 then
			for _, obj in ipairs(list2) do
				if flag2 <= obj.id and obj.id <= amount2 and not obj.pocketed then
					value = false

					break
				end
			end
		end

		local obj5
		local fn_runDot2Result = fn_runDot2(flag, list2, flag2, amount2, value)
		local lookup = {}
		for k, v in ipairs(fn_runDot2Result) do
			if amount < os.clock() then
				break
			end

			local value2, value2_2, value3 = fn_runDot(flag, list2, 0.62, getUnit(flag, v))

			lookup[#lookup + 1] = {
				d = v,
				pts = fn_unnamed(value2, value2_2, value3, flag2, amount2, value)
			}

			if k % 12 == 0 then
				task.wait()
			end
		end

		table.sort(lookup, function(obj, obj2)
			return obj.pts > obj2.pts
		end)

		for i = 1, math.min(3, #lookup) do
			if amount < os.clock() then
				break
			end

			for _, v in ipairs({
				0.35,
				0.5,
				0.65,
				0.8,
				1
			}) do
				for _, instance in ipairs({
					0,
					0.006,
					-0.006,
					0.013,
					-0.013
				}) do
					local unit = getUnit(flag, fn_unnamed2(lookup[i].d, instance))
					local value2, value2_2, value3 = fn_runDot(flag, list2, v, unit)
					local amount3, value2_3, value3_2, value4 = fn_unnamed(value2, value2_2, value3, flag2, amount2, value)
					local amount4 = amount3 - v * 30

					if not obj5 or obj5.pts < amount4 then
						obj5 = {
							pts = amount4,
							power = v,
							dir = unit,
							minhas = value2_3,
							branca = value3_2,
							oito = value4
						}
					end
				end

				task.wait()
			end
		end

		if not obj5 or obj5.pts <= 0 then
			fn_applyStatus("no direct shot, scanning the table...")

			for i = 0, 71 do
				if amount < os.clock() then
					break
				end

				local radians = math.rad(i * 5)
				local vector3 = Vector3.new(math.cos(radians), math.sin(radians), 0)

				for _, v in ipairs({
					0.55,
					0.9
				}) do
					local unit = getUnit(flag, vector3)
					local value2, value2_2, value3 = fn_runDot(flag, list2, v, unit)
					local amount3, value2_3, value3_2, value4 = fn_unnamed(value2, value2_2, value3, flag2, amount2, value)
					local amount4 = amount3 - v * 30

					if not obj5 or obj5.pts < amount4 then
						obj5 = {
							pts = amount4,
							power = v,
							dir = unit,
							minhas = value2_3,
							branca = value3_2,
							oito = value4
						}
					end
				end

				if i % 4 == 0 then
					task.wait()
				end
			end
		end

		local value2 = obj5
		local value3 = not obj5 and "no shot" or nil

		return value2, value3
	end
	local function fn_runWorldToViewportPoint(arg1, list, dir, aimTime)
		if not mousemoveabs then
			return
		end

		local obj

		for _, v in ipairs(list) do
			if v.id == 0 and not v.pocketed then
				obj = v
			end
		end

		if not obj then
			return
		end

		local vector, flag2 = workspace.CurrentCamera:WorldToViewportPoint(obj3.LocalToWorld(arg1, obj.pos) + dir * 4)

		if not flag2 or vector.Z <= 0 then
			return
		end

		local guiInset = GuiService:GetGuiInset()
		local amount = vector.X + guiInset.X
		local amount2 = vector.Y + guiInset.Y
		local mouseLocation = UserInputService:GetMouseLocation()
		local maxValue = math.max(6, math.floor(aimTime / 0.03))

		for i = 1, maxValue do
			local amount3 = i / maxValue
			local amount4 = 1 - (1 - amount3) * (1 - amount3)

			pcall(mousemoveabs, mouseLocation.X + (amount - mouseLocation.X) * amount4, mouseLocation.Y + (amount2 - mouseLocation.Y) * amount4)
			task.wait(0.03)
		end

		pcall(mousemoveabs, amount, amount2)
		task.wait(0.12)
	end
	local function fn_runSub(fn_getAttributeResult)
		local now = os.clock()
		local ok, result = pcall(fn_handleNoShot, fn_getAttributeResult)

		if not ok then
			fn_applyStatus("error: " .. tostring(result):sub(1, 40))

			return
		end

		if not result then
			fn_applyStatus("no good shot")

			return
		end

		fn_applyStatus(("%d ball(s) · power %.0f%% · %.1fs"):format(result.minhas, result.power * 100, os.clock() - now))

		if not fn_getAttribute2(fn_getAttributeResult) then
			fn_applyStatus("lost the turn while calculating")

			return
		end

		if legitDelayService.Legit then
			fn_applyStatus("aiming...")

			local flag, value2 = fn_getAttribute5(fn_getAttributeResult)

			if flag then
				fn_runWorldToViewportPoint(flag, value2, result.dir, legitDelayService.AimTime)
			end

			if not fn_getAttribute2(fn_getAttributeResult) then
				fn_applyStatus("lost the turn while aiming")

				return
			end
		else
			task.wait(legitDelayService.Delay)
		end

		pcall(function()
			obj4.Snooker.Strike.Fire({
				Table = fn_getAttributeResult,
				Power = result.power,
				Heading = result.dir
			})
		end)

		if flag4 then
			pcall(flag4, fn_getAttributeResult, result.power, result.dir, true)
		else
			fn_applyStatus("no RunShot: the cue may stick")
		end

		startAmount = os.clock()
	end

	legitDelayService.Start = function()
		if startFlag then
			return
		end

		if not fn_getExtentsSize() then
			fn_applyStatus("snooker not found in this game")

			return
		end

		startFlag = true
		task.spawn(function()
			while startFlag do
				task.wait(0.6)

				local fn_getAttributeResult = fn_getAttribute()

				if fn_getAttributeResult then
					local fn_getAttribute2Result = fn_getAttribute2(fn_getAttributeResult)

					if legitDelayService.OnTable then
						local fn_getAttribute4Result = fn_getAttribute4(fn_getAttributeResult)
						local pcall_ = pcall
						local OnTable = legitDelayService.OnTable
						local s3 = "%s · %s"
						local format = ("%s · %s").format
						local startFlag3 = fn_getAttribute2Result and "YOUR TURN"

						if not startFlag3 then
							local tostring_ = tostring
							local attribute = fn_getAttributeResult:GetAttribute("ShooterName")

							startFlag3 = tostring_(attribute or "?") .. "'s turn"
						end

						pcall_(OnTable, format(s3, startFlag3, fn_getAttribute4Result == 1 and "solids" or fn_getAttribute4Result == 9 and "stripes" or "open table"))
					end

					if fn_getAttribute2Result and os.clock() - startAmount > 5 and (legitDelayService.Enabled or startFlag2) then
						startFlag2 = false
						fn_runSub(fn_getAttributeResult)
					elseif startFlag2 and not fn_getAttribute2Result then
						fn_applyStatus("not your turn")
						startFlag2 = false
					end
				else
					if legitDelayService.OnTable then
						pcall(legitDelayService.OnTable, "not in a match")
