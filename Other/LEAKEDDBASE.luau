				end

				local text = table.concat(registry, " | ")

				if text == "" then
					ensureEntryResult.InfoText.Visible = false
				else
					ensureEntryResult.InfoText.Text = text
					ensureEntryResult.InfoText.Color = fn_handleToolResult and State.ItemColor or State.DistanceColor
					ensureEntryResult.InfoText.Position = Vector2.new(updateEntryValue, updateEntryAmount4 + 4)
					ensureEntryResult.InfoText.Visible = true
				end
			else
				ensureEntryResult.InfoText.Visible = false
			end

			if ShowHealthBar and updateEntryFlag6 and updateEntryFlag6 > 0 then
				local clamped = math.clamp(updateEntryAmount5 / updateEntryFlag6, 0, 1)
				local updateEntryValue2 = updateEntryFlag2 - 5

				ensureEntryResult.HpBg.From = Vector2.new(updateEntryValue2, updateEntryAmount2)
				ensureEntryResult.HpBg.To = Vector2.new(updateEntryValue2, updateEntryAmount4)
				ensureEntryResult.HpBg.Visible = true
				ensureEntryResult.HpFg.From = Vector2.new(updateEntryValue2, updateEntryAmount4)
				ensureEntryResult.HpFg.To = Vector2.new(updateEntryValue2, updateEntryAmount4 - updateEntryAmount6 * clamped)
				ensureEntryResult.HpFg.Color = Color3.fromRGB(math.floor(255 * (1 - clamped)), math.floor(200 * clamped + 55), 50)
				ensureEntryResult.HpFg.Visible = true
			else
				ensureEntryResult.HpBg.Visible = false
				ensureEntryResult.HpFg.Visible = false
