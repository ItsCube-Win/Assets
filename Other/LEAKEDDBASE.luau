moduleDefs["Modules.Signal.ForceInteractionHandler"] = function()
	local Players = game_:GetService("Players")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local signalService2
	local runners
	local isActive
	local stop
	local setNoDelay
	local isOwner
	local syncEmote
	local noDelay
	local connection
	local forcedRegisterService = {
		Forced = nil
	}
	local thread

	local function fn_getPlayers(ownerUserId)
		local number = tonumber(ownerUserId)

		if not number then
			return nil
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player.UserId == number then
				return player
			end
		end

		return nil
	end
	local function fn_unnamed()
		if thread then
			return
		end

		thread = task.spawn(function()
			while forcedRegisterService.Forced do
				local Forced = forcedRegisterService.Forced
				local fn_getPlayersResult = fn_getPlayers(Forced.ownerId)
				local runnerEntry = runners and runners[Forced.name]

				if setNoDelay then
					pcall(setNoDelay, true)
				end

				if fn_getPlayersResult and fn_getPlayersResult.Character and runnerEntry and isActive and not isActive(Forced.name) then
					pcall(runnerEntry, function()
						return fn_getPlayersResult
					end)
				end

				task.wait(0.4)
			end

			thread = nil
		end)
	end
	local function fn_applyForced()
		local Forced = forcedRegisterService.Forced

		forcedRegisterService.Forced = nil

		if Forced and stop then
			pcall(stop, Forced.name)
		end

		if setNoDelay and noDelay ~= nil then
			pcall(setNoDelay, noDelay)
			noDelay = nil
		end

		if _G.LowHub and _G.LowHub.toast then
			pcall(_G.LowHub.toast, "LowHub", "Interação liberada", "info", "signal")
		end
	end

	forcedRegisterService.Register = function(self, signalService, tagService)
		signalService2 = signalService
		runners = tagService and tagService.runners
		isActive = tagService and tagService.isActive
		stop = tagService and tagService.stop
		setNoDelay = tagService and tagService.setNoDelay
		isOwner = tagService and tagService.isOwner
		syncEmote = tagService and tagService.syncEmote
		signalService:OnMessage("force_interaction", function(obj)
			if not obj then
				return
			end

			local number = tonumber(obj.targetUserId)

			if not number or number ~= LocalPlayer.UserId then
				return
			end

			if obj.action == "stop" then
				fn_applyForced()

				return
			end

			if obj.action == "start" and obj.interaction then
				if isOwner and not isOwner(tonumber(obj.ownerUserId)) then
					return
				end

				local runnerEntry = runners and runners[obj.interaction]

				if not runnerEntry then
					return
				end

				local fn_getPlayersResult = fn_getPlayers(obj.ownerUserId)

				if not fn_getPlayersResult then
					return
				end

				forcedRegisterService.Forced = {
					name = obj.interaction,
					ownerId = tonumber(obj.ownerUserId),
					ownerName = obj.ownerName or fn_getPlayersResult.Name
				}

				if setNoDelay then
					if noDelay == nil and tagService and tagService.getNoDelay then
						noDelay = tagService.getNoDelay()
					end

					pcall(setNoDelay, true)
				end

				if isActive and not isActive(obj.interaction) then
					pcall(runnerEntry, function()
						return fn_getPlayersResult
					end)
				end

				fn_unnamed()

				if _G.LowHub and _G.LowHub.toast then
					pcall(_G.LowHub.toast, "LowHub", (obj.ownerName or fn_getPlayersResult.Name) .. " forçou: " .. obj.interaction, "info", "signal")
				end
			end
		end)
		signalService:OnMessage("force_freeze", function(obj)
			if not obj then
				return
			end

			if isOwner and not isOwner(tonumber(obj.ownerUserId)) then
				return
			end

			if tonumber(obj.targetUserId) ~= LocalPlayer.UserId then
				return
			end

			local Character = LocalPlayer.Character
			local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

			if not HumanoidRootPart then
				return
			end

			if connection then
				connection:Disconnect()
				connection = nil
			end

			if obj.action == "freeze" then
				local CFrame_ = HumanoidRootPart.CFrame

				HumanoidRootPart.Anchored = true
				connection = RunService.Stepped:Connect(function()
					local Character2 = LocalPlayer.Character

					if Character2 then
						local HumanoidRootPart2 = Character2:FindFirstChild("HumanoidRootPart")

						if HumanoidRootPart2 and not HumanoidRootPart2.Anchored then
							HumanoidRootPart2.CFrame = CFrame_
							HumanoidRootPart2.Anchored = true
						end
					end
				end)

				if _G.LowHub and _G.LowHub.toast then
					pcall(_G.LowHub.toast, "LowHub", "Você foi congelado", "info", "signal")
				end
			else
				HumanoidRootPart.Anchored = false

				if _G.LowHub and _G.LowHub.toast then
					pcall(_G.LowHub.toast, "LowHub", "Descongelado", "info", "signal")
				end
			end
		end)
		signalService:OnMessage("force_pull", function(obj)
			if not obj then
				return
			end

			if isOwner and not isOwner(tonumber(obj.ownerUserId)) then
				return
			end

			if tonumber(obj.targetUserId) ~= LocalPlayer.UserId then
				return
			end

			local fn_getPlayersResult = fn_getPlayers(obj.ownerUserId)
			local Character = fn_getPlayersResult and fn_getPlayersResult.Character
			local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local Character2 = LocalPlayer.Character
			local HumanoidRootPart2 = Character2 and Character2:FindFirstChild("HumanoidRootPart")

			if HumanoidRootPart and HumanoidRootPart2 then
				pcall(function()
					HumanoidRootPart2.CFrame = HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
				end)
			end

			local Forced = forcedRegisterService.Forced

			if Forced and runners and runners[Forced.name] and fn_getPlayersResult and isActive and not isActive(Forced.name) then
				pcall(runners[Forced.name], function()
					return fn_getPlayersResult
				end)
			end
		end)
		signalService:OnMessage("force_emote_all", function(obj)
			if not obj then
				return
			end

			if isOwner and not isOwner(tonumber(obj.ownerUserId)) then
				return
			end

			if tonumber(obj.ownerUserId) == LocalPlayer.UserId then
				return
			end

			if not syncEmote then
				return
			end

			local fn_getPlayersResult = fn_getPlayers(obj.ownerUserId)

			if obj.action == "start" and fn_getPlayersResult then
				if not syncEmote:IsActive() then
					pcall(function()
						syncEmote:Toggle(fn_getPlayersResult)
					end)
				end
			elseif syncEmote:IsActive() then
				pcall(function()
					syncEmote:Stop()
				end)
			end
		end)
	end
	forcedRegisterService.Cleanup = function()
		fn_applyForced()

		if connection then
			connection:Disconnect()
			connection = nil
		end

		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

		if HumanoidRootPart and HumanoidRootPart.Anchored then
			HumanoidRootPart.Anchored = false
		end

		if syncEmote and syncEmote:IsActive() then
			pcall(function()
				syncEmote:Stop()
			end)
		end
	end

	return forcedRegisterService
end
moduleDefs["Modules.Signal.KillHandler"] = function()
