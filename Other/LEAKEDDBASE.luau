						break
					end
				end
			end)

			for _, player in ipairs(Players:GetPlayers()) do
				table.insert(self.PlayerList, player)
				self:UpdateEntry(player)
			end

			self._frameAcc = 0
			self.RenderConnection = RunService.RenderStepped:Connect(function(l)
				self._frameAcc = self._frameAcc + l

				if self._frameAcc < 0.0166 then
					return
				end

				self._frameAcc = 0
				self:Update()
			end)

			return self
		end,
		Destroy = function(self)
			self._dead = true
			self.State.MasterEnabled = false

			local tbl = {
				self.RenderConnection,
				self.PlayerAddedConnection,
				self.PlayerRemovingConnection
			}

			for i = 1, 3 do
				local connection = tbl[i]

				if connection then
					pcall(connection.Disconnect, connection)
				end
			end

			self.RenderConnection = nil
			self.PlayerAddedConnection = nil
			self.PlayerRemovingConnection = nil

			if self.Container then
				pcall(self.Container.Destroy, self.Container)
			end

			self.Container = nil
			pcall(self.Clear, self)
			table.clear(self.PlayerList)
		end
	}
end
moduleDefs["Services.VIPAccessService"] = function()
