	packsStateService.SyncWithPlayer = function(player, instance)
		local function fn_applyText(text)
			if not instance then
				return
			end

			local TextLabel = instance:FindFirstChildOfClass("TextLabel")

			if TextLabel then
				TextLabel.Text = text
			end
		end

		if packsStateService.State.Syncing then
			packsStateService.State.Syncing = false
			fn_applyText("Sync Emote")
			packsStateService.StopAll()

			return
		end

		if not player or not player.Character then
			warn_("[LowHub] SyncWithPlayer: No target or target character found.")

			return
		end

		packsStateService.State.Syncing = true
		fn_applyText("Stop Sync")
		task.spawn(function()
			local lookup = {}
			local connection
			local Animate
			local lookup2 = {}
			local syncWithPlayerFlag = false

			local function fnapplyAnimation()
				if connection then
					connection:Disconnect()
					connection = nil
				end

				for _, v in pairs(lookup) do
					pcall(function()
						v:Stop()
						v:Destroy()
					end)
				end

				table.clear(lookup)

				if Animate and next(lookup2) then
					for k, v in pairs(lookup2) do
						local findFirstChildResult = Animate:FindFirstChild(k)

						if findFirstChildResult then
							local Animation = findFirstChildResult:FindFirstChildOfClass("Animation")

							if Animation then
								Animation.AnimationId = v
							end
						end
					end
				end

				if Animate then
					Animate.Disabled = false
				end
			end
			local function fn_handleHumanoid2(instance2)
				local Humanoid = instance2:FindFirstChildOfClass("Humanoid")

				if Humanoid then
					return Humanoid:FindFirstChildOfClass("Animator")
				end

				return nil
			end
			local function fn_applyAnimationId(instance2, instance3)
				local Animate2 = instance2:FindFirstChild("Animate")

				Animate = instance3:FindFirstChild("Animate")

				if not Animate2 or not Animate then
					return
				end

				for _, v in ipairs({
					"walk",
					"run",
					"swim",
					"swimidle",
					"jump",
					"climb",
					"fall",
					"idle",
					"sit",
					"toolnone",
					"toollunge",
					"toolslash"
				}) do
					local findFirstChildResult = Animate2:FindFirstChild(v)
					local findFirstChildResult2 = Animate:FindFirstChild(v)

					if findFirstChildResult and findFirstChildResult2 then
						local Animation = findFirstChildResult:FindFirstChildOfClass("Animation")
						local Animation2 = findFirstChildResult2:FindFirstChildOfClass("Animation")

						if Animation and Animation2 and Animation.AnimationId ~= "" then
							if not lookup2[v] then
								lookup2[v] = Animation2.AnimationId
							end

							Animation2.AnimationId = Animation.AnimationId
						end
					end
				end
			end

			connection = RunService.Heartbeat:Connect(function()
				if not packsStateService.State.Syncing then
					fnapplyAnimation()
					fn_applyText("Sync Emote")

					return
				end

				local l = player and player.Character
				local W = LocalPlayer.Character

				if not l or not W then
					fnapplyAnimation()
					packsStateService.State.Syncing = false
					fn_applyText("Sync Emote")

					return
				end

				if not syncWithPlayerFlag then
					fn_applyAnimationId(l, W)
					syncWithPlayerFlag = true
				end

				local i = fn_handleHumanoid2(l)
				local l = fn_handleHumanoid2(W)
				local G = W:FindFirstChildOfClass("Humanoid")

				if not i or not l or not G then
					return
				end

				Animate = W:FindFirstChild("Animate")

				if Animate and not Animate.Disabled then
					Animate.Disabled = true
				end

				local W = i:GetPlayingAnimationTracks()
				local i = {}

				for M, M in pairs(W) do
					if M.Animation then
						local W = M.Animation.AnimationId

						if W and W ~= "" then
							i[W] = true

							local G = lookup[W]

							if G then
								pcall(function()
									G:AdjustSpeed(M.Speed)
									G:AdjustWeight(M.WeightTarget, 0.1)

									if math.abs(G.TimePosition - M.TimePosition) > 0.15 then
										G.TimePosition = M.TimePosition
									end
								end)
							else
								pcall(function()
									local G = Instance.new("Animation")

									G.AnimationId = W

									local Y = l:LoadAnimation(G)

									Y.Priority = M.Priority
									Y:Play(0.1)
									Y.TimePosition = M.TimePosition
									Y:AdjustSpeed(M.Speed)
									Y:AdjustWeight(M.WeightTarget, 0)
									lookup[W] = Y
								end)
							end
						end
					end
				end

				for l, W in pairs(lookup) do
					if not i[l] then
						pcall(function()
							W:Stop()
							W:Destroy()
						end)
						lookup[l] = nil
					end
				end
			end)

			while packsStateService.State.Syncing do
				task.wait(0.5)
			end

			fnapplyAnimation()
		end)
	end

