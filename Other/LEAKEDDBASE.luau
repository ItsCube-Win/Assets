			end

			local floored = math.floor(number - os.time())

			if floored <= 0 then
				return nil
			end

			local floored2 = math.floor(floored / 86400)
			local floored3 = math.floor(floored % 86400 / 3600)
			local floored4 = math.floor(floored % 3600 / 60)

			if floored2 > 0 then
