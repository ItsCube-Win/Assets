		local fn_handleCoreGuiResult = fn_handleCoreGui()

		if fn_handleCoreGuiResult and pcall(function()
			local VirtualInputManager = game_:GetService("VirtualInputManager")

			fn_handleCoreGuiResult:CaptureFocus()
			task.wait(0.03)
			fn_handleCoreGuiResult.Text = "/re"
			task.wait(0.03)
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game_)
			task.wait(0.02)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game_)
		end) then
			return true
		end

		local DefaultChatSystemChatEvents = game_:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local SayMessageRequest = DefaultChatSystemChatEvents and DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")

		if SayMessageRequest then
			local function fn_fireServer()
				SayMessageRequest:FireServer("/re", "All")
			end

			return pcall(fn_fireServer)
		end

		task.spawn(function()
			pcall(function()
				game_:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync("/re")
			end)
		end)

		return true
	end
	local function fn_getAttribute(flag)
		if connection then
			connection:Disconnect()
			connection = nil
		end

		if flag then
			local amount = 0
			local cycleDelayConfig = {
				CycleDelay = 0.11,
				KeyGap = 0.02,
				HoldTime = 0.03
			}
			local LocalPlayer = Players.LocalPlayer

			connection = RunService.Heartbeat:Connect(function()
				local l = LocalPlayer.Character

				if not l then
					return
				end

				local S = l:GetAttribute("IsCarriedHandcuff") == true or l:GetAttribute("IsCarried") == true or l:GetAttribute("isCarriedHandcuff") == true or l:GetAttribute("IsCarriedHandscuff") == true or LocalPlayer:GetAttribute("IsCarriedHandcuff") == true

				if not S then
					for K, K in ipairs({ "Handcuffs", "Cuffs", "Algemas" }) do
						local x = l:FindFirstChild(K)

						if x and not x:IsA("Tool") then
							S = true

							break
						end
					end
				end

				if S then
					local l = tick()

					if (l - amount) < cycleDelayConfig.CycleDelay then
						return
					end

					amount = l
					task.spawn(function()
						if VIM and VIM.SendKeyEvent then
							VIM:SendKeyEvent(true, Enum.KeyCode.A, false, game_)
							task.wait(cycleDelayConfig.HoldTime)
							VIM:SendKeyEvent(false, Enum.KeyCode.A, false, game_)
							task.wait(cycleDelayConfig.KeyGap)
							VIM:SendKeyEvent(true, Enum.KeyCode.D, false, game_)
							task.wait(cycleDelayConfig.HoldTime)
							VIM:SendKeyEvent(false, Enum.KeyCode.D, false, game_)
						elseif vim then
							vim:SendKeyEvent(true, Enum.KeyCode.A, false, game_)
							task.wait(cycleDelayConfig.HoldTime)
							vim:SendKeyEvent(false, Enum.KeyCode.A, false, game_)
							task.wait(cycleDelayConfig.KeyGap)
							vim:SendKeyEvent(true, Enum.KeyCode.D, false, game_)
							task.wait(cycleDelayConfig.HoldTime)
							vim:SendKeyEvent(false, Enum.KeyCode.D, false, game_)
						end
					end)
				end
			end)
		end
	end
	local function fn_getAttribute2(flag)
		if connection2 then
			connection2:Disconnect()
			connection2 = nil
		end

		if flag then
			local LocalPlayer = Players.LocalPlayer

			connection2 = RunService.Heartbeat:Connect(function()
				local l = LocalPlayer.Character

				if not l then
					return
				end

				local p = workspace:FindFirstChild(LocalPlayer.Name)
				local M = false

				if p then
					M = p:GetAttribute("IsCarried") == true
				end

				if not M then
					M = l:GetAttribute("IsCarriedHandcuff") == true or l:GetAttribute("IsCarried") == true or l:GetAttribute("isCarriedHandcuff") == true or l:GetAttribute("IsCarriedHandscuff") == true or LocalPlayer:GetAttribute("IsCarriedHandcuff") == true
				end

				if M then
					if connection2 then
						connection2:Disconnect()
						connection2 = nil
					end

					task.spawn(fn_applyText)
					fn_unnamed("Escaping via /re!")
					task.delay(2, function()
						if runningModeConfig.Running and runningModeConfig.Mode == "Instant" then
							fn_getAttribute2(true)
							fn_unnamed("Protection on! (VIP)")
						end
					end)
				end
			end)
		end
	end

	runningModeConfig.Execute = function(self)
		if self.Running then
			return false, "Already running"
		end

		local executeFlag = Players.LocalPlayer:GetAttribute("IsVIP") == true or Players.LocalPlayer:GetAttribute("isVIP") == true

		if self.Mode == "Instant" and not executeFlag then
			self.Mode = "Fast"
		end

		self.Running = true

		if self.Mode == "Fast" then
			fn_getAttribute(true)
			fn_unnamed("Fast protection on.")
		elseif self.Mode == "Instant" then
			fn_getAttribute2(true)
			fn_unnamed("Instant protection on! (VIP)")
		end

		return true, "Started"
	end
	runningModeConfig.Stop = function(self)
		self.Running = false
		fn_getAttribute(false)
		fn_getAttribute2(false)
		fn_unnamed("Idle")

		return true
	end

	return runningModeConfig
end
moduleDefs["Games.Rovibes.HandcuffGrab"] = function()
	local Players = game_:GetService("Players")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local RunService = game_:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	local delayLeftAmount = 0
	local lookup = {}

	local function getHumanoidRootPart(character)
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	local function fn_handleRemotes()
		local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

		return Remotes and Remotes:FindFirstChild("HandcuffCarry")
	end

	local delayPersonDelayConfig = {
		Delay = 6,
		PersonDelay = 30,
		Blocker = function(player)
			local Character = player and player.Parent and player.Character
			local humanoidRootPart = getHumanoidRootPart(Character)
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

			if not Character or not humanoidRootPart or not Humanoid then
				return "target has no character"
			end

			if Humanoid.Health <= 0 then
				return "target is dead"
			end

			if Character:GetAttribute("IsObject") then
				return "target turned into an object"
			end

			if Character:GetAttribute("IsCarried") then
				return "target already carried"
			end

			if Character:GetAttribute("IsCarrying") then
				return "target is carrying someone"
			end

			if Humanoid.Sit then
				return "target is seated"
			end

			local Character2 = LocalPlayer.Character

			if Character2 and Character2:GetAttribute("IsCarried") then
				return "you are being carried"
			end

			return nil
		end,
		IsMoving = function(player)
			local Character = player and player.Character
			local humanoidRootPart = getHumanoidRootPart(Character)

			if Character then
				local Humanoid = Character:FindFirstChildOfClass("Humanoid")

				if humanoidRootPart and Humanoid then
					return humanoidRootPart.AssemblyLinearVelocity.Magnitude > 1 or Humanoid.MoveDirection.Magnitude > 0
				end
			end

			return true
		end,
		CarriedByMe = function(player)
			local Character = player and player.Character

			if not Character or Character:GetAttribute("IsCarried") ~= true then
				return false
			end

			if Character:GetAttribute("CarrierUserId") == LocalPlayer.UserId then
				return true
			end

			local Character2 = LocalPlayer.Character

			return Character2 ~= nil and Character2:GetAttribute("IsCarrying") == true
		end
	}

	delayPersonDelayConfig.DelayLeft = function()
		return math.max(0, delayPersonDelayConfig.Delay - (os.clock() - delayLeftAmount))
	end
	delayPersonDelayConfig.PersonDelayLeft = function(player)
		local lookupEntry = player and lookup[player.UserId]

		if lookupEntry then
			return math.max(0, delayPersonDelayConfig.PersonDelay - (os.clock() - lookupEntry))
		end

		return 0
	end

	local s5 = "MarkReleased"

	local function fn_unnamed(player)
		delayLeftAmount = os.clock()

		if player then
			lookup[player.UserId] = os.clock()
		end
	end

	delayPersonDelayConfig[s5] = fn_unnamed

	local function fn_getAttribute(player)
		local Character = player.Character

		task.spawn(function()
			local now = os.clock()

			while Character and Character.Parent and Character:GetAttribute("IsCarried") == true and os.clock() - now < 900 do
				task.wait(0.25)
			end

			delayPersonDelayConfig.MarkReleased(player)
		end)
	end

	delayPersonDelayConfig.Release = function()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid then
			Humanoid:UnequipTools()
		end

		delayLeftAmount = os.clock()
	end

	local function fn_unnamed2(part, humanoid, part2, humanoid2)
		local part3 = part.CFrame * CFrame.new(0, 0, -4)
		local value = part.Position.Y - (humanoid and humanoid.HipHeight or 2) - part.Size.Y / 2 + (humanoid2 and humanoid2.HipHeight or 2) + part2.Size.Y / 2

		return CFrame.lookAt(Vector3.new(part3.Position.X, value, part3.Position.Z), Vector3.new(part.Position.X, value, part.Position.Z))
	end

	delayPersonDelayConfig.Grab = function(player, arg2)
		local grabObj = arg2 or {}
		local onStatus = grabObj.onStatus or function()
		end
		local blocker = delayPersonDelayConfig.Blocker(player)

		if blocker then
			return false, blocker
		end

		local personDelayLeft = delayPersonDelayConfig.PersonDelayLeft(player)

		if personDelayLeft > 0 then
			return false, ("game delay for the same player (%ds)"):format(math.ceil(personDelayLeft))
		end

		local Character = LocalPlayer.Character
		local humanoidRootPart = getHumanoidRootPart(Character)
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not humanoidRootPart or not Humanoid then
			return false, "no character"
		end

		local Algemas = Character:FindFirstChild("Algemas") or LocalPlayer.Backpack:FindFirstChild("Algemas")

		if not Algemas then
			return false, "no handcuffs in inventory"
		end

		local fn_handleRemotesResult = fn_handleRemotes()

		if not fn_handleRemotesResult then
			return false, "remote HandcuffCarry not found"
		end

		if Algemas.Parent ~= Character then
			Humanoid:EquipTool(Algemas)
			task.wait(0.4)
		end

		local grabAmount = 1.55

		local function fn_getNetworkPing()
			local grabAmount2 = 0.1

			pcall(function()
				grabAmount2 = LocalPlayer:GetNetworkPing()
			end)

			return (grabAmount2 * 2 + 0.15) * grabAmount
		end

		local lookup2 = {}

		local function fn_unnamed3(part)
			local now = os.clock()

			lookup2[#lookup2 + 1] = {
				now,
				part.Position
			}

			while #lookup2 > 2 and now - lookup2[1][1] > 0.2 do
				table.remove(lookup2, 1)
			end

			local lookup2Entry = lookup2[1]
			local grabAmount2 = now - lookup2Entry[1]

			if grabAmount2 < 0.05 then
				local AssemblyLinearVelocity = part.AssemblyLinearVelocity

				return Vector3.new(AssemblyLinearVelocity.X, 0, AssemblyLinearVelocity.Z)
			end

			local vector = part.Position - lookup2Entry[2]

			if not (vector.Magnitude / grabAmount2 > 200) then
				return Vector3.new(vector.X, 0, vector.Z) / grabAmount2
			end

			lookup2 = { {
				now,
				part.Position
			} }

			return Vector3.zero
		end
		local function fnapplyC(part, humanoid)
			local vector = fn_unnamed3(part)

			if vector.Magnitude < 2 then
				humanoidRootPart.CFrame = fn_unnamed2(part, humanoid, humanoidRootPart, Humanoid)

				return
			end

			local Unit = vector.Unit
			local vector2 = part.Position + vector * fn_getNetworkPing()
			local grabAmount2 = part.Position.Y - (humanoid and humanoid.HipHeight or 2) - part.Size.Y / 2
			local origin = Vector3.new(vector2.X, grabAmount2 + (Humanoid.HipHeight or 2) + humanoidRootPart.Size.Y / 2, vector2.Z) - Unit * 1.5

			humanoidRootPart.CFrame = CFrame.lookAt(origin, origin + Unit)
			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(vector.X, humanoidRootPart.AssemblyLinearVelocity.Y, vector.Z)
		end

		local connection = RunService.Heartbeat:Connect(function()
			local Character2 = player.Character
			local humanoidRootPart2 = getHumanoidRootPart(Character2)

			if humanoidRootPart2 and humanoidRootPart.Parent then
				fnapplyC(humanoidRootPart2, Character2:FindFirstChildOfClass("Humanoid"))
			end
		end)
		local ok, result, result2 = pcall(function()
			local grabAmount2 = 1
			local tries = grabObj.tries or 3

			for i = grabAmount2, tries do
				local blocker2 = delayPersonDelayConfig.Blocker(player)

				if blocker2 then
					return false, blocker2
				end

				local delayLeft = delayPersonDelayConfig.DelayLeft()

				while delayLeft > 0 do
					onStatus(("Waiting for game delay (%ds)..."):format(math.ceil(delayLeft)))
					task.wait(math.min(delayLeft, 0.5))
					delayLeft = delayPersonDelayConfig.DelayLeft()
				end

				task.wait(i == 1 and 0.6 or 0.3)

				local humanoidRootPart2 = getHumanoidRootPart(player.Character)
				local Magnitude = humanoidRootPart2 and humanoidRootPart2.AssemblyLinearVelocity.Magnitude or 0

				if Magnitude > 150 then
					return false, "target too fast (fling/teleport)"
				end

				local grabFlag = Magnitude > 2

				onStatus((grabFlag and "Cuffing %s (running, compensating ping)..." or "Cuffing %s..."):format(player.DisplayName))
				delayLeftAmount = os.clock()
				pcall(function()
					fn_handleRemotesResult:FireServer(player.Character)
				end)

				local now = os.clock()

				while true do
					task.wait(0.05)

					if delayPersonDelayConfig.CarriedByMe(player) then
						break
					elseif os.clock() - now > 1.5 then
						break
					end
				end

				if delayPersonDelayConfig.CarriedByMe(player) then
					fn_getAttribute(player)

					return true
				end

				if grabFlag then
					grabAmount += 0.35
				end
			end

			return false, "server refused (game delay)"
		end)

		connection:Disconnect()
		pcall(function()
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		end)

		if not ok then
			return false, "error: " .. tostring(result)
		end

		return result, result2
	end

	return delayPersonDelayConfig
end
moduleDefs["Games.SalaoDeFestas.SalaoService"] = function()
	local Players = game_:GetService("Players")

	game_:GetService("RunService")

	local UserInputService = game_:GetService("UserInputService")
	local ReplicatedStorage = game_:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local antiRagdollService = {
		AntiRagdoll = false,
		InstantCharged = false,
		AutoPush = false,
		AutoPushKey = nil,
		AutoPushKeyDown = false,
		AnimSpeed = 1,
		NetworkBoost = false,
		OnStatusChanged = nil
	}
	local instance

	local function fn_unnamed()
		if instance and instance.Parent then
			return instance
		end

		local ok, result = pcall(function()
			return ReplicatedStorage.Connections.dataProviders.playerReplication
		end)

		if ok and result then
			instance = result
		end

		return instance
	end
	local function fn_unnamed2(arg1)
		if antiRagdollService.OnStatusChanged then
			pcall(antiRagdollService.OnStatusChanged, arg1)
		end
	end
	local function fn_handleHumanoid()
		local Character = LocalPlayer.Character

		return Character and Character:FindFirstChildOfClass("Humanoid"), Character
	end

	local registry = {}
	local flag = false

	local function fn_unnamed3(list)
		for _, v in ipairs(list) do
			pcall(function()
				v:Disconnect()
			end)
		end

		table.clear(list)
	end
	local function fn_fireServer()
		local remote = fn_unnamed()

		if not remote then
			return
		end

		pcall(function()
			remote:FireServer("unragdoll")
		end)
	end
	local function fn_applyPlatformStandSit()
		local humanoid, instance2 = fn_handleHumanoid()

		if not humanoid or not instance2 then
			return
		end

		if humanoid.Health <= 0 then
			return
		end

		pcall(function()
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = true
			humanoid.Jump = false
		end)
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
		task.defer(function()
			pcall(function()
				humanoid:ChangeState(Enum.HumanoidStateType.Running)
			end)
		end)

		local HumanoidRootPart = instance2:FindFirstChild("HumanoidRootPart")

		if HumanoidRootPart then
			HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
		end
	end
	local function fnapplyStart()
		if flag then
			return
		end

		local PlayerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
		local InteractiveManager = PlayerScripts and PlayerScripts:FindFirstChild("InteractiveManager")
		local InteractiveHandler = InteractiveManager and InteractiveManager:FindFirstChild("InteractiveHandler")
		local Ragdoll = InteractiveHandler and InteractiveHandler:FindFirstChild("Ragdoll")

		if not Ragdoll then
			return
		end

		local ok, result = pcall(function()
			return getsenv(Ragdoll)
		end)

		if not ok or not result then
			return
		end

		if result._startLocalRagdollRuntime then
			local _startLocalRagdollRuntime = result._startLocalRagdollRuntime

			result._startLocalRagdollRuntime = function(...)
				if antiRagdollService.AntiRagdoll then
					fn_fireServer()

					return
				end

				return _startLocalRagdollRuntime(...)
			end
			flag = true
		end
	end
	local function fngetProperty(character)
		fn_unnamed3(registry)

		if not character then
			return
		end

		local Humanoid = character:WaitForChild("Humanoid", 5)

		if not Humanoid then
			return
		end

		table.insert(registry, Humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
			if not antiRagdollService.AntiRagdoll then
				return
			end

			if Humanoid.PlatformStand then
				fn_fireServer()
				fn_applyPlatformStandSit()
			end
		end))
		table.insert(registry, Humanoid.StateChanged:Connect(function(old, new)
			if not antiRagdollService.AntiRagdoll then
				return
			end

			if new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.PlatformStanding or new == Enum.HumanoidStateType.FallingDown then
				fn_fireServer()
				task.defer(fn_applyPlatformStandSit)
			end
		end))
		table.insert(registry, LocalPlayer:GetAttributeChangedSignal("IsRagdolled"):Connect(function()
			if not antiRagdollService.AntiRagdoll then
				return
			end

			if LocalPlayer:GetAttribute("IsRagdolled") then
				fn_fireServer()
				task.defer(fn_applyPlatformStandSit)
				task.delay(0.05, fn_applyPlatformStandSit)
				task.delay(0.15, fn_applyPlatformStandSit)
			end
		end))
	end

	LocalPlayer.CharacterAdded:Connect(function(character)
		flag = false
		task.wait(0.5)
		fngetProperty(character)
		task.wait(1)
		fnapplyStart()
	end)

	if LocalPlayer.Character then
		fngetProperty(LocalPlayer.Character)
		task.spawn(function()
			task.wait(1)
			fnapplyStart()
		end)
	end

	antiRagdollService.SetAntiRagdoll = function(self, antiRagdoll)
		self.AntiRagdoll = antiRagdoll == true

		local setAntiRagdollValue, s6

		if antiRagdoll then
			fnapplyStart()

			if LocalPlayer:GetAttribute("IsRagdolled") then
				fn_fireServer()
				fn_applyPlatformStandSit()
			end

			setAntiRagdollValue = fn_unnamed2
			s6 = "Anti-Ragdoll ON"
		else
			setAntiRagdollValue = fn_unnamed2
			s6 = "Anti-Ragdoll OFF"
		end

		setAntiRagdollValue(s6)
	end

	local function fn_unnamed4()
		local ok, result = pcall(function()
			return ReplicatedStorage.Connections.dataProviders.saveData
		end)

		if ok then
			return result
		end
	end

	antiRagdollService.SaveOption = function(self, arg2, arg3, arg4)
		local remote = fn_unnamed4()

		if not remote then
			return
		end

		pcall(function()
			remote:InvokeServer("saveSettings", {
				[arg2] = {
					[arg3] = arg4
				}
			})
		end)
	end
	antiRagdollService.ForceInteractiveMode = function(self)
		self:SaveOption("general", "interactive_mode", true)
		self:SaveOption("interactive", "push", "Everyone")
		pcall(function()
			LocalPlayer:SetAttribute("InteractiveMode", true)
			LocalPlayer:SetAttribute("PushEnabled", true)
		end)
	end
	antiRagdollService.SetPushImmunity = function(self, pushImmunity)
		self.PushImmunity = pushImmunity == true

		if pushImmunity then
			self:SaveOption("interactive", "push", "Nobody")
			pcall(function()
				LocalPlayer:SetAttribute("PushEnabled", false)
			end)
			fn_unnamed2("Push Immunity ON (server-gated)")
		else
			self:SaveOption("interactive", "push", "Everyone")
			pcall(function()
				LocalPlayer:SetAttribute("PushEnabled", true)
			end)
			fn_unnamed2("Push Immunity OFF")
		end
	end
	antiRagdollService.UniversalPush = false

	local registry2 = {}

	local function fnapplyAssembly(character)
		local Character = LocalPlayer.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local HumanoidRootPart2 = character and character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart or not HumanoidRootPart2 then
			return
		end

		local Unit = (HumanoidRootPart2.Position - HumanoidRootPart.Position).Unit

		if Unit.X ~= Unit.X then
			Unit = Vector3.new(0, 0, 1)
		end

		pcall(function()
			if firetouchinterest then
				firetouchinterest(HumanoidRootPart, HumanoidRootPart2, 0)
				firetouchinterest(HumanoidRootPart, HumanoidRootPart2, 1)
			end
		end)
		pcall(function()
			HumanoidRootPart2.AssemblyLinearVelocity = Unit * 250 + Vector3.new(0, 80, 0)
		end)
	end

	antiRagdollService.UniversalPushPlayer = function(arg1, player)
		if not player then
			return
		end

		fnapplyAssembly(player.Character)
	end
	antiRagdollService.SetUniversalPush = function(obj, universalPush)
		obj.UniversalPush = universalPush == true
		fn_unnamed3(registry2)

		if not universalPush then
			fn_unnamed2("Universal Push OFF")

			return
		end

		fn_unnamed2("Universal Push armed — use Auto-Push key on a nearby player")
	end
	antiRagdollService.PushCooldown = 2
	antiRagdollService._lastPushAt = 0
	antiRagdollService.GetPushCooldownRemaining = function(self)
		return math.max(0, self.PushCooldown - (os.clock() - self._lastPushAt))
	end
	antiRagdollService.InstantPush = function(self)
		local remote = fn_unnamed()

		if not remote then
			return false
		end

		if self:GetPushCooldownRemaining() > 0 then
			return false
		end

		self._lastPushAt = os.clock()
		instantPushBypass = true
		pcall(function()
			remote:FireServer("beginPushHold")
			task.wait()
			remote:FireServer("beginChargedPushAnimation", 0.7)
			task.wait()
			remote:FireServer("push", "charged", 1)
			remote:FireServer("push", "normal")
		end)
		instantPushBypass = false

		return true
	end

